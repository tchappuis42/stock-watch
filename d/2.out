uploads\/2025\/01\/Flip-7_002_PetitCaribou-90x90.png 90w, https:\/\/lepetitcaribou.ch\/wp-content\/uploads\/2025\/01\/Flip-7_002_PetitCaribou.png 1000w","thumbnail_sizes":"(max-width: 278px) 100vw, 278px","name":"Flip-7_002_PetitCaribou","alt":"Flip 7"}],"categories":[{"id":342,"name":"Ambiance","slug":"ambiance","link":"https:\/\/lepetitcaribou.ch\/categorie-produit\/ambiance\/"}],"tags":[{"id":1598,"name":"8 joueurs et plus","slug":"8-joueurs-et-plus","link":"https:\/\/lepetitcaribou.ch\/etiquette-produit\/8-joueurs-et-plus\/"},{"id":1590,"name":"Catch Up Games","slug":"catch-up-games","link":"https:\/\/lepetitcaribou.ch\/etiquette-produit\/catch-up-games\/"},{"id":78,"name":"Chiffre","slug":"chiffre","link":"https:\/\/lepetitcaribou.ch\/etiquette-produit\/chiffre\/"},{"id":18,"name":"Jeux De Cartes","slug":"jeux-de-cartes","link":"https:\/\/lepetitcaribou.ch\/etiquette-produit\/jeux-de-cartes\/"},{"id":602,"name":"Prise de Risque","slug":"prise-de-risque","link":"https:\/\/lepetitcaribou.ch\/etiquette-produit\/prise-de-risque\/"},{"id":656,"name":"Stop ou Encore","slug":"stopouencore","link":"https:\/\/lepetitcaribou.ch\/etiquette-produit\/stopouencore\/"}],"brands":[],"attributes":[{"id":1,"name":"\u00c2ge","taxonomy":"pa_age","has_variations":false,"terms":[{"id":263,"name":"D\u00e8s 12 ans","slug":"des-12-ans"},{"id":529,"name":"D\u00e8s 6-8 ans","slug":"des-6-8-ans"},{"id":531,"name":"D\u00e8s 9-11 ans","slug":"des-9-11-ans"}]},{"id":2,"name":"Langues","taxonomy":"pa_langues","has_variations":false,"terms":[{"id":23,"name":"Fran\u00e7ais","slug":"francais"}]},{"id":4,"name":"Type de jeux","taxonomy":"pa_type-de-jeux","has_variations":false,"terms":[{"id":397,"name":"Jeux de cartes","slug":"jeux-de-cartes"}]},{"id":6,"name":"Marque","taxonomy":"pa_marque","has_variations":false,"terms":[{"id":1591,"name":"Catch Up Games","slug":"catch-up-games"}]}],"variations":[],"grouped_products":[],"has_options":false,"is_purchasable":true,"is_in_stock":false,"is_on_backorder":false,"low_stock_remaining":0,"stock_availability":{"text":"En rupture de stock","class":"out-of-stock"},"sold_individually":false,"weight":"","dimensions":{"length":"","width":"","height":""},"formatted_weight":"ND","formatted_dimensions":"ND","add_to_cart":{"text":"Lire la suite","description":"En savoir plus sur &ldquo;Flip 7&rdquo;","url":"https:\/\/lepetitcaribou.ch\/produit\/flip-7\/","single_text":"Ajouter au panier","minimum":1,"maximum":1,"multiple_of":1},"is_password_protected":false,"extensions":{"gtm4wp":{"item":{"internal_id":26383,"item_id":"26383","item_name":"Flip 7","sku":"2330","price":17.9,"stocklevel":-2,"stockstatus":"outofstock","google_business_vertical":"retail","item_category":"Ambiance","id":"26383"}}},"_links":{"self":[{"href":"https:\/\/lepetitcaribou.ch\/wp-json\/wc\/store\/v1\/products\/26383","targetHints":{"allow":["GET"]}}],"collection":[{"href":"https:\/\/lepetitcaribou.ch\/wp-json\/wc\/store\/v1\/products"}],"related":[{"embeddable":true,"href":"https:\/\/lepetitcaribou.ch\/wp-json\/wc\/store\/v1\/products?related=26383&per_page=10"}]}},{"id":26068,"name":"Super Peluches","slug":"super-peluches","parent":0,"type":"simple","variation":"","permalink":"https:\/\/lepetitcaribou.ch\/produit\/super-peluches\/","sku":"2308","short_description":"<p>Lors d\u2019une trop calme apr\u00e8s-midi d\u2019\u00e9t\u00e9, des enfants trouvent dans leur chambre 2 d\u00e9s magiques cach\u00e9s dans une petite boite. Lorsque les enfants lancent ces d\u00e9s, les peluches de la chambre prennent vie et expriment leur souhait le plus fou : devenir des Super-h\u00e9ros ! Ou mieux encore\u2026 des Super Peluches !!<\/p>\n<p>Comment \u00e7a marche ?<br \/>\nDans ce jeu, les joueurs sont charg\u00e9s de former la meilleure \u00e9quipe de Super Peluches. Il faut, pour cela, recruter 4 h\u00e9ros en leur fournissant les gants, bottes, capes et masques n\u00e9cessaires \u00e0 leur panoplie de Super Peluches.<\/p>\n<p>Pour ce faire, il suffit de lancer les d\u00e9s, chacun son tour. Leur r\u00e9sultat permettra aux joueurs de r\u00e9colter les diff\u00e9rentes ressources. Mais attention, la place pour les stocker dans votre chambre est limit\u00e9e !<br \/>\nVous pourrez ensuite d\u00e9penser les ressources ainsi amass\u00e9es pour aider une Peluche \u00e0 se transformer. Chaque Super Peluche rejoignant ainsi votre \u00e9quipe vous rapportera un certain nombre d\u2019\u00e9toiles.<br \/>\nLe joueur qui aura le plus d\u2019\u00e9toiles dans son \u00e9quipe de Super Peluches \u00e0 la fin de la partie sera d\u00e9clar\u00e9 vainqueur !<\/p>","description":"<p>Lors d\u2019une trop calme apr\u00e8s-midi d\u2019\u00e9t\u00e9, des enfants trouvent dans leur chambre 2 d\u00e9s magiques cach\u00e9s dans une petite boite. Lorsque les enfants lancent ces d\u00e9s, les peluches de la chambre prennent vie et expriment leur souhait le plus fou : devenir des Super-h\u00e9ros ! Ou mieux encore\u2026 des Super Peluches !!<\/p>\n<p>Comment \u00e7a marche ?<br \/>\nDans ce jeu, les joueurs sont charg\u00e9s de former la meilleure \u00e9quipe de Super Peluches. Il faut, pour cela, recruter 4 h\u00e9ros en leur fournissant les gants, bottes, capes et masques n\u00e9cessaires \u00e0 leur panoplie de Super Peluches.<\/p>\n<p>Pour ce faire, il suffit de lancer les d\u00e9s, chacun son tour. Leur r\u00e9sultat permettra aux joueurs de r\u00e9colter les diff\u00e9rentes ressources. Mais attention, la place pour les stocker dans votre chambre est limit\u00e9e !<br \/>\nVous pourrez ensuite d\u00e9penser les ressources ainsi amass\u00e9es pour aider une Peluche \u00e0 se transformer. Chaque Super Peluche rejoignant ainsi votre \u00e9quipe vous rapportera un certain nombre d\u2019\u00e9toiles.<br \/>\nLe joueur qui aura le plus d\u2019\u00e9toiles dans son \u00e9quipe de Super Peluches \u00e0 la fin de la partie sera d\u00e9clar\u00e9 vainqueur !<\/p>\n<p>Age: 6 ans<\/p>\n<p>Joueurs: 1-4<\/p>\n<p>Dur\u00e9e: 15 minutes<\/p>\n<p><\/p>","on_sale":f