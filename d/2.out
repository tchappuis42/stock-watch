s:\/\/lepetitcaribou.ch\/etiquette-produit\/multijoueurs\/"},{"id":1583,"name":"Pegasus Spiele","slug":"pegasus-spiele","link":"https:\/\/lepetitcaribou.ch\/etiquette-produit\/pegasus-spiele\/"},{"id":232,"name":"Tuiles","slug":"tuiles","link":"https:\/\/lepetitcaribou.ch\/etiquette-produit\/tuiles\/"}],"brands":[],"attributes":[{"id":1,"name":"\u00c2ge","taxonomy":"pa_age","has_variations":false,"terms":[{"id":263,"name":"D\u00e8s 12 ans","slug":"des-12-ans"},{"id":529,"name":"D\u00e8s 6-8 ans","slug":"des-6-8-ans"},{"id":531,"name":"D\u00e8s 9-11 ans","slug":"des-9-11-ans"}]},{"id":2,"name":"Langues","taxonomy":"pa_langues","has_variations":false,"terms":[{"id":22,"name":"Allemand","slug":"allemand"},{"id":23,"name":"Fran\u00e7ais","slug":"francais"},{"id":92,"name":"Italien","slug":"italien"}]},{"id":4,"name":"Type de jeux","taxonomy":"pa_type-de-jeux","has_variations":false,"terms":[{"id":384,"name":"Jeux de plateau","slug":"jeux-de-societe"}]},{"id":6,"name":"Marque","taxonomy":"pa_marque","has_variations":false,"terms":[{"id":460,"name":"Gigamic","slug":"gigamic"}]}],"variations":[],"grouped_products":[],"has_options":false,"is_purchasable":true,"is_in_stock":true,"is_on_backorder":false,"low_stock_remaining":1,"stock_availability":{"text":"1 en stock","class":"in-stock"},"sold_individually":false,"weight":"","dimensions":{"length":"","width":"","height":""},"formatted_weight":"ND","formatted_dimensions":"ND","add_to_cart":{"text":"Ajouter au panier","description":"Ajouter au panier\u00a0: &ldquo;Dorfromantik &#8211; Le Duel&rdquo;","url":"\/wp-json\/wc\/store\/v1\/products?search=30&#038;per_page=100&#038;add-to-cart=25904","single_text":"Ajouter au panier","minimum":1,"maximum":1,"multiple_of":1},"is_password_protected":false,"extensions":{"gtm4wp":{"item":{"internal_id":25904,"item_id":"25904","item_name":"Dorfromantik - Le Duel","sku":"2300","price":43.9,"stocklevel":1,"stockstatus":"instock","google_business_vertical":"retail","item_category":"D\u00e9duction ","item_category2":" Strat\u00e9gie ","item_category3":" R\u00e9flexion","id":"25904"}}},"_links":{"self":[{"href":"https:\/\/lepetitcaribou.ch\/wp-json\/wc\/store\/v1\/products\/25904","targetHints":{"allow":["GET"]}}],"collection":[{"href":"https:\/\/lepetitcaribou.ch\/wp-json\/wc\/store\/v1\/products"}],"upsells":[{"embeddable":true,"href":"https:\/\/lepetitcaribou.ch\/wp-json\/wc\/store\/v1\/products?include=25043"}],"related":[{"embeddable":true,"href":"https:\/\/lepetitcaribou.ch\/wp-json\/wc\/store\/v1\/products?related=25904&per_page=10"}]}},{"id":23528,"name":"Tapis de jeu \u201cCentre Equestre\u201d Petit 90 x 60 cm","slug":"tapis-de-jeu-centre-equestre-petit-90-x-60-cm","parent":0,"type":"simple","variation":"","permalink":"https:\/\/lepetitcaribou.ch\/produit\/tapis-de-jeu-centre-equestre-petit-90-x-60-cm\/","sku":"2030","short_description":"<p>Ce tapis de jeu est sensationnel pour de nombreuses raisons, mais vous retrouverez ici celles qui m\u2019ont convaincues que c\u2019\u00e9tait un produit id\u00e9al pour vous, parents, structures d\u2019accueil, enseignants, etc.<\/p>\n<p>Tout d\u2019abord, ce tapis se roule ais\u00e9ment ce qui est pratique pour le ranger dans son sac de transport fourni.<\/p>\n<p>Fabriqu\u00e9 en France, il est en jersey et n\u00e9opr\u00e8ne, dans un jargon plus simplifi\u00e9 c\u2019est la m\u00eame mati\u00e8re que les combinaisons de plong\u00e9e.<\/p>\n<p>Cette mati\u00e8re antid\u00e9rapante, permet un nettoyage tr\u00e8s facile et rapide. Un petit coup de chiffon humide, avec ou sans produit, r\u00e9gulier ou un nettoyage en machine \u00e0 laver (pas plus de 1-2x par an pour \u00e9viter une usure du dessin sur le long terme).<\/p>","description":"<p>Ce tapis de jeu est sensationnel pour de nombreuses raisons, mais vous retrouverez ici celles qui m\u2019ont convaincues que c\u2019\u00e9tait un produit id\u00e9al pour vous, parents, structures d\u2019accueil, enseignants, etc.<\/p>\n<p>Tout d\u2019abord, ce tapis se roule ais\u00e9ment ce qui est pratique pour le ranger dans son sac de transport fourni.<\/p>\n<p>Fabriqu\u00e9 en France, il est en jersey et n\u00e9opr\u00e8ne, dans un jargon plus simplifi\u00e9 c\u2019est la m\u00eame mati\u00e8re que les combinaisons de plong\u00e9e.<\/p>\n<p>Cette mati\u00e8re antid\u00e9rapante, permet un nettoyage tr\u00e8s facile et rapide. Un petit coup de chiffon humide, avec ou sans produit, r\u00e9gulier ou un nettoyage en machine \u00e0 laver (pas plus de 1-2x par an pour \u00e9viter une usure du dessin sur le long terme).<\/p>\n<p>On aime les univers vari\u00e9s, leurs diff\u00e9rentes tailles (adapt\u00e9es pour tous les lieux d\u2019habitation, salles d\u2019attente, cr\u00e8che, nurserie ou UAPE).<\/p>\n<p>Et enfin on pourra jouer sur ce tapis avec des voitures, Playmobil, Lego, figurines, animaux Schleich, etc. La stabilit\u00e9 des jouets sur le tapis est garantie, fini la frustration due aux jouets qui tombent.<\/p>\n<p>Ce tapis est anti-d\u00e9rapant.<\/p>\n<p>Dimensions: 90 x 60 cm<\/p>\n<p>Mat\u00e9riaux: N\u00e9opr\u00e8ne naturel, Jersey, Encre v\u00e9g\u00e9tale<\/p>\n<p>Poids: 0.9 kg<\/p>\n<p>Entretien: Lavable avec une \u00e9ponge et du d\u00e9sinfectant. Pouvant passer occasionnellement \u00e0 la machine \u00e0 laver (30\u00b0c sans essorage)<\/p>\n<p>Provenance: France<\/p>\n<p><\/p>","on_sale":false,"prices":{"price":"7590","regular_price":"7590","sale_price":"7590","price_range":null,"currency_code":"CHF","currency_symbol":"CHF","currency_minor_unit":2,"currency_decimal_separator":".","currency_thousand_separator":",","currency_prefix":"CHF","currency_suffix":""},"price_html":"<span class=\"woocommerce-Price-amount amount\"><span class=\"woocommerce-Price-currencySymbol\">&#067;&#072;&#070;<\/span>75.90<\/span>","average_rating":"0","review_count":0,"images":[{"id":23533,"src":"https:\/\/lepetitcaribou.ch\/wp-content\/uploads\/2024\/02\/Tapis-Centre-Equestre-Petit_002_PetitCaribou.png","thumbnail":"https:\/\/lepetitcari