titCaribou.png 1000w","thumbnail_sizes":"(max-width: 278px) 100vw, 278px","name":"Happy-Mochi_001_PetitCaribou","alt":"Happy Mochi"}],"categories":[{"id":342,"name":"Ambiance","slug":"ambiance","link":"https:\/\/lepetitcaribou.ch\/categorie-produit\/ambiance\/"}],"tags":[{"id":327,"name":"Alimentation","slug":"alimentation","link":"https:\/\/lepetitcaribou.ch\/etiquette-produit\/alimentation\/"},{"id":227,"name":"Asie","slug":"asie","link":"https:\/\/lepetitcaribou.ch\/etiquette-produit\/asie\/"},{"id":18,"name":"Jeux De Cartes","slug":"jeux-de-cartes","link":"https:\/\/lepetitcaribou.ch\/etiquette-produit\/jeux-de-cartes\/"},{"id":77,"name":"Multijoueurs","slug":"multijoueurs","link":"https:\/\/lepetitcaribou.ch\/etiquette-produit\/multijoueurs\/"}],"brands":[],"attributes":[{"id":1,"name":"\u00c2ge","taxonomy":"pa_age","has_variations":false,"terms":[{"id":263,"name":"D\u00e8s 12 ans","slug":"des-12-ans"},{"id":529,"name":"D\u00e8s 6-8 ans","slug":"des-6-8-ans"},{"id":531,"name":"D\u00e8s 9-11 ans","slug":"des-9-11-ans"}]},{"id":2,"name":"Langues","taxonomy":"pa_langues","has_variations":false,"terms":[{"id":22,"name":"Allemand","slug":"allemand"},{"id":23,"name":"Fran\u00e7ais","slug":"francais"},{"id":92,"name":"Italien","slug":"italien"}]},{"id":4,"name":"Type de jeux","taxonomy":"pa_type-de-jeux","has_variations":false,"terms":[{"id":397,"name":"Jeux de cartes","slug":"jeux-de-cartes"}]}],"variations":[],"grouped_products":[],"has_options":false,"is_purchasable":true,"is_in_stock":true,"is_on_backorder":false,"low_stock_remaining":1,"stock_availability":{"text":"1 en stock","class":"in-stock"},"sold_individually":false,"weight":"","dimensions":{"length":"","width":"","height":""},"formatted_weight":"ND","formatted_dimensions":"ND","add_to_cart":{"text":"Ajouter au panier","description":"Ajouter au panier\u00a0: &ldquo;Happy Mochi&rdquo;","url":"\/wp-json\/wc\/store\/v1\/products?search=30&#038;per_page=100&#038;add-to-cart=27203","single_text":"Ajouter au panier","minimum":1,"maximum":1,"multiple_of":1},"is_password_protected":false,"extensions":{"gtm4wp":{"item":{"internal_id":27203,"item_id":"27203","item_name":"Happy Mochi","sku":"2430","price":15.9,"stocklevel":1,"stockstatus":"instock","google_business_vertical":"retail","item_category":"Ambiance","id":"27203"}}},"_links":{"self":[{"href":"https:\/\/lepetitcaribou.ch\/wp-json\/wc\/store\/v1\/products\/27203","targetHints":{"allow":["GET"]}}],"collection":[{"href":"https:\/\/lepetitcaribou.ch\/wp-json\/wc\/store\/v1\/products"}],"related":[{"embeddable":true,"href":"https:\/\/lepetitcaribou.ch\/wp-json\/wc\/store\/v1\/products?related=27203&per_page=10"}]}},{"id":26383,"name":"Flip 7","slug":"flip-7","parent":0,"type":"simple","variation":"","permalink":"https:\/\/lepetitcaribou.ch\/produit\/flip-7\/","sku":"2330","short_description":"<p>Accumulez les cartes au fil des tours pour gagner des points. Mais attention, si vous recevez un num\u00e9ro que vous avez d\u00e9j\u00e0, vous perdez tout !<\/p>\n<p>Saurez-vous dire stop \u00e0 temps ?<\/p>","description":"<p>Accumulez les cartes au fil des tours pour gagner des points. Mais attention, si vous recevez un num\u00e9ro que vous avez d\u00e9j\u00e0, vous perdez tout !<\/p>\n<p>Saurez-vous dire stop \u00e0 temps ?<\/p>\n<p>\u00c0 chaque manche, collectionnez des cartes une par une pour marquer autant de points que le total de leurs valeurs. Mais vous devrez savoir dire stop avant de recevoir un num\u00e9ro que vous avez d\u00e9j\u00e0 ! Sinon, vous sautez et quittez la manche sans gagner de point&#8230; Et plus une carte a un num\u00e9ro \u00e9lev\u00e9, plus il y en a dans la pioche : le paquet compte une carte 1, et douze cartes 12.<\/p>\n<p>Avec un peu de chance, vous pourrez \u00e9galement compter sur des cartes sp\u00e9ciales pour vous prot\u00e9ger, bloquer vos adversaires, ou les obliger \u00e0 recevoir trois cartes d&#8217;un coup.<\/p>\n<p>Si vous parvenez \u00e0 collectionner 7 cartes Num\u00e9ro diff\u00e9rentes, vous r\u00e9alisez un Flip 7 : vous mettez fin \u00e0 la manche et gagnez 15 points suppl\u00e9mentaires, sous les yeux \u00e9bahis de vos adversaires !<\/p>\n<p>Quand un ou plusieurs joueurs atteignent 200 points \u00e0 la fin d&#8217;une manche, la personne avec le plus haut score remporte la partie !<\/p>\n<p>&nbsp;<\/p>\n<p>Contenu:<\/p>\n<ul>\n<li>79 cartes Num\u00e9ro<\/li>\n<li>6 cartes Bonus<\/li>\n<li>9 cartes Sp\u00e9ciales<\/li>\n<li>R\u00e8gle du jeu<\/li>\n<\/ul>\n<p>Age: 8 ans<\/p>\n<p>Joueurs: 3+<\/p>\n<p>Dur\u00e9e: 20 minutes<\/p>\n<p><\/p>","on_sale":false,"prices":{"price":"1790","regular_price":"1790","sale_price":"1790","price_range":null,"currency_code":"CHF","currency_symbol":"CHF","currency_minor_unit":2,"currency_decimal_separator":".","currency_thousand_separator":",","currency_prefix":"CHF","currency_suffix":""},"price_html":"<span class=\"woocommerce-Price-amount amount\"><span class=\"woocommerce-Price-currencySymbol\">&#067;&#072;&#070;<\/span>17.90<\/span>","average_rating":"0","review_count":0,"images":[{"id":26384,"src":"https:\/\/lepetitcaribou.ch\/wp-content\/uploads\/2025\/01\/Flip-7_001_PetitCaribou.png","thumbnail":"https:\/\/lepetitcaribou.ch\/wp-content\/uploads\/2025\/01\/Flip-7_001_PetitCaribou-278x278.png","srcset":"https:\/\/lepetitcaribou.ch\/wp-content\/uploads\/2025\/01\/Flip-7_001_PetitCaribou.png 1000w, https:\/\/lepetitcaribou.ch\/wp-content\/uploads\/2025\/01\/Flip-7_001_PetitCaribou-278x278.png 278w, https:\/\/lepetitcaribou.ch\/wp-content\/uploads\/2025\/01\/Flip-7_001_PetitCaribou-100x100.png 100w, https:\/\/lepetitcaribou.ch\/wp-content\/uploads\/2025\/01\/Flip-7_001_PetitCaribou-501x501.png 501w, https:\/\/lepetitcaribou.ch\/wp-content\/uploads\/2025\/01\/Flip-7_001_PetitCaribou-300x300.png 300w, https:\/\/lepetitcaribou.ch\/wp-content\/uploads\/2025\/01\/Flip-7_001_PetitCaribou-150x150.png 150w, https:\/\/lepetitcaribou.ch\/wp-content\/uploads\/2025\/01\/Flip-7_001_PetitCaribou-768x768.png 768w, https:\/\