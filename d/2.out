p-json\/wc\/store\/v1\/products"}],"upsells":[{"embeddable":true,"href":"https:\/\/lepetitcaribou.ch\/wp-json\/wc\/store\/v1\/products?include=29186,29197,29198"}],"related":[{"embeddable":true,"href":"https:\/\/lepetitcaribou.ch\/wp-json\/wc\/store\/v1\/products?related=29192&per_page=10"}]}},{"id":29186,"name":"Sac Ours ivoire 30cm","slug":"sac-ours-ivoire-30cm","parent":0,"type":"simple","variation":"","permalink":"https:\/\/lepetitcaribou.ch\/produit\/sac-ours-ivoire-30cm\/","sku":"2558-1","short_description":"<p>Le sac \u00e0 bandouli\u00e8re ours\u00a0 de Doudou et Compagnie est un accessoire charmant et fonctionnel pour les enfants. Avec une hauteur de 30 cm, il offre suffisamment d&#8217;espace pour de petits objets personnels tout en \u00e9tant l\u00e9ger et maniable.<\/p>\n<p>Le sac est fabriqu\u00e9 en mat\u00e9riau doux qui s&#8217;adapte agr\u00e9ablement au dos, garantissant ainsi un grand confort de port. Le design mignon de l&#8217;ours fait de ce sac un compagnon attrayant, qui apporte de la joie tant au quotidien que lors des sorties. Les dimensions du sac sont de 30 cm de hauteur, 15 cm de largeur et 8 cm de longueur, ce qui le rend id\u00e9al pour les petits aventuriers.<\/p>\n<p>Le sac \u00e0 bandouli\u00e8re est un accessoire pratique et douillet qui encourage les enfants \u00e0 transporter leurs propres affaires et \u00e0 prendre des responsabilit\u00e9s.<\/p>","description":"<p>Le sac \u00e0 bandouli\u00e8re ours\u00a0 de Doudou et Compagnie est un accessoire charmant et fonctionnel pour les enfants. Avec une hauteur de 30 cm, il offre suffisamment d&#8217;espace pour de petits objets personnels tout en \u00e9tant l\u00e9ger et maniable.<\/p>\n<p>Le sac est fabriqu\u00e9 en mat\u00e9riau doux qui s&#8217;adapte agr\u00e9ablement au dos, garantissant ainsi un grand confort de port. Le design mignon de l&#8217;ours fait de ce sac un compagnon attrayant, qui apporte de la joie tant au quotidien que lors des sorties. Les dimensions du sac sont de 30 cm de hauteur, 15 cm de largeur et 8 cm de longueur, ce qui le rend id\u00e9al pour les petits aventuriers.<\/p>\n<p>Le sac \u00e0 bandouli\u00e8re est un accessoire pratique et douillet qui encourage les enfants \u00e0 transporter leurs propres affaires et \u00e0 prendre des responsabilit\u00e9s.<\/p>","on_sale":false,"prices":{"price":"2790","regular_price":"2790","sale_price":"2790","price_range":null,"currency_code":"CHF","currency_symbol":"CHF","currency_minor_unit":2,"currency_decimal_separator":".","currency_thousand_separator":",","currency_prefix":"CHF","currency_suffix":""},"price_html":"<span class=\"woocommerce-Price-amount amount\"><span class=\"woocommerce-Price-currencySymbol\">&#067;&#072;&#070;<\/span>27.90<\/span>","average_rating":"0","review_count":0,"images":[{"id":29191,"src":"https:\/\/lepetitcaribou.ch\/wp-content\/uploads\/2025\/11\/Sac-Ours-ivoire-30cm_001_PetitCaribou.png","thumbnail":"https:\/\/lepetitcaribou.ch\/wp-content\/uploads\/2025\/11\/Sac-Ours-ivoire-30cm_001_PetitCaribou-278x278.png","srcset":"https:\/\/lepetitcaribou.ch\/wp-content\/uploads\/2025\/11\/Sac-Ours-ivoire-30cm_001_PetitCaribou.png 1000w, https:\/\/lepetitcaribou.ch\/wp-content\/uploads\/2025\/11\/Sac-Ours-ivoire-30cm_001_PetitCaribou-300x300.png 300w, https:\/\/lepetitcaribou.ch\/wp-content\/uploads\/2025\/11\/Sac-Ours-ivoire-30cm_001_PetitCaribou-150x150.png 150w, https:\/\/lepetitcaribou.ch\/wp-content\/uploads\/2025\/11\/Sac-Ours-ivoire-30cm_001_PetitCaribou-768x768.png 768w, https:\/\/lepetitcaribou.ch\/wp-content\/uploads\/2025\/11\/Sac-Ours-ivoire-30cm_001_PetitCaribou-12x12.png 12w, https:\/\/lepetitcaribou.ch\/wp-content\/uploads\/2025\/11\/Sac-Ours-ivoire-30cm_001_PetitCaribou-32x32.png 32w, https:\/\/lepetitcaribou.ch\/wp-content\/uploads\/2025\/11\/Sac-Ours-ivoire-30cm_001_PetitCaribou-278x278.png 278w, https:\/\/lepetitcaribou.ch\/wp-content\/uploads\/2025\/11\/Sac-Ours-ivoire-30cm_001_PetitCaribou-501x501.png 501w, https:\/\/lepetitcaribou.ch\/wp-co