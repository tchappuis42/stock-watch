nomy":"pa_langues","has_variations":false,"terms":[{"id":23,"name":"Fran\u00e7ais","slug":"francais"}]},{"id":6,"name":"Marque","taxonomy":"pa_marque","has_variations":false,"terms":[{"id":1195,"name":"La Boite de Jeu","slug":"la-boite-de-jeu"}]},{"id":4,"name":"Type de jeux","taxonomy":"pa_type-de-jeux","has_variations":false,"terms":[{"id":384,"name":"Jeux de plateau","slug":"jeux-de-societe"}]}],"variations":[],"grouped_products":[],"has_options":false,"is_purchasable":true,"is_in_stock":true,"is_on_backorder":false,"low_stock_remaining":1,"stock_availability":{"text":"1 en stock","class":"in-stock"},"sold_individually":false,"weight":"","dimensions":{"length":"","width":"","height":""},"formatted_weight":"ND","formatted_dimensions":"ND","add_to_cart":{"text":"Ajouter au panier","description":"Ajouter au panier\u00a0: &ldquo;Super Peluches&rdquo;","url":"\/wp-json\/wc\/store\/v1\/products?search=30&#038;per_page=100&#038;add-to-cart=26068","single_text":"Ajouter au panier","minimum":1,"maximum":1,"multiple_of":1},"is_password_protected":false,"extensions":{"gtm4wp":{"item":{"internal_id":26068,"item_id":"26068","item_name":"Super Peluches","sku":"2308","price":29.9,"stocklevel":1,"stockstatus":"instock","google_business_vertical":"retail","item_category":"Ambiance","id":"26068"}}},"_links":{"self":[{"href":"https:\/\/lepetitcaribou.ch\/wp-json\/wc\/store\/v1\/products\/26068","targetHints":{"allow":["GET"]}}],"collection":[{"href":"https:\/\/lepetitcaribou.ch\/wp-json\/wc\/store\/v1\/products"}],"related":[{"embeddable":true,"href":"https:\/\/lepetitcaribou.ch\/wp-json\/wc\/store\/v1\/products?related=26068&per_page=10"}]}},{"id":25991,"name":"Everdell (Edition Essentielle)","slug":"everdell-edition-essentielle","parent":0,"type":"simple","variation":"","permalink":"https:\/\/lepetitcaribou.ch\/produit\/everdell-edition-essentielle\/","sku":"2307","short_description":"<p>Everdell &#8211; \u00c9dition Essentielle, qu&#8217;est-ce que c&#8217;est ? Il s&#8217;agit du m\u00eame jeu avec l&#8217;arbre majestueux, les magnifiques et si mignonnes cartes et l&#8217;immense plateau de jeu. Dans une bo\u00eete au m\u00eame format.\u00a0\u00c0 la diff\u00e9rence que les ressources customis\u00e9es du jeu ont \u00e9t\u00e9 remplac\u00e9es par des planches de punchboard en carton \u00e9pais et que la version Solo a \u00e9t\u00e9 retir\u00e9e.\u00a0Vous pouvez vous procurer l&#8217;Upgrade Pack s\u00e9par\u00e9ment pour vivre pleinement l&#8217;exp\u00e9rience Everdell.<\/p>\n<p>Au c\u0153ur de la vaste for\u00eat du monde d\u2019Everdell, une civilisation d&#8217;animaux forestiers se d\u00e9veloppe et prosp\u00e8re. Toutes les cr\u00e9atures luttent chaque ann\u00e9e pour construire une nouvelle ville pour passer l\u2019hiver ! Avec des b\u00e2timents \u00e0 construire, des personnages passionnants \u00e0 rencontrer, et des \u00e9v\u00e9nements \u00e0 g\u00e9rer, une ann\u00e9e charg\u00e9e vous attend.<\/p>\n<p>Un jeu simple \u00e0 apprendre avec une r\u00e9elle profondeur !<\/p>","description":"<p>Everdell &#8211; \u00c9dition Essentielle, qu&#8217;est-ce que c&#8217;est ? Il s&#8217;agit du m\u00eame jeu avec l&#8217;arbre majestueux, les magnifiques et si mignonnes cartes et l&#8217;immense plateau de jeu. Dans une bo\u00eete au m\u00eame format.\u00a0\u00c0 la diff\u00e9rence que les ressources customis\u00e9es du jeu ont \u00e9t\u00e9 remplac\u00e9es par des planches de punchboard en carton \u00e9pais et que la version Solo a \u00e9t\u00e9 retir\u00e9e.\u00a0Vous pouvez vous procurer l&#8217;Upgrade Pack s\u00e9par\u00e9ment pour vivre pleinement l&#8217;exp\u00e9rience Everdell.<\/p>\n<p>Au coeur de la vaste for\u00eat du monde d\u2019Everdell, une civilisation d&#8217;animaux forestiers se d\u00e9veloppe et prosp\u00e8re. Toutes les cr\u00e9atures luttent chaque ann\u00e9e pour construire une nouvelle ville pour passer l\u2019hiver ! Avec des b\u00e2timents \u00e0 construire, des personnages passionnants \u00e0 rencontrer, et des \u00e9v\u00e9nements \u00e0 g\u00e9rer, une ann\u00e9e charg\u00e9e vous attend&#8230;<\/p>\n<p>Everdell&#8230;\u00a0placement,\u00a0pose d&#8217;ouvriers, draft et construction de tableau !<\/p>\n<p>Everdell\u00a0allie une m\u00e9canique de placement d\u2019ouvriers \u00e0 celle de la construction de tableau. Incarnez le leader d\u2019un village que vous aurez pour mission de d\u00e9velopper avant la nouvelle lune hivernale.<\/p>\n<p>Serez-vous le meilleur des leaders d\u2019Everdell ?<\/p>\n<p>Everdell, les points forts :<\/p>\n<ul>\n<li>Un jeu simple \u00e0 apprendre avec une r\u00e9elle profondeur<\/li>\n<li>Un syst\u00e8me de placement d&#8217;ouvriers fluide et une grand rejouabilit\u00e9<\/li>\n<\/ul>\n<p>Contenu:<\/p>\n<ul>\n<li>128 cartes superbement illustr\u00e9es<\/li>\n<li>1 plateau de jeu<\/li>\n<li>25 cr\u00e9atures en bois<\/li>\n<li>1 arbre \u00e9ternel<\/li>\n<li>4 tuiles \u00c9v\u00e8nement<\/li>\n<li>27 mini cartes<\/li>\n<li>des jetons divers<\/li>\n<li>1 livret de r\u00e8gles<\/li>\n<\/ul>\n<p>Age: 10 ans<\/p>\n<p>Joueurs: 2-4<\/p>\n<p>Dur\u00e9e: 60 minutes<\/p>","on_sale":false,"prices":{"price":"5390","regular_price":"5390","sale_price":"5390","price_range":null,"currency_code":"CHF","currency_symbol":"CHF","currency_minor_unit":2,"currency_decimal_separator":".","currency_thousand_separator":",","currency_prefix":"CHF","currency_suffix":""},"price_html":"<span class=\"woocommerce-Price-amount amount\"><span class=\"woocommerce-Price-currencySymbol\">&#067;&#072;&#070;<\/span>53.90<\/span>","average_rating":"0","review_count":0,"images":[{"id":25992,"src":"https:\/\/lepetitcaribou.ch\/wp-content\/uploads\/2024\/11\/Everdell-Edition-Essentielle_001_PetitCaribou.png","thumbnail":"https:\/\/lepetitcaribou.ch\/wp-content\/uploads\/2024\/11\/Everdell-Edition-Essentielle_001_PetitCaribou-278x278.png","srcset":"https:\/\/lepetitcaribou.ch\/wp-content\/uploads\/2024\/11\/Everdell-Edition-Essentielle_001_PetitCaribou.png 1000w, https:\/\/lepetitc