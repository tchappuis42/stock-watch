furie-nocturne-30-cm\/","single_text":"Ajouter au panier","minimum":1,"maximum":9999,"multiple_of":1},"is_password_protected":false,"extensions":{"gtm4wp":{"item":{"internal_id":27806,"item_id":"27806","item_name":"Krokmou Furie Nocturne 30 cm","sku":"2470-1","price":34.9,"stocklevel":0,"stockstatus":"outofstock","google_business_vertical":"retail","item_category":"Jouets & B\u00e9b\u00e9","id":"27806"}}},"_links":{"self":[{"href":"https:\/\/lepetitcaribou.ch\/wp-json\/wc\/store\/v1\/products\/27806","targetHints":{"allow":["GET"]}}],"collection":[{"href":"https:\/\/lepetitcaribou.ch\/wp-json\/wc\/store\/v1\/products"}],"related":[{"embeddable":true,"href":"https:\/\/lepetitcaribou.ch\/wp-json\/wc\/store\/v1\/products?related=27806&per_page=10"}]}},{"id":27203,"name":"Happy Mochi","slug":"happy-mochi","parent":0,"type":"simple","variation":"","permalink":"https:\/\/lepetitcaribou.ch\/produit\/happy-mochi\/","sku":"2430","short_description":"<p>Dans Happy Mochi, vous devrez vous d\u00e9barrasser de vos cartes, mais sans les r\u00e9arranger dans votre main, ni combiner des cartes qui ne sont pas \u00e0 c\u00f4t\u00e9 l&#8217;une de l&#8217;autre<\/p>\n<p>Sur le th\u00e8me du Mochi, placez vos cartes Mochi par paires et soyez le premier \u00e0 toutes les jouer ! Super mignon et amusant, et aussi adapt\u00e9 aux daltoniens !<\/p>","description":"<div id=\"et-tab-description\" class=\"et-product-page-tab-wrapper clearfix\">\n<div id=\"content_description\" class=\"ty-wysiwyg-content content-description et-tab-content\">\n<div>D\u00e9barrassez-vous le plus vite possible de vos cartes Mochi !<\/div>\n<div>Pour gagner, ayez le plus petit score lorsqu\u2019au contraire un autre joueur atteint 30 points, mettant fin \u00e0 la partie.<br \/>\nDans Happy Mochi, vous recevez 7 cartes que vous ne pouvez pas classer ! \u00c0 votre tour, piochez une carte ou jouez un duo. Pour ce faire, prenez deux cartes adjacentes dans votre main pour recouvrir le duo central, en respectant les contraintes de valeur (inf\u00e9rieure ou sup\u00e9rieure) et de couleur. Si vous jouez deux cartes de m\u00eame valeur, c\u2019est un Happy Mochi, ne tenez pas compte des contraintes ! Une fois un duo jou\u00e9, appliquez ses effets \u00e9ventuels : tourner la carte Sens, faire piocher, passer une carte \u00e0 son voisin, ou mettre une carte en r\u00e9serve.<\/div>\n<p>D\u00e8s qu\u2019un joueur n\u2019a plus de carte, la manche s\u2019arr\u00eate, chacun compte les points des cartes lui restant en main, et l\u2019on rejoue une nouvelle manche, jusqu\u2019\u00e0 ce qu\u2019un joueur atteigne 30, mettant fin \u00e0 la partie.<\/p>\n<p>Age: 8 ans<\/p>\n<\/div>\n<\/div>\n<p>Joueurs: 2-6<\/p>\n<p>Dur\u00e9e: 15 minutes<\/p>","on_sale":false,"prices":{"price":"1590","regular_price":"1590","sale_price":"1590","price_range":null,"currency_code":"CHF","currency_symbol":"CHF","currency_minor_unit":2,"currency_decimal_separator":".","currency_thousand_separator":",","currency_prefix":"CHF","currency_suffix":""},"price_html":"<span class=\"woocommerce-Price-amount amount\"><span class=\"woocommerce-Price-currencySymbol\">&#067;&#072;&#070;<\/span>15.90<\/span>","average_rating":"0","review_count":0,"images":[{"id":27206,"src":"https:\/\/lepetitcaribou.ch\/wp-content\/uploads\/2025\/03\/Happy-Mochi_001_PetitCaribou.png","thumbnail":"https:\/\/lepetitcaribou.ch\/wp-content\/uploads\/2025\/03\/Happy-Mochi_001_PetitCaribou-278x278.png","srcset":"https:\/\/lepetitcaribou.ch\/wp-content\/uploads\/2025\/03\/Happy-Mochi_001_PetitCaribou.png 1000w, https:\/\/lepetitcaribou.ch\/wp-content\/uploads\/2025\/03\/Happy-Mochi_001_PetitCaribou-278x278.png 278w, https:\/\/lepetitcaribou.ch\/wp-content\/uploads\/2025\/03\/Happy-Mochi_001_PetitCaribou-100x100.png 100w, https:\/\/lepetitcaribou.ch\/wp-content\/uploads\/2025\/03\/Happy-Mochi_001_PetitCaribou-501x501.png 501w, https:\/\/lepetitcaribou.ch\/wp-content\/uploads\/2025\/03\/Happy-Mochi_001_PetitCaribou-300x300.png 300w, https:\/\/lepetit