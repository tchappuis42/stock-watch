iations":false,"terms":[{"id":402,"name":"Puzzles","slug":"puzzles"}]}],"variations":[],"grouped_products":[],"has_options":false,"is_purchasable":true,"is_in_stock":true,"is_on_backorder":false,"low_stock_remaining":2,"stock_availability":{"text":"2 en stock","class":"in-stock"},"sold_individually":false,"weight":"","dimensions":{"length":"","width":"","height":""},"formatted_weight":"ND","formatted_dimensions":"ND","add_to_cart":{"text":"Ajouter au panier","description":"Ajouter au panier\u00a0: &ldquo;Waytoplay Extension Mixed \u2013 8 pi\u00e8ces&rdquo;","url":"\/wp-json\/wc\/store\/v1\/products?search=30&#038;per_page=100&#038;add-to-cart=15147","single_text":"Ajouter au panier","minimum":1,"maximum":2,"multiple_of":1},"is_password_protected":false,"extensions":{"gtm4wp":{"item":{"internal_id":15147,"item_id":"15147","item_name":"Waytoplay Extension Mixed \u2013 8 pi\u00e8ces","sku":"1304","price":29.9,"stocklevel":2,"stockstatus":"instock","google_business_vertical":"retail","item_category":"Jouets & B\u00e9b\u00e9","id":"15147"}}},"_links":{"self":[{"href":"https:\/\/lepetitcaribou.ch\/wp-json\/wc\/store\/v1\/products\/15147","targetHints":{"allow":["GET"]}}],"collection":[{"href":"https:\/\/lepetitcaribou.ch\/wp-json\/wc\/store\/v1\/products"}],"upsells":[{"embeddable":true,"href":"https:\/\/lepetitcaribou.ch\/wp-json\/wc\/store\/v1\/products?include=15094,15093,15100,15099"}],"related":[{"embeddable":true,"href":"https:\/\/lepetitcaribou.ch\/wp-json\/wc\/store\/v1\/products?related=15147&per_page=10"}]}},{"id":15100,"name":"Waytoplay Roi de la route &#8211; 40 pi\u00e8ces","slug":"waytoplay-roi-de-la-route-40-pieces","parent":0,"type":"simple","variation":"","permalink":"https:\/\/lepetitcaribou.ch\/produit\/waytoplay-roi-de-la-route-40-pieces\/","sku":"1303","short_description":"<p>Si vous voulez \u00eatre le\u00a0roi de la route,\u00a0ce coffret est parfait pour vous\u00a0! Il comprend pas moins de 40 pi\u00e8ces, offrant de nombreuses possibilit\u00e9s de jeu pour tous. Ce coffret\u00a0gigantesque\u00a0est hautement recommand\u00e9 pour les amoureux des petites voitures et pour les \u00e9coles et garderies.<\/p>\n<ul>\n<li>Jouet souple et durable, mesurant 648\u00a0cm de long<\/li>\n<li>Comprend 16\u00a0virages, 16\u00a0lignes droites, 4 intersections et 4 ronds-points.<\/li>\n<li>Peut \u00eatre utilis\u00e9 en int\u00e9rieur comme \u00e0 l\u2019ext\u00e9rieur<\/li>\n<li>Pi\u00e8ces faciles \u00e0 assembler<\/li>\n<li>Encourage l\u2019imagination dans le jeu<\/li>\n<li>Id\u00e9al en association avec d\u2019autre jouets<\/li>\n<li>Peuvent \u00eatre assembl\u00e9es sur presque toutes les surfaces.<\/li>\n<\/ul>","description":"<p>Les circuits flexibles, fabriqu\u00e9s en Europe<\/p>\n<p>Si vous voulez \u00eatre le\u00a0roi de la route,\u00a0ce coffret est parfait pour vous\u00a0! Il comprend pas moins de 40 pi\u00e8ces, offrant de nombreuses possibilit\u00e9s de jeu pour tous. Ce coffret\u00a0gigantesque\u00a0est hautement recommand\u00e9 pour les amoureux des petites voitures et pour les \u00e9coles et garderies.<\/p>\n<ul>\n<li>Jouet souple et durable, mesurant 648\u00a0cm de long<\/li>\n<li>Comprend 16\u00a0virages, 16\u00a0lignes droites, 4 intersections et 4 ronds-points.<\/li>\n<li>Peut \u00eatre utilis\u00e9 en int\u00e9rieur comme \u00e0 l\u2019ext\u00e9rieur<\/li>\n<li>Pi\u00e8ces faciles \u00e0 assembler<\/li>\n<li>Encourage l\u2019imagination dans le jeu<\/li>\n<li>Id\u00e9al en association avec d\u2019autre jouets<\/li>\n<li>Peuvent \u00eatre assembl\u00e9es sur presque toutes les surfaces.<\/li>\n<\/ul>\n<p>Age: d\u00e8s 2 ans<\/p>\n<p><\/p>","on_sale":false,"prices":{"price":"13900","regular_price":"13900","sale_price":"13900","price_range":null,"currency_code":"CHF","currency_symbol":"CHF","currency_minor_unit":2,"currency_decimal_separator":".","currency_thousand_separator":",","currency_prefix":"CHF","currency_suffix":""},"price_html":"<span class=\"woocommerce-Price-amount amount\"><span class=\"woo