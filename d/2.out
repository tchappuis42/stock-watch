cklevel":2,"stockstatus":"instock","google_business_vertical":"retail","item_category":"Jouets & B\u00e9b\u00e9","id":"15094"}}},"_links":{"self":[{"href":"https:\/\/lepetitcaribou.ch\/wp-json\/wc\/store\/v1\/products\/15094","targetHints":{"allow":["GET"]}}],"collection":[{"href":"https:\/\/lepetitcaribou.ch\/wp-json\/wc\/store\/v1\/products"}],"upsells":[{"embeddable":true,"href":"https:\/\/lepetitcaribou.ch\/wp-json\/wc\/store\/v1\/products?include=15147,15093,15100,15099"}],"related":[{"embeddable":true,"href":"https:\/\/lepetitcaribou.ch\/wp-json\/wc\/store\/v1\/products?related=15094&per_page=10"}]}},{"id":15093,"name":"Waytoplay P\u00e9riph\u00e9rique &#8211; 12 pi\u00e8ces","slug":"waytoplay-peripherique-12-pieces","parent":0,"type":"simple","variation":"","permalink":"https:\/\/lepetitcaribou.ch\/produit\/waytoplay-peripherique-12-pieces\/","sku":"1300","short_description":"<p>Les circuits flexibles, fabriqu\u00e9s en Europe<\/p>\n<p>Ce coffret basique de 12\u00a0pi\u00e8ces\u00a0P\u00e9riph\u00e9rique\u00a0est id\u00e9al pour cr\u00e9er votre premier circuit avec waytoplay. Vous pouvez compl\u00e9ter votre circuit en achetant nos packs suppl\u00e9mentaires.<\/p>\n<ul>\n<li>Jouet souple et durable, mesurant 170\u00a0cm de long<\/li>\n<li>8\u00a0virages, 2\u00a0lignes droites, 1\u00a0intersection et 1\u00a0rond-point.<\/li>\n<li>Peut \u00eatre utilis\u00e9 en int\u00e9rieur comme \u00e0 l\u2019ext\u00e9rieur<\/li>\n<li>Pi\u00e8ces faciles \u00e0 assembler<\/li>\n<li>Encourage l\u2019imagination dans le jeu<\/li>\n<li>Id\u00e9al en association avec d\u2019autre jouets<\/li>\n<li>Peuvent \u00eatre assembl\u00e9es sur presque toutes les surfaces.<\/li>\n<\/ul>","description":"<p>Les circuits flexibles, fabriqu\u00e9s en Europe<\/p>\n<p>Ce coffret basique de 12\u00a0pi\u00e8ces\u00a0P\u00e9riph\u00e9rique\u00a0est id\u00e9al pour cr\u00e9er votre premier circuit avec waytoplay. Vous pouvez compl\u00e9ter votre circuit en achetant nos packs suppl\u00e9mentaires.<\/p>\n<ul>\n<li>Jouet souple et durable, mesurant 170\u00a0cm de long<\/li>\n<li>8\u00a0virages, 2\u00a0lignes droites, 1\u00a0intersection et 1\u00a0rond-point.<\/li>\n<li>Peut \u00eatre utilis\u00e9 en int\u00e9rieur comme \u00e0 l\u2019ext\u00e9rieur<\/li>\n<li>Pi\u00e8ces faciles \u00e0 assembler<\/li>\n<li>Encourage l\u2019imagination dans le jeu<\/li>\n<li>Id\u00e9al en association avec d\u2019autre jouets<\/li>\n<li>Peuvent \u00eatre assembl\u00e9es sur presque toutes les surfaces.<\/li>\n<\/ul>\n<p>Age: d\u00e8s 2 ans<\/p>\n<p>&nbsp;<\/p>\n<p><\/p>","on_sale":false,"prices":{"price":"4590","regular_price":"4590","sale_price":"4590","price_range":null,"currency_code":"CHF","currency_symbol":"CHF","currency_minor_unit":2,"currency_decimal_separator":".","currency_thousand_separator":",","currency_prefix":"CHF","currency_suffix":""},"price_html":"<span class=\"woocommerce-Price-amount amount\"><span class=\"woocommerce-Price-currencySymbol\">&#067;&#072;&#070;<\/span>45.90<\/span>","average_rating":"0","review_count":0,"images":[{"id":15121,"src":"https:\/\/lepetitcaribou.ch\/wp-content\/uploads\/2021\/07\/Waytoplay-peripherique-12-pieces_001_PetitCaribou.png","thumbnail":"https:\/\/lepetitcaribou.ch\/wp-content\/uploads\/2021\/07\/Waytoplay-peripherique-12-pieces_001_PetitCaribou-278x278.png","srcset":"https:\/\/lepetitcaribou.ch\/wp-content\/uploads\/2021\/07\/Waytoplay-peripherique-12-pieces_001_PetitCaribou.png 1000w, https:\/\/lepetitcaribou.ch\/wp-content\/uploads\/2021\/07\/Waytoplay-peripherique-12-pieces_001_PetitCaribou-278x278.png 278w, https:\/\/lepetitcaribou.ch\/wp-content\/uploads\/2021\/07\/Waytoplay-peripherique-12-pieces_001_PetitCaribou-100x100.png 100w, https:\/\/lepetitcaribou.ch\/wp-content\/uploads\/2021\/07\/Waytoplay-peripherique-12-pieces_001_PetitCaribou-501x501.png 501w, https:\/\/lepetitcaribou.ch\/wp-content\/uploads\/2021\/07\/Waytoplay-peripherique-12-pieces_001_PetitCaribou-300x300.png 300w, https:\/\/lepetitcaribou.ch\/wp-conte