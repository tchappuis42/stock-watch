:\/\/lepetitcaribou.ch\/categorie-produit\/en-duo\/"}],"tags":[{"id":102,"name":"Duel","slug":"duel","link":"https:\/\/lepetitcaribou.ch\/etiquette-produit\/duel\/"},{"id":588,"name":"Iello","slug":"iello","link":"https:\/\/lepetitcaribou.ch\/etiquette-produit\/iello\/"},{"id":18,"name":"Jeux De Cartes","slug":"jeux-de-cartes","link":"https:\/\/lepetitcaribou.ch\/etiquette-produit\/jeux-de-cartes\/"},{"id":43,"name":"Jeux En duo","slug":"jeux-en-duo","link":"https:\/\/lepetitcaribou.ch\/etiquette-produit\/jeux-en-duo\/"},{"id":164,"name":"Monstre","slug":"monstre","link":"https:\/\/lepetitcaribou.ch\/etiquette-produit\/monstre\/"}],"brands":[],"attributes":[{"id":1,"name":"\u00c2ge","taxonomy":"pa_age","has_variations":false,"terms":[{"id":263,"name":"D\u00e8s 12 ans","slug":"des-12-ans"}]},{"id":2,"name":"Langues","taxonomy":"pa_langues","has_variations":false,"terms":[{"id":23,"name":"Fran\u00e7ais","slug":"francais"}]},{"id":6,"name":"Marque","taxonomy":"pa_marque","has_variations":false,"terms":[{"id":490,"name":"Iello","slug":"iello"}]},{"id":4,"name":"Type de jeux","taxonomy":"pa_type-de-jeux","has_variations":false,"terms":[{"id":397,"name":"Jeux de cartes","slug":"jeux-de-cartes"}]}],"variations":[],"grouped_products":[],"has_options":false,"is_purchasable":true,"is_in_stock":true,"is_on_backorder":false,"low_stock_remaining":1,"stock_availability":{"text":"1 en stock","class":"in-stock"},"sold_individually":false,"weight":"","dimensions":{"length":"","width":"","height":""},"formatted_weight":"ND","formatted_dimensions":"ND","add_to_cart":{"text":"Ajouter au panier","description":"Ajouter au panier\u00a0: &ldquo;Time Division&rdquo;","url":"\/wp-json\/wc\/store\/v1\/products?search=30&#038;per_page=100&#038;add-to-cart=25942","single_text":"Ajouter au panier","minimum":1,"maximum":1,"multiple_of":1},"is_password_protected":false,"extensions":{"gtm4wp":{"item":{"internal_id":25942,"item_id":"25942","item_name":"Time Division","sku":"2306","price":35.9,"stocklevel":1,"stockstatus":"instock","google_business_vertical":"retail","item_category":"Ambiance","id":"25942"}}},"_links":{"self":[{"href":"https:\/\/lepetitcaribou.ch\/wp-json\/wc\/store\/v1\/products\/25942","targetHints":{"allow":["GET"]}}],"collection":[{"href":"https:\/\/lepetitcaribou.ch\/wp-json\/wc\/store\/v1\/products"}],"related":[{"embeddable":true,"href":"https:\/\/lepetitcaribou.ch\/wp-json\/wc\/store\/v1\/products?related=25942&per_page=10"}]}},{"id":25938,"name":"Cities","slug":"cities","parent":0,"type":"simple","variation":"","permalink":"https:\/\/lepetitcaribou.ch\/produit\/cities\/","sku":"2305","short_description":"<p>Le conseil municipal vous a charg\u00e9 d&#8217;\u00e9laborer un plan visant \u00e0 transformer tout un quartier de la ville. Vous avez la possibilit\u00e9 de construire de nouveaux logements, des bureaux, des parcs et des zones de loisirs en bord de mer. A vous de rendre la ville meilleure.<\/p>\n<p>Cities est un jeu de construction de ville dans lequel vous faites l&#8217;\u00e9bauche de projets immobiliers \u00e0 disposer dans votre espace de jeu. Vous aurez l&#8217;occasion de visiter les villes de Sydney, Venise, New York, Barcelone, Rio de Janeiro, Lisbonne, Mexico et Buenos Aires. Saurez-vous concevoir le plus beau quartier de la ville ?<\/p>\n<p>Le jeu se joue en huit tours (ou quatre dans une partie \u00e0 deux joueurs). \u00c0 chaque tour, les joueurs utilisent leurs ouvriers pour collecter 1 carte de score, 1 tuile ville, 1 \u00e0 2 tuiles caract\u00e9ristiques et 2 \u00e0 4 pi\u00e8ces de construction. Les tuiles Ville sont constitu\u00e9es de diff\u00e9rents types d&#8217;espace (parcs, points d&#8217;eau et construction). Les pi\u00e8ces de construction sont plac\u00e9es sur des espaces de la m\u00eame couleur pour former des b\u00e2timents pouvant atteindre 1 \u00e0 4 \u00e9tages. Chaque fois qu&#8217;un joueur accomplit un exploit, il place un de ses disques sur le plateau des r\u00e9alisations. \u00c0 la fin du jeu, les joueurs additionnent les points qu&#8217;ils ont gagn\u00e9s gr\u00e2ce \u00e0 leurs cartes objectifs et leurs r\u00e9alisations.<\/p>","description":"<p>Le conseil municipal vous a charg\u00e9 d&#8217;\u00e9laborer un plan visant \u00e0 transformer tout un quartier de la ville. Vous avez la possibilit\u00e9 de construire de nouveaux logements, des bureaux, des parcs et des zones de loisirs en bord de mer. A vous de rendre la ville meilleure.<\/p>\n<p>Cities est un jeu de construction de ville dans lequel vous faites l&#8217;\u00e9bauche de projets immobiliers \u00e0 disposer dans votre espace de jeu. Vous aurez l&#8217;occasion de visiter les villes de Sydney, Venise, New York, Barcelone, Rio de Janeiro, Lisbonne, Mexico et Buenos Aires. Saurez-vous concevoir le plus beau quartier de la ville ?<\/p>\n<p>Le jeu se joue en huit tours (ou quatre dans une partie \u00e0 deux joueurs). \u00c0 chaque tour, les joueurs utilisent leurs ouvriers pour collecter 1 carte de score, 1 tuile ville, 1 \u00e0 2 tuiles caract\u00e9ristiques et 2 \u00e0 4 pi\u00e8ces de construction. Les tuiles Ville sont constitu\u00e9es de diff\u00e9rents types d&#8217;espace (parcs, points d&#8217;eau et construction). Les pi\u00e8ces de construction sont plac\u00e9es sur des espaces de la m\u00eame couleur pour former des b\u00e2timents pouvant atteindre 1 \u00e0 4 \u00e9tages. Chaque fois qu&#8217;un joueur accomplit un exploit, il place un de ses disques sur le plateau des r\u00e9alisations. \u00c0 la fin du jeu, les joueurs additionnent les points qu&#8217;ils ont gagn\u00e9s gr\u00e2ce \u00e0 leurs cartes objectifs et leurs r\u00e9alisations.<\/p>\n<p>Age: 10 ans<\/p>\n<p>Joueurs: 2-4<\/p>\n<p>Dur\u00e9e: 30 minutes<\/p>","on_sale":false,"prices":{"price":"3590","regular_price":"3590","sale_price":"3590","price_range":null,"currency_code":"CHF","currency_symbol":"CHF","currency_minor_unit":2,"currency_decimal_separator":".","currency_thousand_separator":",","currency_prefix":"CHF","curren