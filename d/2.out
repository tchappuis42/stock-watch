tent\/uploads\/2021\/07\/Pour-le-Roi-et-Moi_009_PetitCaribou-32x32.png 32w, https:\/\/lepetitcaribou.ch\/wp-content\/uploads\/2021\/07\/Pour-le-Roi-et-Moi_009_PetitCaribou.png 1000w","thumbnail_sizes":"(max-width: 278px) 100vw, 278px","name":"Pour-le-Roi-et-Moi_009_PetitCaribou","alt":"Pour le Roi (et Moi)"}],"categories":[{"id":342,"name":"Ambiance","slug":"ambiance","link":"https:\/\/lepetitcaribou.ch\/categorie-produit\/ambiance\/"}],"tags":[{"id":290,"name":"Draft","slug":"draft","link":"https:\/\/lepetitcaribou.ch\/etiquette-produit\/draft\/"},{"id":1329,"name":"Ench\u00e8res","slug":"encheres","link":"https:\/\/lepetitcaribou.ch\/etiquette-produit\/encheres\/"},{"id":588,"name":"Iello","slug":"iello","link":"https:\/\/lepetitcaribou.ch\/etiquette-produit\/iello\/"},{"id":18,"name":"Jeux De Cartes","slug":"jeux-de-cartes","link":"https:\/\/lepetitcaribou.ch\/etiquette-produit\/jeux-de-cartes\/"},{"id":77,"name":"Multijoueurs","slug":"multijoueurs","link":"https:\/\/lepetitcaribou.ch\/etiquette-produit\/multijoueurs\/"}],"brands":[],"attributes":[{"id":1,"name":"\u00c2ge","taxonomy":"pa_age","has_variations":false,"terms":[{"id":263,"name":"D\u00e8s 12 ans","slug":"des-12-ans"},{"id":531,"name":"D\u00e8s 9-11 ans","slug":"des-9-11-ans"}]},{"id":2,"name":"Langues","taxonomy":"pa_langues","has_variations":false,"terms":[{"id":23,"name":"Fran\u00e7ais","slug":"francais"}]},{"id":6,"name":"Marque","taxonomy":"pa_marque","has_variations":false,"terms":[{"id":490,"name":"Iello","slug":"iello"}]},{"id":4,"name":"Type de jeux","taxonomy":"pa_type-de-jeux","has_variations":false,"terms":[{"id":397,"name":"Jeux de cartes","slug":"jeux-de-cartes"}]}],"variations":[],"grouped_products":[],"has_options":false,"is_purchasable":true,"is_in_stock":true,"is_on_backorder":false,"low_stock_remaining":1,"stock_availability":{"text":"1 en stock","class":"in-stock"},"sold_individually":false,"weight":"","dimensions":{"length":"","width":"","height":""},"formatted_weight":"ND","formatted_dimensions":"ND","add_to_cart":{"text":"Ajouter au panier","description":"Ajouter au panier\u00a0: &ldquo;Pour le Roi (et Moi)&rdquo;","url":"\/wp-json\/wc\/store\/v1\/products?search=30&#038;per_page=100&#038;add-to-cart=15191","single_text":"Ajouter au panier","minimum":1,"maximum":1,"multiple_of":1},"is_password_protected":false,"extensions":{"gtm4wp":{"item":{"internal_id":15191,"item_id":"15191","item_name":"Pour le Roi (et Moi)","sku":"1308","price":26.9,"stocklevel":1,"stockstatus":"instock","google_business_vertical":"retail","item_category":"Ambiance","id":"15191"}}},"_links":{"self":[{"href":"https:\/\/lepetitcaribou.ch\/wp-json\/wc\/store\/v1\/products\/15191","targetHints":{"allow":["GET"]}}],"collection":[{"href":"https:\/\/lepetitcaribou.ch\/wp-json\/wc\/store\/v1\/products"}],"related":[{"embeddable":true,"href":"https:\/\/lepetitcaribou.ch\/wp-json\/wc\/store\/v1\/products?related=15191&per_page=10"}]}},{"id":15178,"name":"Last Message","slug":"last-message","parent":0,"type":"simple","variation":"","permalink":"https:\/\/lepetitcaribou.ch\/produit\/last-message\/","sku":"1306","short_description":"<div><\/div>\n<p>Last Message : Identifiez le coupable !<\/p>\n<p>3 \u00e0 8 joueurs se divisent en troi- mais avant de donner ces indices, le criminel peut effacer secr\u00e8tement une partie de ces dessins.<\/p>\n<p>Si le criminel n&#8217;est pas identifi\u00e9 \u00e0 la fin du quatri\u00e8me tour, il gagne la partie ; dans le cas contraire, les d\u00e9tectives et la victime gagnent.<\/p>\n<p>Last Message, c&#8217;est un jeu d&#8217;ambiance addictif et malin dans lequel une victime tente de mettre les enqu\u00eateurs sur la piste du coupable, dissimul\u00e9 parmi la foule. C\u2019est un cocktail de fun, d\u00e9duction, rapidit\u00e9, observation et dessin, qui invite de 3 \u00e0 8 joueurs \u00e0 incarner des r\u00f4les diff\u00e9rents, tous aussi excitants \u00e0 jouer.<\/p>\n<div>\n<p>Last Message : Identifiez le coupable !<\/p>\n<\/div>","description":"<div>\n<p>Un crime vient d&#8217;\u00eatre commis !<\/p>\n<\/div>\n<p>La victime est incapable de parler &#8211; mais elle peut dessiner, et ce faisant, elle aidera id\u00e9alement les inspecteurs \u00e0 deviner qui, dans la vaste foule, est le criminel ! Mais ce personnage sournois fera tout et n&#8217;importe quoi pour brouiller les pistes, alors saurez-vous l&#8217;arr\u00eater avant le dernier message ?<\/p>\n<p>Pour donner des indices lors d&#8217;un tour, la victime dispose de 30 secondes pour dessiner et \u00e9crire dans une grille 3&#215;3 &#8211; mais avant de donner ces indices, le criminel peut effacer secr\u00e8tement une partie de ces dessins.<\/p>\n<p>Si le criminel n&#8217;est pas identifi\u00e9 \u00e0 la fin du quatri\u00e8me tour, il gagne la partie ; dans le cas contraire, les d\u00e9tectives et la victime gagnent.<\/p>\n<p>Last Message, c&#8217;est un jeu d&#8217;ambiance addictif et malin dans lequel une victime tente de mettre les enqu\u00eateurs sur la piste du coupable, dissimul\u00e9 parmi la foule. C\u2019est un cocktail de fun, d\u00e9duction, rapidit\u00e9, observation et dessin, qui invite de 3 \u00e0 8 joueurs \u00e0 incarner des r\u00f4les diff\u00e9rents, tous aussi excitants \u00e0 jouer.<\/p>\n<div>\n<p>Last Message : Identifiez le coupable !<\/p>\n<p>3 \u00e0 8 joueurs se divisent en trois r\u00f4les. Une victime. Un coupable. Des enqu\u00eateurs. Le crime a eu lieu dans la foule : identifier le coupable sera donc particuli\u00e8rement complexe. Mais heureusement, la victime peut encore transmettre des indices aux enqu\u00eateurs quant \u00e0 l\u2019identit\u00e9 du coupable. Feutre effa\u00e7able en main, elle peut \u00e9crire ou dessiner des informations permettant de l\u2019identifier sur une ardoise d\u00e9coup\u00e9e en 9 cases. Attention : la victime ne dispose que de 30 secondes pour composer son message. L\u2019ardoise est ensuite transmise\u2026 au coupable.<\/p>\n<p>Le coupable, de son c\u00f4t\u00e9, va tout faire pour perturber le message de la victime. Il a donc la possibilit\u00e9 d\u2019effacer des cases de l\u2019ardoise, pour rendre le message bien plus difficile \u00e0 comprendre ! Plus la partie avance, moins il pourra effacer de cases et plus le message de la victime parviendra aux enqu\u00eateurs de mani\u00e8re lisible. Mais attention : les enqu\u00eateurs ne disposent que de 4 manches pour trouver le coupable !<\/p>\n<p>Une fois l&#8217;ardoise en main, les enqu\u00eateurs doivent identifier un personnage pr\u00e9cis parmi 300 autres, rien de moins. Autant dire qu\u2019il leur faudra scruter les sc\u00e8nes de crimes afin d\u2019y d\u00e9nicher leurs moindres d\u00e9tails. S\u2019ils parviennent \u00e0 identifier le coupable avant la fin de la 4e manche, ils l\u2019emportent. Sinon, le coupable remporte la partie !<\/p>\n<p>Age: 8 ans<\/p>\n<p>Joueurs: 3-8<\/p>\n<p>Dur\u00e9e: 15 minutes<\/p>\n<p><\/p>\n<\/div>","on_sale":false,"prices":{"price":"3190","regular_price":"3190","sale_price":"3190","price_range":null,"currency_code":"CHF","currency_symbol":"CHF","currency_minor_unit":2,"currency_decimal_separator":".","currency_thousand_separator":",","currency_prefix":"CHF","currency_suffix":""},"price_html":"<span class=\"woocommerce-Price-amount amount\"><span class=\"woocommerce-Price-currencySymbol\">&#067;&#072;&#070;<\/span>31.90<\/span>","average_rating":"4.00","review_count":1,"images":[{"id":15185,"src":"https:\/\/lepetitcaribou.ch\/wp-content\/uploads\/2021\/07\/Last-Message_001_PetitCaribou.png","thumbnail":"https:\/\/lepetitcaribou.ch\/wp-content\/uploads\/2021\/07\/Last-Message_001_PetitCaribou-278x278.png","srcset":"https:\/\/lepetitcaribou.ch\/wp-content\/uploads\/2021\/07\/Last-Message_001_PetitCaribou.png 1000w, https:\/\/lepetitcaribou.ch\/wp-content\/uploads\/2021\/07\/Last-Message_001_PetitCaribou-278x278.png 278w, https:\/\/lepetitcaribou.ch\/wp-content\/uploads\/2021\/07\/Last-Message_001_PetitCaribou-100x100.png 100w, https:\/\/lepetitcaribou.ch