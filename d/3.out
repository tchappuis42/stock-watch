u00eete Tripack Pok\u00e9mon ME04 Chaos Ascendant"}],"categories":[{"id":6520,"name":"Tripacks Pok\u00e9mon en Fran\u00e7ais","slug":"tripacks-pokemon-en-francais","link":"https:\/\/www.bdfancomics.ch\/categorie-produit\/cartes-a-collectionner\/pokemon-cartes\/cartes-pokemon-en-francais\/tripacks-pokemon-en-francais\/"}],"tags":[{"id":2281,"name":"Pok\u00e9mon","slug":"pokemon","link":"https:\/\/www.bdfancomics.ch\/etiquette-produit\/pokemon\/"}],"brands":[{"id":6477,"name":"The Pok\u00e9mon Company","slug":"the-pokemon-company","link":"https:\/\/www.bdfancomics.ch\/marque\/the-pokemon-company\/"}],"attributes":[{"id":11,"name":"Licence","taxonomy":"pa_licence","has_variations":false,"terms":[{"id":6680,"name":"Pok\u00e9mon","slug":"pokemon"}]},{"id":7,"name":"Langue","taxonomy":"pa_langue","has_variations":false,"terms":[{"id":5361,"name":"Fran\u00e7ais","slug":"francais"}]},{"id":37,"name":"Type de produit TCG","taxonomy":"pa_format-tcg","has_variations":false,"terms":[{"id":12050,"name":"Tripack","slug":"tripack"}]},{"id":38,"name":"Bloc Pok\u00e9mon","taxonomy":"pa_bloc-pokemon","has_variations":false,"terms":[{"id":12065,"name":"M\u00e9ga-\u00c9volution","slug":"mega-evolution"}]},{"id":39,"name":"Extension","taxonomy":"pa_extension","has_variations":false,"terms":[{"id":12079,"name":"Chaos Ascendant","slug":"chaos-ascendant"}]}],"variations":[],"grouped_products":[],"has_options":false,"is_purchasable":true,"is_in_stock":true,"is_on_backorder":false,"low_stock_remaining":null,"stock_availability":{"text":"En stock","class":"in-stock"},"sold_individually":false,"weight":"","dimensions":{"length":"","width":"","height":""},"formatted_weight":"ND","formatted_dimensions":"ND","add_to_cart":{"text":"Ajouter au panier","description":"Ajouter au panier\u00a0: &ldquo;Tripack Pok\u00e9mon ME04 Chaos Ascendant&rdquo;","url":"\/wp-json\/wc\/store\/v1\/products?search=pokemon&#038;per_page=100&#038;orderby=date&#038;order=desc&#038;add-to-cart=89437","single_text":"Ajouter au panier","minimum":1,"maximum":60,"multiple_of":1},"is_password_protected":false,"extensions":{},"_links":{"self":[{"href":"https:\/\/www.bdfancomics.ch\/wp-json\/wc\/store\/v1\/products\/89437","targetHints":{"allow":["GET"]}}],"collection":[{"href":"https:\/\/www.bdfancomics.ch\/wp-json\/wc\/store\/v1\/products"}],"upsells":[{"embeddable":true,"href":"https:\/\/www.bdfancomics.ch\/wp-json\/wc\/store\/v1\/products?include=89015,89032,89578,89007"}],"cross_sells":[{"embeddable":true,"href":"https:\/\/www.bdfancomics.ch\/wp-json\/wc\/store\/v1\/products?include=89183,91139,91068,89434"}],"related":[{"embeddable":true,"href":"https:\/\/www.bdfancomics.ch\/wp-json\/wc\/store\/v1\/products?related=89437&per_page=10"}]}},{"id":89436,"name":"Tripack Pok\u00e9mon ME05 Nuit Noire","slug":"tripack-nuit-noire-me05","parent":0,"type":"simple","variation":"","permalink":"https:\/\/www.bdfancomics.ch\/produit\/tripack-nuit-noire-me05\/","sku":"196214142411","short_description":"<p><strong>Tripack Pok\u00e9mon Nuit Noire<\/strong> : trois boosters de l&rsquo;extension ME05 en fran\u00e7ais et une carte promo Opermine, visible derri\u00e8re le plastique.<\/p>\n<p>De quoi partir \u00e0 la chasse \u00e0 M\u00e9ga-Darkrai-ex sans passer tout de suite \u00e0 l&rsquo;ETB ou \u00e0 la display, et un format parfait \u00e0 offrir \u00e0 un dresseur qui ne dort jamais.<\/p>","description":"<h2>Tripack Pok\u00e9mon Nuit Noire : trois boosters ME05 et Opermine pour monter la garde<\/h2>\n<p>Avec le <strong>Tripack Pok\u00e9mon Nuit Noire<\/strong>, la nuit tombe sur la cinqui\u00e8me extension du bloc M\u00e9ga-\u00c9volution, mais pas question d&rsquo;y aller les mains vides : une carte promo Opermine accompagne les trois boosters. Elle est l\u00e0, bien droite au centre du blister, comme un veilleur de nuit qui aurait pris son service avant vous.<\/p>\n<h3>Le contenu, sans d\u00e9tour<\/h3>\n<p>Trois boosters Nuit Noire en version fran\u00e7aise et une carte promo Opermine. La promo est garantie, les boosters r\u00e9servent le reste. C&rsquo;est le format juste au-dessus du booster \u00e0 l&rsquo;unit\u00e9 : on ouvre plus, on compare ses tirages, et on garde une carte \u00e0 part qu&rsquo;on ne trouve pas dans les boosters du set.<\/p>\n<h3>M\u00e9ga-Darkrai-ex, le cauchemar en t\u00eate d&rsquo;affiche<\/h3>\n<p>Nuit Noire est sortie le 17 juillet 2026 avec plus de 115 cartes. M\u00e9ga-Darkrai-ex en est la vedette, et l&rsquo;extension lui r\u00e9serve m\u00eame une raret\u00e9 \u00e0 part, la \u00ab M\u00e9ga hyper rare \u00bb. Logique : selon le Pok\u00e9dex, Darkrai plonge ceux qui l&rsquo;approchent dans des cauchemars sans fin. Lui donner une M\u00e9ga-\u00c9volution, c&rsquo;\u00e9tait forc\u00e9ment promettre des nuits agit\u00e9es. \u00c0 ses c\u00f4t\u00e9s, M\u00e9ga-Zeraora-ex, M\u00e9ga-Lugulabre-ex et M\u00e9ga-Minotaupe-ex forment un casting qui pr\u00e9f\u00e8re clairement l&rsquo;obscurit\u00e9 aux n\u00e9ons.<\/p>\n<p>Le set mise aussi sur des cartes M\u00e9ga textur\u00e9es et plus de 35 illustrations sp\u00e9ciales. De quoi passer un moment \u00e0 incliner chaque carte sous la lampe pour voir ce que donne la texture.<\/p>\n<p>Pour tout savoir des cartes phares et des autres produits du set, notre page <a href=\"https:\/\/www.bdfancomics.ch\/extension\/nuit-noire\/\"><strong>Nuit Noire<\/strong><\/a> fait le tour de l&rsquo;extension.<\/p>\n<h3>Tripack, ETB ou display : le bon calibre<\/h3>\n<p>Le tripack, c&rsquo;est l&rsquo;ouverture d&rsquo;un soir. Pour ceux qui veulent pousser plus loin, l&rsquo;<a href=\"https:\/\/www.bdfancomics.ch\/produit\/etb-pokemon-coffret-dresseur-delite-nuit-noire-me05\/\"><strong>ETB Nuit Noire<\/strong><\/a> ajoute neuf boosters, des accessoires de jeu et une promo Zarude. Et pour les collectionneurs d\u00e9cid\u00e9s \u00e0 remplir leur classeur, la display de 36 boosters reste l&rsquo;option la plus compl\u00e8te.<\/p>\n<p>Entre les deux, le tripack a un r\u00f4le simple : tester l&rsquo;extension, faire plaisir, ou s&rsquo;offrir une petite session sans se poser trop de questions.<\/p>\n<h3>Un cadeau qui tient dans la main<\/h3>\n<p>Le blister se range dans un sac, se glisse dans un calendrier de l&rsquo;Avent fait maison ou finit sous le sapin. L&rsquo;enfant qui d\u00e9couvre le JCC comme l&rsquo;adulte qui collectionne depuis le premier set y trouvent leur compte : une carte assur\u00e9e, trois boosters \u00e0 d\u00e9chirer.<\/p>\n<h3>Caract\u00e9ristiques<\/h3>\n<ul>\n<li><strong>Jeu :<\/strong> JCC Pok\u00e9mon, en fran\u00e7ais<\/li>\n<li><strong>Extension :<\/strong> M\u00e9ga-\u00c9volution \u2013 Nuit Noire (ME05)<\/li>\n<li><strong>Contenu :<\/strong> 3 boosters + 1 carte promo Opermine<\/li>\n<li><strong>EAN :<\/strong> 196214142411<\/li>\n<\/ul>\n<div class=\"category-seo-more\">\n<details>\n<summary style=\"cursor:pointer;color:#cc0000\"><strong><span style=\"color:#ffffff\">Lire plus<\/span><\/strong><\/summary>\n<p>Une extension qui s&rsquo;appelle Nuit Noire, une vedette nomm\u00e9e Darkrai, connue pour donner des cauchemars : si le dernier booster cache une M\u00e9ga hyper rare, on vous conseille quand m\u00eame d&rsquo;essayer de dormir. Essayer seulement.<\/p>\n<\/details>\n<\/div>","on_sale":false,"prices":{"price":"2490","regular_price":"2490","sale_price":"2490","price_range":null,"currency_code":"CHF","currency_symbol":"CHF","currency_minor_unit":2,"currency_decimal_separator":",","currency_thousand_separator":"","currency_prefix":"","currency_suffix":"CHF"},"price_html":"<span class=\"woocommerce-Price-amount amount\">24,90<span class=\"woocommerce-Price-currencySymbol\" dir=\"auto\">&#067;&#072;&#070;<\/span><\/span>","average_rating":"0","review_count":0,"images":[],"categories":[{"id":6520,"name":"Tripacks Pok\u00e9mon en Fran\u00e7ais","slug":"tripacks-pokemon-en-francais","link":"https:\/\/www.bdfancomics.ch\/categorie-produit\/cartes-a-collectionner\/pokemon-cartes\/cartes-pokemon-en-francais\/tripacks-pokemon-en-francais\/"}],"tags":[{"id":2281,"name":"Pok\u00e9mon","slug":"pokemon","link":"https:\/\/www.bdfancomics.ch\/etiquette-produit\/pokemon\/"}],"brands":[{"id":6477,"name":"The Pok\u00e9mon Company","slug":"the-pokemon-company","link":"https:\/\/www.bdfancomics.ch\/marque\/the-pokemon-company\/"}],"attributes":[{"id":11,"name":"Licence","taxonomy":"pa_licence","has_variations":false,"terms":[{"id":6680,"name":"Pok\u00e9mon","slug":"pokemon"}]},{"id":7,"name":"Langue","taxonomy":"pa_langue","has_variations":false,"terms":[{"id":5361,"name":"Fran\u00e7ais","slug":"francais"}]},{"id":37,"name":"Type de produit TCG","taxonomy":"pa_format-tcg","has_variations":false,"terms":[{"id":12050,"name":"Tripack","slug":"tripack"}]},{"id":38,"name":"Bloc Pok\u00e9mon","taxonomy":"pa_bloc-pokemon","has_variations":false,"terms":[{"id":12065,"name":"M\u00e9ga-\u00c9volution","slug":"mega-evolution"}]},{"id":39,"name":"Extension","taxonomy":"pa_extension","has_variations":false,"terms":[{"id":12080,"name":"Nuit Noire","slug":"nuit-noire"}]}],"variations":[],"grouped_products":[],"has_options":false,"is_purchasable":true,"is_in_stock":true,"is_on_backorder":false,"low_stock_remaining":null,"stock_availability":{"text":"En stock","class":"in-stock"},"sold_individually":false,"weight":"","dimensions":{"length":"","width":"","height":""},"formatted_weight":"ND","formatted_dimensions":"ND","add_to_cart":{"text":"Ajouter au panier","description":"Ajouter au panier\u00a0: &ldquo;Tripack Pok\u00e9mon ME05 Nuit Noire&rdquo;","url":"\/wp-json\/wc\/store\/v1\/products?search=pokemon&#038;per_page=100&#038;orderby=date&#038;order=desc&#038;add-to-cart=89436","single_text":"Ajouter au panier","minimum":1,"maximum":10,"multiple_of":1},"is_password_protected":false,"extensions":{},"_links":{"self":[{"href":"https:\/\/www.bdfancomics.ch\/wp-json\/wc\/store\/v1\/products\/89436","targetHints":{"allow":["GET"]}}],"collection":[{"href":"https:\/\/www.bdfancomics.ch\/wp-json\/wc\/store\/v1\/products"}],"related":[{"embeddable":true,"href":"https:\/\/www.bdfancomics.ch\/wp-json\/wc\/store\/v1\/products?related=89436&per_page=10"}]}},{"id":89223,"name":"Peluche Pok\u00e9mon Sekiguchi Salam\u00e8che","slug":"peluche-pokemon-sekiguchi-salameche","parent":0,"type":"simple","variation":"","permalink":"https:\/\/www.bdfancomics.ch\/produit\/peluche-pokemon-sekiguchi-salameche\/","sku":"4905610671458","short_description":"<p>La <strong>peluche Salam\u00e8che Sekiguchi<\/strong> appartient \u00e0 la gamme japonaise Mokomoko : un tissu boucl\u00e9 \u00e0 poils longs, tr\u00e8s doux, sur un Salam\u00e8che assis d&rsquo;environ 18 cm, ventre cr\u00e8me et grands yeux brillants.<\/p>\n<p>Sa flamme est en tissu : vous pouvez enfin le serrer contre vous sans vous soucier de la m\u00e9t\u00e9o.<\/p>","description":"<h2>Peluche Salam\u00e8che Sekiguchi : le starter de feu en version boucl\u00e9e<\/h2>\n<p>Dans <em>Pok\u00e9mon Rouge et Bleu<\/em>, le premier vrai choix du jeu se fait devant trois Pok\u00e9 Balls. Ceux qui ont pris Salam\u00e8che s&rsquo;en souviennent encore. Cette <strong>peluche Salam\u00e8che<\/strong> de Sekiguchi le transforme en petit l\u00e9zard assis, tout en courbes, dans une mati\u00e8re boucl\u00e9e qui donne imm\u00e9diatement envie de passer la main dessus.<\/p>\n<p>Le corps orange, le ventre et les plantes de pieds cr\u00e8me, les grands yeux noirs aux reflets bleus : tout y est, en version plus ronde et plus douce que dans le jeu.<\/p>\n<h3>La gamme Mokomoko, le moelleux \u00e0 la japonaise<\/h3>\n<p>Sekiguchi est un fabricant japonais de peluches, connu notamment pour avoir cr\u00e9\u00e9 Monchhichi. Sa gamme Pok\u00e9mon \u00ab Mokomoko \u00bb (\u3082\u3053\u3082\u3053, une onomatop\u00e9e japonaise qui \u00e9voque le duveteux) se reconna\u00eet \u00e0 son tissu \u00e0 poils longs et boucl\u00e9s, tr\u00e8s diff\u00e9rent des peluches lisses habituelles. Elle existe aussi en version \u00ab Mokomoko Petit \u00bb, plus petite et au poil plus court.<\/p>\n<p>Ce Salam\u00e8che-ci fait partie de la gamme d&rsquo;origine. Il mesure environ 18 cm pour 14 cm de large : assez compact pour une \u00e9tag\u00e8re, assez pr\u00e9sent pour ne pas dispara\u00eetre entre deux mangas.<\/p>\n<h3>Salam\u00e8che, la flamme qu&rsquo;il ne faut jamais laisser s&rsquo;\u00e9teindre<\/h3>\n<p>Pok\u00e9mon n\u00b0004 de type Feu, Salam\u00e8che porte une flamme au bout de la queue qui refl\u00e8te son \u00e9tat de sant\u00e9 et son humeur. Plus elle br\u00fble fort, mieux il se porte. Il \u00e9volue en Reptincel au niveau 16, puis en Dracaufeu au niveau 36.<\/p>\n<p>Dans l&rsquo;anime, le Salam\u00e8che de Sacha commence d&rsquo;ailleurs sa carri\u00e8re abandonn\u00e9 sur un rocher, sous la pluie, \u00e0 attendre un dresseur qui ne reviendra pas. Une sc\u00e8ne qui a fait pleurer beaucoup d&rsquo;enfants. Bonne nouvelle : cette version en tissu ne craint ni l&rsquo;averse ni l&rsquo;abandon.<\/p>\n<h3>Une peluche de collection plut\u00f4t qu&rsquo;un jouet de bac \u00e0 sable<\/h3>\n<p>Le poil boucl\u00e9 est la vraie signature de ce mod\u00e8le. Il accroche la lumi\u00e8re, gonfle l\u00e9g\u00e8rement le volume et rend la silhouette encore plus ronde. Mieux vaut l&rsquo;installer dans un endroit peu poussi\u00e9reux pour que les boucles restent belles.<\/p>\n<p>Elle fait aussi un tr\u00e8s beau cadeau pour quelqu&rsquo;un qui a choisi Salam\u00e8che il y a plus de vingt-cinq ans et ne l&rsquo;a jamais regrett\u00e9. M\u00eame quand Dracaufeu a commenc\u00e9 \u00e0 n&rsquo;en faire qu&rsquo;\u00e0 sa t\u00eate.<\/p>\n<h3>Salam\u00e8che en plusieurs formats<\/h3>\n<p>Le m\u00eame Pok\u00e9mon existe en <a href=\"https:\/\/www.bdfancomics.ch\/produit\/mini-peluche-pokemon-sekiguchi-salameche\/\"><strong>mini peluche Salam\u00e8che Sekiguchi<\/strong><\/a>, pour ceux qui veulent le glisser partout. Et pour une version rigide, la <a href=\"https:\/\/www.bdfancomics.ch\/produit\/figurine-pokemon-salameche\/\"><strong>figurine Pok\u00e9mon Salam\u00e8che<\/strong><\/a> le montre en pose sur son socle.<\/p>\n<p>Les autres cr\u00e9atures de la gamme attendent dans le rayon <a href=\"https:\/\/www.bdfancomics.ch\/categorie-produit\/jeux-jouets\/peluches-jeux\/peluches-pokemon\/\"><strong>peluches Pok\u00e9mon<\/strong><\/a>.<\/p>\n<div class=\"category-seo-more\">\n<details>\n<summary style=\"cursor:pointer;color:#cc0000\"><strong><span style=\"color:#ffffff\">Lire plus<\/span><\/strong><\/summary>\n<p>Consigne de dresseur : si votre Salam\u00e8che en peluche finit par \u00e9voluer, ce n&rsquo;est pas lui, c&rsquo;est vous qui en avez achet\u00e9 un deuxi\u00e8me. Et si un jour il refuse de vous ob\u00e9ir, ne vous inqui\u00e9tez pas, c&rsquo;est seulement l&rsquo;esprit de Dracaufeu qui parle.<\/p>\n<\/details>\n<\/div>","on_sale":false,"prices":{"price":"4900","regular_price":"4900","sale_price":"4900","price_range":null,"currency_code":"CHF","currency_symbol":"CHF","currency_minor_unit":2,"currency_decimal_separator":",","currency_thousand_separator":"","currency_prefix":"","currency_suffix":"CHF"},"price_html":"<span class=\"woocommerce-Price-amount amount\">49,00<span class=\"woocommerce-Price-currencySymbol\" dir=\"auto\">&#067;&#072;&#070;<\/span><\/span>","average_rating":"0","review_count":0,"images":[{"id":93805,"src":"https:\/\/www.bdfancomics.ch\/wp-content\/uploads\/2026\/10\/peluche-pokemon-sekiguchi-salameche-nyon.webp","thumbnail":"https:\/\/www.bdfancomics.ch\/wp-content\/uploads\/2026\/10\/peluche-pokemon-sekiguchi-salameche-nyon-500x500.webp","srcset":"https:\/\/www.bdfancomics.ch\/wp-content\/uploads\/2026\/10\/peluche-pokemon-sekiguchi-salameche-nyon.webp 1200w, https:\/\/www.bdfancomics.ch\/wp-content\/uploads\/2026\/10\/peluche-pokemon-sekiguchi-salameche-nyon-300x300.webp 300w, https:\/\/www.bdfancomics.ch\/wp-content\/uploads\/2026\/10\/peluche-pokemon-sekiguchi-salameche-nyon-1024x1024.webp 1024w, https:\/\/www.bdfancomics.ch\/wp-content\/uploads\/2026\/10\/peluche-pokemon-sekiguchi-salameche-nyon-150x150.webp 150w, https:\/\/www.bdfancomics.ch\/wp-content\/uploads\/2026\/10\/peluche-pokemon-sekiguchi-salameche-nyon-768x768.webp 768w, https:\/\/www.bdfancomics.ch\/wp-content\/uploads\/2026\/10\/peluche-pokemon-sekiguchi-salameche-nyon-500x500.webp 500w, https:\/\/www.bdfancomics.ch\/wp-content\/uploads\/2026\/10\/peluche-pokemon-sekiguchi-salameche-nyon-600x600.webp 600w, https:\/\/www.bdfancomics.ch\/wp-content\/uploads\/2026\/10\/peluche-pokemon-sekiguchi-salameche-nyon-100x100.webp 100w, https:\/\/www.bdfancomics.ch\/wp-content\/uploads\/2026\/10\/peluche-pokemon-sekiguchi-salameche-nyon-64x64.webp 64w","sizes":"(max-width: 1200px) 100vw, 1200px","thumbnail_srcset":"https:\/\/www.bdfancomics.ch\/wp-content\/uploads\/2026\/10\/peluche-pokemon-sekiguchi-salameche-nyon-500x500.webp 500w, https:\/\/www.bdfancomics.ch\/wp-content\/uploads\/2026\/10\/peluche-pokemon-sekiguchi-salameche-nyon-300x300.webp 300w, https:\/\/www.bdfancomics.ch\/wp-content\/uploads\/2026\/10\/peluche-pokemon-sekiguchi-salameche-nyon-1024x1024.webp 1024w, https:\/\/www.bdfancomics.ch\/wp-content\/uploads\/2026\/10\/peluche-pokemon-sekiguchi-salameche-nyon-150x150.webp 150w, https:\/\/www.bdfancomics.ch\/wp-content\/uploads\/2026\/10\/peluche-pokemon-sekiguchi-salameche-nyon-768x768.webp 768w, https:\/\/www.bdfancomics.ch\/wp-content\/uploads\/2026\/10\/peluche-pokemon-sekiguchi-salameche-nyon-600x600.webp 600w, https:\/\/www.bdfancomics.ch\/wp-content\/uploads\/2026\/10\/peluche-pokemon-sekiguchi-salameche-nyon-100x100.webp 100w, https:\/\/www.bdfancomics.ch\/wp-content\/uploads\/2026\/10\/peluche-pokemon-sekiguchi-salameche-nyon-64x64.webp 64w, https:\/\/www.bdfancomics.ch\/wp-content\/uploads\/2026\/10\/peluche-pokemon-sekiguchi-salameche-nyon.webp 1200w","thumbnail_sizes":"(max-width: 500px) 100vw, 500px","name":"Peluche Pok\u00e9mon Sekiguchi Salam\u00e8che","alt":"Peluche Pok\u00e9mon Sekiguchi Salam\u00e8che"}],"categories":[{"id":1102,"name":"Jeux &amp; Jouets","slug":"jeux-jouets","link":"https:\/\/www.bdfancomics.ch\/categorie-produit\/jeux-jouets\/"},{"id":3652,"name":"Peluches","slug":"peluches-jeux","link":"https:\/\/www.bdfancomics.ch\/categorie-produit\/jeux-jouets\/peluches-jeux\/"},{"id":6560,"name":"Peluches Pok\u00e9mon","slug":"peluches-pokemon","link":"https:\/\/www.bdfancomics.ch\/categorie-produit\/jeux-jouets\/peluches-jeux\/peluches-pokemon\/"}],"tags":[],"brands":[{"id":6477,"name":"The Pok\u00e9mon Company","slug":"the-pokemon-company","link":"https:\/\/www.bdfancomics.ch\/marque\/the-pokemon-company\/"}],"attributes":[{"id":11,"name":"Licence","taxonomy":"pa_licence","has_variations":false,"terms":[{"id":6680,"name":"Pok\u00e9mon","slug":"pokemon"}]},{"id":13,"name":"Personnage","taxonomy":"pa_personnage","has_variations":false,"terms":[{"id":6755,"name":"Salam\u00e8che","slug":"salameche"}]},{"id":12,"name":"Univers \/ M\u00e9dia","taxonomy":"pa_univers-media","has_variations":false,"terms":[{"id":6682,"name":"Anime","slug":"anime"}]}],"variations":[],"grouped_products":[],"has_options":false,"is_purchasable":true,"is_in_stock":true,"is_on_backorder":false,"low_stock_remaining":1,"stock_availability":{"text":"Plus que 1 en stock","class":"in-stock"},"sold_individually":false,"weight":"","dimensions":{"length":"","width":"","height":""},"formatted_weight":"ND","formatted_dimensions":"ND","add_to_cart":{"text":"Ajouter au panier","description":"Ajouter au panier\u00a0: &ldquo;Peluche Pok\u00e9mon Sekiguchi Salam\u00e8che&rdquo;","url":"\/wp-json\/wc\/store\/v1\/products?search=pokemon&#038;per_page=100&#038;orderby=date&#038;order=desc&#038;add-to-cart=89223","single_text":"Ajouter au panier","minimum":1,"maximum":1,"multiple_of":1},"is_password_protected":false,"extensions":{},"_links":{"self":[{"href":"https:\/\/www.bdfancomics.ch\/wp-json\/wc\/store\/v1\/products\/89223","targetHints":{"allow":["GET"]}}],"collection":[{"href":"https:\/\/www.bdfancomics.ch\/wp-json\/wc\/store\/v1\/products"}],"upsells":[{"embeddable":true,"href":"https:\/\/www.bdfancomics.ch\/wp-json\/wc\/store\/v1\/products?include=89465,78164,76404,59926"}],"cross_sells":[{"embeddable":true,"href":"https:\/\/www.bdfancomics.ch\/wp-json\/wc\/store\/v1\/products?include=89188,89225,89224,89221"}],"related":[{"embeddable":true,"href":"https:\/\/www.bdfancomics.ch\/wp-json\/wc\/store\/v1\/products?related=89223&per_page=10"}]}},{"id":89221,"name":"Peluche Pok\u00e9mon Sekiguchi Otaquin","slug":"peluche-pokemon-sekiguchi-otaquin","parent":0,"type":"simple","variation":"","permalink":"https:\/\/www.bdfancomics.ch\/produit\/peluche-pokemon-sekiguchi-otaquin\/","sku":"4905610671649","short_description":"<p>La <strong>peluche Otaquin Sekiguchi<\/strong>, de la gamme Mokomoko, r\u00e9unit poil boucl\u00e9 bleu, collerette bleu clair et petit nez rose sur un Otaquin assis d&rsquo;environ 21 cm.<\/p>\n<p>Le starter Eau d&rsquo;Alola en version c\u00e2line, sans bulle d&rsquo;eau \u00e0 \u00e9clater en pleine figure.<\/p>","description":"<h2>Peluche Otaquin Sekiguchi : le petit otarie d&rsquo;Alola tout en boucles<\/h2>\n<p>Parmi les starters de <em>Pok\u00e9mon Soleil et Lune<\/em>, Otaquin \u00e9tait celui qu&rsquo;on choisissait pour son sourire. Cette <strong>peluche Otaquin<\/strong> de Sekiguchi garde cette bonne humeur intacte : un corps bleu boucl\u00e9, une collerette bleu clair autour du cou et le nez rose bien rond, comme une balle de clown.<\/p>\n<p>Il est assis, pr\u00eat \u00e0 applaudir avec ses nageoires. Ce qui, connaissant le personnage, est probablement sa position pr\u00e9f\u00e9r\u00e9e.<\/p>\n<h3>Mokomoko : le poil long qui change tout<\/h3>\n<p>La gamme Mokomoko de Sekiguchi se distingue par un tissu \u00e0 poils boucl\u00e9s, plus \u00e9pais et plus moelleux qu&rsquo;une peluche classique. Sur Otaquin, l&rsquo;effet est particuli\u00e8rement r\u00e9ussi : le bleu change de reflets avec la lumi\u00e8re et la collerette ressort nettement.<\/p>\n<p>Le mod\u00e8le mesure environ 21 cm de haut. Un format id\u00e9al pour un bureau, une table de chevet ou une \u00e9tag\u00e8re de jeux 3DS.<\/p>\n<h3>Otaquin, artiste de cirque \u00e0 bulles<\/h3>\n<p>Pok\u00e9mon n\u00b0728 de type Eau, Otaquin est le starter aquatique de la septi\u00e8me g\u00e9n\u00e9ration, celle de la r\u00e9gion d&rsquo;Alola inspir\u00e9e d&rsquo;Hawa\u00ef. Il sait gonfler des bulles d&rsquo;eau avec son nez et s&rsquo;en sert pour ses acrobaties. Il faut beaucoup d&rsquo;entra\u00eenement avant d&rsquo;en r\u00e9ussir une grande, et il ne se d\u00e9courage pas.<\/p>\n<p>Il \u00e9volue en Otarlette au niveau 17, puis en Oratoria au niveau 34. Cette derni\u00e8re devient alors Eau et F\u00e9e, avec une allure de chanteuse d&rsquo;op\u00e9ra : sacr\u00e9e progression pour un otarie qui ratait ses bulles au d\u00e9part.<\/p>\n<h3>Plus \u00e0 l&rsquo;aise dans l&rsquo;eau, plus mignon sur l&rsquo;\u00e9tag\u00e8re<\/h3>\n<p>Sur la terre ferme, Otaquin est un peu pataud. Dans l&rsquo;eau, il devient vif et rapide. La peluche, elle, a fait son choix : elle reste au sec et se contente d&rsquo;\u00eatre adorable. Le poil boucl\u00e9 supporte mal l&rsquo;humidit\u00e9, mieux vaut donc la tenir \u00e9loign\u00e9e de la salle de bain.<\/p>\n<p>Pour ceux qui ont d\u00e9couvert Pok\u00e9mon avec la 3DS, c&rsquo;est aussi une alternative bienvenue aux habituels starters de Kanto.<\/p>\n<h3>Le trio d&rsquo;Alola, presque au complet<\/h3>\n<p>Otaquin a un rival naturel : la <a href=\"https:\/\/www.bdfancomics.ch\/produit\/peluche-pokemon-sekiguchi-flamiaou\/\"><strong>peluche Flamiaou Sekiguchi<\/strong><\/a>, starter Feu de la m\u00eame g\u00e9n\u00e9ration et de la m\u00eame gamme. C\u00f4te \u00e0 c\u00f4te, l&rsquo;eau et le feu se tiennent \u00e9tonnamment tranquilles.<\/p>\n<p>Les autres Pok\u00e9mon en tissu se trouvent parmi les <a href=\"https:\/\/www.bdfancomics.ch\/categorie-produit\/jeux-jouets\/peluches-jeux\/peluches-pokemon\/\"><strong>peluches Pok\u00e9mon<\/strong><\/a> de la boutique.<\/p>\n<div class=\"category-seo-more\">\n<details>\n<summary style=\"cursor:pointer;color:#cc0000\"><strong><span style=\"color:#ffffff\">Lire plus<\/span><\/strong><\/summary>\n<p>Avertissement aux nouveaux dresseurs : Otaquin applaudit volontiers, mais il attend aussi qu&rsquo;on l&rsquo;applaudisse en retour. Si la peluche vous fixe avec insistance apr\u00e8s une bonne nouvelle, vous savez d\u00e9sormais ce qu&rsquo;il vous reste \u00e0 faire.<\/p>\n<\/details>\n<\/div>","on_sale":false,"prices":{"price":"3900","regular_price":"3900","sale_price":"3900","price_range":null,"currency_code":"CHF","currency_symbol":"CHF","currency_minor_unit":2,"currency_decimal_separator":",","currency_thousand_separator":"","currency_prefix":"","currency_suffix":"CHF"},"price_html":"<span class=\"woocommerce-Price-amount amount\">39,00<span class=\"woocommerce-Price-currencySymbol\" dir=\"auto\">&#067;&#072;&#070;<\/span><\/span>","average_rating":"0","review_count":0,"images":[{"id":93804,"src":"https:\/\/www.bdfancomics.ch\/wp-content\/uploads\/2026\/10\/peluche-pokemon-sekiguchi-otaquin-nyon.webp","thumbnail":"https:\/\/www.bdfancomics.ch\/wp-content\/uploads\/2026\/10\/peluche-pokemon-sekiguchi-otaquin-nyon-500x500.webp","srcset":"https:\/\/www.bdfancomics.ch\/wp-content\/uploads\/2026\/10\/peluche-pokemon-sekiguchi-otaquin-nyon.webp 1200w, https:\/\/www.bdfancomics.ch\/wp-content\/uploads\/2026\/10\/peluche-pokemon-sekiguchi-otaquin-nyon-300x300.webp 300w, https:\/\/www.bdfancomics.ch\/wp-content\/uploads\/2026\/10\/peluche-pokemon-sekiguchi-otaquin-nyon-1024x1024.webp 1024w, https:\/\/www.bdfancomics.ch\/wp-content\/uploads\/2026\/10\/peluche-pokemon-sekiguchi-otaquin-nyon-150x150.webp 150w, https:\/\/www.bdfancomics.ch\/wp-content\/uploads\/2026\/10\/peluche-pokemon-sekiguchi-otaquin-nyon-768x768.webp 768w, https:\/\/www.bdfancomics.ch\/wp-content\/uploads\/2026\/10\/peluche-pokemon-sekiguchi-otaquin-nyon-500x500.webp 500w, https:\/\/www.bdfancomics.ch\/wp-content\/uploads\/2026\/10\/peluche-pokemon-sekiguchi-otaquin-nyon-600x600.webp 600w, https:\/\/www.bdfancomics.ch\/wp-content\/uploads\/2026\/10\/peluche-pokemon-sekiguchi-otaquin-nyon-100x100.webp 100w, https:\/\/www.bdfancomics.ch\/wp-content\/uploads\/2026\/10\/peluche-pokemon-sekiguchi-otaquin-nyon-64x64.webp 64w","sizes":"(max-width: 1200px) 100vw, 1200px","thumbnail_srcset":"https:\/\/www.bdfancomics.ch\/wp-content\/uploads\/2026\/10\/peluche-pokemon-sekiguchi-otaquin-nyon-500x500.webp 500w, https:\/\/www.bdfancomics.ch\/wp-content\/uploads\/2026\/10\/peluche-pokemon-sekiguchi-otaquin-nyon-300x300.webp 300w, https:\/\/www.bdfancomics.ch\/wp-content\/uploads\/2026\/10\/peluche-pokemon-sekiguchi-otaquin-nyon-1024x1024.webp 1024w, https:\/\/www.bdfancomics.ch\/wp-content\/uploads\/2026\/10\/peluche-pokemon-sekiguchi-otaquin-nyon-150x150.webp 150w, https:\/\/www.bdfancomics.ch\/wp-content\/uploads\/2026\/10\/peluche-pokemon-sekiguchi-otaquin-nyon-768x768.webp 768w, https:\/\/www.bdfancomics.ch\/wp-content\/uploads\/2026\/10\/peluche-pokemon-sekiguchi-otaquin-nyon-600x600.webp 600w, https:\/\/www.bdfancomics.ch\/wp-content\/uploads\/2026\/10\/peluche-pokemon-sekiguchi-otaquin-nyon-100x100.webp 100w, https:\/\/www.bdfancomics.ch\/wp-content\/uploads\/2026\/10\/peluche-pokemon-sekiguchi-otaquin-nyon-64x64.webp 64w, https:\/\/www.bdfancomics.ch\/wp-content\/uploads\/2026\/10\/peluche-pokemon-sekiguchi-otaquin-nyon.webp 1200w","thumbnail_sizes":"(max-width: 500px) 100vw, 500px","name":"Peluche Pok\u00e9mon Sekiguchi Otaquin","alt":"Peluche Pok\u00e9mon Sekiguchi Otaquin"}],"categories":[{"id":1102,"name":"Jeux &amp; Jouets","slug":"jeux-jouets","link":"https:\/\/www.bdfancomics.ch\/categorie-produit\/jeux-jouets\/"},{"id":3652,"name":"Peluches","slug":"peluches-jeux","link":"https:\/\/www.bdfancomics.ch\/categorie-produit\/jeux-jouets\/peluches-jeux\/"},{"id":6560,"name":"Peluches Pok\u00e9mon","slug":"peluches-pokemon","link":"https:\/\/www.bdfancomics.ch\/categorie-produit\/jeux-jouets\/peluches-jeux\/peluches-pokemon\/"}],"tags":[],"brands":[{"id":6477,"name":"The Pok\u00e9mon Company","slug":"the-pokemon-company","link":"https:\/\/www.bdfancomics.ch\/marque\/the-pokemon-company\/"}],"attributes":[{"id":11,"name":"Licence","taxonomy":"pa_licence","has_variations":false,"terms":[{"id":6680,"name":"Pok\u00e9mon","slug":"pokemon"}]},{"id":12,"name":"Univers \/ M\u00e9dia","taxonomy":"pa_univers-media","has_variations":false,"terms":[{"id":6682,"name":"Anime","slug":"anime"}]}],"variations":[],"grouped_products":[],"has_options":false,"is_purchasable":true,"is_in_stock":true,"is_on_backorder":false,"low_stock_remaining":null,"stock_availability":{"text":"En stock","class":"in-stock"},"sold_individually":false,"weight":"","dimensions":{"length":"","width":"","height":""},"formatted_weight":"ND","formatted_dimensions":"ND","add_to_cart":{"text":"Ajouter au panier","description":"Ajouter au panier\u00a0: &ldquo;Peluche Pok\u00e9mon Sekiguchi Otaquin&rdquo;","url":"\/wp-json\/wc\/store\/v1\/products?search=pokemon&#038;per_page=100&#038;orderby=date&#038;order=desc&#038;add-to-cart=89221","single_text":"Ajouter au panier","minimum":1,"maximum":3,"multiple_of":1},"is_password_protected":false,"extensions":{},"_links":{"self":[{"href":"https:\/\/www.bdfancomics.ch\/wp-json\/wc\/store\/v1\/products\/89221","targetHints":{"allow":["GET"]}}],"collection":[{"href":"https:\/\/www.bdfancomics.ch\/wp-json\/wc\/store\/v1\/products"}],"upsells":[{"embeddable":true,"href":"https:\/\/www.bdfancomics.ch\/wp-json\/wc\/store\/v1\/products?include=89465,78164,76404,59926"}],"cross_sells":[{"embeddable":true,"href":"https:\/\/www.bdfancomics.ch\/wp-json\/wc\/store\/v1\/products?include=89223,89188,89225,89224"}],"related":[{"embeddable":true,"href":"https:\/\/www.bdfancomics.ch\/wp-json\/wc\/store\/v1\/products?related=89221&per_page=10"}]}},{"id":89219,"name":"Peluche Pok\u00e9mon Sekiguchi Miaouss","slug":"peluche-pokemon-sekiguchi-miaouss","parent":0,"type":"simple","variation":"","permalink":"https:\/\/www.bdfancomics.ch\/produit\/peluche-pokemon-sekiguchi-miaouss\/","sku":"4905610671502","short_description":"<p>La <strong>peluche Miaouss Sekiguchi<\/strong>, mod\u00e8le Mokomoko, montre le chat le plus bavard de Pok\u00e9mon en version boucl\u00e9e cr\u00e8me, bouche ouverte et crocs visibles, sa pi\u00e8ce dor\u00e9e sur le front. Environ 21 cm.<\/p>\n<p>Il ne parle pas, contrairement \u00e0 celui de la Team Rocket. C&rsquo;est sans doute mieux pour votre tranquillit\u00e9.<\/p>","description":"<h2>Peluche Miaouss Sekiguchi : le chat \u00e0 la pi\u00e8ce d&rsquo;or, version moelleuse<\/h2>\n<p>Miaouss est sans doute le Pok\u00e9mon chat le plus c\u00e9l\u00e8bre du monde, et pas seulement gr\u00e2ce aux jeux. Cette <strong>peluche Miaouss<\/strong> de Sekiguchi le repr\u00e9sente assis, la bouche grande ouverte sur un sourire \u00e0 crocs, avec sa pi\u00e8ce dor\u00e9e sur le front et ses moustaches bien en place.<\/p>\n<p>Le corps cr\u00e8me est r\u00e9alis\u00e9 dans un tissu boucl\u00e9, tandis que les pattes et le bout de la queue passent au brun. On jurerait qu&rsquo;il vient de trouver quelque chose de brillant.<\/p>\n<h3>La gamme Mokomoko de Sekiguchi<\/h3>\n<p>Sekiguchi, le fabricant japonais \u00e0 qui l&rsquo;on doit Monchhichi, a donn\u00e9 \u00e0 Pok\u00e9mon une gamme de peluches \u00e0 poils longs appel\u00e9e Mokomoko. Le mot imite en japonais l&rsquo;id\u00e9e de quelque chose de duveteux et gonfl\u00e9, et le tissu boucl\u00e9 tient parfaitement la promesse.<\/p>\n<p>Miaouss mesure ici environ 21 cm de haut. Sa t\u00eate large et ses oreilles en font un mod\u00e8le bien pr\u00e9sent, m\u00eame sur une \u00e9tag\u00e8re charg\u00e9e.<\/p>\n<h3>Miaouss, chasseur de pi\u00e8ces et amateur de nuit<\/h3>\n<p>Pok\u00e9mon n\u00b0052 de type Normal, Miaouss adore tout ce qui brille et sort volontiers la nuit pour en chercher. Son attaque f\u00e9tiche, Jackpot, fait litt\u00e9ralement pleuvoir des pi\u00e8ces. Il \u00e9volue en Persian au niveau 28, un chat nettement plus distingu\u00e9 et beaucoup moins sympathique.<\/p>\n<p>Dans l&rsquo;anime, celui de la Team Rocket est un cas \u00e0 part : il marche sur deux pattes et parle comme un humain, une comp\u00e9tence apprise pour s\u00e9duire une Miaouss dont il \u00e9tait amoureux. Avec Jessie et James, il a jur\u00e9 de capturer Pikachu des centaines de fois, sans jamais y arriver. Mais toujours avec panache.<\/p>\n<h3>Le compagnon id\u00e9al des fans de la premi\u00e8re heure<\/h3>\n<p>Cette peluche parle surtout \u00e0 ceux qui ont grandi avec l&rsquo;anime des ann\u00e9es 1990 et sa c\u00e9l\u00e8bre devise. La bouche ouverte et les crocs lui donnent une expression vivante, presque moqueuse, qui colle bien \u00e0 la version Team Rocket.<\/p>\n<p>Un coup de brosse douce de temps en temps pr\u00e9serve ses boucles. Et gardez-la loin des objets brillants. Par principe.<\/p>\n<h3>Rejoindre la Team Rocket<\/h3>\n<p>Pour un Miaouss en pose diff\u00e9rente, la <a href=\"https:\/\/www.bdfancomics.ch\/produit\/figurine-pokemon-miaouss-saison\/\"><strong>figurine Pok\u00e9mon Miaouss Saison<\/strong><\/a> le place dans une petite sc\u00e8ne de nature. Et pour ranger ses cartes en restant fid\u00e8le \u00e0 l&rsquo;\u00e9quipe, le <a href=\"https:\/\/www.bdfancomics.ch\/produit\/portfolio-pokemon-a4-team-rocket-252-cartes\/\"><strong>portfolio Pok\u00e9mon Team Rocket<\/strong><\/a> reprend le c\u00e9l\u00e8bre \u00ab R \u00bb rouge.<\/p>\n<div class=\"category-seo-more\">\n<details>\n<summary style=\"cursor:pointer;color:#cc0000\"><strong><span style=\"color:#ffffff\">Lire plus<\/span><\/strong><\/summary>\n<p>\u00ab Miaouss, oui, la guerre ! \u00bb Vous l&rsquo;avez lu avec la bonne voix, n&rsquo;est-ce pas ? Bonne nouvelle : cette peluche ne vous la jouera jamais au r\u00e9veil. Mauvaise nouvelle : vous allez probablement la prononcer vous-m\u00eame chaque fois que vous la verrez.<\/p>\n<\/details>\n<\/div>","on_sale":false,"prices":{"price":"4900","regular_price":"4900","sale_price":"4900","price_range":null,"currency_code":"CHF","currency_symbol":"CHF","currency_minor_unit":2,"currency_decimal_separator":",","currency_thousand_separator":"","currency_prefix":"","currency_suffix":"CHF"},"price_html":"<span class=\"woocommerce-Price-amount amount\">49,00<span class=\"woocommerce-Price-currencySymbol\" dir=\"auto\">&#067;&#072;&#070;<\/span><\/span>","average_rating":"0","review_count":0,"images":[{"id":93803,"src":"https:\/\/www.bdfancomics.ch\/wp-content\/uploads\/2026\/10\/peluche-pokemon-sekiguchi-miaouss-nyon.webp","thumbnail":"https:\/\/www.bdfancomics.ch\/wp-content\/uploads\/2026\/10\/peluche-pokemon-sekiguchi-miaouss-nyon-500x500.webp","srcset":"https:\/\/www.bdfancomics.ch\/wp-content\/uploads\/2026\/10\/peluche-pokemon-sekiguchi-miaouss-nyon.webp 1200w, https:\/\/www.bdfancomics.ch\/wp-content\/uploads\/2026\/10\/peluche-pokemon-sekiguchi-miaouss-nyon-300x300.webp 300w, https:\/\/www.bdfancomics.ch\/wp-content\/uploads\/2026\/10\/peluche-pokemon-sekiguchi-miaouss-nyon-1024x1024.webp 1024w, https:\/\/www.bdfancomics.ch\/wp-content\/uploads\/2026\/10\/peluche-pokemon-sekiguchi-miaouss-nyon-150x150.webp 150w, https:\/\/www.bdfancomics.ch\/wp-content\/uploads\/2026\/10\/peluche-pokemon-sekiguchi-miaouss-nyon-768x768.webp 768w, https:\/\/www.bdfancomics.ch\/wp-content\/uploads\/2026\/10\/peluche-pokemon-sekiguchi-miaouss-nyon-500x500.webp 500w, https:\/\/www.bdfancomics.ch\/wp-content\/uploads\/2026\/10\/peluche-pokemon-sekiguchi-miaouss-nyon-600x600.webp 600w, https:\/\/www.bdfancomics.ch\/wp-content\/uploads\/2026\/10\/peluche-pokemon-sekiguchi-miaouss-nyon-100x100.webp 100w, https:\/\/www.bdfancomics.ch\/wp-content\/uploads\/2026\/10\/peluche-pokemon-sekiguchi-miaouss-nyon-64x64.webp 64w","sizes":"(max-width: 1200px) 100vw, 1200px","thumbnail_srcset":"https:\/\/www.bdfancomics.ch\/wp-content\/uploads\/2026\/10\/peluche-pokemon-sekiguchi-miaouss-nyon-500x500.webp 500w, https:\/\/www.bdfancomics.ch\/wp-content\/uploads\/2026\/10\/peluche-pokemon-sekiguchi-miaouss-nyon-300x300.webp 300w, https:\/\/www.bdfancomics.ch\/wp-content\/uploads\/2026\/10\/peluche-pokemon-sekiguchi-miaouss-nyon-1024x1024.webp 1024w, https:\/\/www.bdfancomics.ch\/wp-content\/uploads\/2026\/10\/peluche-pokemon-sekiguchi-miaouss-nyon-150x150.webp 150w, https:\/\/www.bdfancomics.ch\/wp-content\/uploads\/2026\/10\/peluche-pokemon-sekiguchi-miaouss-nyon-768x768.webp 768w, https:\/\/www.bdfancomics.ch\/wp-content\/uploads\/2026\/10\/peluche-pokemon-sekiguchi-miaouss-nyon-600x600.webp 600w, https:\/\/www.bdfancomics.ch\/wp-content\/uploads\/2026\/10\/peluche-pokemon-sekiguchi-miaouss-nyon-100x100.webp 100w, https:\/\/www.bdfancomics.ch\/wp-content\/uploads\/2026\/10\/peluche-pokemon-sekiguchi-miaouss-nyon-64x64.webp 64w, https:\/\/www.bdfancomics.ch\/wp-content\/uploads\/2026\/10\/peluche-pokemon-sekiguchi-miaouss-nyon.webp 1200w","thumbnail_sizes":"(max-width: 500px) 100vw, 500px","name":"Peluche Pok\u00e9mon Sekiguchi Miaouss","alt":"Peluche Pok\u00e9mon Sekiguchi Miaouss"}],"categories":[{"id":1102,"name":"Jeux &amp; Jouets","slug":"jeux-jouets","link":"https:\/\/www.bdfancomics.ch\/categorie-produit\/jeux-jouets\/"},{"id":3652,"name":"Peluches","slug":"peluches-jeux","link":"https:\/\/www.bdfancomics.ch\/categorie-produit\/jeux-jouets\/peluches-jeux\/"},{"id":6560,"name":"Peluches Pok\u00e9mon","slug":"peluches-pokemon","link":"https:\/\/www.bdfancomics.ch\/categorie-produit\/jeux-jouets\/peluches-jeux\/peluches-pokemon\/"}],"tags":[],"brands":[{"id":6477,"name":"The Pok\u00e9mon Company","slug":"the-pokemon-company","link":"https:\/\/www.bdfancomics.ch\/marque\/the-pokemon-company\/"}],"attributes":[{"id":11,"name":"Licence","taxonomy":"pa_licence","has_variations":false,"terms":[{"id":6680,"name":"Pok\u00e9mon","slug":"pokemon"}]},{"id":13,"name":"Personnage","taxonomy":"pa_personnage","has_variations":false,"terms":[{"id":6725,"name":"Miaouss","slug":"miaouss"}]},{"id":12,"name":"Univers \/ M\u00e9dia","taxonomy":"pa_univers-media","has_variations":false,"terms":[{"id":6682,"name":"Anime","slug":"anime"}]}],"variations":[],"grouped_products":[],"has_options":false,"is_purchasable":true,"is_in_stock":true,"is_on_backorder":false,"low_stock_remaining":2,"stock_availability":{"text":"Plus que 2 en stock","class":"in-stock"},"sold_individually":false,"weight":"","dimensions":{"length":"","width":"","height":""},"formatted_weight":"ND","formatted_dimensions":"ND","add_to_cart":{"text":"Ajouter au panier","description":"Ajouter au panier\u00a0: &ldquo;Peluche Pok\u00e9mon Sekiguchi Miaouss&rdquo;","url":"\/wp-json\/wc\/store\/v1\/products?search=pokemon&#038;per_page=100&#038;orderby=date&#038;order=desc&#038;add-to-cart=89219","single_text":"Ajouter au panier","minimum":1,"maximum":2,"multiple_of":1},"is_password_protected":false,"extensions":{},"_links":{"self":[{"href":"https:\/\/www.bdfancomics.ch\/wp-json\/wc\/store\/v1\/products\/89219","targetHints":{"allow":["GET"]}}],"collection":[{"href":"https:\/\/www.bdfancomics.ch\/wp-json\/wc\/store\/v1\/products"}],"upsells":[{"embeddable":true,"href":"https:\/\/www.bdfancomics.ch\/wp-json\/wc\/store\/v1\/products?include=89465,78164,76404,59926"}],"cross_sells":[{"embeddable":true,"href":"https:\/\/www.bdfancomics.ch\/wp-json\/wc\/store\/v1\/products?include=89223,89188,89225,89224"}],"related":[{"embeddable":true,"href":"https:\/\/www.bdfancomics.ch\/wp-json\/wc\/store\/v1\/products?related=89219&per_page=10"}]}},{"id":89218,"name":"Peluche Pok\u00e9mon Sekiguchi Flamiaou","slug":"peluche-pokemon-sekiguchi-flamiaou","parent":0,"type":"simple","variation":"","permalink":"https:\/\/www.bdfancomics.ch\/produit\/peluche-pokemon-sekiguchi-flamiaou\/","sku":"4905610671632","short_description":"<p>La <strong>peluche Flamiaou Sekiguchi<\/strong> reprend le chaton de feu d&rsquo;Alola dans le tissu boucl\u00e9 de la gamme Mokomoko : pelage noir \u00e0 rayures rouges, oreilles grises et yeux jaunes. Environ 20 cm.<\/p>\n<p>Un chat qui ne crache pas de boules de poils enflamm\u00e9es. C&rsquo;est d\u00e9j\u00e0 un progr\u00e8s.<\/p>","description":"<h2>Peluche Flamiaou Sekiguchi : le chaton de feu, poil boucl\u00e9 compris<\/h2>\n<p>Flamiaou est le starter Feu de <em>Pok\u00e9mon Soleil et Lune<\/em>, et sans doute l&rsquo;un des chats les plus styl\u00e9s du Pok\u00e9dex. Cette <strong>peluche Flamiaou<\/strong> de Sekiguchi reprend son pelage noir ray\u00e9 de rouge, ses oreilles grises et ses yeux jaunes un peu distants, le tout dans un tissu boucl\u00e9 qui adoucit franchement son caract\u00e8re.<\/p>\n<p>Car Flamiaou, dans le jeu, n&rsquo;est pas du genre \u00e0 r\u00e9clamer des c\u00e2lins. En peluche, il n&rsquo;a plus vraiment le choix.<\/p>\n<h3>Un mod\u00e8le de la gamme Mokomoko<\/h3>\n<p>Sekiguchi, fabricant japonais sp\u00e9cialis\u00e9 dans les peluches depuis des d\u00e9cennies, d\u00e9cline Pok\u00e9mon dans sa gamme Mokomoko, reconnaissable \u00e0 son poil long et boucl\u00e9. Sur un Pok\u00e9mon noir, la texture est particuli\u00e8rement visible : chaque boucle accroche la lumi\u00e8re et casse l&rsquo;aspect uniforme.<\/p>\n<p>La peluche mesure environ 20 cm de haut. Elle tient sans difficult\u00e9 sur une \u00e9tag\u00e8re, \u00e0 c\u00f4t\u00e9 d&rsquo;une console ou d&rsquo;une pile de boosters.<\/p>\n<h3>Flamiaou, la toilette la plus dangereuse du monde Pok\u00e9mon<\/h3>\n<p>Pok\u00e9mon n\u00b0725 de type Feu, Flamiaou fait sa toilette en se l\u00e9chant longuement. Les poils qu&rsquo;il avale s&rsquo;accumulent, et il les recrache\u2026 enflamm\u00e9s. Une technique de combat aussi efficace que peu rago\u00fbtante.<\/p>\n<p>Solitaire et r\u00e9serv\u00e9, il ne montre pas facilement ses \u00e9motions. Il \u00e9volue en Matoufeu au niveau 17, puis en F\u00e9linferno au niveau 34, qui devient alors Feu et T\u00e9n\u00e8bres et adopte une carrure de catcheur, ceinture de flammes comprise. Dans l&rsquo;anime Soleil et Lune, Sacha adopte un Flamiaou qui finira par \u00e9voluer.<\/p>\n<h3>Le chat pour ceux qui pr\u00e9f\u00e8rent les chats<\/h3>\n<p>La peluche plaira autant aux joueurs de la septi\u00e8me g\u00e9n\u00e9ration qu&rsquo;aux amateurs de f\u00e9lins en g\u00e9n\u00e9ral. Son air un peu fier change agr\u00e9ablement des Pok\u00e9mon qui sourient en permanence.<\/p>\n<p>Comme toute la gamme boucl\u00e9e, elle pr\u00e9f\u00e8re un endroit sec et sans poussi\u00e8re. Et elle ne fera jamais de boule de poils sur votre canap\u00e9, ce qui la place d\u00e9j\u00e0 au-dessus de pas mal de vrais chats.<\/p>\n<h3>D&rsquo;autres f\u00e9lins et d&rsquo;autres starters<\/h3>\n<p>Son rival de g\u00e9n\u00e9ration est disponible dans la m\u00eame gamme : la <a href=\"https:\/\/www.bdfancomics.ch\/produit\/peluche-pokemon-sekiguchi-otaquin\/\"><strong>peluche Otaquin Sekiguchi<\/strong><\/a>, starter Eau d&rsquo;Alola. Et pour un autre chat starter, cette fois de Paldea, la <a href=\"https:\/\/www.bdfancomics.ch\/produit\/peluche-pokemon-miascarade\/\"><strong>peluche Miascarade<\/strong><\/a> montre o\u00f9 m\u00e8ne l&rsquo;\u00e9volution de Poussacha.<\/p>\n<div class=\"category-seo-more\">\n<details>\n<summary style=\"cursor:pointer;color:#cc0000\"><strong><span style=\"color:#ffffff\">Lire plus<\/span><\/strong><\/summary>\n<p>Un conseil de dresseur avis\u00e9 : ne caressez jamais un vrai Flamiaou \u00e0 rebrousse-poil. Avec la peluche, en revanche, vous pouvez y aller. Elle gardera son air vaguement vex\u00e9, mais c&rsquo;est son expression naturelle, rien de personnel.<\/p>\n<\/details>\n<\/div>","on_sale":false,"prices":{"price":"4900","regular_price":"4900","sale_price":"4900","price_range":null,"currency_code":"CHF","currency_symbol":"CHF","currency_minor_unit":2,"currency_decimal_separator":",","currency_thousand_separator":"","currency_prefix":"","currency_suffix":"CHF"},"price_html":"<span class=\"woocommerce-Price-amount amount\">49,00<span class=\"woocommerce-Price-currencySymbol\" dir=\"auto\">&#067;&#072;&#070;<\/span><\/span>","average_rating":"0","review_count":0,"images":[{"id":93802,"src":"https:\/\/www.bdfancomics.ch\/wp-content\/uploads\/2026\/10\/peluche-pokemon-sekiguchi-flamiaou-nyon.webp","thumbnail":"https:\/\/www.bdfancomics.ch\/wp-content\/uploads\/2026\/10\/peluche-pokemon-sekiguchi-flamiaou-nyon-500x500.webp","srcset":"https:\/\/www.bdfancomics.ch\/wp-content\/uploads\/2026\/10\/peluche-pokemon-sekiguchi-flamiaou-nyon.webp 1200w, https:\/\/www.bdfancomics.ch\/wp-content\/uploads\/2026\/10\/peluche-pokemon-sekiguchi-flamiaou-nyon-300x300.webp 300w, https:\/\/www.bdfancomics.ch\/wp-content\/uploads\/2026\/10\/peluche-pokemon-sekiguchi-flamiaou-nyon-1024x1024.webp 1024w, https:\/\/www.bdfancomics.ch\/wp-content\/uploads\/2026\/10\/peluche-pokemon-sekiguchi-flamiaou-nyon-150x150.webp 150w, https:\/\/www.bdfancomics.ch\/wp-content\/uploads\/2026\/10\/peluche-pokemon-sekiguchi-flamiaou-nyon-768x768.webp 768w, https:\/\/www.bdfancomics.ch\/wp-content\/uploads\/2026\/10\/peluche-pokemon-sekiguchi-flamiaou-nyon-500x500.webp 500w, https:\/\/www.bdfancomics.ch\/wp-content\/uploads\/2026\/10\/peluche-pokemon-sekiguchi-flamiaou-nyon-600x600.webp 600w, https:\/\/www.bdfancomics.ch\/wp-content\/uploads\/2026\/10\/peluche-pokemon-sekiguchi-flamiaou-nyon-100x100.webp 100w, https:\/\/www.bdfancomics.ch\/wp-content\/uploads\/2026\/10\/peluche-pokemon-sekiguchi-flamiaou-nyon-64x64.webp 64w","sizes":"(max-width: 1200px) 100vw, 1200px","thumbnail_srcset":"https:\/\/www.bdfancomics.ch\/wp-content\/uploads\/2026\/10\/peluche-pokemon-sekiguchi-flamiaou-nyon-500x500.webp 500w, https:\/\/www.bdfancomics.ch\/wp-content\/uploads\/2026\/10\/peluche-pokemon-sekiguchi-flamiaou-nyon-300x300.webp 300w, https:\/\/www.bdfancomics.ch\/wp-content\/uploads\/2026\/10\/peluche-pokemon-sekiguchi-flamiaou-nyon-1024x1024.webp 1024w, https:\/\/www.bdfancomics.ch\/wp-content\/uploads\/2026\/10\/peluche-pokemon-sekiguchi-flamiaou-nyon-150x150.webp 150w, https:\/\/www.bdfancomics.ch\/wp-content\/uploads\/2026\/10\/peluche-pokemon-sekiguchi-flamiaou-nyon-768x768.webp 768w, https:\/\/www.bdfancomics.ch\/wp-content\/uploads\/2026\/10\/peluche-pokemon-sekiguchi-flamiaou-nyon-600x600.webp 600w, https:\/\/www.bdfancomics.ch\/wp-content\/uploads\/2026\/10\/peluche-pokemon-sekiguchi-flamiaou-nyon-100x100.webp 100w, https:\/\/www.bdfancomics.ch\/wp-content\/uploads\/2026\/10\/peluche-pokemon-sekiguchi-flamiaou-nyon-64x64.webp 64w, https:\/\/www.bdfancomics.ch\/wp-content\/uploads\/2026\/10\/peluche-pokemon-sekiguchi-flamiaou-nyon.webp 1200w","thumbnail_sizes":"(max-width: 500px) 100vw, 500px","name":"Peluche Pok\u00e9mon Sekiguchi Flamiaou","alt":"Peluche Pok\u00e9mon Sekiguchi Flamiaou"}],"categories":[{"id":1102,"name":"Jeux &amp; Jouets","slug":"jeux-jouets","link":"https:\/\/www.bdfancomics.ch\/categorie-produit\/jeux-jouets\/"},{"id":3652,"name":"Peluches","slug":"peluches-jeux","link":"https:\/\/www.bdfancomics.ch\/categorie-produit\/jeux-jouets\/peluches-jeux\/"},{"id":6560,"name":"Peluches Pok\u00e9mon","slug":"peluches-pokemon","link":"https:\/\/www.bdfancomics.ch\/categorie-produit\/jeux-jouets\/peluches-jeux\/peluches-pokemon\/"}],"tags":[],"brands":[{"id":6477,"name":"The Pok\u00e9mon Company","slug":"the-pokemon-company","link":"https:\/\/www.bdfancomics.ch\/marque\/the-pokemon-company\/"}],"attributes":[{"id":11,"name":"Licence","taxonomy":"pa_licence","has_variations":false,"terms":[{"id":6680,"name":"Pok\u00e9mon","slug":"pokemon"}]},{"id":12,"name":"Univers \/ M\u00e9dia","taxonomy":"pa_univers-media","has_variations":false,"terms":[{"id":6682,"name":"Anime","slug":"anime"}]}],"variations":[],"grouped_products":[],"has_options":false,"is_purchasable":true,"is_in_stock":true,"is_on_backorder":false,"low_stock_remaining":null,"stock_availability":{"text":"En stock","class":"in-stock"},"sold_individually":false,"weight":"","dimensions":{"length":"","width":"","height":""},"formatted_weight":"ND","formatted_dimensions":"ND","add_to_cart":{"text":"Ajouter au panier","description":"Ajouter au panier\u00a0: &ldquo;Peluche Pok\u00e9mon Sekiguchi Flamiaou&rdquo;","url":"\/wp-json\/wc\/store\/v1\/products?search=pokemon&#038;per_page=100&#038;orderby=date&#038;order=desc&#038;add-to-cart=89218","single_text":"Ajouter au panier","minimum":1,"maximum":3,"multiple_of":1},"is_password_protected":false,"extensions":{},"_links":{"self":[{"href":"https:\/\/www.bdfancomics.ch\/wp-json\/wc\/store\/v1\/products\/89218","targetHints":{"allow":["GET"]}}],"collection":[{"href":"https:\/\/www.bdfancomics.ch\/wp-json\/wc\/store\/v1\/products"}],"upsells":[{"embeddable":true,"href":"https:\/\/www.bdfancomics.ch\/wp-json\/wc\/store\/v1\/products?include=89465,78164,76404,59926"}],"cross_sells":[{"embeddable":true,"href":"https:\/\/www.bdfancomics.ch\/wp-json\/wc\/store\/v1\/products?include=89223,89188,89225,89224"}],"related":[{"embeddable":true,"href":"https:\/\/www.bdfancomics.ch\/wp-json\/wc\/store\/v1\/products?related=89218&per_page=10"}]}},{"id":89217,"name":"Peluche Pok\u00e9mon Sekiguchi Chelours","slug":"peluche-pokemon-sekiguchi-chelours","parent":0,"type":"simple","variation":"","permalink":"https:\/\/www.bdfancomics.ch\/produit\/peluche-pokemon-sekiguchi-chelours\/","sku":"4905610671892","short_description":"<p>La <strong>peluche Chelours Sekiguchi<\/strong> (s\u00e9rie Mokomoko) repr\u00e9sente l&rsquo;ours le plus dangereux \u00e0 c\u00e2liner du monde Pok\u00e9mon : t\u00eate rose et blanche, corps noir boucl\u00e9, coussinets roses. Environ 18 cm.<\/p>\n<p>La seule version de Chelours que l&rsquo;on peut serrer dans ses bras en gardant toutes ses c\u00f4tes.<\/p>","description":"<h2>Peluche Chelours Sekiguchi : enfin un c\u00e2lin de Chelours sans danger<\/h2>\n<p>Chelours a l&rsquo;air d&rsquo;une peluche g\u00e9ante. C&rsquo;est pr\u00e9cis\u00e9ment le pi\u00e8ge. Dans le Pok\u00e9dex, ses \u00e9treintes sont assez puissantes pour broyer les os de ceux qu&rsquo;il appr\u00e9cie. Cette <strong>peluche Chelours<\/strong> de Sekiguchi inverse enfin la situation : c&rsquo;est vous qui le serrez dans vos bras, et personne ne se blesse.<\/p>\n<p>T\u00eate rose et blanche, corps noir boucl\u00e9, petits coussinets roses : le mod\u00e8le conserve toute la bonhomie trompeuse du personnage.<\/p>\n<h3>Mokomoko, ou l&rsquo;art du rembourrage moelleux<\/h3>\n<p>Sekiguchi, entreprise japonaise de peluches \u00e0 l&rsquo;origine de Monchhichi, a int\u00e9gr\u00e9 Chelours \u00e0 sa gamme Pok\u00e9mon \u00ab Mokomoko \u00bb. Le tissu boucl\u00e9 \u00e0 poils longs donne au Pok\u00e9mon une texture d&rsquo;ourson en laine, particuli\u00e8rement r\u00e9ussie sur le noir du corps.<\/p>\n<p>La peluche mesure environ 18 cm de haut, pour une largeur presque \u00e9quivalente : un format trapu, \u00e0 l&rsquo;image du Pok\u00e9mon. Elle tient bien assise et prend vite sa place sur un lit ou une \u00e9tag\u00e8re.<\/p>\n<h3>Chelours, la force brute avec une t\u00eate de nounours<\/h3>\n<p>Pok\u00e9mon n\u00b0760 de types Normal et Combat, Chelours vient de la r\u00e9gion d&rsquo;Alola, dans <em>Pok\u00e9mon Soleil et Lune<\/em>. Il \u00e9volue \u00e0 partir de Nounourson, un petit ourson qui se d\u00e9bat quand on veut le c\u00e2liner, au niveau 27. Le paradoxe est total : le b\u00e9b\u00e9 refuse les c\u00e2lins, l&rsquo;adulte les distribue avec une force colossale.<\/p>\n<p>Dans l&rsquo;anime, Chelours est devenu une l\u00e9gende gr\u00e2ce \u00e0 un running gag : il surgit r\u00e9guli\u00e8rement de nulle part pour emporter Jessie, James et Miaouss sous son bras et les ram\u00e8ne dans son repaire, o\u00f9 il les nourrit de baies. La Team Rocket n&rsquo;a jamais vraiment compris pourquoi, et le public non plus.<\/p>\n<h3>Le c\u00e2lin sans cl\u00e9 de bras<\/h3>\n<p>Cette peluche fera sourire tous ceux qui connaissent la r\u00e9putation de Chelours. Elle fonctionne aussi comme un simple ours tout doux pour les autres, ce qui en fait une bonne id\u00e9e de cadeau \u00e0 double lecture.<\/p>\n<p>Comme le reste de la gamme boucl\u00e9e, elle pr\u00e9f\u00e8re une chambre s\u00e8che \u00e0 une \u00e9tag\u00e8re de salle de bain. Et rien ne vous emp\u00eache de lui faire porter un jour un petit chapeau de la Team Rocket.<\/p>\n<h3>Ses victimes pr\u00e9f\u00e9r\u00e9es, ses cousins ours<\/h3>\n<p>Pour reconstituer la sc\u00e8ne de l&rsquo;anime, la <a href=\"https:\/\/www.bdfancomics.ch\/produit\/peluche-pokemon-sekiguchi-miaouss\/\"><strong>peluche Miaouss Sekiguchi<\/strong><\/a>, de la m\u00eame gamme, se glisse parfaitement sous son bras. C\u00f4t\u00e9 ours, la <a href=\"https:\/\/www.bdfancomics.ch\/produit\/peluche-pokemon-teddiursa-3\/\"><strong>peluche Teddiursa<\/strong><\/a> offre une version beaucoup plus innocente.<\/p>\n<div class=\"category-seo-more\">\n<details>\n<summary style=\"cursor:pointer;color:#cc0000\"><strong><span style=\"color:#ffffff\">Lire plus<\/span><\/strong><\/summary>\n<p>Mode d&#8217;emploi officieux : on peut serrer cette peluche aussi fort qu&rsquo;on veut, elle ne rendra jamais la pareille. C&rsquo;est d&rsquo;ailleurs la seule r\u00e8gle qui distingue r\u00e9ellement Chelours en peluche du vrai. Pour la Team Rocket, la nuance arrive malheureusement un peu tard.<\/p>\n<\/details>\n<\/div>","on_sale":false,"prices":{"price":"4900","regular_price":"4900","sale_price":"4900","price_range":null,"currency_code":"CHF","currency_symbol":"CHF","currency_minor_unit":2,"currency_decimal_separator":",","currency_thousand_separator":"","currency_prefix":"","currency_suffix":"CHF"},"price_html":"<span class=\"woocommerce-Price-amount amount\">49,00<span class=\"woocommerce-Price-currencySymbol\" dir=\"auto\">&#067;&#072;&#070;<\/span><\/span>","average_rating":"0","review_count":0,"images":[{"id":93801,"src":"https:\/\/www.bdfancomics.ch\/wp-content\/uploads\/2026\/10\/peluche-pokemon-sekiguchi-chelours-nyon.webp","thumbnail":"https:\/\/www.bdfancomics.ch\/wp-content\/uploads\/2026\/10\/peluche-pokemon-sekiguchi-chelours-nyon-500x500.webp","srcset":"https:\/\/www.bdfancomics.ch\/wp-content\/uploads\/2026\/10\/peluche-pokemon-sekiguchi-chelours-nyon.webp 1200w, https:\/\/www.bdfancomics.ch\/wp-content\/uploads\/2026\/10\/peluche-pokemon-sekiguchi-chelours-nyon-300x300.webp 300w, https:\/\/www.bdfancomics.ch\/wp-content\/uploads\/2026\/10\/peluche-pokemon-sekiguchi-chelours-nyon-1024x1024.webp 1024w, https:\/\/www.bdfancomics.ch\/wp-content\/uploads\/2026\/10\/peluche-pokemon-sekiguchi-chelours-nyon-150x150.webp 150w, https:\/\/www.bdfancomics.ch\/wp-content\/uploads\/2026\/10\/peluche-pokemon-sekiguchi-chelours-nyon-768x768.webp 768w, https:\/\/www.bdfancomics.ch\/wp-content\/uploads\/2026\/10\/peluche-pokemon-sekiguchi-chelours-nyon-500x500.webp 500w, https:\/\/www.bdfancomics.ch\/wp-content\/uploads\/2026\/10\/peluche-pokemon-sekiguchi-chelours-nyon-600x600.webp 600w, https:\/\/www.bdfancomics.ch\/wp-content\/uploads\/2026\/10\/peluche-pokemon-sekiguchi-chelours-nyon-100x100.webp 100w, https:\/\/www.bdfancomics.ch\/wp-content\/uploads\/2026\/10\/peluche-pokemon-sekiguchi-chelours-nyon-64x64.webp 64w","sizes":"(max-width: 1200px) 100vw, 1200px","thumbnail_srcset":"https:\/\/www.bdfancomics.ch\/wp-content\/uploads\/2026\/10\/peluche-pokemon-sekiguchi-chelours-nyon-500x500.webp 500w, https:\/\/www.bdfancomics.ch\/wp-content\/uploads\/2026\/10\/peluche-pokemon-sekiguchi-chelours-nyon-300x300.webp 300w, https:\/\/www.bdfancomics.ch\/wp-content\/uploads\/2026\/10\/peluche-pokemon-sekiguchi-chelours-nyon-1024x1024.webp 1024w, https:\/\/www.bdfancomics.ch\/wp-content\/uploads\/2026\/10\/peluche-pokemon-sekiguchi-chelours-nyon-150x150.webp 150w, https:\/\/www.bdfancomics.ch\/wp-content\/uploads\/2026\/10\/peluche-pokemon-sekiguchi-chelours-nyon-768x768.webp 768w, https:\/\/www.bdfancomics.ch\/wp-content\/uploads\/2026\/10\/peluche-pokemon-sekiguchi-chelours-nyon-600x600.webp 600w, https:\/\/www.bdfancomics.ch\/wp-content\/uploads\/2026\/10\/peluche-pokemon-sekiguchi-chelours-nyon-100x100.webp 100w, https:\/\/www.bdfancomics.ch\/wp-content\/uploads\/2026\/10\/peluche-pokemon-sekiguchi-chelours-nyon-64x64.webp 64w, https:\/\/www.bdfancomics.ch\/wp-content\/uploads\/2026\/10\/peluche-pokemon-sekiguchi-chelours-nyon.webp 1200w","thumbnail_sizes":"(max-width: 500px) 100vw, 500px","name":"Peluche Pok\u00e9mon Sekiguchi Chelours","alt":"Peluche Pok\u00e9mon Sekiguchi Chelours"}],"categories":[{"id":1102,"name":"Jeux &amp; Jouets","slug":"jeux-jouets","link":"https:\/\/www.bdfancomics.ch\/categorie-produit\/jeux-jouets\/"},{"id":3652,"name":"Peluches","slug":"peluches-jeux","link":"https:\/\/www.bdfancomics.ch\/categorie-produit\/jeux-jouets\/peluches-jeux\/"},{"id":6560,"name":"Peluches Pok\u00e9mon","slug":"peluches-pokemon","link":"https:\/\/www.bdfancomics.ch\/categorie-produit\/jeux-jouets\/peluches-jeux\/peluches-pokemon\/"}],"tags":[],"brands":[{"id":6477,"name":"The Pok\u00e9mon Company","slug":"the-pokemon-company","link":"https:\/\/www.bdfancomics.ch\/marque\/the-pokemon-company\/"}],"attributes":[{"id":11,"name":"Licence","taxonomy":"pa_licence","has_variations":false,"terms":[{"id":6680,"name":"Pok\u00e9mon","slug":"pokemon"}]},{"id":12,"name":"Univers \/ M\u00e9dia","taxonomy":"pa_univers-media","has_variations":false,"terms":[{"id":6682,"name":"Anime","slug":"anime"}]}],"variations":[],"grouped_products":[],"has_options":false,"is_purchasable":true,"is_in_stock":true,"is_on_backorder":false,"low_stock_remaining":2,"stock_availability":{"text":"Plus que 2 en stock","class":"in-stock"},"sold_individually":false,"weight":"","dimensions":{"length":"","width":"","height":""},"formatted_weight":"ND","formatted_dimensions":"ND","add_to_cart":{"text":"Ajouter au panier","description":"Ajouter au panier\u00a0: &ldquo;Peluche Pok\u00e9mon Sekiguchi Chelours&rdquo;","url":"\/wp-json\/wc\/store\/v1\/products?search=pokemon&#038;per_page=100&#038;orderby=date&#038;order=desc&#038;add-to-cart=89217","single_text":"Ajouter au panier","minimum":1,"maximum":2,"multiple_of":1},"is_password_protected":false,"extensions":{},"_links":{"self":[{"href":"https:\/\/www.bdfancomics.ch\/wp-json\/wc\/store\/v1\/products\/89217","targetHints":{"allow":["GET"]}}],"collection":[{"href":"https:\/\/www.bdfancomics.ch\/wp-json\/wc\/store\/v1\/products"}],"upsells":[{"embeddable":true,"href":"https:\/\/www.bdfancomics.ch\/wp-json\/wc\/store\/v1\/products?include=89465,78164,76404,59926"}],"cross_sells":[{"embeddable":true,"href":"https:\/\/www.bdfancomics.ch\/wp-json\/wc\/store\/v1\/products?include=89223,89188,89225,89224"}],"related":[{"embeddable":true,"href":"https:\/\/www.bdfancomics.ch\/wp-json\/wc\/store\/v1\/products?related=89217&per_page=10"}]}},{"id":89198,"name":"Mini Tin Pok\u00e9mon Illumis","slug":"minitin-illumis","parent":0,"type":"simple","variation":"","permalink":"https:\/\/www.bdfancomics.ch\/produit\/minitin-illumis\/","sku":"0196214139275","short_description":"<p>La <strong>Mini Tin Pok\u00e9mon Illumis<\/strong> renferme deux boosters du JCC Pok\u00e9mon, une planche d&rsquo;autocollants et une carte d&rsquo;illustration assortie au couvercle.<\/p>\n<p>Cinq bo\u00eetes, cinq coins de rue : pos\u00e9es c\u00f4te \u00e0 c\u00f4te, elles reconstituent toute une place de la ville.<\/p>","description":"<h2>Mini Tin Pok\u00e9mon Illumis : la ville lumi\u00e8re dans le creux de la main<\/h2>\n<p>Illumis est la grande ville de Kalos, avec sa tour au centre et ses avenues pav\u00e9es. Elle sert de d\u00e9cor \u00e0 L\u00e9gendes Pok\u00e9mon : Z-A, et c&rsquo;est elle que l&rsquo;on retrouve sur la <strong>Mini Tin Pok\u00e9mon Illumis<\/strong>, une petite bo\u00eete en m\u00e9tal qui glisse deux boosters dans la poche.<\/p>\n<h3>Ce qu&rsquo;il y a dedans<\/h3>\n<p>Chaque mini-bo\u00eete Illumis contient 2 boosters du JCC Pok\u00e9mon, 1 page d&rsquo;autocollants ainsi qu&rsquo;une carte artistique qui reproduit le dessin de la bo\u00eete. Les autocollants finissent souvent sur un classeur ou un cahier, la carte artistique sur une \u00e9tag\u00e8re.<\/p>\n<h3>Cinq bo\u00eetes qui se r\u00e9pondent<\/h3>\n<p>Il existe cinq illustrations diff\u00e9rentes, et elles se combinent pour former une image plus grande. Chaque bo\u00eete associe deux Pok\u00e9mon : Aligatueur et Rozbouton, Drattak et H\u00e9lionceau, Gallame et deux Mucuscule, M\u00e9ganium et Mistigrix, et enfin Roitiflam et S\u00e9piatop, devant la grande tour de la ville.<\/p>\n<p>M\u00e9ganium, Roitiflam et Aligatueur sont les formes finales des trois Pok\u00e9mon de d\u00e9part propos\u00e9s dans L\u00e9gendes Pok\u00e9mon : Z-A. Les joueurs du jeu reconna\u00eetront tout de suite le clin d&rsquo;\u0153il.<\/p>\n<h3>La ville de la Tour Prismatique<\/h3>\n<p>Dans Pok\u00e9mon X et Y, Illumis est organis\u00e9e autour de la Tour Prismatique, qui abrite l&rsquo;ar\u00e8ne de Lem, le champion de type \u00c9lectrik. Ses grands boulevards en \u00e9toile et ses caf\u00e9s en ont fait l&rsquo;une des villes les plus marquantes de la s\u00e9rie. L\u00e9gendes Pok\u00e9mon : Z-A y revient enti\u00e8rement, avec un projet de r\u00e9am\u00e9nagement urbain au c\u0153ur de l&rsquo;histoire.<\/p>\n<h3>Une sortie de 2026<\/h3>\n<p>Les mini-bo\u00eetes Illumis sont sorties au deuxi\u00e8me trimestre 2026, en plein bloc M\u00e9ga-\u00c9volution. Elles prolongent l&rsquo;ambiance de Kalos, la r\u00e9gion o\u00f9 les M\u00e9ga-\u00c9volutions sont n\u00e9es dans Pok\u00e9mon X et Y. Pour mieux comprendre ce bloc, notre article <a href=\"https:\/\/www.bdfancomics.ch\/le-bloc-pokemon-mega-evolution-ce-quil-faut-vraiment-savoir\/\"><strong>sur le bloc Pok\u00e9mon M\u00e9ga-\u00c9volution<\/strong><\/a> fait le point.<\/p>\n<h3>Un petit format qui a tout d&rsquo;un grand<\/h3>\n<p>Deux boosters, c&rsquo;est l&rsquo;occasion de tester sa chance sans grosse d\u00e9pense. La bo\u00eete en m\u00e9tal reste ensuite utile pour ranger un deck de d\u00e9couverte ou quelques cartes favorites. Pour comparer avec les mini-bo\u00eetes d&rsquo;autres extensions, direction le rayon <a href=\"https:\/\/www.bdfancomics.ch\/categorie-produit\/cartes-a-collectionner\/pokemon-cartes\/cartes-pokemon-en-francais\/mini-tins-pokemon-en-francais\/\"><strong>Mini Tins Pok\u00e9mon<\/strong><\/a>.<\/p>\n<h3>Caract\u00e9ristiques<\/h3>\n<p>Mini-bo\u00eete Illumis du JCC Pok\u00e9mon, sortie au deuxi\u00e8me trimestre 2026. Par bo\u00eete : une carte d&rsquo;illustration, des autocollants et deux boosters ; cinq motifs diff\u00e9rents existent. EAN : 0196214139275.<\/p>\n<div class=\"category-seo-more\">\n<details>\n<summary style=\"cursor:pointer;color:#cc0000\"><strong><span style=\"color:#ffffff\">Lire plus<\/span><\/strong><\/summary>\n<p>Illumis compte des dizaines de caf\u00e9s dans les jeux de Kalos. Cette mini-bo\u00eete n&rsquo;en contient aucun, mais elle se range tr\u00e8s bien \u00e0 c\u00f4t\u00e9 de la tasse du matin.<\/p>\n<\/details>\n<\/div>","on_sale":false,"prices":{"price":"1290","regular_price":"1290","sale_price":"1290","price_range":null,"currency_code":"CHF","currency_symbol":"CHF","currency_minor_unit":2,"currency_decimal_separator":",","currency_thousand_separator":"","currency_prefix":"","currency_suffix":"CHF"},"price_html":"<span class=\"woocommerce-Price-amount amount\">12,90<span class=\"woocommerce-Price-currencySymbol\" dir=\"auto\">&#067;&#072;&#070;<\/span><\/span>","average_rating":"0","review_count":0,"images":[{"id":93823,"src":"https:\/\/www.bdfancomics.ch\/wp-content\/uploads\/2026\/10\/mini-tin-pokemon-illumis-aligatueur-rozbouton-nyon.webp","thumbnail":"https:\/\/www.bdfancomics.ch\/wp-content\/uploads\/2026\/10\/mini-tin-pokemon-illumis-aligatueur-rozbouton-nyon-500x500.webp","srcset":"https:\/\/www.bdfancomics.ch\/wp-content\/uploads\/2026\/10\/mini-tin-pokemon-illumis-aligatueur-rozbouton-nyon.webp 1000w, https:\/\/www.bdfancomics.ch\/wp-content\/uploads\/2026\/10\/mini-tin-pokemon-illumis-aligatueur-rozbouton-nyon-300x300.webp 300w, https:\/\/www.bdfancomics.ch\/wp-content\/uploads\/2026\/1