        <div id="website_cookies_bar" class="s_popup o_snippet_invisible o_no_save d-none" data-name="Cookies Bar" data-vcss="001" data-invisible="1">
            <div class="modal modal_shown o_cookies_discrete s_popup_bottom" data-show-after="500" data-display="afterDelay" data-consents-duration="999" data-bs-focus="false" data-bs-backdrop="false" data-bs-keyboard="false" tabindex="-1" style="display: none; background-color: rgba(0, 0, 0, 0.64);" aria-hidden="true">
                <div class="modal-dialog d-flex s_popup_size_full">
                    <div class="modal-content oe_structure"><section class="o_colored_level o_cc o_cc1"><div class="container"><div class="row"><div class="col-lg-8 pt16 o_colored_level"><p><span class="pe-1">Nous utilisons des cookies pour vous offrir une meilleure expérience utilisateur sur ce site.</span><a href="/politique-de-cookies#top" class="o_cookies_bar_text_policy px-0 o_translate_inline btn btn-link">Politique en matière de cookies</a></p></div><div class="col-lg-4 text-end pb16 o_colored_level pt24"><a href="#" id="cookies-consent-essential" role="button" class="js_close_popup btn btn-outline-primary rounded-circle btn-sm px-2"><span class="base-fs">Que les essentiels</span></a>&nbsp; &nbsp; &nbsp; &nbsp;<span class="base-fs"></span><a href="#" id="cookies-consent-all" role="button" class="js_close_popup btn btn-outline-primary rounded-circle btn-sm"><span class="base-fs">Je suis d'accord</span></a></div></div></div></section></div>
                </div>
            </div>
        </div>
            </div>
        <script>
document.addEventListener('DOMContentLoaded', function () {

  /* ---------- util CSS (injection une seule fois) ---------- */
  (function injectOnce() {
    if (document.getElementById('rk-common-css')) return;
    const s = document.createElement('style');
    s.id = 'rk-common-css';
    s.textContent = `
      .rk-visually-hidden {
        position: absolute !important;
        left: -9999px !important;
        width: 1px !important;
        height: 1px !important;
        opacity: 0 !important;
      }
      .rk-hidden {
        display: none !important;
      }
      /* Force l'affichage du label Prénom dans le formulaire infos perso */
      label[for="rk_first_name"], 
      #rk_first_name_label {
        display: block !important;
        visibility: visible !important;
      }
    `;
    document.head.appendChild(s);
  })();

  /* ============================================================
   * A) "Mes informations" (address_form) - robuste (observer)
   * ============================================================ */
  (function initAddressForm() {
    const form = document.querySelector('form[name="address_form"]');
    if (!form) return;

    const applyEnhancements = () => {
      const nameGroup = form.querySelector('#div_name');
      const nameInput = nameGroup && nameGroup.querySelector('input[name="name"]');
      const nameLabel = nameGroup && nameGroup.querySelector('label');
      if (!nameGroup || !nameInput) return;

      // 1) cacher "name" visuellement
      nameInput.classList.add('rk-visually-hidden');
      if (nameLabel) nameLabel.classList.add('rk-hidden');

      // 2) injecter Prénom/Nom (si pas déjà présents)
      if (!nameGroup.querySelector('#rk_first_name') && !nameGroup.querySelector('#rk_last_name')) {
        const firstWrap = document.createElement('div');
        firstWrap.className = 'form-group mb-2';
        firstWrap.innerHTML = `
          <label id="rk_first_name_label" for="rk_first_name">Prénom *</label>
          <input id="rk_first_name" name="first_name" class="form-control" required autocomplete="given-name">
        `;

        const lastWrap = document.createElement('div');
        lastWrap.className = 'form-group mb-2';
        lastWrap.innerHTML = `
          <label for="rk_last_name">Nom *</label>
          <input id="rk_last_name" name="last_name" class="form-control" required autocomplete="family-name">
        `;

        nameGroup.insertBefore(lastWrap, nameGroup.firstChild);
        nameGroup.insertBefore(firstWrap, nameGroup.firstChild);

        // Pré-remplir depuis "name" si ce n'est pas un email
        const raw = (nameInput.value || '').trim();
        if (raw && !/@/.test(raw)) {
          const parts = raw.split(/\s+/);
          const ln = parts.pop() || '';
          const fn = parts.join(' ');
          firstWrap.querySelector('input').value = fn;
          lastWrap.querySelector('input').value = ln;
        }

        // Sync -> compose "name" depuis first/last
        const first = firstWrap.querySelector('input');
        const last = lastWrap.querySelector('input');
        const compose = () => {
          nameInput.value = `${(first.value || '').trim()} ${(last.value || '').trim()}`.trim();
        };
        first.addEventListener('input', compose, { passive: true });
        last.addEventListener('input', compose, { passive: true });
        form.addEventListener('submit', compose, true);
      }

      // 3) masquer (sans supprimer) les blocs facture + phrase
      const hideByLabel = (txt) => {
        const label = Array.from(form.querySelectorAll('label'))
          .find(l => l.textContent.trim().toLowerCase() === txt.toLowerCase());
        if (!label) return;
        const field = label.closest('.form-group, .mb-2, .o_we_form_group, .col, .row > div') || label.parentElement;
        if (field) {
          field.classList.add('rk-hidden');
          field.querySelectorAll('input,select,textarea').forEach(el => {
            el.disabled = true;
          });
        }
      };

      hideByLabel('Recevoir des factures');
      hideByLabel('Format électronique');

      const hint = Array.from(form.querySelectorAll('p, .text-muted, small'))
        .find(p => /Choisissez le mode d'envoi de vos factures/i.test(p.textContent));
      if (hint) hint.classList.add('rk-hidden');
    };

    // 1) première application après que le JS Odoo a fini
    window.addEventListener('load', () => applyEnhancements());

    // 2) ré-appliquer si Odoo modifie le DOM
    const mo = new MutationObserver(() => {
      clearTimeout(mo._t);
      mo._t = setTimeout(applyEnhancements, 50);
    });
    mo.observe(form, { childList: true, subtree: true });
  })();

  /* ============================================================
   * B) "Inscription" (oe_signup_form)
   * - Cache le champ name Odoo
   * - Ajoute Prénom/Nom AVANT le bloc complet Mot de passe
   * - Compose name = "Prénom Nom"
   * ============================================================ */
  (function initSignupForm() {
    let enhanced = false;
    let mo;

    function findPasswordAnchor(form, pwdInput) {
      // 1) On cherche le label "Mot de passe" lié au champ password
      let pwdLabel = null;

      if (pwdInput.id) {
        pwdLabel = form.querySelector(`label[for="${pwdInput.id}"]`);
      }

      if (!pwdLabel) {
        pwdLabel = Array.from(form.querySelectorAll('label'))
          .find(label => {
            const txt = label.textContent.trim().toLowerCase();
            return txt === 'mot de passe';
          });
      }

      // 2) Si le label existe, on insère AVANT le label ou son bloc complet
      if (pwdLabel) {
        const labelBlock = pwdLabel.closest('.form-group, .mb-2, .mb-3, .col, .row > div');

        // Si le bloc contient aussi l'input password, on insère avant le bloc complet
        if (labelBlock && labelBlock.contains(pwdInput)) {
          return labelBlock;
        }

        // Sinon, le label est isolé : on insère directement avant le label
        return pwdLabel;
      }

      // 3) Fallback : avant le bloc du champ password
      return pwdInput.closest('.form-group, .mb-2, .mb-3, .col, div') || pwdInput;
    }

    function enhanceOnce() {
      if (enhanced) return true;

      const form = document.querySelector('form.oe_signup_form');
      if (!form) return false;

      const nameInput = form.querySelector('input[name="name"]');
      const pwdInput = form.querySelector('input[name="password"]');

      if (!nameInput || !pwdInput) return false;

      if (form.dataset.rkSignupEnhanced === '1') {
        enhanced = true;
        return true;
      }

      form.dataset.rkSignupEnhanced = '1';

      // 1) Cacher le champ name Odoo sans le supprimer
      nameInput.required = false;
      nameInput.setAttribute('aria-hidden', 'true');
      nameInput.tabIndex = -1;

      const nameGroup = nameInput.closest('.form-group, .mb-2, .mb-3, .col, div') || nameInput.parentElement;
      if (nameGroup) {
        nameGroup.classList.add('rk-hidden');
      }

      // 2) Créer Prénom/Nom
      const container = document.createElement('div');
      container.id = 'rk_signup_name_fields';
      container.innerHTML = `
        <div class="mb-2 form-group">
          <label for="signup_first_name">Prénom</label>
          <input id="signup_first_name"
                 name="first_name"
                 class="form-control"
                 required
                 autocomplete="given-name">
        </div>
        <div class="mb-2 form-group">
          <label for="signup_last_name">Nom</label>
          <input id="signup_last_name"
                 name="last_name"
                 class="form-control"
                 required
                 autocomplete="family-name">
        </div>
      `;

      // 3) Insérer AVANT le vrai bloc "Mot de passe"
      const anchor = findPasswordAnchor(form, pwdInput);
      anchor.before(container);

      const first = container.querySelector('#signup_first_name');
      const last = container.querySelector('#signup_last_name');

      // 4) Pré-remplir si name existe déjà
      const raw = (nameInput.value || '').trim();
      if (raw && !/@/.test(raw)) {
        const parts = raw.split(/\s+/);
        const ln = parts.pop() || '';
        const fn = parts.join(' ');
        first.value = fn;
        last.value = ln;
      }

      // 5) Composer le name Odoo
      const compose = () => {
        const fn = (first.value || '').trim();
        const ln = (last.value || '').trim();
        nameInput.value = `${fn} ${ln}`.trim();
      };

      first.addEventListener('input', compose, { passive: true });
      last.addEventListener('input', compose, { passive: true });
      first.addEventListener('change', compose, { passive: true });
      last.addEventListener('change', compose, { passive: true });

      form.addEventListener('submit', function (e) {
        compose();

        if (!first.checkValidity() || !last.checkValidity()) {
          return;
        }

        if (!nameInput.value.trim()) {
          e.preventDefault();
          first.reportValidity();
        }
      }, true);

      enhanced = true;
      if (mo) mo.disconnect();

      return true;
    }

    if (enhanceOnce()) return;

    mo = new MutationObserver(() => {
      enhanceOnce();
    });

    mo.observe(document.documentElement, {
      childList: true,
      subtree: true
    });

    setTimeout(() => {
      if (mo) mo.disconnect();
    }, 8000);
  })();

});
</script>
        </body>
</html>