francais\/coffrets-pokemon-en-francais\/"}],"tags":[{"id":2281,"name":"Pok\u00e9mon","slug":"pokemon","link":"https:\/\/www.bdfancomics.ch\/etiquette-produit\/pokemon\/"}],"brands":[{"id":6477,"name":"The Pok\u00e9mon Company","slug":"the-pokemon-company","link":"https:\/\/www.bdfancomics.ch\/marque\/the-pokemon-company\/"}],"attributes":[{"id":11,"name":"Licence","taxonomy":"pa_licence","has_variations":false,"terms":[{"id":6680,"name":"Pok\u00e9mon","slug":"pokemon"}]},{"id":7,"name":"Langue","taxonomy":"pa_langue","has_variations":false,"terms":[{"id":5361,"name":"Fran\u00e7ais","slug":"francais"}]},{"id":37,"name":"Type de produit TCG","taxonomy":"pa_format-tcg","has_variations":false,"terms":[{"id":12052,"name":"Coffret","slug":"coffret"}]},{"id":38,"name":"Bloc Pok\u00e9mon","taxonomy":"pa_bloc-pokemon","has_variations":false,"terms":[{"id":12065,"name":"M\u00e9ga-\u00c9volution","slug":"mega-evolution"}]}],"variations":[],"grouped_products":[],"has_options":false,"is_purchasable":false,"is_in_stock":true,"is_on_backorder":false,"low_stock_remaining":1,"stock_availability":{"text":"Plus que 1 en stock","class":"in-stock"},"sold_individually":false,"weight":"","dimensions":{"length":"","width":"","height":""},"formatted_weight":"ND","formatted_dimensions":"ND","add_to_cart":{"text":"Lire la suite","description":"En savoir plus sur &ldquo;Coffret Pok\u00e9mon Premium M\u00e9tamorph ME05.5 Celebration 30 Ans&rdquo;","url":"https:\/\/www.bdfancomics.ch\/produit\/coffret-pokemon-premium-metamorph-me05-5-celebration-30-ans\/","single_text":"Ajouter au panier","minimum":1,"maximum":1,"multiple_of":1},"is_password_protected":false,"extensions":{},"_links":{"self":[{"href":"https:\/\/www.bdfancomics.ch\/wp-json\/wc\/store\/v1\/products\/93868","targetHints":{"allow":["GET"]}}],"collection":[{"href":"https:\/\/www.bdfancomics.ch\/wp-json\/wc\/store\/v1\/products"}],"related":[{"embeddable":true,"href":"https:\/\/www.bdfancomics.ch\/wp-json\/wc\/store\/v1\/products?related=93868&per_page=10"}]}},{"id":93865,"name":"Coffret Pok\u00e9mon Figurine Mewtwo ME05.5 Celebration 30 Ans","slug":"coffret-pokemon-figurine-mewtwo-me05-5-celebration-30-ans","parent":0,"type":"simple","variation":"","permalink":"https:\/\/www.bdfancomics.ch\/produit\/coffret-pokemon-figurine-mewtwo-me05-5-celebration-30-ans\/","sku":"196214145511","short_description":"<p>Le <strong>coffret Pok\u00e9mon figurine Mewtwo<\/strong> des 30 ans r\u00e9unit une figurine Kaiyodo de Mewtwo, une promo brillante, une carte grand format et cinq boosters de l&rsquo;extension 30\u1d49 Anniversaire, en fran\u00e7ais.<\/p>\n<p>Mewtwo y prend une pose de l\u00e9vitation, bras \u00e9cart\u00e9s, au-dessus d&rsquo;un socle sombre. Il ne sourit pas. Il n&rsquo;a jamais souri.<\/p>","description":"<h2>Coffret Pok\u00e9mon figurine Mewtwo : le num\u00e9ro 150 entre en sc\u00e8ne<\/h2>\n<p>Le <strong>coffret Pok\u00e9mon figurine Mewtwo<\/strong> met \u00e0 l&rsquo;honneur le Pok\u00e9mon num\u00e9ro 150, cr\u00e9\u00e9 en laboratoire \u00e0 partir de Mew selon la l\u00e9gende des premiers jeux. Trente ans plus tard, il reste l&rsquo;un des visages les plus reconnaissables de la licence, et sans doute le plus s\u00e9rieux.<\/p>\n<h3>La figurine de Daichi F. Sugimoto<\/h3>\n<p>Le c\u0153ur du coffret est une figurine de Mewtwo produite par Kaiyodo et sculpt\u00e9e par Daichi F. Sugimoto. Mewtwo y l\u00e9vite au-dessus d&rsquo;un socle anguleux aux tons violets, les bras ouverts, la longue queue en \u00e9quilibre. La silhouette est tendue, presque mena\u00e7ante, \u00e0 l&rsquo;oppos\u00e9 de la figurine de Mew vendue dans l&rsquo;autre coffret. Kaiyodo est une maison japonaise connue pour ses sculptures pr\u00e9cises, et cela se voit dans le dessin des muscles et des mains.<\/p>\n<h3>Ce qui accompagne la figurine<\/h3>\n<p>Dans la bo\u00eete, Mewtwo n&rsquo;arrive pas seul :<\/p>\n<p>une carte promo brillante \u00e0 son effigie ;<br \/>\nune carte grand format, pens\u00e9e pour l&rsquo;exposition ;<br \/>\ncinq boosters en fran\u00e7ais issus de l&rsquo;extension anniversaire.<\/p>\n<p>L&rsquo;extension rassemble plus de 150 cartes. Ses boosters ont un format inhabituel : 5 cartes brillantes, dont un Pikachu choisi parmi 30 illustrations diff\u00e9rentes, plus une \u00c9nergie de base brillante.<\/p>\n<h3>Le duo Mew et Mewtwo<\/h3>\n<p>Les deux coffrets figurine de l&rsquo;anniversaire racontent la m\u00eame histoire de deux points de vue. Mew, l&rsquo;original, insouciant et rose ; Mewtwo, la copie qui a mal pris le fait d&rsquo;en \u00eatre une. Les poser ensemble sur une \u00e9tag\u00e8re cr\u00e9e tout de suite une petite sc\u00e8ne, et les deux sculpteurs ont manifestement travaill\u00e9 dans ce sens.<\/p>\n<p>Les fans de la premi\u00e8re g\u00e9n\u00e9ration appr\u00e9cieront de prolonger la f\u00eate avec <a href=\"https:\/\/www.bdfancomics.ch\/extension\/celebrations\/\"><strong>C\u00e9l\u00e9brations<\/strong><\/a>, l&rsquo;extension des 25 ans, qui revisitait d\u00e9j\u00e0 plusieurs cartes cultes des d\u00e9buts du jeu.<\/p>\n<h3>Un Pok\u00e9mon l\u00e9gendaire au sommet<\/h3>\n<p>Mewtwo est un Pok\u00e9mon l\u00e9gendaire de type Psy. Dans les premi\u00e8res versions, on ne pouvait l&rsquo;affronter qu&rsquo;apr\u00e8s avoir battu la Ligue, au fond d&rsquo;une grotte r\u00e9serv\u00e9e aux dresseurs confirm\u00e9s. Ce statut de boss de fin de partie l&rsquo;a suivi depuis : dans les jeux, les films et le jeu de cartes, il reste l&rsquo;adversaire que l&rsquo;on garde pour la fin.<\/p>\n<h3>Exposer sans ab\u00eemer<\/h3>\n<p>Une figurine comme celle-ci gagne \u00e0 rester loin d&rsquo;une fen\u00eatre : les UV finissent par d\u00e9colorer les peintures, surtout les violets. La carte grand format, elle, se range mieux debout sur un support ou dans un cadre que pos\u00e9e \u00e0 plat sous d&rsquo;autres objets. Quant \u00e0 la promo, un prot\u00e8ge-carte suffit \u00e0 la garder intacte en attendant de d\u00e9cider si elle rejoint un classeur ou un deck.<\/p>\n<p>Pour d&rsquo;autres bo\u00eetes de la m\u00eame vague, le rayon des <a href=\"https:\/\/www.bdfancomics.ch\/categorie-produit\/cartes-a-collectionner\/pokemon-cartes\/cartes-pokemon-en-francais\/coffrets-pokemon-en-francais\/\"><strong>coffrets Pok\u00e9mon en fran\u00e7ais<\/strong><\/a> est le bon point de d\u00e9part.<\/p>\n<div class=\"category-seo-more\">\n<details>\n<summary style=\"cursor:pointer;color:#cc0000\"><strong><span style=\"color:#ffffff\">Lire plus<\/span><\/strong><\/summary>\n<p>Mewtwo a pass\u00e9 un film entier \u00e0 se demander pourquoi il existait. Sur une \u00e9tag\u00e8re, la question ne se pose plus : il est l\u00e0 pour impressionner les visiteurs.<\/p>\n<\/details>\n<\/div>","on_sale":false,"prices":{"price":"5990","regular_price":"5990","sale_price":"5990","price_range":null,"currency_code":"CHF","currency_symbol":"CHF","currency_minor_unit":2,"currency_decimal_separator":",","currency_thousand_separator":"","currency_prefix":"","currency_suffix":"CHF"},"price_html":"<span class=\"woocommerce-Price-amount amount\">59,90<span class=\"woocommerce-Price-currencySymbol\" dir=\"auto\">&#067;&#072;&#070;<\/span><\/span>","average_rating":"0","review_count":0,"images":[{"id":93962,"src":"https:\/\/www.bdfancomics.ch\/wp-content\/uploads\/2026\/10\/coffret-pokemon-figurine-mewtwo-30-ans-boutique-nyon.webp","thumbnail":"https:\/\/www.bdfancomics.ch\/wp-content\/uploads\/2026\/10\/coffret-pokemon-figurine-mewtwo-30-ans-boutique-nyon-500x500.webp","srcset":"https:\/\/www.bdfancomics.ch\/wp-content\/uploads\/2026\/10\/coffret-pokemon-figurine-mewtwo-30-ans-boutique-nyon.webp 1200w, https:\/\/www.bdfancomics.ch\/wp-content\/uploads\/2026\/10\/coffret-pokemon-figurine-mewtwo-30-ans-boutique-nyon-300x300.webp 300w, https:\/\/www.bdfancomics.ch\/wp-content\/uploads\/2026\/10\/coffret-pokemon-figurine-mewtwo-30-ans-boutique-nyon-1024x1024.webp 1024w, https:\/\/www.bdfancomics.ch\/wp-content\/uploads\/2026\/10\/coffret-pokemon-