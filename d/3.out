.bdfancomics.ch\/wp-content\/uploads\/2026\/10\/carte-cadeau-bdfancomics-nyon.webp 1200w","thumbnail_sizes":"(max-width: 500px) 100vw, 500px","name":"Carte cadeau BDFancomics \u2013 Manga, Pok\u00e9mon &#038; Pop Culture","alt":"Carte cadeau BDFancomics aux couleurs de la boutique de Nyon : manga, Pok\u00e9mon et pop culture"}],"categories":[{"id":6655,"name":"Carte cadeau","slug":"carte-cadeau","link":"https:\/\/www.bdfancomics.ch\/categorie-produit\/carte-cadeau\/"}],"tags":[],"brands":[],"attributes":[{"id":0,"name":"Montant de la carte-cadeau","taxonomy":null,"has_variations":true,"terms":[{"id":0,"name":"10CHF","slug":"10CHF"},{"id":0,"name":"25CHF","slug":"25CHF"},{"id":0,"name":"50CHF","slug":"50CHF"},{"id":0,"name":"100CHF","slug":"100CHF"},{"id":0,"name":"150CHF","slug":"150CHF"},{"id":0,"name":"200CHF","slug":"200CHF"}]}],"variations":[{"id":89551,"attributes":[{"name":"Montant de la carte-cadeau","value":"10CHF"}]},{"id":89552,"attributes":[{"name":"Montant de la carte-cadeau","value":"25CHF"}]},{"id":89553,"attributes":[{"name":"Montant de la carte-cadeau","value":"50CHF"}]},{"id":89554,"attributes":[{"name":"Montant de la carte-cadeau","value":"100CHF"}]},{"id":89561,"attributes":[{"name":"Montant de la carte-cadeau","value":"150CHF"}]},{"id":89562,"attributes":[{"name":"Montant de la carte-cadeau","value":"200CHF"}]}],"grouped_products":[],"has_options":true,"is_purchasable":true,"is_in_stock":true,"is_on_backorder":false,"low_stock_remaining":null,"stock_availability":{"text":"","class":"in-stock"},"sold_individually":false,"weight":"","dimensions":{"length":"","width":"","height":""},"formatted_weight":"ND","formatted_dimensions":"ND","add_to_cart":{"text":"S\u00e9lectionnez le montant","description":"S\u00e9lectionner les options pour &ldquo;Carte Cadeau Bdfancomics &#8211; Manga, Pok\u00e9mon &#038; Pop Culture&rdquo;","url":"https:\/\/www.bdfancomics.ch\/produit\/carte-cadeau-bdfancomics-manga-pokemon-pop-culture\/","single_text":"Ajouter au panier","minimum":1,"maximum":9999,"multiple_of":1},"is_password_protected":false,"extensions":{},"_links":{"self":[{"href":"https:\/\/www.bdfancomics.ch\/wp-json\/wc\/store\/v1\/products\/89550","targetHints":{"allow":["GET"]}}],"collection":[{"href":"https:\/\/www.bdfancomics.ch\/wp-json\/wc\/store\/v1\/products"}],"upsells":[{"embeddable":true,"href":"https:\/\/www.bdfancomics.ch\/wp-json\/wc\/store\/v1\/products?include=88977,89465,78164,88971"}],"cross_sells":[{"embeddable":true,"href":"https:\/\/www.bdfancomics.ch\/wp-json\/wc\/store\/v1\/products?include=89578,76404,59926,89183"}],"related":[{"embeddable":true,"href":"https:\/\/www.bdfancomics.ch\/wp-json\/wc\/store\/v1\/products?related=89550&per_page=10"}]}},{"id":89468,"name":"Deck Pok\u00e9mon Mon Premier Combat","slug":"deck-pokemon-mon-premier-combat","parent":0,"type":"variable","variation":"","permalink":"https:\/\/www.bdfancomics.ch\/produit\/deck-pokemon-mon-premier-combat\/","sku":"820650555930","short_description":"<p><strong>Mon Premier Combat<\/strong> est le kit officiel pour apprendre le JCC Pok\u00e9mon \u00e0 deux : 2 mini-decks de 17 cartes, 2 tapis de jeu, un livret de r\u00e8gles simplifi\u00e9es, une grande pi\u00e8ce m\u00e9tallis\u00e9e et des marqueurs.<\/p>\n<p>Deux mod\u00e8les : Pikachu et Bulbizarre, ou Salam\u00e8che et Carapuce.<\/p>","description":"<h2>Mon Premier Combat : apprendre le JCC Pok\u00e9mon en une soir\u00e9e<\/h2>\n<p>Beaucoup d&rsquo;enfants collectionnent les cartes Pok\u00e9mon sans savoir y jouer. <strong>Mon Premier Combat<\/strong> a \u00e9t\u00e9 con\u00e7u pour r\u00e9gler ce probl\u00e8me : tout ce qu&rsquo;il faut pour un premier combat \u00e0 deux, avec des r\u00e8gles simplifi\u00e9es et des guides pas \u00e0 pas. Sorti au 3e trimestre 2023, c&rsquo;est l&rsquo;outil officiel pour d\u00e9marrer en famille.<\/p>\n<h3>Le contenu officiel<\/h3>\n<p>La bo\u00eete contient 2 mini-decks de 17 cartes, 2 tapis de jeu, un livret de r\u00e8gles, une grande pi\u00e8ce m\u00e9tallis\u00e9e Pok\u00e9mon, une feuille de marqueurs de d\u00e9g\u00e2ts et 6 jetons R\u00e9compense. Les tapis indiquent o\u00f9 poser chaque carte, ce qui \u00e9vite de passer la premi\u00e8re partie \u00e0 chercher dans le livret.<\/p>\n<h3>Deux mod\u00e8les<\/h3>\n<p>Le kit existe en deux versions : Pikachu et Bulbizarre, ou Salam\u00e8che et Carapuce. Les deux reprennent des Pok\u00e9mon de la premi\u00e8re g\u00e9n\u00e9ration, connus de tous, parents compris. On choisit le mod\u00e8le sur la fiche, selon son Pok\u00e9mon pr\u00e9f\u00e9r\u00e9.<\/p>\n<h3>Pourquoi 17 cartes ?<\/h3>\n<p>Un deck normal compte 60 cartes. Pour un d\u00e9butant, c&rsquo;est beaucoup : trop de cartes \u00e0 lire, trop de choix \u00e0 faire. Avec 17 cartes, la partie est courte, les r\u00e8gles s&rsquo;apprennent en jouant et l&rsquo;enfant comprend vite le principe des \u00c9nergies, des attaques et des R\u00e9compenses. Une fois \u00e0 l&rsquo;aise, il peut passer \u00e0 un vrai deck de 60 cartes.<\/p>\n<h3>Pikachu, toujours le premier<\/h3>\n<p>Dans Pok\u00e9mon Jaune, sorti en 1998 au Japon, Pikachu \u00e9tait le seul starter et suivait le joueur \u00e0 pied, comme dans le dessin anim\u00e9. C&rsquo;est ce jeu qui a fait de lui l&rsquo;ami qu&rsquo;on emm\u00e8ne partout. Le retrouver dans un kit pour d\u00e9butants n&rsquo;a rien d&rsquo;\u00e9tonnant : c&rsquo;est souvent par lui que tout commence.<\/p>\n<h3>Pour qui ?<\/h3>\n<p>Pour les enfants d\u00e8s 6 ans, pour les parents qui veulent jouer avec eux sans lire un manuel de 30 pages, et pour les grands fr\u00e8res et s\u0153urs qui veulent initier les plus petits.<\/p>\n<p>Apr\u00e8s Mon Premier Combat, le <a href=\"https:\/\/www.bdfancomics.ch\/produit\/coffret-pokemon-necessaire-du-dresseur-2025\/\"><strong>N\u00e9cessaire du Dresseur 2025<\/strong><\/a> aide \u00e0 construire de vrais decks. Pour un deck complet pr\u00eat \u00e0 jouer, voir le <a href=\"https:\/\/www.bdfancomics.ch\/produit\/deck-pokemon-combat-de-ligue-palkia-originel-vstar\/\"><strong>Deck Combat de Ligue Palkia Originel-VSTAR<\/strong><\/a>. Tous les decks sont dans les <a href=\"https:\/\/www.bdfancomics.ch\/categorie-produit\/cartes-a-collectionner\/pokemon-cartes\/cartes-pokemon-en-francais\/decks-pokemon-en-francais\/\"><strong>decks Pok\u00e9mon en fran\u00e7ais<\/strong><\/a>.<\/p>\n<h3>Caract\u00e9ristiques<\/h3>\n<p>Mon premier combat du JCC Pok\u00e9mon, version fran\u00e7aise. Mod\u00e8les : Pikachu et Bulbizarre, ou Salam\u00e8che et Carapuce. Contenu : 2 mini-decks de 17 cartes, 2 tapis de jeu, 1 livret de r\u00e8gles, 1 grande pi\u00e8ce m\u00e9tallis\u00e9e, 1 feuille de marqueurs de d\u00e9g\u00e2ts, 6 jetons R\u00e9compense. EAN : 820650555930.<\/p>\n<div class=\"category-seo-more\">\n<details>\n<summary style=\"cursor:pointer;color:#cc0000\"><strong><span style=\"color:#ffffff\">Lire plus<\/span><\/strong><\/summary>\n<p>Attention, effet secondaire connu : apr\u00e8s la premi\u00e8re partie, l&rsquo;enfant gagne. Apr\u00e8s la deuxi\u00e8me aussi. \u00c0 la troisi\u00e8me, c&rsquo;est lui qui vous explique les r\u00e8gles.<\/p>\n<\/details>\n<\/div>","on_sale":false,"prices":{"price":"2000","regular_price":"2000","sale_price":"2000","price_range":null,"currency_code":"CHF","currency_symbol":"CHF","currency_minor_unit":2,"currency_decimal_separator":",","currency_thousand_separator":"","currency_prefix":"","currency_suffix":"CHF"},"price_html":"<span class=\"woocommerce-Price-amount amount\">20,00<span class=\"woocommerce-Price-currencySymbol\" dir=\"auto\">&#067;&#072;&#070;<\/span><\/span>","average_rating":"0","review_count":0,"images":[{"id":93671,"src":"https:\/\/www.bdfancomics.ch\/wp-content\/uploads\/2026\/08\/deck-pokemon-mon-premier-combat-nyon.webp","thumbnail":"https:\/\/www.bdfancomics.ch\/wp-content\/uploads\/2026\/08\/deck-pokemon-mon-premier-combat-nyon-500x500.webp","srcset":"https:\/\/www.bdfancomics.ch\/wp-content\/uploads\/2026\/08\/deck-pokemon-mon-premier-combat-nyon.w