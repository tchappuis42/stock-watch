ancomics.ch\/wp-content\/uploads\/2026\/10\/figurine-pokemon-mew-2-nyon-1024x1024.webp 1024w, https:\/\/www.bdfancomics.ch\/wp-content\/uploads\/2026\/10\/figurine-pokemon-mew-2-nyon-150x150.webp 150w, https:\/\/www.bdfancomics.ch\/wp-content\/uploads\/2026\/10\/figurine-pokemon-mew-2-nyon-768x768.webp 768w, https:\/\/www.bdfancomics.ch\/wp-content\/uploads\/2026\/10\/figurine-pokemon-mew-2-nyon-600x600.webp 600w, https:\/\/www.bdfancomics.ch\/wp-content\/uploads\/2026\/10\/figurine-pokemon-mew-2-nyon-100x100.webp 100w, https:\/\/www.bdfancomics.ch\/wp-content\/uploads\/2026\/10\/figurine-pokemon-mew-2-nyon-64x64.webp 64w, https:\/\/www.bdfancomics.ch\/wp-content\/uploads\/2026\/10\/figurine-pokemon-mew-2-nyon.webp 1200w","thumbnail_sizes":"(max-width: 500px) 100vw, 500px","name":"Figurine Pok\u00e9mon Mew (bo\u00eete)","alt":"Figurine Pok\u00e9mon Mew dans sa bo\u00eete"}],"categories":[{"id":3873,"name":"Figurines Pok\u00e9mon","slug":"figurines-pokemon","link":"https:\/\/www.bdfancomics.ch\/categorie-produit\/figurines\/figurines-mangas\/figurines-pokemon\/"}],"tags":[],"brands":[{"id":6477,"name":"The Pok\u00e9mon Company","slug":"the-pokemon-company","link":"https:\/\/www.bdfancomics.ch\/marque\/the-pokemon-company\/"}],"attributes":[{"id":11,"name":"Licence","taxonomy":"pa_licence","has_variations":false,"terms":[{"id":6680,"name":"Pok\u00e9mon","slug":"pokemon"}]},{"id":12,"name":"Univers \/ M\u00e9dia","taxonomy":"pa_univers-media","has_variations":false,"terms":[{"id":6682,"name":"Anime","slug":"anime"}]},{"id":13,"name":"Personnage","taxonomy":"pa_personnage","has_variations":false,"terms":[{"id":6727,"name":"Mew","slug":"mew"}]},{"id":41,"name":"Fabricant","taxonomy":"pa_fabricant","has_variations":false,"terms":[{"id":12206,"name":"Funism","slug":"funism"}]},{"id":3,"name":"Taille","taxonomy":"pa_taille","has_variations":false,"terms":[{"id":12164,"name":"Moins de 15 cm","slug":"moins-de-15-cm"}]}],"variations":[],"grouped_products":[],"has_options":false,"is_purchasable":true,"is_in_stock":true,"is_on_backorder":false,"low_stock_remaining":null,"stock_availability":{"text":"En stock","class":"in-stock"},"sold_individually":false,"weight":"","dimensions":{"length":"","width":"","height":""},"formatted_weight":"ND","formatted_dimensions":"ND","add_to_cart":{"text":"Ajouter au panier","description":"Ajouter au panier\u00a0: &ldquo;Figurine Pok\u00e9mon Mew&rdquo;","url":"\/wp-json\/wc\/store\/v1\/products?search=pokemon&#038;per_page=100&#038;orderby=date&#038;order=desc&#038;add-to-cart=89130","single_text":"Ajouter au panier","minimum":1,"maximum":4,"multiple_of":1},"is_password_protected":false,"extensions":{},"_links":{"self":[{"href":"https:\/\/www.bdfancomics.ch\/wp-json\/wc\/store\/v1\/products\/89130","targetHints":{"allow":["GET"]}}],"collection":[{"href":"https:\/\/www.bdfancomics.ch\/wp-json\/wc\/store\/v1\/products"}],"upsells":[{"embeddable":true,"href":"https:\/\/www.bdfancomics.ch\/wp-json\/wc\/store\/v1\/products?include=89465,78164,89578,76404"}],"cross_sells":[{"embeddable":true,"href":"https:\/\/www.bdfancomics.ch\/wp-json\/wc\/store\/v1\/products?include=89120,89111,44935,89140"}],"related":[{"embeddable":true,"href":"https:\/\/www.bdfancomics.ch\/wp-json\/wc\/store\/v1\/products?related=89130&per_page=10"}]}},{"id":89129,"name":"Figurine Pok\u00e9mon Magicarpe","slug":"figurine-pokemon-magicarpe","parent":0,"type":"simple","variation":"","permalink":"https:\/\/www.bdfancomics.ch\/produit\/figurine-pokemon-magicarpe\/","sku":"6972940551802","short_description":"<p>La <strong>figurine Magicarpe<\/strong> Funism Prime Figure Mini saute hors de l&rsquo;eau, entour\u00e9 d&rsquo;effets aquatiques transparents. Environ 10 cm de PVC, licence officielle Pok\u00e9mon.<\/p>\n<p>Il ne sait faire que Trempette, mais il le fait avec style, et il finira peut-\u00eatre en L\u00e9viator.<\/p>","description":"<h2>Figurine Magicarpe Funism : Trempette, version statue<\/h2>\n<p>Certains Pok\u00e9mon impressionnent par leur puissance. Magicarpe impressionne par sa pers\u00e9v\u00e9rance. La <strong>figurine Magicarpe<\/strong> de Funism lui rend enfin justice : le poisson orange bondit hors de l&rsquo;eau, entour\u00e9 d&rsquo;effets aquatiques transparents, avec toute la conviction d&rsquo;un Pok\u00e9mon qui n&rsquo;a pourtant qu&rsquo;une seule attaque.<\/p>\n<h3>Le n\u00b0129, roi de l&rsquo;\u00e9claboussure<\/h3>\n<p>Apparu dans Pok\u00e9mon Rouge et Bleu, Magicarpe est le Pok\u00e9mon de type Eau qui ne sert \u00e0 rien\u2026 jusqu&rsquo;au niveau 20. Les joueurs qui ont eu la patience de l&rsquo;entra\u00eener ont \u00e9t\u00e9 r\u00e9compens\u00e9s par un L\u00e9viator, l&rsquo;une des \u00e9volutions les plus spectaculaires de toute la s\u00e9rie.<\/p>\n<p>Le vendeur de Magicarpe du Centre Pok\u00e9mon de la Route 4, qui le c\u00e9dait pour 500 Pok\u00e9dollars, reste d&rsquo;ailleurs l&rsquo;un des premiers arnaqueurs de l&rsquo;histoire du jeu vid\u00e9o.<\/p>\n<h3>Une figurine pleine d&rsquo;eau<\/h3>\n<p>Dans la gamme Prime Figure Mini, chaque Pok\u00e9mon re\u00e7oit son effet transparent. Pour Magicarpe, c&rsquo;est \u00e9videmment de l&rsquo;eau, en \u00e9claboussures qui l&rsquo;entourent sur le socle. On y lit son nom anglais, Magikarp, et son nom chinois. Hauteur : environ 10 cm.<\/p>\n<h3>Avant, apr\u00e8s<\/h3>\n<p>Magicarpe et L\u00e9viator forment le duo parfait pour illustrer la patience r\u00e9compens\u00e9e. La <a href=\"https:\/\/www.bdfancomics.ch\/produit\/figurine-pokemon-leviator\/\"><strong>figurine L\u00e9viator Funism<\/strong><\/a> montre l&rsquo;\u00e9volution dans la m\u00eame gamme, surgissant d&rsquo;une vague. Les deux c\u00f4te \u00e0 c\u00f4te racontent une histoire que tous les dresseurs connaissent.<\/p>\n<h3>Un poisson qui a eu son propre jeu<\/h3>\n<p>Magicarpe est tellement aim\u00e9 pour sa nullit\u00e9 qu&rsquo;il a eu droit \u00e0 son propre jeu mobile en 2017, Magicarpe Jump, o\u00f9 l&rsquo;unique but est de le faire sauter plus haut que les autres. Une cons\u00e9cration pour un Pok\u00e9mon dont le Pok\u00e9dex dit lui-m\u00eame qu&rsquo;il est l&rsquo;un des plus faibles qui existent.<\/p>\n<p>La figurine Funism le prend au s\u00e9rieux, et c&rsquo;est ce qui la rend dr\u00f4le : une pose de saut digne d&rsquo;un grand champion, des \u00e9claboussures partout, et toujours ce regard vide qu&rsquo;on lui conna\u00eet depuis 1996.<\/p>\n<h3>Un saut hors de la vague<\/h3>\n<p>Magicarpe jaillit d&rsquo;une vague bleu et blanc, la bouche ouverte en rond, nageoires et barbillons dor\u00e9s bien d\u00e9ploy\u00e9s. Le socle bleu indique MAGIKARP et son nom chinois. La sc\u00e8ne est volontairement dramatique, comme si ce saut allait enfin changer quelque chose : tout l&rsquo;humour de la figurine est l\u00e0.<\/p>\n<h3>Caract\u00e9ristiques<\/h3>\n<p>Marque : Funism. Gamme : Prime Figure Mini. Mat\u00e9riau : PVC avec effets transparents. Hauteur : environ 10 cm. Licence officielle Pok\u00e9mon. EAN : 6972940551802.<\/p>\n<div class=\"category-seo-more\">\n<details>\n<summary style=\"cursor:pointer;color:#cc0000\"><strong><span style=\"color:#ffffff\">Lire plus<\/span><\/strong><\/summary>\n<p>Trempette est sans doute l&rsquo;attaque la plus c\u00e9l\u00e8bre du monde Pok\u00e9mon : elle ne fait strictement rien. C&rsquo;est pr\u00e9cis\u00e9ment pour \u00e7a qu&rsquo;on l&rsquo;aime. Sur une \u00e9tag\u00e8re, Magicarpe fait au moins autant d&rsquo;effet que n&rsquo;importe quel l\u00e9gendaire.<\/p>\n<\/details>\n<\/div>","on_sale":false,"prices":{"price":"2900","regular_price":"2900","sale_price":"2900","price_range":null,"currency_code":"CHF","currency_symbol":"CHF","currency_minor_unit":2,"currency_decimal_separator":",","currency_thousand_separator":"","currency_prefix":"","currency_suffix":"CHF"},"price_html":"<span class=\"woocommerce-Price-amount amount\">29,00<span class=\"woocommerce-Price-currencySymbol\" dir=\"auto\">&#067;&#072;&#070;<\/span><\/span>","average_rating":"0","revi