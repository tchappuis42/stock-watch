500px","name":"ETB Pok\u00e9mon Coffret Dresseur d\u2019Elite ME04 Chaos Ascendant","alt":"ETB Pok\u00e9mon Coffret Dresseur d\u2019Elite ME04 Chaos Ascendant"}],"categories":[{"id":2631,"name":"ETB Pok\u00e9mon en Fran\u00e7ais","slug":"etb","link":"https:\/\/www.bdfancomics.ch\/categorie-produit\/cartes-a-collectionner\/pokemon-cartes\/cartes-pokemon-en-francais\/etb\/"}],"tags":[],"brands":[{"id":6477,"name":"The Pok\u00e9mon Company","slug":"the-pokemon-company","link":"https:\/\/www.bdfancomics.ch\/marque\/the-pokemon-company\/"}],"attributes":[{"id":11,"name":"Licence","taxonomy":"pa_licence","has_variations":false,"terms":[{"id":6680,"name":"Pok\u00e9mon","slug":"pokemon"}]},{"id":7,"name":"Langue","taxonomy":"pa_langue","has_variations":false,"terms":[{"id":5361,"name":"Fran\u00e7ais","slug":"francais"}]},{"id":37,"name":"Type de produit TCG","taxonomy":"pa_format-tcg","has_variations":false,"terms":[{"id":12053,"name":"ETB","slug":"etb"}]},{"id":38,"name":"Bloc Pok\u00e9mon","taxonomy":"pa_bloc-pokemon","has_variations":false,"terms":[{"id":12065,"name":"M\u00e9ga-\u00c9volution","slug":"mega-evolution"}]},{"id":39,"name":"Extension","taxonomy":"pa_extension","has_variations":false,"terms":[{"id":12079,"name":"Chaos Ascendant","slug":"chaos-ascendant"}]}],"variations":[],"grouped_products":[],"has_options":false,"is_purchasable":true,"is_in_stock":true,"is_on_backorder":false,"low_stock_remaining":null,"stock_availability":{"text":"En stock","class":"in-stock"},"sold_individually":false,"weight":"","dimensions":{"length":"","width":"","height":""},"formatted_weight":"ND","formatted_dimensions":"ND","add_to_cart":{"text":"Ajouter au panier","description":"Ajouter au panier\u00a0: &ldquo;ETB Pok\u00e9mon Coffret Dresseur d\u2019Elite ME04 Chaos Ascendant&rdquo;","url":"\/wp-json\/wc\/store\/v1\/products?search=pokemon&#038;per_page=100&#038;orderby=date&#038;order=desc&#038;add-to-cart=89032","single_text":"Ajouter au panier","minimum":1,"maximum":9,"multiple_of":1},"is_password_protected":false,"extensions":{},"_links":{"self":[{"href":"https:\/\/www.bdfancomics.ch\/wp-json\/wc\/store\/v1\/products\/89032","targetHints":{"allow":["GET"]}}],"collection":[{"href":"https:\/\/www.bdfancomics.ch\/wp-json\/wc\/store\/v1\/products"}],"upsells":[{"embeddable":true,"href":"https:\/\/www.bdfancomics.ch\/wp-json\/wc\/store\/v1\/products?include=89015,89021,89020,89578"}],"cross_sells":[{"embeddable":true,"href":"https:\/\/www.bdfancomics.ch\/wp-json\/wc\/store\/v1\/products?include=88455,89183,91139,89714"}],"related":[{"embeddable":true,"href":"https:\/\/www.bdfancomics.ch\/wp-json\/wc\/store\/v1\/products?related=89032&per_page=10"}]}},{"id":89021,"name":"Display Pok\u00e9mon ME03 Equilibre Parfait 36 Boosters","slug":"display-pokemon-equilibre-parfait-me03","parent":0,"type":"simple","variation":"","permalink":"https:\/\/www.bdfancomics.ch\/produit\/display-pokemon-equilibre-parfait-me03\/","sku":"196214137141","short_description":"<p>Le <strong>Display \u00c9quilibre Parfait<\/strong> contient 36 boosters de l&rsquo;extension ME03, soit 360 cartes et 36 \u00c9nergies de base \u00e0 ouvrir.<\/p>\n<p>La bo\u00eete qu&rsquo;il faut pour r\u00e9unir M\u00e9ga-Zygarde-ex et toute la ville d&rsquo;\u00c9quilibre Parfait.<\/p>","description":"<h2>Display \u00c9quilibre Parfait : 36 boosters pour rassembler les cellules<\/h2>\n<p>\u00c9quilibre Parfait, troisi\u00e8me extension du bloc M\u00e9ga-\u00c9volution, est sortie en fran\u00e7ais le 27 mars 2026. Le <strong>Display \u00c9quilibre Parfait<\/strong> en r\u00e9unit 36 boosters, chacun avec 10 cartes et une \u00c9nergie de base. C&rsquo;est le format des collectionneurs qui veulent avancer vite dans la liste, et des joueurs qui veulent leurs cartes en plusieurs exemplaires.<\/p>\n<h3>Zygarde, le Pok\u00e9mon qui se construit morceau par morceau<\/h3>\n<p>Le nom de l&rsquo;extension n&rsquo;est pas un hasard. Dans Pok\u00e9mon Soleil et Lune, Zygarde est \u00e9parpill\u00e9 en Cellules et en Noyaux un peu partout dans Alola. Il faut les ramasser une \u00e0 une pour passer de la Forme 10 % \u00e0 la Forme 50 %, puis \u00e0 la Forme Parfaite. Il y en avait 100 \u00e0 trouver, de quoi occuper les compl\u00e9tistes pendant des soir\u00e9es enti\u00e8res. Un display, c&rsquo;est un peu la m\u00eame philosophie : on rassemble, booster apr\u00e8s booster.<\/p>\n<h3>Ce qu&rsquo;on ouvre<\/h3>\n<p>M\u00e9ga-Zygarde-ex tient l&rsquo;affiche, entour\u00e9 de M\u00e9ga-M\u00e9lodelfe-ex, M\u00e9ga-Staross-ex et d&rsquo;un Miaouss-ex qui a r\u00e9ussi \u00e0 s&rsquo;inviter parmi les grands. Avec 360 cartes, on voit d\u00e9filer une grande partie de l&rsquo;extension, on accumule les doubles utiles pour un deck et on multiplie les chances de tomber sur les cartes \u00e0 illustration sp\u00e9ciale.<\/p>\n<h3>Ouvrir ou garder scell\u00e9 ?<\/h3>\n<p>Certains ouvrent tout le soir m\u00eame, d&rsquo;autres \u00e9talent les boosters sur plusieurs semaines, d&rsquo;autres encore gardent la bo\u00eete intacte. Le display est vendu scell\u00e9, avec son pr\u00e9sentoir illustr\u00e9 : il fait aussi un bel objet sur une \u00e9tag\u00e8re. \u00c0 200 CHF, c&rsquo;est aussi le moyen le plus \u00e9conomique d&rsquo;avoir 36 boosters de cette extension chez nous.<\/p>\n<h3>Pour quel joueur ?<\/h3>\n<p>Un deck centr\u00e9 sur le gardien vert demande souvent plusieurs exemplaires des m\u00eames cartes Dresseur et Pok\u00e9mon de base. C&rsquo;est l\u00e0 qu&rsquo;un display fait la diff\u00e9rence par rapport \u00e0 quelques boosters isol\u00e9s.<\/p>\n<p>L&rsquo;extension est pr\u00e9sent\u00e9e sur la page <a href=\"https:\/\/www.bdfancomics.ch\/extension\/equilibre-parfait\/\"><strong>\u00c9quilibre Parfait<\/strong><\/a>. Pour jouer tout de suite, l&rsquo;<a href=\"https:\/\/www.bdfancomics.ch\/produit\/etb-pokemon-equilibre-parfait-me03\/\"><strong>ETB \u00c9quilibre Parfait<\/strong><\/a> ajoute prot\u00e8ge-cartes et \u00c9nergies, et le <a href=\"https:\/\/www.bdfancomics.ch\/produit\/bundle-pokemon-equilibre-parfait-me03\/\"><strong>lot de 6 boosters<\/strong><\/a> convient aux petites ouvertures. Les autres bo\u00eetes sont dans les <a href=\"https:\/\/www.bdfancomics.ch\/categorie-produit\/cartes-a-collectionner\/pokemon-cartes\/cartes-pokemon-en-francais\/displays-pokemon-en-francais\/\"><strong>displays Pok\u00e9mon en fran\u00e7ais<\/strong><\/a>.<\/p>\n<h3>Caract\u00e9ristiques<\/h3>\n<p>Display M\u00e9ga-\u00c9volution \u2013 \u00c9quilibre Parfait (ME03), version fran\u00e7aise. Contenu : 36 boosters de 10 cartes + 1 \u00c9nergie de base. Sortie : 27 mars 2026. EAN : 196214137141.<\/p>\n<div class=\"category-seo-more\">\n<details>\n<summary style=\"cursor:pointer;color:#cc0000\"><strong><span style=\"color:#ffffff\">Lire plus<\/span><\/strong><\/summary>\n<p>Zygarde avait besoin de 100 Cellules pour atteindre sa Forme Parfaite. Avec 36 boosters, vous \u00eates d\u00e9j\u00e0 \u00e0 plus d&rsquo;un tiers du chemin. Il ne reste qu&rsquo;\u00e0 trouver les 64 autres.<\/p>\n<\/details>\n<\/div>","on_sale":false,"prices":{"price":"20000","regular_price":"20000","sale_price":"20000","price_range":null,"currency_code":"CHF","currency_symbol":"CHF","currency_minor_unit":2,"currency_decimal_separator":",","currency_thousand_separator":"","currency_prefix":"","currency_suffix":"CHF"},"price_html":"<span class=\"woocommerce-Price-amount amount\">200,00<span class=\"woocommerce-Price-currencySymbol\" dir=\"auto\">&#067;&#072;&#070;<\/span><\/span>","average_rating":"0","review_count":0,"images":[{"id":90933,"src":"https:\/\/www.bdfancomics.ch\/wp-content\/uploads\/2026\/08\/display-pokemon-equilibre-parfait-me03.webp","thumbnail":"https:\/\/www.bdfancomics.ch\/wp-content\/uploads\/2026\/08\/display-pokemon-equilibre-parfait-me03-500x500.webp","srcset":"https:\/\/www.bdfancomics.ch\/wp-content\/uploads\/2026\/08\/display-pokemon-equilibre-parfait-me03.webp 1000w, https:\/\/www.bdfancomics.ch\/wp-content\/uploads\/2026\/08\/display-pokemon-equilibre-parfait-me03-300x300.webp 300w, https:\/\/www.bdfancomics.ch\/wp-content\/uploads\/2026\/08\/display-pokemon-equilibre-parfait-me03-150x150.webp 150w, https:\/\/www.bdfancomics.ch\/wp-content\/uploads\/2026\/08\/display-pokemon-equilibre-parfait-me03-768x768.webp 768w, https:\/\/www.bdfancomics.ch\/wp-content\/uploads\/2026\/08\/display-pokemon-equilibre-parfait-me03-500x500.webp 500w, https:\/\/www.bdfancomics.ch\/wp-content\/uploads\/2026\/08\/display-pokemon-equilibre-parfait-me03-600x600.webp 600w, https:\/\/www.bdfancomics.ch\/wp-content\/uploads\/2026\/08\/display-pokemon-equilibre-parfait-me03-100x100.webp 100w, https:\/\/www.bdfancomics.ch\/wp-content\/uploads\/2026\/08\/display-pokemon-equilibre-parfait-me03-64x64.webp 64w","sizes":"(max-width: 1000px) 100vw, 1000px","thumbnail_srcset":"https:\/\/www.bdfancomics.ch\/wp-content\/uploads\/2026\/08\/display-pokemon-equilibre-parfait-me03-500x500.webp 500w, https:\/\/www.bdfancomics.ch\/wp-content\/uploads\/2026\/08\/display-pokemon-equilibre-parfait-me03-300x300.webp 300w, https:\/\/www.bdfancomics.ch\/wp-content\/uploads\/2026\/08\/display-pokemon-equilibre-parfait-me03-150x150.webp 150w, https:\/\/www.bdfancomics.ch\/wp-content\/uploads\/2026\/08\/display-pokemon-equilibre-parfait-me03-768x768.webp 768w, https:\/\/www.bdfancomics.ch\/wp-content\/uploads\/2026\/08\/display-pokemon-equilibre-parfait-me03-600x600.webp 600w, https:\/\/www.bdfancomics.ch\/wp-content\/uploads\/2026\/08\/display-pokemon-equilibre-parfait-me03-100x100.webp 100w, https:\/\/www.bdfancomics.ch\/wp-content\/uploads\/2026\/08\/display-pokemon-equilibre-parfait-me03-64x64.webp 64w, https:\/\/www.bdfancomics.ch\/wp-content\/uploads\/2026\/08\/display-pokemon-equilibre-parfait-me03.webp 1000w","thumbnail_sizes":"(max-width: 500px) 100vw, 500px","name":"display-pokemon-equilibre-parfait-me03","alt":"Display Pok\u00e9mon \u00c9quilibre Parfait ME03"}],"categories":[{"id":2630,"name":"Displays Pok\u00e9mon en Fran\u00e7ais","slug":"displays-pokemon-en-francais","link":"https:\/\/www.bdfancomics.ch\/categorie-produit\/cartes-a-collectionner\/pokemon-cartes\/cartes-pokemon-en-francais\/displays-pokemon-en-francais\/"}],"tags":[],"brands":[{"id":6477,"name":"The Pok\u00e9mon Company","slug":"the-pokemon-company","link":"https:\/\/www.bdfancomics.ch\/marque\/the-pokemon-company\/"}],"attributes":[{"id":11,"name":"Licence","taxonomy":"pa_licence","has_variations":false,"terms":[{"id":6680,"name":"Pok\u00e9mon","slug":"pokemon"}]},{"id":7,"name":"Langue","taxonomy":"pa_langue","has_variations":false,"terms":[{"id":5361,"name":"Fran\u00e7ais","slug":"francais"}]},{"id":37,"name":"Type de produit TCG","taxonomy":"pa_format-tcg","has_variations":false,"terms":[{"id":12060,"name":"Display","slug":"display"}]},{"id":38,"name":"Bloc Pok\u00e9mon","taxonomy":"pa_bloc-pokemon","has_variations":false,"terms":[{"id":12065,"name":"M\u00e9ga-\u00c9volution","slug":"mega-evolution"}]},{"id":39,"name":"Extension","taxonomy":"pa_extension","has_variations":false,"terms":[{"id":12082,"name":"\u00c9quilibre Parfait","slug":"equilibre-parfait"}]}],"variations":[],"grouped_products":[],"has_options":false,"is_purchasable":true,"is_in_stock":true,"is_on_backorder":false,"low_stock_remaining":null,"stock_availability":{"text":"En stock","class":"in-stock"},"sold_individually":false,"weight":"","dimensions":{"length":"","width":"","height":""},"formatted_weight":"ND","formatted_dimensions":"ND","add_to_cart":{"text":"Ajouter au panier","description":"Ajouter au panier\u00a0: &ldquo;Display Pok\u00e9mon ME03 Equilibre Parfait 36 Boosters&rdquo;","url":"\/wp-json\/wc\/store\/v1\/products?search=pokemon&#038;per_page=100&#038;orderby=date&#038;order=desc&#038;add-to-cart=89021","single_text":"Ajouter au panier","minimum":1,"maximum":21,"multiple_of":1},"is_password_protected":false,"extensions":{},"_links":{"self":[{"href":"https:\/\/www.bdfancomics.ch\/wp-json\/wc\/store\/v1\/products\/89021","targetHints":{"allow":["GET"]}}],"collection":[{"href":"https:\/\/www.bdfancomics.ch\/wp-json\/wc\/store\/v1\/products"}],"upsells":[{"embeddable":true,"href":"https:\/\/www.bdfancomics.ch\/wp-json\/wc\/store\/v1\/products?include=89034,89007,89005,89003"}],"cross_sells":[{"embeddable":true,"href":"https:\/\/www.bdfancomics.ch\/wp-json\/wc\/store\/v1\/products?include=90931,89434,89714,89183"}],"related":[{"embeddable":true,"href":"https:\/\/www.bdfancomics.ch\/wp-json\/wc\/store\/v1\/products?related=89021&per_page=10"}]}},{"id":89020,"name":"Display Pok\u00e9mon ME05 Nuit Noire 36 Boosters","slug":"display-nuit-noire-me05","parent":0,"type":"simple","variation":"","permalink":"https:\/\/www.bdfancomics.ch\/produit\/display-nuit-noire-me05\/","sku":"196214142916","short_description":"<p>Le <strong>Display Nuit Noire<\/strong> contient 36 boosters de l&rsquo;extension ME05, soit 360 cartes et 36 \u00c9nergies de base.<\/p>\n<p>La bo\u00eete des chasseurs de M\u00e9ga-Darkrai-ex, avec des cartes M\u00e9ga textur\u00e9es.<\/p>","description":"<h2>Display Nuit Noire : 36 boosters pour une nuit blanche<\/h2>\n<p>Nuit Noire, cinqui\u00e8me extension du bloc M\u00e9ga-\u00c9volution, est sortie en fran\u00e7ais le 17 juillet 2026. Le <strong>Display Nuit Noire<\/strong> en contient 36 boosters, chacun avec 10 cartes et une \u00c9nergie de base. C&rsquo;est le format le plus direct pour partir \u00e0 la recherche des grandes cartes de l&rsquo;extension.<\/p>\n<h3>Darkrai et Cresselia, le duo de la nuit<\/h3>\n<p>Darkrai est l&rsquo;un des Pok\u00e9mon fabuleux de Sinnoh, apparu avec Pok\u00e9mon Diamant et Perle. Son talent, Mauvais R\u00eave, fait souffrir ceux qui dorment. Dans les jeux, un enfant de Joliberges ne peut se r\u00e9veiller de ses cauchemars qu&rsquo;avec une Plume de Lune de Cresselia, sa rivale lumineuse. Dans le film \u00ab L&rsquo;Ascension de Darkrai \u00bb, il est pourtant le h\u00e9ros incompris qui d\u00e9fend la ville. Bref, un m\u00e9chant pas si m\u00e9chant, parfait pour une extension sombre.<\/p>\n<h3>Ce que l&rsquo;extension cache<\/h3>\n<p>M\u00e9ga-Darkrai-ex assombrit la ville, M\u00e9ga-Zeraora-ex contre-attaque avec ses \u00e9clairs, rejoint par M\u00e9ga-Lugulabre-ex et M\u00e9ga-Minotaupe-ex. Les cartes Pok\u00e9mon-ex M\u00e9ga-\u00c9volution de Nuit Noire sont textur\u00e9es : les doigts sentent le relief avant m\u00eame que les yeux voient le nom. Avec 360 cartes \u00e0 ouvrir, les chances de croiser plusieurs M\u00e9ga sont bien r\u00e9elles.<\/p>\n<h3>Un display pour qui ?<\/h3>\n<p>Pour les collectionneurs qui veulent compl\u00e9ter la liste, pour les joueurs qui ont besoin de plusieurs exemplaires d&rsquo;une m\u00eame carte, et pour ceux qui aiment les longues soir\u00e9es d&rsquo;ouverture entre amis. On peut aussi en garder quelques boosters pour les offrir, un booster gliss\u00e9 dans une carte d&rsquo;anniversaire fait toujours son effet.<\/p>\n<h3>Scell\u00e9, le display se garde bien<\/h3>\n<p>La bo\u00eete arrive ferm\u00e9e, avec son pr\u00e9sentoir illustr\u00e9 de M\u00e9ga-Darkrai-ex. Ferm\u00e9e, elle s&rsquo;expose. Ouverte, elle range. Dans les deux cas, elle ne finit pas \u00e0 la poubelle.<\/p>\n<p>L&rsquo;extension est d\u00e9taill\u00e9e sur la page <a href=\"https:\/\/www.bdfancomics.ch\/extension\/nuit-noire\/\"><strong>Nuit Noire<\/strong><\/a>. Pour un plus petit format : l&rsquo;<a href=\"https:\/\/www.bdfancomics.ch\/produit\/etb-pokemon-coffret-dresseur-delite-nuit-noire-me05\/\"><strong>ETB Nuit Noire<\/strong><\/a> avec sa promo Zarude, ou le <a href=\"https:\/\/www.bdfancomics.ch\/produit\/booster-blister-carton-nuit-noire-me05\/\"><strong>booster blister Nuit Noire<\/strong><\/a>. C\u00f4t\u00e9 bo\u00eetes compl\u00e8tes, voir aussi les <a href=\"https:\/\/www.bdfancomics.ch\/categorie-produit\/cartes-a-collectionner\/pokemon-cartes\/cartes-pokemon-en-francais\/displays-pokemon-en-francais\/\"><strong>displays Pok\u00e9mon en fran\u00e7ais<\/strong><\/a>, et notre <a href=\"https:\/\/www.bdfancomics.ch\/le-bloc-pokemon-mega-evolution-ce-quil-faut-vraiment-savoir\/\"><strong>guide du bloc M\u00e9ga-\u00c9volution<\/strong><\/a> explique les r\u00e8gles des M\u00e9ga.<\/p>\n<h3>Caract\u00e9ristiques<\/h3>\n<p>Display M\u00e9ga-\u00c9volution \u2013 Nuit Noire (ME05), version fran\u00e7aise. Contenu : 36 boosters de 10 cartes + 1 \u00c9nergie de base. Sortie : 17 juillet 2026. EAN : 196214142916.<\/p>\n<div class=\"category-seo-more\">\n<details>\n<summary style=\"cursor:pointer;color:#cc0000\"><strong><span style=\"color:#ffffff\">Lire plus<\/span><\/strong><\/summary>\n<p>Pas de Plume de Lune fournie avec ce display. Si vous l&rsquo;ouvrez juste avant d&rsquo;aller dormir, les cauchemars de Darkrai seront remplac\u00e9s par un seul : avoir rat\u00e9 la carte qu&rsquo;il vous fallait.<\/p>\n<\/details>\n<\/div>","on_sale":false,"prices":{"price":"24900","regular_price":"24900","sale_price":"24900","price_range":null,"currency_code":"CHF","currency_symbol":"CHF","currency_minor_unit":2,"currency_decimal_separator":",","currency_thousand_separator":"","currency_prefix":"","currency_suffix":"CHF"},"price_html":"<span class=\"woocommerce-Price-amount amount\">249,00<span class=\"woocommerce-Price-currencySymbol\" dir=\"auto\">&#067;&#072;&#070;<\/span><\/span>","average_rating":"0","review_count":0,"images":[{"id":90348,"src":"https:\/\/www.bdfancomics.ch\/wp-content\/uploads\/2026\/08\/display-pokemon-me05-nuit-noire-36-boosters.webp","thumbnail":"https:\/\/www.bdfancomics.ch\/wp-content\/uploads\/2026\/08\/display-pokemon-me05-nuit-noire-36-boosters-500x500.webp","srcset":"https:\/\/www.bdfancomics.ch\/wp-content\/uploads\/2026\/08\/display-pokemon-me05-nuit-noire-36-boosters.webp 1000w, https:\/\/www.bdfancomics.ch\/wp-content\/uploads\/2026\/08\/display-pokemon-me05-nuit-noire-36-boosters-300x300.webp 300w, https:\/\/www.bdfancomics.ch\/wp-content\/uploads\/2026\/08\/display-pokemon-me05-nuit-noire-36-boosters-150x150.webp 150w, https:\/\/www.bdfancomics.ch\/wp-content\/uploads\/2026\/08\/display-pokemon-me05-nuit-noire-36-boosters-768x768.webp 768w, https:\/\/www.bdfancomics.ch\/wp-content\/uploads\/2026\/08\/display-pokemon-me05-nuit-noire-36-boosters-500x500.webp 500w, https:\/\/www.bdfancomics.ch\/wp-content\/uploads\/2026\/08\/display-pokemon-me05-nuit-noire-36-boosters-600x600.webp 600w, https:\/\/www.bdfancomics.ch\/wp-content\/uploads\/2026\/08\/display-pokemon-me05-nuit-noire-36-boosters-100x100.webp 100w, https:\/\/www.bdfancomics.ch\/wp-content\/uploads\/2026\/08\/display-pokemon-me05-nuit-noire-36-boosters-64x64.webp 64w","sizes":"(max-width: 1000px) 100vw, 1000px","thumbnail_srcset":"https:\/\/www.bdfancomics.ch\/wp-content\/uploads\/2026\/08\/display-pokemon-me05-nuit-noire-36-boosters-500x500.webp 500w, https:\/\/www.bdfancomics.ch\/wp-content\/uploads\/2026\/08\/display-pokemon-me05-nuit-noire-36-boosters-300x300.webp 300w, https:\/\/www.bdfancomics.ch\/wp-content\/uploads\/2026\/08\/display-pokemon-me05-nuit-noire-36-boosters-150x150.webp 150w, https:\/\/www.bdfancomics.ch\/wp-content\/uploads\/2026\/08\/display-pokemon-me05-nuit-noire-36-boosters-768x768.webp 768w, https:\/\/www.bdfancomics.ch\/wp-content\/uploads\/2026\/08\/display-pokemon-me05-nuit-noire-36-boosters-600x600.webp 600w, https:\/\/www.bdfancomics.ch\/wp-content\/uploads\/2026\/08\/display-pokemon-me05-nuit-noire-36-boosters-100x100.webp 100w, https:\/\/www.bdfancomics.ch\/wp-content\/uploads\/2026\/08\/display-pokemon-me05-nuit-noire-36-boosters-64x64.webp 64w, https:\/\/www.bdfancomics.ch\/wp-content\/uploads\/2026\/08\/display-pokemon-me05-nuit-noire-36-boosters.webp 1000w","thumbnail_sizes":"(max-width: 500px) 100vw, 500px","name":"display-pokemon-me05-nuit-noire-36-boosters","alt":"Display Pok\u00e9mon ME05 Nuit Noire contenant 36 boosters"}],"categories":[{"id":2630,"name":"Displays Pok\u00e9mon en Fran\u00e7ais","slug":"displays-pokemon-en-francais","link":"https:\/\/www.bdfancomics.ch\/categorie-produit\/cartes-a-collectionner\/pokemon-cartes\/cartes-pokemon-en-francais\/displays-pokemon-en-francais\/"}],"tags":[],"brands":[{"id":6477,"name":"The Pok\u00e9mon Company","slug":"the-pokemon-company","link":"https:\/\/www.bdfancomics.ch\/marque\/the-pokemon-company\/"}],"attributes":[{"id":11,"name":"Licence","taxonomy":"pa_licence","has_variations":false,"terms":[{"id":6680,"name":"Pok\u00e9mon","slug":"pokemon"}]},{"id":7,"name":"Langue","taxonomy":"pa_langue","has_variations":false,"terms":[{"id":5361,"name":"Fran\u00e7ais","slug":"francais"}]},{"id":37,"name":"Type de produit TCG","taxonomy":"pa_format-tcg","has_variations":false,"terms":[{"id":12060,"name":"Display","slug":"display"}]},{"id":38,"name":"Bloc Pok\u00e9mon","taxonomy":"pa_bloc-pokemon","has_variations":false,"terms":[{"id":12065,"name":"M\u00e9ga-\u00c9volution","slug":"mega-evolution"}]},{"id":39,"name":"Extension","taxonomy":"pa_extension","has_variations":false,"terms":[{"id":12080,"name":"Nuit Noire","slug":"nuit-noire"}]}],"variations":[],"grouped_products":[],"has_options":false,"is_purchasable":true,"is_in_stock":true,"is_on_backorder":false,"low_stock_remaining":null,"stock_availability":{"text":"En stock","class":"in-stock"},"sold_individually":false,"weight":"","dimensions":{"length":"","width":"","height":""},"formatted_weight":"ND","formatted_dimensions":"ND","add_to_cart":{"text":"Ajouter au panier","description":"Ajouter au panier\u00a0: &ldquo;Display Pok\u00e9mon ME05 Nuit Noire 36 Boosters&rdquo;","url":"\/wp-json\/wc\/store\/v1\/products?search=pokemon&#038;per_page=100&#038;orderby=date&#038;order=desc&#038;add-to-cart=89020","single_text":"Ajouter au panier","minimum":1,"maximum":6,"multiple_of":1},"is_password_protected":false,"extensions":{},"_links":{"self":[{"href":"https:\/\/www.bdfancomics.ch\/wp-json\/wc\/store\/v1\/products\/89020","targetHints":{"allow":["GET"]}}],"collection":[{"href":"https:\/\/www.bdfancomics.ch\/wp-json\/wc\/store\/v1\/products"}],"upsells":[{"embeddable":true,"href":"https:\/\/www.bdfancomics.ch\/wp-json\/wc\/store\/v1\/products?include=89035,89578,90441,89615"}],"cross_sells":[{"embeddable":true,"href":"https:\/\/www.bdfancomics.ch\/wp-json\/wc\/store\/v1\/products?include=90931,89434,89714,89183"}],"related":[{"embeddable":true,"href":"https:\/\/www.bdfancomics.ch\/wp-json\/wc\/store\/v1\/products?related=89020&per_page=10"}]}},{"id":89015,"name":"Display Pok\u00e9mon ME04 Chaos Ascendant 36 Boosters","slug":"display-chaos-ascendant-me04","parent":0,"type":"simple","variation":"","permalink":"https:\/\/www.bdfancomics.ch\/produit\/display-chaos-ascendant-me04\/","sku":"196214141063","short_description":"<p>Le <strong>Display Chaos Ascendant<\/strong> r\u00e9unit 36 boosters de l&rsquo;extension ME04 : 360 cartes et 36 \u00c9nergies de base.<\/p>\n<p>De quoi croiser M\u00e9ga-Floette-ex, M\u00e9ga-Amphinobi-ex et toute la bande d&rsquo;Illumis.<\/p>","description":"<h2>Display Chaos Ascendant : 36 boosters au c\u0153ur d&rsquo;Illumis<\/h2>\n<p>Chaos Ascendant, quatri\u00e8me extension du bloc M\u00e9ga-\u00c9volution, est arriv\u00e9e en fran\u00e7ais le 22 mai 2026. Le <strong>Display Chaos Ascendant<\/strong> contient 36 boosters de 10 cartes, chacun avec une \u00c9nergie de base. C&rsquo;est la bo\u00eete des grosses ouvertures, des decks complets et des classeurs qui se remplissent vite.<\/p>\n<h3>Floette, une fleur qui a travers\u00e9 3 000 ans<\/h3>\n<p>Dans Pok\u00e9mon X et Y, on d\u00e9couvre l&rsquo;histoire d&rsquo;AZ, un g\u00e9ant qui a v\u00e9cu il y a 3 000 ans \u00e0 Kalos. Son Floette, mort pendant une guerre, a \u00e9t\u00e9 ramen\u00e9 \u00e0 la vie par une machine terrible, et le Floette est devenu immortel, avec sa Fleur \u00c9ternelle. Pendant des ann\u00e9es, ce Floette est rest\u00e9 un Pok\u00e9mon que les joueurs ne pouvaient pas obtenir. Dans Chaos Ascendant, c&rsquo;est M\u00e9ga-Floette-ex qui s\u00e8me le trouble, et l&rsquo;histoire ajoute une vraie profondeur \u00e0 ce petit Pok\u00e9mon F\u00e9e.<\/p>\n<h3>Les h\u00e9ros de l&rsquo;extension<\/h3>\n<p>Pour lui tenir t\u00eate, M\u00e9ga-Amphinobi-ex prend la t\u00eate d&rsquo;une \u00e9quipe avec M\u00e9ga-N\u00e9m\u00e9lios-ex et M\u00e9ga-Kravarech-ex. Amphinobi, le ninja grenouille, compte parmi les Pok\u00e9mon les plus populaires de Kalos : pour beaucoup de fans, c&rsquo;est m\u00eame la vraie star du bloc. Avec 360 cartes \u00e0 ouvrir, on a de bonnes chances de croiser ces M\u00e9ga plusieurs fois, dans leurs diff\u00e9rentes versions.<\/p>\n<h3>Pourquoi un display plut\u00f4t que des boosters ?<\/h3>\n<p>Le prix au booster est plus doux, et la quantit\u00e9 permet de monter un deck jouable avec les Dresseurs en plusieurs exemplaires. Pour un collectionneur, 36 boosters sont aussi le meilleur moyen de r\u00e9duire la liste des cartes manquantes avant de passer aux \u00e9changes. Et les doubles font d&rsquo;excellentes monnaies d&rsquo;\u00e9change en tournoi ou entre amis.<\/p>\n<h3>Une bo\u00eete qui reste<\/h3>\n<p>Le display arrive scell\u00e9, avec son pr\u00e9sentoir illustr\u00e9. Gard\u00e9 intact, il trouve facilement sa place dans une vitrine. Ouvert, il sert ensuite \u00e0 ranger les boosters vides de ceux qui les collectionnent, car oui, \u00e7a existe.<\/p>\n<p>Tous les d\u00e9tails de l&rsquo;extension sont sur la page <a href=\"https:\/\/www.bdfancomics.ch\/extension\/chaos-ascendant\/\"><strong>Chaos Ascendant<\/strong><\/a>. Pour un format plus petit : l&rsquo;<a href=\"https:\/\/www.bdfancomics.ch\/produit\/etb-pokemon-chaos-ascendant-me04\/\"><strong>ETB Chaos Ascendant<\/strong><\/a> ou le <a href=\"https:\/\/www.bdfancomics.ch\/produit\/blister-pokemon-chaos-ascendant-me4\/\"><strong>booster blister Chaos Ascendant<\/strong><\/a>. Toutes nos bo\u00eetes de 36 sont r\u00e9unies dans les <a href=\"https:\/\/www.bdfancomics.ch\/categorie-produit\/cartes-a-collectionner\/pokemon-cartes\/cartes-pokemon-en-francais\/displays-pokemon-en-francais\/\"><strong>displays Pok\u00e9mon en fran\u00e7ais<\/strong><\/a>.<\/p>\n<h3>Caract\u00e9ristiques<\/h3>\n<p>Display M\u00e9ga-\u00c9volution \u2013 Chaos Ascendant (ME04), version fran\u00e7aise. Contenu : 36 boosters de 10 cartes + 1 \u00c9nergie de base. Sortie : 22 mai 2026. EAN : 196214141063.<\/p>\n<div class=\"category-seo-more\">\n<details>\n<summary style=\"cursor:pointer;color:#cc0000\"><strong><span style=\"color:#ffffff\">Lire plus<\/span><\/strong><\/summary>\n<p>Le Floette d&rsquo;AZ a attendu 3 000 ans pour retrouver son dresseur. Votre carte pr\u00e9f\u00e9r\u00e9e de l&rsquo;extension mettra s\u00fbrement moins de temps, mais rien ne garantit qu&rsquo;elle soit dans le premier booster.<\/p>\n<\/details>\n<\/div>","on_sale":false,"prices":{"price":"24900","regular_price":"24900","sale_price":"24900","price_range":null,"currency_code":"CHF","currency_symbol":"CHF","currency_minor_unit":2,"currency_decimal_separator":",","currency_thousand_separator":"","currency_prefix":"","currency_suffix":"CHF"},"price_html":"<span class=\"woocommerce-Price-amount amount\">249,00<span class=\"woocommerce-Price-currencySymbol\" dir=\"auto\">&#067;&#072;&#070;<\/span><\/span>","average_rating":"0","review_count":0,"images":[{"id":93663,"src":"https:\/\/www.bdfancomics.ch\/wp-content\/uploads\/2026\/08\/display-pokemon-me04-chaos-ascendant-36-boosters-nyon.webp","thumbnail":"https:\/\/www.bdfancomics.ch\/wp-content\/uploads\/2026\/08\/display-pokemon-me04-chaos-ascendant-36-boosters-nyon-500x500.webp","srcset":"https:\/\/www.bdfancomics.ch\/wp-content\/uploads\/2026\/08\/display-pokemon-me04-chaos-ascendant-36-boosters-nyon.webp 1200w, https:\/\/www.bdfancomics.ch\/wp-content\/uploads\/2026\/08\/display-pokemon-me04-chaos-ascendant-36-boosters-nyon-300x300.webp 300w, https:\/\/www.bdfancomics.ch\/wp-content\/uploads\/2026\/08\/display-pokemon-me04-chaos-ascendant-36-boosters-nyon-1024x1024.webp 1024w, https:\/\/www.bdfancomics.ch\/wp-content\/uploads\/2026\/08\/display-pokemon-me04-chaos-ascenda