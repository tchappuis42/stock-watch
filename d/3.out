cs.ch\/wp-content\/uploads\/2026\/08\/booster-blister-pokemon-me04-chaos-ascendant-nyon-64x64.webp 64w, https:\/\/www.bdfancomics.ch\/wp-content\/uploads\/2026\/08\/booster-blister-pokemon-me04-chaos-ascendant-nyon.webp 1200w","thumbnail_sizes":"(max-width: 500px) 100vw, 500px","name":"Booster Blister Pok\u00e9mon ME04 Chaos Ascendant","alt":"Booster Blister Pok\u00e9mon ME04 Chaos Ascendant \u2013 visuel du produit"}],"categories":[{"id":2626,"name":"Boosters Pok\u00e9mon en Fran\u00e7ais","slug":"boosters-pokemon-en-francais","link":"https:\/\/www.bdfancomics.ch\/categorie-produit\/cartes-a-collectionner\/pokemon-cartes\/cartes-pokemon-en-francais\/boosters-pokemon-en-francais\/"}],"tags":[],"brands":[{"id":6477,"name":"The Pok\u00e9mon Company","slug":"the-pokemon-company","link":"https:\/\/www.bdfancomics.ch\/marque\/the-pokemon-company\/"}],"attributes":[{"id":11,"name":"Licence","taxonomy":"pa_licence","has_variations":false,"terms":[{"id":6680,"name":"Pok\u00e9mon","slug":"pokemon"}]},{"id":7,"name":"Langue","taxonomy":"pa_langue","has_variations":false,"terms":[{"id":5361,"name":"Fran\u00e7ais","slug":"francais"}]},{"id":37,"name":"Type de produit TCG","taxonomy":"pa_format-tcg","has_variations":false,"terms":[{"id":12059,"name":"Booster","slug":"booster"}]},{"id":38,"name":"Bloc Pok\u00e9mon","taxonomy":"pa_bloc-pokemon","has_variations":false,"terms":[{"id":12065,"name":"M\u00e9ga-\u00c9volution","slug":"mega-evolution"}]},{"id":39,"name":"Extension","taxonomy":"pa_extension","has_variations":false,"terms":[{"id":12079,"name":"Chaos Ascendant","slug":"chaos-ascendant"}]}],"variations":[],"grouped_products":[],"has_options":false,"is_purchasable":true,"is_in_stock":true,"is_on_backorder":false,"low_stock_remaining":null,"stock_availability":{"text":"En stock","class":"in-stock"},"sold_individually":false,"weight":"","dimensions":{"length":"","width":"","height":""},"formatted_weight":"ND","formatted_dimensions":"ND","add_to_cart":{"text":"Ajouter au panier","description":"Ajouter au panier\u00a0: &ldquo;Booster Blister Pok\u00e9mon ME04 Chaos Ascendant&rdquo;","url":"\/wp-json\/wc\/store\/v1\/products?search=pokemon&#038;per_page=100&#038;orderby=date&#038;order=desc&#038;add-to-cart=88967","single_text":"Ajouter au panier","minimum":1,"maximum":37,"multiple_of":1},"is_password_protected":false,"extensions":{},"_links":{"self":[{"href":"https:\/\/www.bdfancomics.ch\/wp-json\/wc\/store\/v1\/products\/88967","targetHints":{"allow":["GET"]}}],"collection":[{"href":"https:\/\/www.bdfancomics.ch\/wp-json\/wc\/store\/v1\/products"}],"upsells":[{"embeddable":true,"href":"https:\/\/www.bdfancomics.ch\/wp-json\/wc\/store\/v1\/products?include=89015,89032,89578,89007"}],"cross_sells":[{"embeddable":true,"href":"https:\/\/www.bdfancomics.ch\/wp-json\/wc\/store\/v1\/products?include=89183,91139,91068,89434"}],"related":[{"embeddable":true,"href":"https:\/\/www.bdfancomics.ch\/wp-json\/wc\/store\/v1\/products?related=88967&per_page=10"}]}},{"id":89430,"name":"Tapis de Jeu Pok\u00e9mon Pikachu","slug":"tapis-de-jeu-pokemon-pikachu","parent":0,"type":"simple","variation":"","permalink":"https:\/\/www.bdfancomics.ch\/produit\/tapis-de-jeu-pokemon-pikachu\/","sku":"074427165420","short_description":"<p>Le <strong>Tapis Pikachu Ultra Pro<\/strong> mesure environ 61 \u00d7 34 cm. Sa surface textile prot\u00e8ge les cartes pendant le jeu et son dos caoutchouc antid\u00e9rapant \u00e9vite qu\u2019il se prom\u00e8ne sur la table.<\/p>","description":"<h2>Tapis Pikachu Ultra Pro : la table devient imm\u00e9diatement Pok\u00e9mon<\/h2>\n<p>Le <strong>Tapis Pikachu Ultra Pro<\/strong> offre une surface d\u2019environ <strong>61 \u00d7 34 cm<\/strong>, avec dessus textile doux et dos en caoutchouc antid\u00e9rapant.<\/p>\n<p>\u00c0 la base, il sert \u00e0 jouer aux cartes.<\/p>\n<p>Dans la pratique, il risque aussi de devenir le tapis sur lequel vous triez des cartes, ouvrez des boosters, prenez des photos et posez votre souris.<\/p>\n<h2>Une surface qui \u00e9vite de jouer directement sur la table<\/h2>\n<p>Le tissu r\u00e9duit les frottements et facilite la prise en main des cartes. Le dessous en caoutchouc maintient le tapis en place pendant les manipulations.<\/p>\n<p>C\u2019est particuli\u00e8rement agr\u00e9able lorsqu\u2019on doit soulever une carte sleeved sans commencer \u00e0 la pousser du bout de l\u2019ongle contre une table parfaitement plate.<\/p>\n<h2>Pikachu prend toute la place<\/h2>\n<p>Le visuel Pikachu transforme l\u2019accessoire en \u00e9l\u00e9ment de d\u00e9cor \u00e0 part enti\u00e8re. Et contrairement \u00e0 une figurine, personne ne pourra vous demander pourquoi elle occupe de la place sur le bureau.<\/p>\n<p>Le tapis est le bureau.<\/p>\n<p>Le dossier est clos.<\/p>\n<h2>Caract\u00e9ristiques<\/h2>\n<ul>\n<li><strong>Marque :<\/strong> Ultra PRO<\/li>\n<li><strong>Licence :<\/strong> Pok\u00e9mon<\/li>\n<li><strong>Personnage :<\/strong> Pikachu<\/li>\n<li><strong>Dimensions :<\/strong> environ 61 \u00d7 34 cm<\/li>\n<li><strong>Dessus :<\/strong> tissu doux<\/li>\n<li><strong>Dessous :<\/strong> caoutchouc antid\u00e9rapant<\/li>\n<li><strong>EAN :<\/strong> 074427165420<\/li>\n<\/ul>\n<p>Voir nos autres <a href=\"https:\/\/www.bdfancomics.ch\/categorie-produit\/cartes-a-collectionner\/accessoires-cartes\/tapis-gaming\/\">tapis gaming<\/a>.<\/p>\n<div class=\"seo-plus\" style=\"margin-top: 30px\">\n<details>\n<summary style=\"cursor: pointer;color: #cc0000;font-weight: 600\"><span style=\"color: #cc0000\">&#x25b6;\u00a0 Lire plus<\/span><\/summary>\n<p>Ultra PRO pr\u00e9cise qu\u2019un playmat peut aussi servir de grand tapis de souris. C\u2019est exact. Le probl\u00e8me est qu\u2019une fois Pikachu install\u00e9 sur le bureau, la souris n\u2019est plus forc\u00e9ment l\u2019objet qui attire le plus l\u2019attention.<\/p>\n<\/details>\n<\/div>","on_sale":true,"prices":{"price":"2490","regular_price":"2900","sale_price":"2490","price_range":null,"currency_code":"CHF","currency_symbol":"CHF","currency_minor_unit":2,"currency_decimal_separator":",","currency_thousand_separator":"","currency_prefix":"","currency_suffix":"CHF"},"price_html":"<span class=\"sale-price\"><del aria-hidden=\"true\"><span class=\"woocommerce-Price-amount amount\">29,00<span class=\"woocommerce-Price-currencySymbol\" dir=\"auto\">&#067;&#072;&#070;<\/span><\/span><\/del> <span class=\"screen-reader-text\">Le prix initial \u00e9tait\u00a0: 29,00&#067;&#072;&#070;.<\/span><ins aria-hidden=\"true\"><span class=\"woocommerce-Price-amount amount\">24,90<span class=\"woocommerce-Price-currencySymbol\" dir=\"auto\">&#067;&#072;&#070;<\/span><\/span><\/ins><span class=\"screen-reader-text\">Le prix actuel est\u00a0: 24,90&#067;&#072;&#070;.<\/span><\/span>","average_rating":"0","review_count":0,"images":[{"id":89856,"src":"https:\/\/www.bdfancomics.ch\/wp-content\/uploads\/2026\/08\/tapis-de-jeu-pokemon-officiel-ultra-pro-officiel-pikachu.webp","thumbnail":"https:\/\/www.bdfancomics.ch\/wp-content\/uploads\/2026\/08\/tapis-de-jeu-pokemon-officiel-ultra-pro-officiel-pikachu-500x500.webp","srcset":"https:\/\/www.bdfancomics.ch\/wp-content\/uploads\/2026\/08\/tapis-de-jeu-pokemon-officiel-ultra-pro-officiel-pikachu.webp 1200w, https:\/\/www.bdfancomics.ch\/wp-content\/uploads\/2026\/08\/tapis-de-jeu-pokemon-officiel-ultra-pro-officiel-pikachu-300x300.webp 300w, https:\/\/www.bdfancomics.ch\/wp-content\/uploads\/2026\/08\/tapis-de-jeu-pokemon-officiel-ultra-pro-officiel-pikachu-1024x1024.webp 1024w, https:\/\/www.bdfancomics.ch\/wp-content\/uploads\/2026\/08\/tapis-de-jeu-pokemon-officiel-ultra-pro-officiel-pikachu-150x150.webp 150w, https:\/\/www.bdfancomics.ch\/wp-content\/uploads\/2026\/08\/tapis-de-jeu-pokemon-officiel-ultra-pro-officiel-pikachu-768x768.webp 768w, https:\/\/www.bdfancomics.ch\/wp-content\/uploads\/2026\/08\/tapis-de-jeu-pokemon-officiel-ultra-pro-officiel-pikachu-500x500.webp 500w, https:\/\/www.bdfancomics.ch\/wp-content\/uploads\/2026\/08\/tapis-de-jeu-p