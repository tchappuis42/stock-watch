comics.ch\/wp-content\/uploads\/2026\/08\/coffret-pokemon-mega-zygarde-ex.jpg 1000w","thumbnail_sizes":"(max-width: 500px) 100vw, 500px","name":"Coffret Pok\u00e9mon M\u00e9ga-Zygarde Ex","alt":"Coffret Pok\u00e9mon M\u00e9ga-Zygarde Ex"}],"categories":[{"id":2628,"name":"Coffrets Pok\u00e9mon en Fran\u00e7ais","slug":"coffrets-pokemon-en-francais","link":"https:\/\/www.bdfancomics.ch\/categorie-produit\/cartes-a-collectionner\/pokemon-cartes\/cartes-pokemon-en-francais\/coffrets-pokemon-en-francais\/"}],"tags":[],"brands":[{"id":6477,"name":"The Pok\u00e9mon Company","slug":"the-pokemon-company","link":"https:\/\/www.bdfancomics.ch\/marque\/the-pokemon-company\/"}],"attributes":[{"id":11,"name":"Licence","taxonomy":"pa_licence","has_variations":false,"terms":[{"id":6680,"name":"Pok\u00e9mon","slug":"pokemon"}]},{"id":7,"name":"Langue","taxonomy":"pa_langue","has_variations":false,"terms":[{"id":5361,"name":"Fran\u00e7ais","slug":"francais"}]},{"id":37,"name":"Type de produit TCG","taxonomy":"pa_format-tcg","has_variations":false,"terms":[{"id":12052,"name":"Coffret","slug":"coffret"}]},{"id":38,"name":"Bloc Pok\u00e9mon","taxonomy":"pa_bloc-pokemon","has_variations":false,"terms":[{"id":12066,"name":"\u00c9carlate et Violet","slug":"ecarlate-et-violet"},{"id":12065,"name":"M\u00e9ga-\u00c9volution","slug":"mega-evolution"}]},{"id":39,"name":"Extension","taxonomy":"pa_extension","has_variations":false,"terms":[{"id":12082,"name":"\u00c9quilibre Parfait","slug":"equilibre-parfait"},{"id":12072,"name":"\u00c9volutions \u00e0 Paldea","slug":"evolutions-a-paldea"},{"id":12077,"name":"Flammes Fantasmagoriques","slug":"flammes-fantasmagoriques"}]}],"variations":[],"grouped_products":[],"has_options":false,"is_purchasable":true,"is_in_stock":true,"is_on_backorder":false,"low_stock_remaining":null,"stock_availability":{"text":"En stock","class":"in-stock"},"sold_individually":false,"weight":"","dimensions":{"length":"","width":"","height":""},"formatted_weight":"ND","formatted_dimensions":"ND","add_to_cart":{"text":"Ajouter au panier","description":"Ajouter au panier\u00a0: &ldquo;Coffret Pok\u00e9mon M\u00e9ga-Zygarde Ex&rdquo;","url":"\/wp-json\/wc\/store\/v1\/products?search=pokemon&#038;per_page=100&#038;orderby=date&#038;order=desc&#038;add-to-cart=89003","single_text":"Ajouter au panier","minimum":1,"maximum":3,"multiple_of":1},"is_password_protected":false,"extensions":{},"_links":{"self":[{"href":"https:\/\/www.bdfancomics.ch\/wp-json\/wc\/store\/v1\/products\/89003","targetHints":{"allow":["GET"]}}],"collection":[{"href":"https:\/\/www.bdfancomics.ch\/wp-json\/wc\/store\/v1\/products"}],"upsells":[{"embeddable":true,"href":"https:\/\/www.bdfancomics.ch\/wp-json\/wc\/store\/v1\/products?include=89021,73303,89034,88352"}],"cross_sells":[{"embeddable":true,"href":"https:\/\/www.bdfancomics.ch\/wp-json\/wc\/store\/v1\/products?include=89428,89183,91139,89714"}],"related":[{"embeddable":true,"href":"https:\/\/www.bdfancomics.ch\/wp-json\/wc\/store\/v1\/products?related=89003&per_page=10"}]}},{"id":89000,"name":"Coffret Pok\u00e9mon Collection Sp\u00e9ciale Amphinobi-ex et Hyporoi-ex","slug":"coffret-pokemon-mega-amphinobi-ex-et-hyporoi-ex","parent":0,"type":"simple","variation":"","permalink":"https:\/\/www.bdfancomics.ch\/produit\/coffret-pokemon-mega-amphinobi-ex-et-hyporoi-ex\/","sku":"196214129849","short_description":"<p>La <strong>Collection sp\u00e9ciale Amphinobi-ex et Hyporoi-ex<\/strong> contient une carte promo de chacun, une carte grand format d&rsquo;Amphinobi-ex et 8 boosters du JCC Pok\u00e9mon.<\/p>\n<p>Un ninja et un dragon des mers dans la m\u00eame bo\u00eete.<\/p>","description":"<h2>Collection sp\u00e9ciale Amphinobi-ex et Hyporoi-ex : le duo de l&rsquo;eau<\/h2>\n<p>La <strong>Collection sp\u00e9ciale Amphinobi-ex et Hyporoi-ex<\/strong> associe deux Pok\u00e9mon Eau venus de deux r\u00e9gions diff\u00e9rentes. Le nom sur la bo\u00eete est clair : il s&rsquo;agit d&rsquo;Amphinobi-ex, pas de sa forme M\u00e9ga, et d&rsquo;Hyporoi-ex.<\/p>\n<h3>Le contenu<\/h3>\n<p>Le coffret r\u00e9unit une carte promo d&rsquo;Amphinobi-ex, une carte promo d&rsquo;Hyporoi-ex, une carte grand format d&rsquo;Amphinobi-ex et 8 boosters du JCC Pok\u00e9mon. Sur la photo, on reconna\u00eet derri\u00e8re la fen\u00eatre plusieurs extensions de l&rsquo;\u00e8re \u00c9carlate et Violet, dont Couronne Stellaire.<\/p>\n<h3>Amphinobi, le ninja de Kalos<\/h3>\n<p>Dernier stade de Grenousse, le starter Eau de Pok\u00e9mon X et Y, Amphinobi lance des shurikens d&rsquo;eau compress\u00e9e. Dans la s\u00e9rie anim\u00e9e, celui de Sacha atteint une forme unique gr\u00e2ce \u00e0 leur lien. Depuis, il figure r\u00e9guli\u00e8rement dans les sondages de popularit\u00e9 des fans, souvent tout en haut.<\/p>\n<h3>Hyporoi, le roi des abysses<\/h3>\n<p>Hyporoi est un Pok\u00e9mon Eau et Dragon de Johto, apparu dans Pok\u00e9mon Or et Argent. Pour l&rsquo;obtenir, il fallait \u00e9changer un Hypoc\u00e9an tenant une \u00c9caille Draco, une m\u00e9thode qui a fait courir plus d&rsquo;un joueur derri\u00e8re un c\u00e2ble link. Pendant longtemps, il a \u00e9t\u00e9 l&rsquo;un des rares Dragons qui n&rsquo;avaient qu&rsquo;une seule faiblesse, ce qui le rendait redoutable en combat.<\/p>\n<h3>Pour qui ?<\/h3>\n<p>Pour les fans des Pok\u00e9mon Eau, pour ceux qui collectionnent toutes les cartes d&rsquo;Amphinobi, et pour les nostalgiques de la deuxi\u00e8me g\u00e9n\u00e9ration. Huit boosters, c&rsquo;est aussi 80 cartes \u00e0 d\u00e9couvrir, une belle s\u00e9ance d&rsquo;ouverture.<\/p>\n<p>Amphinobi a aussi sa forme M\u00e9ga dans la <a href=\"https:\/\/www.bdfancomics.ch\/produit\/coffret-pokemon-premium-mega-amphinobi-ex-8-boosters\/\"><strong>Collection Premium M\u00e9ga-Amphinobi-ex<\/strong><\/a>. Les boosters de Couronne Stellaire sont pr\u00e9sent\u00e9s sur la page <a href=\"https:\/\/www.bdfancomics.ch\/extension\/couronne-stellaire\/\"><strong>Couronne Stellaire<\/strong><\/a>. Encore plus de choix parmi les <a href=\"https:\/\/www.bdfancomics.ch\/categorie-produit\/cartes-a-collectionner\/pokemon-cartes\/cartes-pokemon-en-francais\/coffrets-pokemon-en-francais\/\"><strong>coffrets Pok\u00e9mon en fran\u00e7ais<\/strong><\/a>.<\/p>\n<h3>Caract\u00e9ristiques<\/h3>\n<p>Collection sp\u00e9ciale Amphinobi-ex et Hyporoi-ex, version fran\u00e7aise. Contenu : 1 carte promo Amphinobi-ex, 1 carte promo Hyporoi-ex, 1 carte grand format Amphinobi-ex, 8 boosters du JCC Pok\u00e9mon. EAN : 196214129849.<\/p>\n<div class=\"category-seo-more\">\n<details>\n<summary style=\"cursor:pointer;color:#cc0000\"><strong><span style=\"color:#ffffff\">Lire plus<\/span><\/strong><\/summary>\n<p>En 1999, obtenir Hyporoi demandait un ami, deux Game Boy et un c\u00e2ble. Aujourd&rsquo;hui, il suffit de passer \u00e0 la boutique. On appelle \u00e7a le progr\u00e8s.<\/p>\n<\/details>\n<\/div>","on_sale":false,"prices":{"price":"7900","regular_price":"7900","sale_price":"7900","price_range":null,"currency_code":"CHF","currency_symbol":"CHF","currency_minor_unit":2,"currency_decimal_separator":",","currency_thousand_separator":"","currency_prefix":"","currency_suffix":"CHF"},"price_html":"<span class=\"woocommerce-Price-amount amount\">79,00<span class=\"woocommerce-Price-currencySymbol\" dir=\"auto\">&#067;&#072;&#070;<\/span><\/span>","average_rating":"0","review_count":0,"images":[{"id":91013,"src":"https:\/\/www.bdfancomics.ch\/wp-content\/uploads\/2026\/08\/coffret-pokemon-mega-amphinobi-ex-et-hyporoi-ex.webp","thumbnail":"https:\/\/www.bdfancomics.ch\/wp-content\/uploads\/2026\/08\/coffret-pokemon-mega-amphinobi-ex-et-hyporoi-ex-500x500.webp","srcset":"https:\/\/www.bdfancomics.ch\/wp-content\/uploads\/2026\/08\/coffret-pokemon-mega-amphinobi-ex-et-hyporoi-ex.webp 800w, https:\/\/www.bdfancomics.ch\/wp-content\/uploads\/2026\/08\/coffret-pokemon-mega-amphinobi-ex-et-hyporoi-ex-300x300.webp 300w, https:\/\/www.bdfancomics.ch\/wp-content\/uploads\/2026\/08\/coffret-pokemon-mega-amphinobi-e