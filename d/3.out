ncais\/coffrets-pokemon-en-francais\/"}],"tags":[],"brands":[{"id":6477,"name":"The Pok\u00e9mon Company","slug":"the-pokemon-company","link":"https:\/\/www.bdfancomics.ch\/marque\/the-pokemon-company\/"}],"attributes":[{"id":11,"name":"Licence","taxonomy":"pa_licence","has_variations":false,"terms":[{"id":6680,"name":"Pok\u00e9mon","slug":"pokemon"}]},{"id":7,"name":"Langue","taxonomy":"pa_langue","has_variations":false,"terms":[{"id":5361,"name":"Fran\u00e7ais","slug":"francais"}]},{"id":37,"name":"Type de produit TCG","taxonomy":"pa_format-tcg","has_variations":false,"terms":[{"id":12052,"name":"Coffret","slug":"coffret"}]},{"id":38,"name":"Bloc Pok\u00e9mon","taxonomy":"pa_bloc-pokemon","has_variations":false,"terms":[{"id":12067,"name":"\u00c9p\u00e9e et Bouclier","slug":"epee-et-bouclier"}]},{"id":39,"name":"Extension","taxonomy":"pa_extension","has_variations":false,"terms":[{"id":12078,"name":"C\u00e9l\u00e9brations","slug":"celebrations"},{"id":12084,"name":"R\u00e8gne de Glace","slug":"regne-de-glace"},{"id":12085,"name":"Styles de Combat","slug":"styles-de-combat"}]}],"variations":[],"grouped_products":[],"has_options":false,"is_purchasable":true,"is_in_stock":true,"is_on_backorder":false,"low_stock_remaining":1,"stock_availability":{"text":"Plus que 1 en stock","class":"in-stock"},"sold_individually":false,"weight":"","dimensions":{"length":"","width":"","height":""},"formatted_weight":"ND","formatted_dimensions":"ND","add_to_cart":{"text":"Ajouter au panier","description":"Ajouter au panier\u00a0: &ldquo;Coffret Pok\u00e9mon Ultra Premium Collection 25 Ans&rdquo;","url":"\/wp-json\/wc\/store\/v1\/products?search=pokemon&#038;per_page=100&#038;orderby=date&#038;order=desc&#038;add-to-cart=89009","single_text":"Ajouter au panier","minimum":1,"maximum":1,"multiple_of":1},"is_password_protected":false,"extensions":{},"_links":{"self":[{"href":"https:\/\/www.bdfancomics.ch\/wp-json\/wc\/store\/v1\/products\/89009","targetHints":{"allow":["GET"]}}],"collection":[{"href":"https:\/\/www.bdfancomics.ch\/wp-json\/wc\/store\/v1\/products"}],"upsells":[{"embeddable":true,"href":"https:\/\/www.bdfancomics.ch\/wp-json\/wc\/store\/v1\/products?include=37546,25096,91086,55438"}],"cross_sells":[{"embeddable":true,"href":"https:\/\/www.bdfancomics.ch\/wp-json\/wc\/store\/v1\/products?include=89428,89183,91139,89714"}],"related":[{"embeddable":true,"href":"https:\/\/www.bdfancomics.ch\/wp-json\/wc\/store\/v1\/products?related=89009&per_page=10"}]}},{"id":89007,"name":"Coffret Pok\u00e9mon Premium M\u00e9ga-Amphinobi Ex 8 Boosters","slug":"coffret-pokemon-premium-mega-amphinobi-ex-8-boosters","parent":0,"type":"simple","variation":"","permalink":"https:\/\/www.bdfancomics.ch\/produit\/coffret-pokemon-premium-mega-amphinobi-ex-8-boosters\/","sku":"196214141964","short_description":"<p>La <strong>Collection Premium M\u00e9ga-Amphinobi-ex<\/strong> contient une carte promo brillante de M\u00e9ga-Amphinobi-ex, sa version grand format lenticulaire, un autocollant r\u00e9ajustable et 8 boosters du JCC Pok\u00e9mon.<\/p>\n<p>Le ninja pr\u00e9f\u00e9r\u00e9 des fans, dans sa forme la plus puissante.<\/p>","description":"<h2>Collection Premium M\u00e9ga-Amphinobi-ex : le ninja passe \u00e0 la vitesse M\u00e9ga<\/h2>\n<p>Amphinobi est l&rsquo;un des Pok\u00e9mon les plus populaires de Kalos, et sa M\u00e9ga-\u00c9volution \u00e9tait attendue depuis longtemps. La <strong>Collection Premium M\u00e9ga-Amphinobi-ex<\/strong> lui consacre un coffret complet, sorti au 3e trimestre 2026, avec deux cartes promo et huit boosters.<\/p>\n<h3>Le contenu officiel<\/h3>\n<p>Le coffret contient une carte promo brillante de M\u00e9ga-Amphinobi-ex pour le jeu, une carte promo grand format lenticulaire du m\u00eame Pok\u00e9mon, un autocollant r\u00e9ajustable \u00e0 son effigie et 8 boosters du JCC Pok\u00e9mon. Sur notre exemplaire, on reconna\u00eet \u00e0 travers la fen\u00eatre des boosters de plusieurs extensions du bloc M\u00e9ga-\u00c9volution.<\/p>\n<h3>Une carte pens\u00e9e pour frapper<\/h3>\n<p>Le talent Shuriken Mortel de M\u00e9ga-Amphinobi-ex permet de d\u00e9fausser une \u00c9nergie Eau de base de sa main pour placer six marqueurs de d\u00e9g\u00e2ts sur un Pok\u00e9mon adverse. Son attaque H\u00e9lice Ninja peut ensuite infliger jusqu&rsquo;\u00e0 200 d\u00e9g\u00e2ts. Une combinaison qui plaira aux joueurs qui aiment pr\u00e9parer le terrain avant de frapper fort.<\/p>\n<h3>Amphinobi, une star de l&rsquo;anime<\/h3>\n<p>Dans la s\u00e9rie XY, le Amphinobi de Sacha obtient une forme unique, l&rsquo;Amphinobi-Sacha, gr\u00e2ce au lien tr\u00e8s fort entre le Pok\u00e9mon et son dresseur. Cette forme a marqu\u00e9 toute une g\u00e9n\u00e9ration de fans, et elle explique en partie pourquoi Amphinobi reste si populaire. Le petit d\u00e9tail qui pla\u00eet : son \u00e9charpe est en r\u00e9alit\u00e9 sa langue.<\/p>\n<h3>Le reste du coffret<\/h3>\n<p>La carte lenticulaire change d&rsquo;image selon l&rsquo;angle, parfaite pour une vitrine. L&rsquo;autocollant r\u00e9ajustable se d\u00e9colle et se recolle sans laisser de traces : sur un classeur, une bo\u00eete de deck ou un ordinateur. Huit boosters, enfin, c&rsquo;est 80 cartes \u00e0 ouvrir, une bonne s\u00e9ance pour une soir\u00e9e.<\/p>\n<p>Amphinobi est aussi la vedette de l&rsquo;extension <a href=\"https:\/\/www.bdfancomics.ch\/extension\/chaos-ascendant\/\"><strong>Chaos Ascendant<\/strong><\/a>. Pour une autre version du ninja, voir le <a href=\"https:\/\/www.bdfancomics.ch\/produit\/coffret-pokemon-mega-amphinobi-ex-et-hyporoi-ex\/\"><strong>coffret Amphinobi-ex et Hyporoi-ex<\/strong><\/a>, ou le grand <a href=\"https:\/\/www.bdfancomics.ch\/produit\/coffret-pokemon-ultra-premium-amphinobi-ex\/\"><strong>Ultra-Premium Amphinobi-ex<\/strong><\/a>. Envie de comparer ? Notre s\u00e9lection compl\u00e8te vous attend dans les <a href=\"https:\/\/www.bdfancomics.ch\/categorie-produit\/cartes-a-collectionner\/pokemon-cartes\/cartes-pokemon-en-francais\/coffrets-pokemon-en-francais\/\"><strong>coffrets Pok\u00e9mon en fran\u00e7ais<\/strong><\/a>.<\/p>\n<h3>Caract\u00e9ristiques<\/h3>\n<p>Collection Premium M\u00e9ga-Amphinobi-ex, version fran\u00e7aise. Contenu : 1 carte promo brillante M\u00e9ga-Amphinobi-ex, 1 carte grand format lenticulaire, 1 autocollant r\u00e9ajustable, 8 boosters du JCC Pok\u00e9mon. Sortie : 3e trimestre 2026. EAN : 196214141964.<\/p>\n<div class=\"category-seo-more\">\n<details>\n<summary style=\"cursor:pointer;color:#cc0000\"><strong><span style=\"color:#ffffff\">Lire plus<\/span><\/strong><\/summary>\n<p>Un ninja est cens\u00e9 \u00eatre discret. Avec une carte lenticulaire grand format et un autocollant \u00e0 son effigie, Amphinobi a visiblement d\u00e9cid\u00e9 de laisser tomber cette r\u00e8gle.<\/p>\n<\/details>\n<\/div>","on_sale":false,"prices":{"price":"5900","regular_price":"5900","sale_price":"5900","price_range":null,"currency_code":"CHF","currency_symbol":"CHF","currency_minor_unit":2,"currency_decimal_separator":",","currency_thousand_separator":"","currency_prefix":"","currency_suffix":"CHF"},"price_html":"<span class=\"woocommerce-Price-amount amount\">59,00<span class=\"woocommerce-Price-currencySymbol\" dir=\"auto\">&#067;&#072;&#070;<\/span><\/span>","average_rating":"0","review_count":0,"images":[{"id":89712,"src":"https:\/\/www.bdfancomics.ch\/wp-content\/uploads\/2026\/08\/coffret-pokemon-premium-mega-amphinobi-ex-8-boosters.webp","thumbnail":"https:\/\/www.bdfancomics.ch\/wp-content\/uploads\/2026\/08\/coffret-pokemon-premium-mega-amphinobi-ex-8-boosters-500x500.webp","srcset":"https:\/\/www.bdfancomics.ch\/wp-content\/uploads\/2026\/08\/coffret-pokemon-premium-mega-amphinobi-ex-8-boosters.webp 800w, https:\/\/www.bdfancomics.ch\/wp-content\/uploads\/2026\/08\/coffret-pokemon-premium-mega-amphinobi-ex-8-boosters-500x500.webp 500w, https:\/\/www.bdfancomics.ch\/wp-content\/uploads\/2026\/08\/coffret-pokemon-premium-mega-amphinobi-ex-8-boosters-100x100.webp 100w, https