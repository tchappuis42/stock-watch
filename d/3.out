apuce-2-nyon-1024x1024.webp 1024w, https:\/\/www.bdfancomics.ch\/wp-content\/uploads\/2026\/10\/figurine-pokemon-carapuce-2-nyon-150x150.webp 150w, https:\/\/www.bdfancomics.ch\/wp-content\/uploads\/2026\/10\/figurine-pokemon-carapuce-2-nyon-768x768.webp 768w, https:\/\/www.bdfancomics.ch\/wp-content\/uploads\/2026\/10\/figurine-pokemon-carapuce-2-nyon-500x500.webp 500w, https:\/\/www.bdfancomics.ch\/wp-content\/uploads\/2026\/10\/figurine-pokemon-carapuce-2-nyon-600x600.webp 600w, https:\/\/www.bdfancomics.ch\/wp-content\/uploads\/2026\/10\/figurine-pokemon-carapuce-2-nyon-100x100.webp 100w, https:\/\/www.bdfancomics.ch\/wp-content\/uploads\/2026\/10\/figurine-pokemon-carapuce-2-nyon-64x64.webp 64w","sizes":"(max-width: 1200px) 100vw, 1200px","thumbnail_srcset":"https:\/\/www.bdfancomics.ch\/wp-content\/uploads\/2026\/10\/figurine-pokemon-carapuce-2-nyon-500x500.webp 500w, https:\/\/www.bdfancomics.ch\/wp-content\/uploads\/2026\/10\/figurine-pokemon-carapuce-2-nyon-300x300.webp 300w, https:\/\/www.bdfancomics.ch\/wp-content\/uploads\/2026\/10\/figurine-pokemon-carapuce-2-nyon-1024x1024.webp 1024w, https:\/\/www.bdfancomics.ch\/wp-content\/uploads\/2026\/10\/figurine-pokemon-carapuce-2-nyon-150x150.webp 150w, https:\/\/www.bdfancomics.ch\/wp-content\/uploads\/2026\/10\/figurine-pokemon-carapuce-2-nyon-768x768.webp 768w, https:\/\/www.bdfancomics.ch\/wp-content\/uploads\/2026\/10\/figurine-pokemon-carapuce-2-nyon-600x600.webp 600w, https:\/\/www.bdfancomics.ch\/wp-content\/uploads\/2026\/10\/figurine-pokemon-carapuce-2-nyon-100x100.webp 100w, https:\/\/www.bdfancomics.ch\/wp-content\/uploads\/2026\/10\/figurine-pokemon-carapuce-2-nyon-64x64.webp 64w, https:\/\/www.bdfancomics.ch\/wp-content\/uploads\/2026\/10\/figurine-pokemon-carapuce-2-nyon.webp 1200w","thumbnail_sizes":"(max-width: 500px) 100vw, 500px","name":"Figurine Pok\u00e9mon Carapuce (bo\u00eete)","alt":"Figurine Pok\u00e9mon Carapuce dans sa bo\u00eete"}],"categories":[{"id":3873,"name":"Figurines Pok\u00e9mon","slug":"figurines-pokemon","link":"https:\/\/www.bdfancomics.ch\/categorie-produit\/figurines\/figurines-mangas\/figurines-pokemon\/"}],"tags":[],"brands":[{"id":6477,"name":"The Pok\u00e9mon Company","slug":"the-pokemon-company","link":"https:\/\/www.bdfancomics.ch\/marque\/the-pokemon-company\/"}],"attributes":[{"id":11,"name":"Licence","taxonomy":"pa_licence","has_variations":false,"terms":[{"id":6680,"name":"Pok\u00e9mon","slug":"pokemon"}]},{"id":12,"name":"Univers \/ M\u00e9dia","taxonomy":"pa_univers-media","has_variations":false,"terms":[{"id":6682,"name":"Anime","slug":"anime"}]},{"id":13,"name":"Personnage","taxonomy":"pa_personnage","has_variations":false,"terms":[{"id":11585,"name":"Carapuce","slug":"carapuce"}]},{"id":41,"name":"Fabricant","taxonomy":"pa_fabricant","has_variations":false,"terms":[{"id":12206,"name":"Funism","slug":"funism"}]},{"id":3,"name":"Taille","taxonomy":"pa_taille","has_variations":false,"terms":[{"id":12164,"name":"Moins de 15 cm","slug":"moins-de-15-cm"}]}],"variations":[],"grouped_products":[],"has_options":false,"is_purchasable":true,"is_in_stock":true,"is_on_backorder":false,"low_stock_remaining":null,"stock_availability":{"text":"En stock","class":"in-stock"},"sold_individually":false,"weight":"","dimensions":{"length":"","width":"","height":""},"formatted_weight":"ND","formatted_dimensions":"ND","add_to_cart":{"text":"Ajouter au panier","description":"Ajouter au panier\u00a0: &ldquo;Figurine Pok\u00e9mon Carapuce&rdquo;","url":"\/wp-json\/wc\/store\/v1\/products?search=pokemon&#038;per_page=100&#038;orderby=date&#038;order=desc&#038;add-to-cart=89113","single_text":"Ajouter au panier","minimum":1,"maximum":6,"multiple_of":1},"is_password_protected":false,"extensions":{},"_links":{"self":[{"href":"https:\/\/www.bdfancomics.ch\/wp-json\/wc\/store\/v1\/products\/89113","targetHints":{"allow":["GET"]}}],"collection":[{"href":"https:\/\/www.bdfancomics.ch\/wp-json\/wc\/store\/v1\/products"}],"upsells":[{"embeddable":true,"href":"https:\/\/www.bdfancomics.ch\/wp-json\/wc\/store\/v1\/products?include=89465,78164,89578,76404"}],"cross_sells":[{"embeddable":true,"href":"https:\/\/www.bdfancomics.ch\/wp-json\/wc\/store\/v1\/products?include=89130,89120,89111,44935"}],"related":[{"embeddable":true,"href":"https:\/\/www.bdfancomics.ch\/wp-json\/wc\/store\/v1\/products?related=89113&per_page=10"}]}},{"id":89112,"name":"Figurine Pok\u00e9mon Bulbizarre Saison","slug":"figurine-pokemon-bulbizarre-saison","parent":0,"type":"simple","variation":"","permalink":"https:\/\/www.bdfancomics.ch\/produit\/figurine-pokemon-bulbizarre-saison\/","sku":"6923517312937","short_description":"<p>Les pattes pos\u00e9es sur une feuille de n\u00e9nuphar, des fleurs mauves tout autour : la <strong>figurine Pok\u00e9mon Bulbizarre Saison<\/strong> de Langbowang installe le premier Pok\u00e9mon du Pok\u00e9dex au bord d&rsquo;une mare tranquille. Une petite sc\u00e8ne paisible sign\u00e9e Langbowang, pour les amoureux des Pok\u00e9mon calmes.<\/p>","description":"<h2>Figurine Pok\u00e9mon Bulbizarre Saison : une sieste au bord de la mare<\/h2>\n<p>Ici, pas de lianes, pas d&rsquo;attaque. Cette <strong>figurine Pok\u00e9mon Bulbizarre Saison<\/strong> le montre pos\u00e9 sur une grande feuille de n\u00e9nuphar, au milieu d&rsquo;une petite mare bleue bord\u00e9e de fleurs violettes. Le bulbe sur le dos, l&rsquo;air paisible, il semble simplement profiter du soleil.<\/p>\n<h3>La s\u00e9rie Nature Adventure de Langbowang<\/h3>\n<p>Dans cette gamme de Langbowang, le d\u00e9cor compte autant que le personnage. Chaque figurine est un petit diorama complet, avec son sol, sa v\u00e9g\u00e9tation et son \u00e9l\u00e9ment d&rsquo;eau ou de prairie. Pour Bulbizarre, le choix de la mare est logique : un Pok\u00e9mon Plante a besoin d&rsquo;eau et de lumi\u00e8re.<\/p>\n<p>Le n\u00e9nuphar, l&rsquo;eau et les fleurs sont peints avec des couleurs douces qui font penser \u00e0 un jardin japonais au d\u00e9but de l&rsquo;\u00e9t\u00e9.<\/p>\n<h3>Le bulbe qui prend le soleil<\/h3>\n<p>Le Pok\u00e9dex explique que Bulbizarre porte depuis sa naissance une graine sur le dos, qui grandit en absorbant les rayons du soleil. Ce n&rsquo;est donc pas un hasard si la figurine le montre en plein air, face \u00e0 la lumi\u00e8re : il recharge ses batteries.<\/p>\n<p>Num\u00e9ro 0001 du Pok\u00e9dex national, il reste le symbole de tous les d\u00e9buts dans Pok\u00e9mon, et l&rsquo;un des starters pr\u00e9f\u00e9r\u00e9s de ceux qui aiment les Pok\u00e9mon calmes et fid\u00e8les plut\u00f4t que les dragons spectaculaires.<\/p>\n<h3>Deux Bulbizarre, deux humeurs<\/h3>\n<p>Le contraste est amusant avec la <a href=\"https:\/\/www.bdfancomics.ch\/produit\/figurine-pokemon-bulbizarre\/\"><strong>figurine Bulbizarre Prime Figure Mini<\/strong><\/a> de Funism, qui le montre en plein Fouet Lianes. C\u00f4te \u00e0 c\u00f4te, on a le Bulbizarre du dimanche et celui du jour de combat. Dans la m\u00eame s\u00e9rie Nature Adventure, la <a href=\"https:\/\/www.bdfancomics.ch\/produit\/figurine-pokemon-ramoloss-saison\/\"><strong>figurine Ramoloss Saison<\/strong><\/a> prolonge l&rsquo;ambiance aquatique et paresseuse.<\/p>\n<p>Ce diorama trouve sa place sur un bureau, une table de chevet ou dans une vitrine consacr\u00e9e aux Pok\u00e9mon Plante. Il pla\u00eet aussi beaucoup en cadeau, notamment \u00e0 ceux qui ont choisi Bulbizarre comme premier Pok\u00e9mon.<\/p>\n<p>La composition fonctionne aussi bien de face que de c\u00f4t\u00e9 : de profil, on voit le n\u00e9nuphar flotter au-dessus de l&rsquo;eau et les fleurs pousser sur la berge, ce qui donne une vraie profondeur \u00e0 ce d\u00e9cor miniature. C&rsquo;est la preuve qu&rsquo;un petit format peut \u00eatre soign\u00e9 quand le fabricant prend le temps de travailler le d\u00e9cor autant que le Pok\u00e9mon.<\/p>\n<p>Les couleurs, tr\u00e8s douces, en font une figurine facile \u00e0 int\u00e9grer dans une chambre ou un salon, m\u00eame pour ceux qui ne veulent pas d&rsquo;une d\u00e9coration trop \u00ab geek \u00bb.<\/p>\n<h3>Caract\u00e9ristiques<\/h3>\n<p><strong>Fabricant :<\/strong> Langbowang \u00b7 <strong>Gamme :<\/strong> Nature Adventure (Saison) \u00b7 <strong>Personnage :<\/strong> Bulbizarre (n\u00b0 0001) \u00b7 <strong>Mati\u00e8re :<\/strong> PVC \u00b7 <strong>Pr\u00e9sentation :<\/strong> bo\u00eete \u00b7 <strong>EAN :<\/strong> 6923517312937<\/p>\n<p>Pour le nettoyer, un pinceau souple passe facilement entre les fleurs.<\/p>\n<div class=\"category-seo-more\">\n<details>\n<summary style=\"cursor:pointer;color:#cc0000\"><strong><span style=\"color:#ffffff\">Lire plus<\/span><\/strong><\/summary>\n<p>Le Pok\u00e9dex dit que sa graine pousse au soleil. Si votre Bulbizarre a l&rsquo;air un peu fatigu\u00e9, essayez la fen\u00eatre plut\u00f4t que l&rsquo;arrosoir.<\/p>\n<\/details>\n<\/div>","on_sale":false,"prices":{"price":"2900","regular_price":"2900","sale_price":"2900","price_range":null,"currency_code":"CHF","currency_symbol":"CHF","currency_minor_unit":2,"currency_decimal_separator":",","currency_thousand_separator":"","currency_prefix":"","currency_suffix":"CHF"},"price_html":"<span class=\"woocommerce-Price-amount amount\">29,00<span class=\"woocommerce-Price-currencySymbol\" dir=\"auto\">&#067;&#072;&#070;<\/span><\/span>","average_rating":"0","review_count":0,"images":[{"id":93769,"src":"https:\/\/www.bdfancomics.ch\/wp-content\/uploads\/2026\/10\/figurine-pokemon-bulbizarre-saison-nyon.webp","thumbnail":"https:\/\/www.bdfancomics.ch\/wp-content\/uploads\/2026\/10\/figurine-pokemon-bulbizarre-saison-nyon-500x500.webp","srcset":"https:\/\/www.bdfancomics.ch\/wp-content\/uploads\/2026\/10\/figurine-pokemon-bulbizarre-saison-nyon.webp 1200w, https:\/\/www.bdfancomics.ch\/wp-content\/uploads\/2026\/10\/figurine-pokemon-bulbizarre-saison-nyon-300x300.webp 300w, https:\/\/www.bdfancomics.ch\/wp-content\/uploads\/2026\/10\/figurine-pokemon-bulbizarre-saison-nyon-1024x1024.webp 1024w, https:\/\/www.bdfancomics.ch\/wp-content\/uploads\/2026\/10\/figurine-pokemon-bulbizarre-saison-nyon-150x150.webp 150w, https:\/\/www.bdfancomics.ch\/wp-content\/uploads\/2026\/10\/figurine-pokemon-bulbizarre-saison-nyon-768x768.webp 768w, https:\/\/www.bdfancomics.ch\/wp-content\/uploads\/2026\/10\/figurine-pokemon-bulbizarre-saison-nyon-500x500.webp 500w, https:\/\/www.bdfancomics.ch\/wp-content\/uploads\/2026\/10\/figurine-pokemon-bulbizarre-saison-nyon-600x600.webp 600w, https:\/\/www.bdfancomics.ch\/wp-content\/uploads\/2026\/10\/figurine-pokemon-bulbizarre-saison-nyon-100x100.webp 100w, https:\/\/www.bdfancomics.ch\/wp-content\/uploads\/2026\/10\/figurine-pokemon-bulbizarre-saison-nyon-64x64.webp 64w","sizes":"(max-width: 1200px) 100vw, 1200px","thumbnail_srcset":"https:\/\/www.bdfancomics.ch\/wp-content\/uploads\/2026\/10\/figurine-pokemon-bulbizarre-saison-nyon-500x500.webp 500w, https:\/\/www.bdfancomics.ch\/wp-content\/uploads\/2026\/10\/figurine-pokemon-bulbizarre-saison-nyon-300x300.webp 300w, https:\/\/www.bdfancomics.ch\/wp-content\/uploads\/2026\/10\/figurine-pokemon-bulbizarre-saison-nyon-1024x1024.webp 1024w, https:\/\/www.bdfancomics.ch\/wp-content\/uploads\/2026\/10\/figurine-pokemon-bulbizarre-saison-nyon-150x150.webp 150w, https:\/\/www.bdfancomics.ch\/wp-content\/uploads\/2026\/10\/figurine-pokemon-bulbizarre-saison-nyon-768x768.webp 768w, https:\/\/www.bdfancomics.ch\/wp-content\/uploads\/2026\/10\/figurine-pokemon-bulbizarre-saison-nyon-600x600.webp 600w, https:\/\/www.bdfancomics.ch\/wp-content\/uploads\/2026\/10\/figurine-pokemon-bulbizarre-saison-nyon-100x100.webp 100w, https:\/\/www.bdfancomics.ch\/wp-content\/uploads\/2026\/10\/figurine-pokemon-bulbizarre-saison-nyon-64x64.webp 64w, https:\/\/www.bdfancomics.ch\/wp-content\/uploads\/2026\/10\/figurine-pokemon-bulbizarre-saison-nyon.webp 1200w","thumbnail_sizes":"(max-width: 500px) 100vw, 500px","name":"Figurine Pok\u00e9mon Bulbizarre Saison","alt":"Figurine Pok\u00e9mon Bulbizarre Saison"}],"categories":[{"id":3873,"name":"Figurines Pok\u00e9mon","slug":"figurines-pokemon","link":"https:\/\/www.bdfancomics.ch\/categorie-produit\/figurines\/figurines-mangas\/figurines-pokemon\/"}],"tags":[],"brands":[{"id":6477,"name":"The Pok\u00e9mon Company","slug":"the-pokemon-company","link":"https:\/\/www.bdfancomics.ch\/marque\/the-pokemon-company\/"}],"attributes":[{"id":11,"name":"Licence","taxonomy":"pa_licence","has_variations":false,"terms":[{"id":6680,"name":"Pok\u00e9mon","slug":"pokemon"}]},{"id":13,"name":"Personnage","taxonomy":"pa_personnage","has_variations":false,"terms":[{"id":6683,"name":"Bulbizarre","slug":"bulbizarre"}]},{"id":12,"name":"Univers \/ M\u00e9dia","taxonomy":"pa_univers-media","has_variations":false,"terms":[{"id":6682,"name":"Anime","slug":"anime"}]},{"id":41,"name":"Fabricant","taxonomy":"pa_fabricant","has_variations":false,"terms":[{"id":12215,"name":"Langbowang","slug":"langbowang"}]},{"id":3,"name":"Taille","taxonomy":"pa_taille","has_variations":false,"terms":[{"id":12164,"name":"Moins de 15 cm","slug":"moins-de-15-cm"}]}],"variations":[],"grouped_products":[],"has_options":false,"is_purchasable":true,"is_in_stock":true,"is_on_backorder":false,"low_stock_remaining":null,"stock_availability":{"text":"En stock","class":"in-stock"},"sold_individually":false,"weight":"","dimensions":{"length":"","width":"","height":""},"formatted_weight":"ND","formatted_dimensions":"ND","add_to_cart":{"text":"Ajouter au panier","description":"Ajouter au panier\u00a0: &ldquo;Figurine Pok\u00e9mon Bulbizarre Saison&rdquo;","url":"\/wp-json\/wc\/store\/v1\/products?search=pokemon&#038;per_page=100&#038;orderby=date&#038;order=desc&#038;add-to-cart=89112","single_text":"Ajouter au panier","minimum":1,"maximum":4,"multiple_of":1},"is_password_protected":false,"extensions":{},"_links":{"self":[{"href":"https:\/\/www.bdfancomics.ch\/wp-json\/wc\/store\/v1\/products\/89112","targetHints":{"allow":["GET"]}}],"collection":[{"href":"https:\/\/www.bdfancomics.ch\/wp-json\/wc\/store\/v1\/products"}],"upsells":[{"embeddable":true,"href":"https:\/\/www.bdfancomics.ch\/wp-json\/wc\/store\/v1\/products?include=89465,78164,89578,76404"}],"cross_sells":[{"embeddable":true,"href":"https:\/\/www.bdfancomics.ch\/wp-json\/wc\/store\/v1\/products?include=89130,89120,89111,44935"}],"related":[{"embeddable":true,"href":"https:\/\/www.bdfancomics.ch\/wp-json\/wc\/store\/v1\/products?related=89112&per_page=10"}]}},{"id":89111,"name":"Figurine Pok\u00e9mon Bulbizarre","slug":"figurine-pokemon-bulbizarre","parent":0,"type":"simple","variation":"","permalink":"https:\/\/www.bdfancomics.ch\/produit\/figurine-pokemon-bulbizarre\/","sku":"6971680458167","short_description":"<p>La <strong>figurine Bulbizarre<\/strong> de la gamme Funism Prime Figure Mini met le n\u00b0001 du Pok\u00e9dex en pose sur un socle orn\u00e9 d&rsquo;effets transparents. Environ 10 cm de PVC sous licence officielle Pok\u00e9mon.<\/p>\n<p>Le premier choix de bien des dresseurs, le bulbe en prime, et un vrai clin d&rsquo;\u0153il aux d\u00e9buts de Pok\u00e9mon Rouge et Bleu.<\/p>","description":"<h2>Figurine Bulbizarre Funism : le n\u00b0001 du Pok\u00e9dex, version Prime Figure Mini<\/h2>\n<p>Avant Pikachu, avant les M\u00e9ga-\u00c9volutions, il y avait un num\u00e9ro 001. La <strong>figurine Bulbizarre<\/strong> de Funism rend hommage au tout premier Pok\u00e9mon du Pok\u00e9dex national, celui qui ouvrait la liste dans Pok\u00e9mon Rouge et Bleu et que beaucoup ont choisi sans h\u00e9siter \u00e0 Bourg Palette.<\/p>\n<h3>Le starter qu&rsquo;on sous-estime toujours<\/h3>\n<p>Plante et Poison, Bulbizarre a longtemps port\u00e9 l&rsquo;\u00e9tiquette du \u00ab choix facile \u00bb face \u00e0 Salam\u00e8che et Carapuce. Les joueurs qui l&rsquo;ont pris le savent : ses premiers combats contre Pierre et Ondine se passent nettement mieux qu&rsquo;avec les deux autres. Une petite revanche discr\u00e8te, \u00e0 l&rsquo;image du Pok\u00e9mon.<\/p>\n<p>La figurine reprend sa silhouette trapue et son bulbe bien vert, celui qui grandit en absorbant la lumi\u00e8re du soleil.<\/p>\n<h3>Ce que propose la gamme Prime Figure Mini<\/h3>\n<p>Funism con\u00e7oit sa gamme Prime Figure Mini comme de petites statues d&rsquo;exposition : un Pok\u00e9mon en pose, un socle rond et un effet transparent qui donne du mouvement \u00e0 la sc\u00e8ne. Pour Bulbizarre, ces effets accompagnent la figurine sur sa base, o\u00f9 figurent son nom anglais, Bulbasaur, et son nom chinois.<\/p>\n<p>Le format, environ 10 cm, se glisse partout : sur un bureau, \u00e0 c\u00f4t\u00e9 d&rsquo;un \u00e9cran ou au milieu d&rsquo;une \u00e9tag\u00e8re de mangas.<\/p>\n<h3>Une figurine \u00e0 associer<\/h3>\n<p>Bulbizarre ne voyage jamais tr\u00e8s loin de ses deux camarades de d\u00e9part. La <a href=\"https:\/\/www.bdfancomics.ch\/produit\/figurine-pokemon-salameche\/\"><strong>figurine Salam\u00e8che de la m\u00eame gamme<\/strong><\/a> permet de reconstituer le duo, et Carapuce compl\u00e8te le trio de Kanto dans la m\u00eame collection.<\/p>\n<p>Pour une version plus bucolique, la <a href=\"https:\/\/www.bdfancomics.ch\/produit\/figurine-pokemon-bulbizarre-saison\/\"><strong>figurine Bulbizarre Saison<\/strong><\/a> le montre dans un petit d\u00e9cor de mare et de fleurs.<\/p>\n<h3>De Bulbizarre \u00e0 Florizarre<\/h3>\n<p>Bulbizarre \u00e9volue en Herbizarre au niveau 16, puis en Florizarre au niveau 32, et son bulbe finit par s&rsquo;ouvrir en une \u00e9norme fleur. Les joueurs de Pok\u00e9mon Jaune se souviennent qu&rsquo;on pouvait l&rsquo;obtenir gratuitement \u00e0 Azuria, \u00e0 condition que Pikachu soit suffisamment attach\u00e9 \u00e0 son dresseur.<\/p>\n<p>Ceux qui veulent voir la forme finale en action trouveront la <a href=\"https:\/\/www.bdfancomics.ch\/produit\/figurine-pokemon-attaque-florizarre\/\"><strong>figurine Florizarre Attaque<\/strong><\/a> dans le rayon : de quoi poser le d\u00e9but et la fin de la lign\u00e9e c\u00f4te \u00e0 c\u00f4te.<\/p>\n<h3>Une pose pleine de malice<\/h3>\n<p>Funism a choisi un Bulbizarre souriant, la bouche grande ouverte, avec deux lianes qui sortent de son bulbe et s&rsquo;enroulent de chaque c\u00f4t\u00e9. Des feuilles vertes translucides l&rsquo;encadrent sur un socle vert pomme : on pense imm\u00e9diatement \u00e0 un Fouet Lianes lanc\u00e9 juste avant la photo.<\/p>\n<h3>Caract\u00e9ristiques<\/h3>\n<p>Fabricant : Funism. Gamme : Prime Figure Mini. Mati\u00e8re : PVC. Hauteur : environ 10 cm. Licence officielle Pok\u00e9mon. EAN : 6971680458167.<\/p>\n<div class=\"category-seo-more\">\n<details>\n<summary style=\"cursor:pointer;color:#cc0000\"><strong><span style=\"color:#ffffff\">Lire plus<\/span><\/strong><\/summary>\n<p>Dans la s\u00e9rie anim\u00e9e, le Bulbizarre de Sacha refuse obstin\u00e9ment d&rsquo;\u00e9voluer. Celui-ci ne vous demandera pas votre avis non plus : il restera Bulbizarre sur l&rsquo;\u00e9tag\u00e8re, bulbe compris, et c&rsquo;est tr\u00e8s bien comme \u00e7a.<\/p>\n<\/details>\n<\/div>","on_sale":false,"prices":{"price":"2900","regular_price":"2900","sale_price":"2900","price_range":null,"currency_code":"CHF","currency_symbol":"CHF","currency_minor_unit":2,"currency_decimal_separator":",","currency_thousand_separator":"","currency_prefix":"","currency_suffix":"CHF"},"price_html":"<span class=\"woocommerce-Price-amount amount\">29,00<span class=\"woocommerce-Price-currencySymbol\" dir=\"auto\">&#067;&#072;&#070;<\/span><\/span>","average_rating":"0","review_count":0,"images":[{"id":93767,"src":"https:\/\/www.bdfancomics.ch\/wp-content\/uploads\/2026\/10\/figurine-pokemon-bulbizarre-nyon.webp","thumbnail":"https:\/\/www.bdfancomics.ch\/wp-content\/uploads\/2026\/10\/figurine-pokemon-bulbizarre-nyon-500x500.webp","srcset":"https:\/\/www.bdfancomics.ch\/wp-content\/uploads\/2026\/10\/figurine-pokemon-bulbizarre-nyon.webp 1200w, https:\/\/www.bdfancomics.ch\/wp-content\/uploads\/2026\/10\/figurine-pokemon-bulbizarre-nyon-300x300.webp 300w, https:\/\/www.bdfancomics.ch