0\/figurine-pokemon-evoli-et-evolutions-mirroirs-nyon-500x500.webp 500w, https:\/\/www.bdfancomics.ch\/wp-content\/uploads\/2026\/10\/figurine-pokemon-evoli-et-evolutions-mirroirs-nyon-300x300.webp 300w, https:\/\/www.bdfancomics.ch\/wp-content\/uploads\/2026\/10\/figurine-pokemon-evoli-et-evolutions-mirroirs-nyon-1024x1024.webp 1024w, https:\/\/www.bdfancomics.ch\/wp-content\/uploads\/2026\/10\/figurine-pokemon-evoli-et-evolutions-mirroirs-nyon-150x150.webp 150w, https:\/\/www.bdfancomics.ch\/wp-content\/uploads\/2026\/10\/figurine-pokemon-evoli-et-evolutions-mirroirs-nyon-768x768.webp 768w, https:\/\/www.bdfancomics.ch\/wp-content\/uploads\/2026\/10\/figurine-pokemon-evoli-et-evolutions-mirroirs-nyon-600x600.webp 600w, https:\/\/www.bdfancomics.ch\/wp-content\/uploads\/2026\/10\/figurine-pokemon-evoli-et-evolutions-mirroirs-nyon-100x100.webp 100w, https:\/\/www.bdfancomics.ch\/wp-content\/uploads\/2026\/10\/figurine-pokemon-evoli-et-evolutions-mirroirs-nyon-64x64.webp 64w, https:\/\/www.bdfancomics.ch\/wp-content\/uploads\/2026\/10\/figurine-pokemon-evoli-et-evolutions-mirroirs-nyon.webp 1200w","thumbnail_sizes":"(max-width: 500px) 100vw, 500px","name":"Bo\u00eete myst\u00e8re Pok\u00e9mon \u00c9voli et \u00e9volutions Let&rsquo;s Go! \u00c9voli","alt":"Bo\u00eete myst\u00e8re Funism Pok\u00e9mon Let's Go! \u00c9voli"}],"categories":[{"id":3873,"name":"Figurines Pok\u00e9mon","slug":"figurines-pokemon","link":"https:\/\/www.bdfancomics.ch\/categorie-produit\/figurines\/figurines-mangas\/figurines-pokemon\/"}],"tags":[],"brands":[{"id":6477,"name":"The Pok\u00e9mon Company","slug":"the-pokemon-company","link":"https:\/\/www.bdfancomics.ch\/marque\/the-pokemon-company\/"}],"attributes":[{"id":11,"name":"Licence","taxonomy":"pa_licence","has_variations":false,"terms":[{"id":6680,"name":"Pok\u00e9mon","slug":"pokemon"}]},{"id":13,"name":"Personnage","taxonomy":"pa_personnage","has_variations":false,"terms":[{"id":6735,"name":"\u00c9voli","slug":"evoli"}]},{"id":12,"name":"Univers \/ M\u00e9dia","taxonomy":"pa_univers-media","has_variations":false,"terms":[{"id":6682,"name":"Anime","slug":"anime"}]},{"id":41,"name":"Fabricant","taxonomy":"pa_fabricant","has_variations":false,"terms":[{"id":12206,"name":"Funism","slug":"funism"}]},{"id":3,"name":"Taille","taxonomy":"pa_taille","has_variations":false,"terms":[{"id":12164,"name":"Moins de 15 cm","slug":"moins-de-15-cm"}]}],"variations":[],"grouped_products":[],"has_options":false,"is_purchasable":true,"is_in_stock":true,"is_on_backorder":false,"low_stock_remaining":1,"stock_availability":{"text":"Plus que 1 en stock","class":"in-stock"},"sold_individually":false,"weight":"","dimensions":{"length":"","width":"","height":""},"formatted_weight":"ND","formatted_dimensions":"ND","add_to_cart":{"text":"Ajouter au panier","description":"Ajouter au panier\u00a0: &ldquo;Figurine Pok\u00e9mon \u00c9voli et \u00e9volutions \u2013 Bo\u00eete myst\u00e8re Let&rsquo;s Go! \u00c9voli&rdquo;","url":"\/wp-json\/wc\/store\/v1\/products?search=pokemon&#038;per_page=100&#038;orderby=date&#038;order=desc&#038;add-to-cart=89118","single_text":"Ajouter au panier","minimum":1,"maximum":1,"multiple_of":1},"is_password_protected":false,"extensions":{},"_links":{"self":[{"href":"https:\/\/www.bdfancomics.ch\/wp-json\/wc\/store\/v1\/products\/89118","targetHints":{"allow":["GET"]}}],"collection":[{"href":"https:\/\/www.bdfancomics.ch\/wp-json\/wc\/store\/v1\/products"}],"upsells":[{"embeddable":true,"href":"https:\/\/www.bdfancomics.ch\/wp-json\/wc\/store\/v1\/products?include=89465,78164,89578,76404"}],"cross_sells":[{"embeddable":true,"href":"https:\/\/www.bdfancomics.ch\/wp-json\/wc\/store\/v1\/products?include=89130,89120,89111,44935"}],"related":[{"embeddable":true,"href":"https:\/\/www.bdfancomics.ch\/wp-json\/wc\/store\/v1\/products?related=89118&per_page=10"}]}},{"id":89117,"name":"Figurine Pok\u00e9mon Dracolosse Attaque","slug":"figurine-pokemon-dracoloss-attaque","parent":0,"type":"simple","variation":"","permalink":"https:\/\/www.bdfancomics.ch\/produit\/figurine-pokemon-dracoloss-attaque\/","sku":"6923517303911","short_description":"<p>Ailes ouvertes, port\u00e9 par un nuage et encadr\u00e9 d&rsquo;\u00e9clairs jaunes : la <strong>figurine Pok\u00e9mon Dracolosse Attaque<\/strong> de Langbowang montre le grand dragon orange de Kanto en plein vol de combat. Une sc\u00e8ne a\u00e9rienne sous licence officielle, livr\u00e9e dans sa bo\u00eete.<\/p>","description":"<h2>Figurine Pok\u00e9mon Dracolosse Attaque : le gentil g\u00e9ant passe \u00e0 l&rsquo;offensive<\/h2>\n<p>On le conna\u00eet plut\u00f4t souriant, presque bonhomme. Cette <strong>figurine Pok\u00e9mon Dracolosse Attaque<\/strong> montre l&rsquo;autre facette du dragon : le corps tendu, les petites ailes d\u00e9ploy\u00e9es, il fonce au-dessus d&rsquo;un nuage blanc tandis que des \u00e9clairs jaunes translucides cr\u00e9pitent autour de lui.<\/p>\n<h3>Le dragon qui fait le tour du monde<\/h3>\n<p>Num\u00e9ro 0149 du Pok\u00e9dex, Dracolosse est de type Dragon et Vol. C&rsquo;est l&rsquo;\u00e9volution finale de Minidraco, puis de Draco, une lign\u00e9e rare qu&rsquo;on trouvait dans Pok\u00e9mon Rouge et Bleu au Parc Safari ou en p\u00eachant avec une Super Canne. Le Pok\u00e9dex affirme qu&rsquo;il peut faire le tour du monde en seize heures, et qu&rsquo;il guide les navires perdus vers la c\u00f4te.<\/p>\n<p>Dans les jeux, il est l&#8217;embl\u00e8me de Peter, le ma\u00eetre des dragons du Conseil 4. Avec Ultralaser et Fatal-Foudre, les dresseurs ont appris \u00e0 ne jamais sous-estimer ce colosse aux airs de peluche.<\/p>\n<h3>La s\u00e9rie Battle Moment de Langbowang<\/h3>\n<p>Dans cette collection officielle, chaque Pok\u00e9mon re\u00e7oit le d\u00e9cor qui convient \u00e0 son combat. Pour Dracolosse, le d\u00e9cor est a\u00e9rien : un nuage blanc sculpt\u00e9 en guise de socle, qui donne \u00e0 la figurine une vraie impression de vol. Les \u00e9clairs jaunes, en plastique transparent, entourent le dragon et renforcent la sensation de vitesse.<\/p>\n<p>Le jaune orang\u00e9 de la peau, le ventre cr\u00e8me et les ailes vert d&rsquo;eau sont fid\u00e8les au design d&rsquo;origine, avec ses petites antennes sur le front.<\/p>\n<h3>Avec quels Pok\u00e9mon l&rsquo;exposer ?<\/h3>\n<p>Il forme un duo naturel avec la <a href=\"https:\/\/www.bdfancomics.ch\/produit\/figurine-pokemon-dracaufeu-attaque\/\"><strong>figurine Dracaufeu Attaque<\/strong><\/a> : deux Pok\u00e9mon volants orange de Kanto, deux fa\u00e7ons tr\u00e8s diff\u00e9rentes de faire peur. Pour une vitrine de dragons, la <a href=\"https:\/\/www.bdfancomics.ch\/produit\/figurine-pokemon-leviator\/\"><strong>figurine L\u00e9viator<\/strong><\/a> compl\u00e8te bien la sc\u00e8ne, m\u00eame si elle n&rsquo;est pas vraiment un dragon au sens du Pok\u00e9dex.<\/p>\n<p>Dracolosse fonctionne aussi seul, sur un bureau, comme une figurine-souvenir de toutes ces aventures o\u00f9 il a fini par porter l&rsquo;\u00e9quipe \u00e0 lui seul.<\/p>\n<p>La sculpture \u00e9vite le pi\u00e8ge du Dracolosse trop rond : le cou est tendu, la queue se prolonge vers l&rsquo;arri\u00e8re et les bras courts sont repli\u00e9s comme pour fendre l&rsquo;air. Le r\u00e9sultat a plus d&rsquo;\u00e9lan que la plupart des figurines de ce Pok\u00e9mon, souvent repr\u00e9sent\u00e9 assis et souriant.<\/p>\n<p>Un bon choix aussi pour un cadeau : Dracolosse est de ces Pok\u00e9mon que tout le monde trouve sympathique, m\u00eame sans conna\u00eetre la licence.<\/p>\n<h3>Caract\u00e9ristiques<\/h3>\n<p><strong>Fabricant :<\/strong> Langbowang \u00b7 <strong>Gamme :<\/strong> Battle Moment (Attaque) \u00b7 <strong>Personnage :<\/strong> Dracolosse (n\u00b0 0149) \u00b7 <strong>Mati\u00e8re :<\/strong> PVC \u00b7 <strong>Pr\u00e9sentation :<\/strong> bo\u00eete \u00b7 <strong>EAN :<\/strong> 6923517303911<\/p>\n<p>Figurine-diorama statique sous licence officielle. Les \u00e9clairs transparents sont d\u00e9licats : on la d\u00e9place par le nuage.<\/p>\n<div class=\"category-seo-more\">\n<details>\n<summary style=\"cursor:pointer;color:#cc0000\"><strong><span style=\"color:#ffffff\">Lire plus<\/span><\/strong><\/summary>\n<p>Seize heures pour faire le tour du monde, d&rsquo;apr\u00e8s le Pok\u00e9dex. Il lui faudra un peu moins pour faire le tour de votre \u00e9tag\u00e8re, mais il n&rsquo;est pas press\u00e9.<\/p>\n<\/details>\n<\/div>","on_sale":false,"prices":{"price":"3900","regular_price":"3900","sale_price":"3900","price_range":null,"currency_code":"CHF","currency_symbol":"CHF","currency_minor_unit":2,"currency_decimal_separator":",","currency_thousand_separator":"","currency_prefix":"","currency_suffix":"CHF"},"price_html":"<span class=\"woocommerce-Price-amount amount\">39,00<span class=\"woocommerce-Price-currencySymbol\" dir=\"auto\">&#067;&#072;&#070;<\/span><\/span>","average_rating":"0","review_count":0,"images":[{"id":93774,"src":"https:\/\/www.bdfancomics.ch\/wp-content\/uploads\/2026\/10\/figurine-pokemon-dracoloss-attaque-nyon.webp","thumbnail":"https:\/\/www.bdfancomics.ch\/wp-content\/uploads\/2026\/10\/figurine-pokemon-dracoloss-attaque-nyon-500x500.webp","srcset":"https:\/\/www.bdfancomics.ch\/wp-content\/uploads\/2026\/10\/figurine-pokemon-dracoloss-attaque-nyon.webp 1200w, https:\/\/www.bdfancomics.ch\/wp-content\/uploads\/2026\/10\/figurine-pokemon-dracoloss-attaque-nyon-300x300.webp 300w, https:\/\/www.bdfancomics.ch\/wp-content\/uploads\/2026\/10\/figurine-pokemon-dracoloss-attaque-nyon-1024x1024.webp 1024w, https:\/\/www.bdfancomics.ch\/wp-content\/uploads\/2026\/10\/figurine-pokemon-dracoloss-attaque-nyon-150x150.webp 150w, https:\/\/www.bdfancomics.ch\/wp-content\/uploads\/2026\/10\/figurine-pokemon-dracoloss-attaque-nyon-768x768.webp 768w, https:\/\/www.bdfancomics.ch\/wp-content\/uploads\/2026\/10\/figurine-pokemon-dracoloss-attaque-nyon-500x500.webp 500w, https:\/\/www.bdfancomics.ch\/wp-content\/uploads\/2026\/10\/figurine-pokemon-dracoloss-attaque-nyon-600x600.webp 600w, https:\/\/www.bdfancomics.ch\/wp-content\/uploads\/2026\/10\/figurine-pokemon-dracoloss-attaque-nyon-100x100.webp 100w, https:\/\/www.bdfancomics.ch\/wp-content\/uploads\/2026\/10\/figurine-pokemon-dracoloss-attaque-nyon-64x64.webp 64w","sizes":"(max-width: 1200px) 100vw, 1200px","thumbnail_srcset":"https:\/\/www.bdfancomics.ch\/wp-content\/uploads\/2026\/10\/figurine-pokemon-dracoloss-attaque-nyon-500x500.webp 500w, https:\/\/www.bdfancomics.ch\/wp-content\/uploads\/2026\/10\/figurine-pokemon-dracoloss-attaque-nyon-300x300.webp 300w, https:\/\/www.bdfancomics.ch\/wp-content\/uploads\/2026\/10\/figurine-pokemon-dracoloss-attaque-nyon-1024x1024.webp 1024w, https:\/\/www.bdfancomics.ch\/wp-content\/uploads\/2026\/10\/figurine-pokemon-dracoloss-attaque-nyon-150x150.webp 150w, https:\/\/www.bdfancomics.ch\/wp-content\/uploads\/2026\/10\/figurine-pokemon-dracoloss-attaque-nyon-768x768.webp 768w, https:\/\/www.bdfancomics.ch\/wp-content\/uploads\/2026\/10\/figurine-pokemon-dracoloss-attaque-nyon-600x600.webp 600w, https:\/\/www.bdfancomics.ch\/wp-content\/uploads\/2026\/10\/figurine-pokemon-dracoloss-attaque-nyon-100x100.webp 100w, https:\/\/www.bdfancomics.ch\/wp-content\/uploads\/2026\/10\/figurine-pokemon-dracoloss-attaque-nyon-64x64.webp 64w, https:\/\/www.bdfancomics.ch\/wp-content\/uploads\/2026\/10\/figurine-pokemon-dracoloss-attaque-nyon.webp 1200w","thumbnail_sizes":"(max-width: 500px) 100vw, 500px","name":"Figurine Pok\u00e9mon Dracolosse Attaque","alt":"Figurine Pok\u00e9mon Dracolosse Attaque"}],"categories":[{"id":3873,"name":"Figurines Pok\u00e9mon","slug":"figurines-pokemon","link":"https:\/\/www.bdfancomics.ch\/categorie-produit\/figurines\/figurines-mangas\/figurines-pokemon\/"}],"tags":[],"brands":[{"id":6477,"name":"The Pok\u00e9mon Company","slug":"the-pokemon-company","link":"https:\/\/www.bdfancomics.ch\/marque\/the-pokemon-company\/"}],"attributes":[{"id":11,"name":"Licence","taxonomy":"pa_licence","has_variations":false,"terms":[{"id":6680,"name":"Pok\u00e9mon","slug":"pokemon"}]},{"id":12,"name":"Univers \/ M\u00e9dia","taxonomy":"pa_univers-media","has_variations":false,"terms":[{"id":6682,"name":"Anime","slug":"anime"}]},{"id":13,"name":"Personnage","taxonomy":"pa_personnage","has_variations":false,"terms":[{"id":12216,"name":"Dracolosse","slug":"dracolosse"}]},{"id":41,"name":"Fabricant","taxonomy":"pa_fabricant","has_variations":false,"terms":[{"id":12215,"name":"Langbowang","slug":"langbowang"}]},{"id":3,"name":"Taille","taxonomy":"pa_taille","has_variations":false,"terms":[{"id":12164,"name":"Moins de 15 cm","slug":"moins-de-15-cm"}]}],"variations":[],"grouped_products":[],"has_options":false,"is_purchasable":true,"is_in_stock":true,"is_on_backorder":false,"low_stock_remaining":null,"stock_availability":{"text":"En stock","class":"in-stock"},"sold_individually":false,"weight":"","dimensions":{"length":"","width":"","height":""},"formatted_weight":"ND","formatted_dimensions":"ND","add_to_cart":{"text":"Ajouter au panier","description":"Ajouter au panier\u00a0: &ldquo;Figurine Pok\u00e9mon Dracolosse Attaque&rdquo;","url":"\/wp-json\/wc\/store\/v1\/products?search=pokemon&#038;per_page=100&#038;orderby=date&#038;order=desc&#038;add-to-cart=89117","single_text":"Ajouter au panier","minimum":1,"maximum":5,"multiple_of":1},"is_password_protected":false,"extensions":{},"_links":{"self":[{"href":"https:\/\/www.bdfancomics.ch\/wp-json\/wc\/store\/v1\/products\/89117","targetHints":{"allow":["GET"]}}],"collection":[{"href":"https:\/\/www.bdfancomics.ch\/wp-json\/wc\/store\/v1\/products"}],"upsells":[{"embeddable":true,"href":"https:\/\/www.bdfancomics.ch\/wp-json\/wc\/store\/v1\/products?include=89465,78164,76404,59926"}],"cross_sells":[{"embeddable":true,"href":"https:\/\/www.bdfancomics.ch\/wp-json\/wc\/store\/v1\/products?include=89130,89120,89111,44935"}],"related":[{"embeddable":true,"href":"https:\/\/www.bdfancomics.ch\/wp-json\/wc\/store\/v1\/products?related=89117&per_page=10"}]}},{"id":89116,"name":"Figurine Pok\u00e9mon Dracaufeu Attaque","slug":"figurine-pokemon-dracaufeu-attaque","parent":0,"type":"simple","variation":"","permalink":"https:\/\/www.bdfancomics.ch\/produit\/figurine-pokemon-dracaufeu-attaque\/","sku":"6923517303904","short_description":"<p>Ailes grandes ouvertes, boule de feu en pr\u00e9paration et sol de lave sous les pattes : la <strong>figurine Pok\u00e9mon Dracaufeu Attaque<\/strong> de Langbowang fige le dragon de Kanto au c\u0153ur d&rsquo;un brasier. Pour les fans du starter Feu, c&rsquo;est la version la plus enflamm\u00e9e du rayon.<\/p>","description":"<h2>Figurine Pok\u00e9mon Dracaufeu Attaque : le brasier de Kanto<\/h2>\n<p>Si un seul Pok\u00e9mon devait repr\u00e9senter la licence aupr\u00e8s des collectionneurs, ce serait sans doute lui. Cette <strong>figurine Pok\u00e9mon Dracaufeu Attaque<\/strong> le montre ailes d\u00e9ploy\u00e9es, la gueule ouverte, une boule de feu translucide entre les pattes, debout sur un sol de roche volcanique d&rsquo;o\u00f9 montent des flammes.<\/p>\n<h3>Le dragon qui n&rsquo;est pas un dragon<\/h3>\n<p>Num\u00e9ro 0006 du Pok\u00e9dex, Dracaufeu est l&rsquo;\u00e9volution finale de Salam\u00e8che, apr\u00e8s Reptincel. Malgr\u00e9 son allure, il est de type Feu et Vol, pas Dragon, un d\u00e9tail qui fait encore d\u00e9bat chez les fans. Le Pok\u00e9dex raconte que son feu devient plus intense apr\u00e8s un combat difficile, et qu&rsquo;il ne s&rsquo;en prend jamais \u00e0 un adversaire plus faible que lui.<\/p>\n<p>Mascotte de Pok\u00e9mon Rouge, il est aussi devenu une l\u00e9gende du jeu de cartes : sa carte holographique du Set de Base reste l&rsquo;une des plus recherch\u00e9es au monde. Dans l&rsquo;anime, celui de Sacha a longtemps refus\u00e9 de lui ob\u00e9ir, avant de devenir l&rsquo;un de ses plus fid\u00e8les alli\u00e9s.<\/p>\n<h3>La s\u00e9rie Battle Moment de Langbowang<\/h3>\n<p>Langbowang a r\u00e9serv\u00e9 \u00e0 Dracaufeu le d\u00e9cor le plus spectaculaire de la s\u00e9rie. Pour lui, tout est question de feu : le socle de roche craquel\u00e9e, les flammes rouges et orange qui en sortent et la boule de feu, travaill\u00e9e en plastique transparent, qui donne de la lumi\u00e8re \u00e0 l&rsquo;ensemble.<\/p>\n<p>Les ailes, avec leur int\u00e9rieur bleu-vert, prennent beaucoup de place et donnent de l&rsquo;envergure \u00e0 la figurine. La queue enflamm\u00e9e se recourbe sur le c\u00f4t\u00e9, comme il se doit.<\/p>\n<h3>De la flamm\u00e8che au brasier<\/h3>\n<p>Pour suivre toute l&rsquo;\u00e9volution, la <a href=\"https:\/\/www.bdfancomics.ch\/produit\/figurine-pokemon-salameche\/\"><strong>figurine Salam\u00e8che Prime Figure Mini<\/strong><\/a> montre le point de d\u00e9part. Et pour voir Dracaufeu dans une ambiance plus complice, la <a href=\"https:\/\/www.bdfancomics.ch\/produit\/figurine-funism-pikachu-et-dracaufeu\/\"><strong>figurine Funism Pikachu et Dracaufeu<\/strong><\/a> le r\u00e9unit avec la mascotte de la licence dans une grande sc\u00e8ne de combat.<\/p>\n<p>C\u00f4t\u00e9 s\u00e9rie Attaque, il forme avec Tortank et Florizarre le trio des \u00e9volutions finales de Kanto. Trois figurines, un seul dilemme r\u00e9gl\u00e9 une bonne fois pour toutes.<\/p>\n<p>Le travail sur les couleurs m\u00e9rite un mot : le d\u00e9grad\u00e9 du rouge au jaune dans les flammes du socle r\u00e9pond \u00e0 la boule de feu centrale, ce qui cr\u00e9e une vraie unit\u00e9 visuelle. Sous un \u00e9clairage chaud, le diorama prend presque des airs de volcan miniature.<\/p>\n<h3>Caract\u00e9ristiques<\/h3>\n<p><strong>Fabricant :<\/strong> Langbowang \u00b7 <strong>Gamme :<\/strong> Battle Moment (Attaque) \u00b7 <strong>Personnage :<\/strong> Dracaufeu (n\u00b0 0006) \u00b7 <strong>Mati\u00e8re :<\/strong> PVC \u00b7 <strong>Pr\u00e9sentation :<\/strong> bo\u00eete \u00b7 <strong>EAN :<\/strong> 6923517303904<\/p>\n<p>Pi\u00e8ce fixe, pens\u00e9e pour la vitrine. Les ailes d\u00e9passent largement du socle : pr\u00e9voyez un peu de place autour.<\/p>\n<div class=\"category-seo-more\">\n<details>\n<summary style=\"cursor:pointer;color:#cc0000\"><strong><span style=\"color:#ffffff\">Lire plus<\/span><\/strong><\/summary>\n<p>Le Pok\u00e9dex dit qu&rsquo;il ne s&rsquo;en prend jamais \u00e0 plus faible que lui. Votre figurine Magicarpe peut donc dormir tranquille, au moins jusqu&rsquo;au niveau 20.<\/p>\n<\/details>\n<\/div>","on_sale":false,"prices":{"price":"3900","regular_price":"3900","sale_price":"3900","price_range":null,"currency_code":"CHF","currency_symbol":"CHF","currency_minor_unit":2,"currency_decimal_separator":",","currency_thousand_separator":"","currency_prefix":"","currency_suffix":"CHF"},"price_html":"<span class=\"woocommerce-Price-amount amount\">39,00<span class=\"woocommerce-Price-currencySymbol\" dir=\"auto\">&#067;&#072;&#070;<\/span><\/span>","average_rating":"0","review_count":0,"images":[{"id":93815,"src":"https:\/\/www.bdfancomics.ch\/wp-content\/uploads\/2026\/10\/figurine-pokemon-dracaufeu-attaque-nyon.webp","thumbnail":"https:\/\/www.bdfancomics.ch\/wp-content\/uploads\/2026\/10\/figurine-pokemon-dracaufeu-attaque-nyon-500x500.webp","srcset":"https:\/\/www.bdfancomics.ch\/wp-content\/uploads\/2026\/10\/figurine-pokemon-dracaufeu-attaque-nyon.webp 1200w, https:\/\/www.bdfancomics.ch\/wp-content\/uploads\/2026\/10\/figurine-pokemon-dracaufeu-attaque-nyon-300x300.webp 300w, https:\/\/www.bdfancomics.ch\/wp-content\/uploads\/2026\/10\/figurine-pokemon-dracaufeu-attaque-nyon-1024x1024.webp 1024w, https:\/\/www.bdfancomics.ch\/wp-content\/uploads\/2026\/10\/figurine-pokemon-dracaufeu-attaque-nyon-150x150.webp 150w, https:\/\/www.bdfancomics.ch\/wp-content\/uploads\/2026\/10\/figurine-pokemon-dracaufeu-attaque-nyon-768x768.webp 768w, https:\/\/www.bdfancomics.ch\/wp-content\/uploads\/2026\/10\/figurine-pokemon-dracaufeu-attaque-nyon-500x500.webp 500w, https:\/\/www.bdfancomics.ch\/wp-content\/uploads\/2026\/10\/figurine-pokemon-dracaufeu-attaque-nyon-600x600.webp 600w, https:\/\/www.bdfancomics.ch\/wp-content\/uploads\/2026\/10\/figurine-pokemon-dracaufeu-attaque-nyon-100x100.webp 100w, https:\/\/www.bdfancomics.ch\/wp-content\/uploads\/2026\/10\/figurine-pokemon-dracaufeu-attaque-nyon-64x64.webp 64w","sizes":"(max-width: 1200px) 100vw, 1200px","thumbnail_srcset":"https:\/\/www.bdfancomics.ch\/wp-content\/uploads\/2026\/10\/figurine-pokemon-dracaufeu-attaque-nyon-500x500.webp 500w, https:\/\/www.bdfancomics.ch\/wp-content\/uploads\/2026\/10\/figurine-pokemon-dracaufeu-attaque-nyon-300x300.webp 300w, https:\/\/www.bdfancomics.ch\/wp-content\/uploads\/2026\/10\/figurine-pokemon-dracaufeu-attaque-nyon-1024x1024.webp 1024w, https:\/\/www.bdfancomics.ch\/wp-content\/uploads\/2026\/10\/figurine-pokemon-dracaufeu-attaque-nyon-150x150.webp 150w, https:\/\/www.bdfancomics.ch\/wp-content\/uploads\/2026\/10\/figurine-pokemon-dracaufeu-attaque-nyon-768x768.webp 768w, https:\/\/www.bdfancomics.ch\/wp-content\/uploads\/2026\/10\/figurine-pokemon-dracaufeu-attaque-nyon-600x600.webp 600w, https:\/\/www.bdfancomics.ch\/wp-content\/uploads\/2026\/10\/figurine-pokemon-dracaufeu-attaque-nyon-100x100.webp 100w, https:\/\/www.bdfancomics.ch\/wp-content\/uploads\/2026\/10\/figurine-pokemon-dracaufeu-attaque-nyon-64x64.webp 64w, https:\/\/www.bdfancomics.ch\/wp-content\/uploads\/2026\/10\/figurine-pokemon-dracaufeu-attaque-nyon.webp 1200w","thumbnail_sizes":"(max-width: 500px) 100vw, 500px","name":"Figurine Pok\u00e9mon Dracaufeu Attaque","alt":"Figurine Pok\u00e9mon Dracaufeu Attaque"}],"categories":[{"id":3873,"name":"Figurines Pok\u00e9mon","slug":"figurines-pokemon","link":"https:\/\/www.bdfancomics.ch\/categorie-produit\/figurines\/figurines-mangas\/figurines-pokemon\/"}],"tags":[],"brands":[{"id":6477,"name":"The Pok\u00e9mon Company","slug":"the-pokemon-company","link":"https:\/\/www.bdfancomics.ch\/marque\/the-pokemon-company\/"}],"attributes":[{"id":11,"name":"Licence","taxonomy":"pa_licence","has_variations":false,"terms":[{"id":6680,"name":"Pok\u00e9mon","slug":"pokemon"}]},{"id":13,"name":"Personnage","taxonomy":"pa_personnage","has_variations":false,"terms":[{"id":6698,"name":"Dracaufeu","slug":"dracaufeu"}]},{"id":12,"name":"Univers \/ M\u00e9dia","taxonomy":"pa_univers-media","has_variations":false,"terms":[{"id":6682,"name":"Anime","slug":"anime"}]},{"id":41,"name":"Fabricant","taxonomy":"pa_fabricant","has_variations":false,"terms":[{"id":12215,"name":"Langbowang","slug":"langbowang"}]},{"id":3,"name":"Taille","taxonomy":"pa_taille","has_variations":false,"terms":[{"id":12164,"name":"Moins de 15 cm","slug":"moins-de-15-cm"}]}],"variations":[],"grouped_products":[],"has_options":false,"is_purchasable":true,"is_in_stock":true,"is_on_backorder":false,"low_stock_remaining":null,"stock_availability":{"text":"En stock","class":"in-stock"},"sold_individually":false,"weight":"","dimensions":{"length":"","width":"","height":""},"formatted_weight":"ND","formatted_dimensions":"ND","add_to_cart":{"text":"Ajouter au panier","description":"Ajouter au panier\u00a0: &ldquo;Figurine Pok\u00e9mon Dracaufeu Attaque&rdquo;","url":"\/wp-json\/wc\/store\/v1\/products?search=pokemon&#038;per_page=100&#038;orderby=date&#038;order=desc&#038;add-to-cart=89116","single_text":"Ajouter au panier","minimum":1,"maximum":5,"multiple_of":1},"is_password_protected":false,"extensions":{},"_links":{"self":[{"href":"https:\/\/www.bdfancomics.ch\/wp-json\/wc\/store\/v1\/products\/89116","targetHints":{"allow":["GET"]}}],"collection":[{"href":"https:\/\/www.bdfancomics.ch\/wp-json\/wc\/store\/v1\/products"}],"upsells":[{"embeddable":true,"href":"https:\/\/www.bdfancomics.ch\/wp-json\/wc\/store\/v1\/products?include=89465,78164,76404,59926"}],"cross_sells":[{"embeddable":true,"href":"https:\/\/www.bdfancomics.ch\/wp-json\/wc\/store\/v1\/products?include=89130,89120,89111,44935"}],"related":[{"embeddable":true,"href":"https:\/\/www.bdfancomics.ch\/wp-json\/wc\/store\/v1\/products?related=89116&per_page=10"}]}},{"id":89115,"name":"Figurine Pok\u00e9mon Dodoala Coussin","slug":"figurine-pokemon-dodoala-coussin","parent":0,"type":"simple","variation":"","permalink":"https:\/\/www.bdfancomics.ch\/produit\/figurine-pokemon-dodoala-coussin\/","sku":"6972913401332","short_description":"<p>Pelotonn\u00e9 dans un petit lit bleu, sa b\u00fbche serr\u00e9e contre lui : la <strong>figurine Pok\u00e9mon Dodoala Coussin<\/strong> de Langbowang montre le koala d&rsquo;Alola dans son activit\u00e9 pr\u00e9f\u00e9r\u00e9e, dormir. Elle vient de la s\u00e9rie Starry Dream et arrive dans un emballage pastel.<\/p>","description":"<h2>Figurine Pok\u00e9mon Dodoala Coussin : le champion toutes cat\u00e9gories de la sieste<\/h2>\n<p>Il y a les Pok\u00e9mon qui dorment beaucoup, et il y a Dodoala. Cette <strong>figurine Pok\u00e9mon Dodoala Coussin<\/strong> le montre lov\u00e9 dans un petit lit rond bleu ciel, les yeux ferm\u00e9s, serrant contre lui la b\u00fbche qui ne le quitte jamais. Le genre de figurine qui donne envie de b\u00e2iller rien qu&rsquo;en la regardant.<\/p>\n<h3>Le Pok\u00e9mon qui ne se r\u00e9veille jamais<\/h3>\n<p>Num\u00e9ro 0775 du Pok\u00e9dex, Dodoala est un Pok\u00e9mon Normal apparu dans Pok\u00e9mon Soleil et Lune, dans la r\u00e9gion d&rsquo;Alola. Le Pok\u00e9dex affirme qu&rsquo;il na\u00eet endormi et passe toute sa vie \u00e0 dormir : tous ses mouvements, m\u00eame en combat, ne seraient que des r\u00e9actions \u00e0 ses r\u00eaves. Il ne l\u00e2che jamais sa b\u00fbche, qu&rsquo;il serre m\u00eame pendant ses attaques.<\/p>\n<p>Son talent, Hypersommeil, est unique : il est toujours consid\u00e9r\u00e9 comme endormi, ce qui le prot\u00e8ge des autres alt\u00e9rations de statut. Un Pok\u00e9mon qui dort si bien qu&rsquo;aucun poison ne peut le d\u00e9ranger, c&rsquo;est une philosophie.<\/p>\n<h3>La s\u00e9rie Starry Dream de Langbowang<\/h3>\n<p>Dans cette s\u00e9rie de Langbowang, chaque dormeur a droit \u00e0 son propre nid. Pour Dodoala, c&rsquo;est un petit lit rembourr\u00e9 aux bords arrondis, sculpt\u00e9 pour imiter un tissu moelleux. Le gris-bleu de sa fourrure, ses oreilles rondes et sa b\u00fbche brune sont rendus avec douceur.<\/p>\n<p>La bo\u00eete, aux teintes pastel, reprend l&rsquo;ambiance de la s\u00e9rie. Elle est assez jolie pour qu&rsquo;on la garde.<\/p>\n<h3>Les grands dormeurs<\/h3>\n<p>Dodoala a un compagnon de sieste tout d\u00e9sign\u00e9 : la <a href=\"https:\/\/www.bdfancomics.ch\/produit\/figurine-pokemon-jirachi-coussin\/\"><strong>figurine Jirachi Coussin<\/strong><\/a>, qui dort lui aussi sur son pouf, en attendant son r\u00e9veil mill\u00e9naire. Les deux ensemble forment un coin repos parfait sur une \u00e9tag\u00e8re ou une table de nuit. Et pour une version \u00e0 c\u00e2liner, les <a href=\"https:\/\/www.bdfancomics.ch\/categorie-produit\/jeux-jouets\/peluches-jeux\/peluches-pokemon\/\"><strong>peluches Pok\u00e9mon<\/strong><\/a> comptent plusieurs Pok\u00e9mon tout aussi endormis.<\/p>\n<p>Petite, mignonne et abordable, cette figurine est aussi une jolie attention pour quelqu&rsquo;un qui aime les koalas, les siestes, ou les deux.<\/p>\n<p>La pose est attendrissante : le museau enfoui contre la b\u00fbche, les yeux bien ferm\u00e9s, le corps roul\u00e9 en boule. On a vraiment l&rsquo;impression d&rsquo;un Pok\u00e9mon qui a trouv\u00e9 la position id\u00e9ale et qui ne compte plus en changer. La b\u00fbche brune ajoute une petite touche de bois au milieu des tons pastel.<\/p>\n<p>Ceux qui ont jou\u00e9 \u00e0 Soleil et Lune se souviennent peut-\u00eatre de l&rsquo;avoir crois\u00e9 sur les routes d&rsquo;Alola, imperturbable au milieu des combats.<\/p>\n<h3>Caract\u00e9ristiques<\/h3>\n<p><strong>Fabricant :<\/strong> Langbowang \u00b7 <strong>Gamme :<\/strong> Starry Dream (Coussin) \u00b7 <strong>Personnage :<\/strong> Dodoala (n\u00b0 0775) \u00b7 <strong>Mati\u00e8re :<\/strong> PVC \u00b7 <strong>Pr\u00e9sentation :<\/strong> bo\u00eete \u00b7 <strong>EAN :<\/strong> 6972913401332<\/p>\n<p>Le petit lit n&rsquo;est pas en tissu mais en PVC : un pinceau doux suffit \u00e0 le garder net.<\/p>\n<div class=\"category-seo-more\">\n<details>\n<summary style=\"cursor:pointer;color:#cc0000\"><strong><span style=\"color:#ffffff\">Lire plus<\/span><\/strong><\/summary>\n<p>Ne cherchez pas \u00e0 le r\u00e9veiller : m\u00eame le Pok\u00e9dex a renonc\u00e9. Laissez-le r\u00eaver, il a l&rsquo;air d&rsquo;en avoir besoin.<\/p>\n<\/details>\n<\/div>","on_sale":false,"prices":{"price":"1500","regular_price":"1500","sale_price":"1500","price_range":null,"currency_code":"CHF","currency_symbol":"CHF","currency_minor_unit":2,"currency_decimal_separator":",","currency_thousand_separator":"","currency_prefix":"","currency_suffix":"CHF"},"price_html":"<span class=\"woocommerce-Price-amount amount\">15,00<span class=\"woocommerce-Price-currencySymbol\" dir=\"auto\">&#067;&#072;&#070;<\/span><\/span>","average_rating":"0","review_count":0,"images":[{"id":93773,"src":"https:\/\/www.bdfancomics.ch\/wp-content\/uploads\/2026\/10\/figurine-pokemon-dodoala-coussin-nyon.webp","thumbnail":"https:\/\/www.bdfancomics.ch\/wp-content\/uploads\/2026\/10\/figurine-pokemon-dodoala-coussin-nyon-500x500.webp","srcset":"https:\/\/www.bdfancomics.ch\/wp-content\/uploads\/2026\/10\/figurine-pokemon-dodoala-coussin-nyon.webp 1200w, https:\/\/www.bdfancomics.ch\/wp-content\/uploads\/2026\/10\/figurine-pokemon-dodoala-coussin-nyon-300x300.webp 300w, https:\/\/www.bdfancomics.ch\/wp-content\/uploads\/2026\/10\/figurine-pokemon-dodoala-coussin-nyon-1024x1024.webp 1024w, https:\/\/www.bdfancomics.ch\/wp-content\/uploads\/2026\/10\/figurine-pokemon-dodoala-coussin-nyon-150x150.webp 150w, https:\/\/www.bdfancomics.ch\/wp-content\/uploads\/2026\/10\/figurine-pokemon-dodoala-coussin-nyon-768x768.webp 768w, https:\/\/www.bdfancomics.ch\/wp-content\/uploads\/2026\/10\/figurine-pokemon-dodoala-coussin-nyon-500x500.webp 500w, https:\/\/www.bdfancomics.ch\/wp-content\/uploads\/2026\/10\/figurine-pokemon-dodoala-coussin-nyon-600x600.webp 600w, https:\/\/www.bdfancomics.ch\/wp-content\/uploads\/2026\/10\/figurine-pokemon-dodoala-coussin-nyon-100x100.webp 100w, https:\/\/www.bdfancomics.ch\/wp-content\/uploads\/2026\/10\/figurine-pokemon-dodoala-coussin-nyon-64x64.webp 64w","sizes":"(max-width: 1200px) 100vw, 1200px","thumbnail_srcset":"https:\/\/www.bdfancomics.ch\/wp-content\/uploads\/2026\/10\/figurine-pokemon-dodoala-coussin-nyon-500x500.webp 500w, https:\/\/www.bdfancomics.ch\/wp-content\/uploads\/2026\/10\/figurine-pokemon-dodoala-coussin-nyon-300x300.webp 300w, https:\/\/www.bdfancomics.ch\/wp-content\/uploads\/2026\/10\/figurine-pokemon-dodoala-coussin-nyon-1024x1024.webp 1024w, https:\/\/www.bdfancomics.ch\/wp-content\/uploads\/2026\/10\/figurine-pokemon-dodoala-coussin-nyon-150x150.webp 150w, https:\/\/www.bdfancomics.ch\/wp-content\/uploads\/2026\/10\/figurine-pokemon-dodoala-coussin-nyon-768x768.webp 768w, https:\/\/www.bdfancomics.ch\/wp-content\/uploads\/2026\/10\/figurine-pokemon-dodoala-coussin-nyon-600x600.webp 600w, https:\/\/www.bdfancomics.ch\/wp-content\/uploads\/2026\/10\/figurine-pokemon-dodoala-coussin-nyon-100x100.webp 100w, https:\/\/www.bdfancomics.ch\/wp-content\/uploads\/2026\/10\/figurine-pokemon-dodoala-coussin-nyon-64x64.webp 64w, https:\/\/www.bdfancomics.ch\/wp-content\/uploads\/2026\/10\/figurine-pokemon-dodoala-coussin-nyon.webp 1200w","thumbnail_sizes":"(max-width: 500px) 100vw, 500px","name":"Figurine Pok\u00e9mon Dodoala Coussin","alt":"Figurine Pok\u00e9mon Dodoala Coussin"}],"categories":[{"id":3873,"name":"Figurines Pok\u00e9mon","slug":"figurines-pokemon","link":"https:\/\/www.bdfancomics.ch\/categorie-produit\/figurines\/figurines-mangas\/figurines-pokemon\/"}],"tags":[],"brands":[{"id":6477,"name":"The Pok\u00e9mon Company","slug":"the-pokemon-company","link":"https:\/\/www.bdfancomics.ch\/marque\/the-pokemon-company\/"}],"attributes":[{"id":11,"name":"Licence","taxonomy":"pa_licence","has_variations":false,"terms":[{"id":6680,"name":"Pok\u00e9mon","slug":"pokemon"}]},{"id":12,"name":"Univers \/ M\u00e9dia","taxonomy":"pa_univers-media","has_variations":false,"terms":[{"id":6682,"name":"Anime","slug":"anime"}]},{"id":13,"name":"Personnage","taxonomy":"pa_personnage","has_variations":false,"terms":[{"id":12219,"name":"Dodoala","slug":"dodoala"}]},{"id":41,"name":"Fabricant","taxonomy":"pa_fabricant","has_variations":false,"terms":[{"id":12215,"name":"Langbowang","slug":"langbowang"}]},{"id":3,"name":"Taille","taxonomy":"pa_taille","has_variations":false,"terms":[{"id":12164,"name":"Moins de 15 cm","slug":"moins-de-15-cm"}]}],"variations":[],"grouped_products":[],"has_options":false,"is_purchasable":true,"is_in_stock":true,"is_on_backorder":false,"low_stock_remaining":null,"stock_availability":{"text":"En stock","class":"in-stock"},"sold_individually":false,"weight":"","dimensions":{"length":"","width":"","height":""},"formatted_weight":"ND","formatted_dimensions":"ND","add_to_cart":{"text":"Ajouter au panier","description":"Ajouter au panier\u00a0: &ldquo;Figurine Pok\u00e9mon Dodoala Coussin&rdquo;","url":"\/wp-json\/wc\/store\/v1\/products?search=pokemon&#038;per_page=100&#038;orderby=date&#038;order=desc&#038;add-to-cart=89115","single_text":"Ajouter au panier","minimum":1,"maximum":10,"multiple_of":1},"is_password_protected":false,"extensions":{},"_links":{"self":[{"href":"https:\/\/www.bdfancomics.ch\/wp-json\/wc\/store\/v1\/products\/89115","targetHints":{"allow":["GET"]}}],"collection":[{"href":"https:\/\/www.bdfancomics.ch\/wp-json\/wc\/store\/v1\/products"}],"upsells":[{"embeddable":true,"href":"https:\/\/www.bdfancomics.ch\/wp-json\/wc\/store\/v1\/products?include=89465,78164,89578,76404"}],"cross_sells":[{"embeddable":true,"href":"https:\/\/www.bdfancomics.ch\/wp-json\/wc\/store\/v1\/products?include=89130,89120,89111,44935"}],"related":[{"embeddable":true,"href":"https:\/\/www.bdfancomics.ch\/wp-json\/wc\/store\/v1\/products?related=89115&per_page=10"}]}},{"id":89114,"name":"Figurine Pok\u00e9mon Cizayox","slug":"figurine-pokemon-cizayox","parent":0,"type":"simple","variation":"","permalink":"https:\/\/www.bdfancomics.ch\/produit\/figurine-pokemon-cizayox\/","sku":"6972407211560","short_description":"<p>Pinces lev\u00e9es, carapace rouge m\u00e9tallis\u00e9 et \u00e9clats jaunes au pied : la <strong>figurine Pok\u00e9mon Cizayox<\/strong> de Funism met en sc\u00e8ne l&rsquo;\u00e9volution d&rsquo;Ins\u00e9cateur dans une pose d&rsquo;intimidation. Elle mesure une dizaine de centim\u00e8tres et porte son nom anglais, <em>Scizor<\/em>, sur la base.<\/p>","description":"<h2>Figurine Pok\u00e9mon Cizayox : l&rsquo;acier rouge qui fait peur<\/h2>\n<p>Cizayox ne cherche pas \u00e0 \u00eatre aim\u00e9. Cette <strong>figurine Pok\u00e9mon Cizayox<\/strong> le montre dress\u00e9, les deux pinces lev\u00e9es comme une menace, sur un socle d&rsquo;o\u00f9 jaillissent des \u00e9clats jaunes translucides. Le rouge de son corps et ses ailes courtes lui donnent l&rsquo;allure d&rsquo;une machine de guerre.<\/p>\n<h3>Les faux deviennent des pinces<\/h3>\n<p>Num\u00e9ro 0212 du Pok\u00e9dex, Cizayox est n\u00e9 dans Pok\u00e9mon Or et Argent. Il \u00e9volue \u00e0 partir d&rsquo;Ins\u00e9cateur, \u00e9chang\u00e9 avec une Peau M\u00e9tal, et passe alors du type Vol au type Acier. Ses pinces portent des motifs en forme d&rsquo;yeux : selon le Pok\u00e9dex, il les l\u00e8ve pour faire croire \u00e0 l&rsquo;adversaire qu&rsquo;il a trois t\u00eates.<\/p>\n<p>Ce double type Insecte et Acier lui laisse une seule vraie faiblesse, le Feu, ce qui en a fait un pilier des \u00e9quipes comp\u00e9titives. Son attaque Pisto-Poing, une frappe d&rsquo;acier ultra-rapide, est rest\u00e9e sa marque de fabrique pendant des ann\u00e9es. Il a m\u00eame droit \u00e0 une M\u00e9ga-\u00c9volution depuis Pok\u00e9mon X et Y.<\/p>\n<h3>Le rendu Prime Figure Mini<\/h3>\n<p>Funism a choisi une posture frontale, presque statique, qui mise sur l&rsquo;intimidation plut\u00f4t que sur l&rsquo;\u00e9lan. Les pinces sont grandes ouvertes et parfaitement visibles, avec leurs motifs noirs. \u00c0 la base, des \u00e9clats jaunes et orang\u00e9s en plastique transparent rappellent l&rsquo;impact d&rsquo;une attaque.<\/p>\n<p>Le corps est peint dans un rouge profond, avec quelques touches grises sur les articulations. Son nom figure sur la base, en alphabet latin et en caract\u00e8res chinois.<\/p>\n<h3>Avec son ancienne forme<\/h3>\n<p>\u00c0 c\u00f4t\u00e9 de la <a href=\"https:\/\/www.bdfancomics.ch\/produit\/figurine-pokemon-insecateur\/\"><strong>figurine Ins\u00e9cateur<\/strong><\/a>, le contraste est frappant : le vert agile d&rsquo;un c\u00f4t\u00e9, le rouge blind\u00e9 de l&rsquo;autre. Ensemble, ils racontent l&rsquo;une des \u00e9volutions par \u00e9change les plus c\u00e9l\u00e8bres de la licence. Pour une vitrine de combattants de type Acier, <a href=\"https:\/\/www.bdfancomics.ch\/produit\/figurine-pokemon-lucario\/\"><strong>Lucario<\/strong><\/a> compl\u00e8te bien le tableau.<\/p>\n<p>Il pla\u00eet aussi aux amateurs de Pok\u00e9mon au design m\u00e9canique : ses ailes trop petites pour voler longtemps, qui lui servent surtout \u00e0 r\u00e9guler la temp\u00e9rature de son corps d&rsquo;acier selon le Pok\u00e9dex, ajoutent un d\u00e9tail amusant \u00e0 cette silhouette de char d&rsquo;assaut.<\/p>\n<p>Ceux qui ont grandi avec la deuxi\u00e8me g\u00e9n\u00e9ration le connaissent surtout pour l&rsquo;effort qu&rsquo;il demandait : trouver une Peau M\u00e9tal, puis convaincre quelqu&rsquo;un d&rsquo;\u00e9changer un Ins\u00e9cateur avec soi. Le voir ici, pr\u00eat \u00e0 attaquer, c&rsquo;est un peu la r\u00e9compense de ces apr\u00e8s-midi pass\u00e9es avec un c\u00e2ble Link.<\/p>\n<p>Vue de dos, on remarque aussi les petites ailes translucides et la queue segment\u00e9e, des d\u00e9tails qu&rsquo;on oublie souvent sur ce Pok\u00e9mon.<\/p>\n<h3>Caract\u00e9ristiques<\/h3>\n<p><strong>Fabricant :<\/strong> Funism \u00b7 <strong>Gamme :<\/strong> Prime Figure Mini \u00b7 <strong>Personnage :<\/strong> Cizayox (n\u00b0 0212) \u00b7 <strong>Hauteur :<\/strong> environ 10 cm \u00b7 <strong>Mati\u00e8re :<\/strong> PVC \u00b7 <strong>Pr\u00e9sentation :<\/strong> bo\u00eete vitrine \u00b7 <strong>EAN :<\/strong> 6972407211560<\/p>\n<p>Figurine statique sur socle, pour vitrine ou bureau.<\/p>\n<div class=\"category-seo-more\">\n<details>\n<summary style=\"cursor:pointer;color:#cc0000\"><strong><span style=\"color:#ffffff\">Lire plus<\/span><\/strong><\/summary>\n<p>Ses pinces ont des yeux pour impressionner l&rsquo;adversaire. Sur l&rsquo;\u00e9tag\u00e8re, \u00e7a marche aussi tr\u00e8s bien sur les autres figurines.<\/p>\n<\/details>\n<\/div>","on_sale":false,"prices":{"price":"2900","regular_price":"2900","sale_price":"2900","price_range":null,"currency_code":"CHF","currency_symbol":"CHF","currency_minor_unit":2,"currency_decimal_separator":",","currency_thousand_separator":"","currency_prefix":"","currency_suffix":"CHF"},"price_html":"<span class=\"woocommerce-Price-amount amount\">29,00<span class=\"woocommerce-Price-currencySymbol\" dir=\"auto\">&#067;&#072;&#070;<\/span><\/span>","average_rating":"0","review_count":0,"images":[{"id":93772,"src":"https:\/\/www.bdfancomics.ch\/wp-content\/uploads\/2026\/10\/figurine-pokemon-cizayox-nyon.webp","thumbnail":"https:\/\/www.bdfancomics.ch\/wp-content\/uploads\/2026\/10\/figurine-pokemon-cizayox-nyon-500x500.webp","srcset":"https:\/\/www.bdfancomics.ch\/wp-content\/uploads\/2026\/10\/figurine-pokemon-cizayox-nyon.webp 1200w, https:\/\/www.bdfancomics.ch\/wp-content\/uploads\/2026\/10\/figurine-pokemon-cizayox-nyon-300x300.webp 300w, https:\/\/www.bdfancomics.ch\/wp-content\/uploads\/2026\/10\/figurine-pokemon-cizayox-nyon-1024x1024.webp 1024w, https:\/\/www.bdfancomics.ch\/wp-content\/uploads\/2026\/10\/figurine-pokemon-cizayox-nyon-150x150.webp 150w, https:\/\/www.bdfancomics.ch\/wp-content\/uploads\/2026\/10\/figurine-pokemon-cizayox-nyon-768x768.webp 768w, https:\/\/www.bdfancomics.ch\/wp-content\/uploads\/2026\/10\/figurine-pokemon-cizayox-nyon-500x500.webp 500w, https:\/\/www.bdfancomics.ch\/wp-content\/uploads\/2026\/10\/figurine-pokemon-cizayox-nyon-600x600.webp 600w, https:\/\/www.bdfancomics.ch\/wp-content\/uploads\/2026\/10\/figurine-pokemon-cizayox-nyon-100x100.webp 100w, https:\/\/www.bdfancomics.ch\/wp-content\/uploads\/2026\/10\/figurine-pokemon-cizayox-nyon-64x64.webp 64w","sizes":"(max-width: 1200px) 100vw, 1200px","thumbnail_srcset":"https:\/\/www.bdfancomics.ch\/wp-content\/uploads\/2026\/10\/figurine-pokemon-cizayox-nyon-500x500.webp 500w, https:\/\/www.bdfancomics.ch\/wp-content\/uploads\/2026\/10\/figurine-pokemon-cizayox-nyon-300x300.webp 300w, https:\/\/www.bdfancomics.ch\/wp-content\/uploads\/2026\/10\/figurine-pokemon-cizayox-nyon-1024x1024.webp 1024w, https:\/\/www.bdfancomics.ch\/wp-content\/uploads\/2026\/10\/figurine-pokemon-cizayox-nyon-150x150.webp 150w, https:\/\/www.bdfancomics.ch\/wp-content\/uploads\/2026\/10\/figurine-pokemon-cizayox-nyon-768x768.webp 768w, https:\/\/www.bdfancomics.ch\/wp-content\/uploads\/2026\/10\/figurine-pokemon-cizayox-nyon-600x600.webp 600w, https:\/\/www.bdfancomics.ch\/wp-content\/uploads\/2026\/10\/figurine-pokemon-cizayox-nyon-100x100.webp 100w, https:\/\/www.bdfancomics.ch\/wp-content\/uploads\/2026\/10\/figurine-pokemon-cizayox-nyon-64x64.webp 64w, https:\/\/www.bdfancomics.ch\/wp-content\/uploads\/2026\/10\/figurine-pokemon-cizayox-nyon.webp 1200w","thumbnail_sizes":"(max-width: 500px) 100vw, 500px","name":"Figurine Pok\u00e9mon Cizayox","alt":"Figurine Pok\u00e9mon Cizayox"}],"categories":[{"id":3873,"name":"Figurines Pok\u00e9mon","slug":"figurines-pokemon","link":"https:\/\/www.bdfancomics.ch\/categorie-produit\/figurines\/figurines-mangas\/figurines-pokemon\/"}],"tags":[],"brands":[{"id":6477,"name":"The Pok\u00e9mon Company","slug":"the-pokemon-company","link":"https:\/\/www.bdfancomics.ch\/marque\/the-pokemon-company\/"}],"attributes":[{"id":11,"name":"Licence","taxonomy":"pa_licence","has_variations":false,"terms":[{"id":6680,"name":"Pok\u00e9mon","slug":"pokemon"}]},{"id":12,"name":"Univers \/ M\u00e9dia","taxonomy":"pa_univers-media","has_variations":false,"terms":[{"id":6682,"name":"Anime","slug":"anime"}]},{"id":13,"name":"Personnage","taxonomy":"pa_personnage","has_variations":false,"terms":[{"id":12211,"name":"Cizayox","slug":"cizayox"}]},{"id":41,"name":"Fabricant","taxonomy":"pa_fabricant","has_variations":false,"terms":[{"id":12206,"name":"Funism","slug":"funism"}]},{"id":3,"name":"Taille","taxonomy":"pa_taille","has_variations":false,"terms":[{"id":12164,"name":"Moins de 15 cm","slug":"moins-de-15-cm"}]}],"variations":[],"grouped_products":[],"has_options":false,"is_purchasable":true,"is_in_stock":true,"is_on_backorder":false,"low_stock_remaining":2,"stock_availability":{"text":"Plus que 2 en stock","class":"in-stock"},"sold_individually":false,"weight":"","dimensions":{"length":"","width":"","height":""},"formatted_weight":"ND","formatted_dimensions":"ND","add_to_cart":{"text":"Ajouter au panier","description":"Ajouter au panier\u00a0: &ldquo;Figurine Pok\u00e9mon Cizayox&rdquo;","url":"\/wp-json\/wc\/store\/v1\/products?search=pokemon&#038;per_page=100&#038;orderby=date&#038;order=desc&#038;add-to-cart=89114","single_text":"Ajouter au panier","minimum":1,"maximum":2,"multiple_of":1},"is_password_protected":false,"extensions":{},"_links":{"self":[{"href":"https:\/\/www.bdfancomics.ch\/wp-json\/wc\/store\/v1\/products\/89114","targetHints":{"allow":["GET"]}}],"collection":[{"href":"https:\/\/www.bdfancomics.ch\/wp-json\/wc\/store\/v1\/products"}],"upsells":[{"embeddable":true,"href":"https:\/\/www.bdfancomics.ch\/wp-json\/wc\/store\/v1\/products?include=89465,78164,89578,76404"}],"cross_sells":[{"embeddable":true,"href":"https:\/\/www.bdfancomics.ch\/wp-json\/wc\/store\/v1\/products?include=89130,89120,89111,44935"}],"related":[{"embeddable":true,"href":"https:\/\/www.bdfancomics.ch\/wp-json\/wc\/store\/v1\/products?related=89114&per_page=10"}]}},{"id":89113,"name":"Figurine Pok\u00e9mon Carapuce","slug":"figurine-pokemon-carapuce","parent":0,"type":"simple","variation":"","permalink":"https:\/\/www.bdfancomics.ch\/produit\/figurine-pokemon-carapuce\/","sku":"6971680458136","short_description":"<p>La <strong>figurine Carapuce<\/strong> Funism Prime Figure Mini montre le starter Eau de Kanto entour\u00e9 d&rsquo;effets d&rsquo;eau transparents. Environ 10 cm de PVC, licence officielle Pok\u00e9mon.<\/p>\n<p>Lunettes de soleil non fournies, attitude incluse : le starter Eau de Kanto dans un format qui tient partout.<\/p>","description":"<h2>Figurine Carapuce Funism : le starter Eau de Kanto qui garde la t\u00eate froide<\/h2>\n<p>Il y a ceux qui ont choisi la flamme, ceux qui ont choisi le bulbe, et ceux qui ont pris la carapace. La <strong>figurine Carapuce<\/strong> de Funism s&rsquo;adresse clairement aux troisi\u00e8mes : le petit Pok\u00e9mon tortue de Bourg Palette, entour\u00e9 d&rsquo;effets d&rsquo;eau transparents qui donnent l&rsquo;impression qu&rsquo;un Pistolet \u00e0 O vient de partir.<\/p>\n<h3>Le n\u00b0007, toujours pr\u00eat \u00e0 arroser<\/h3>\n<p>Carapuce porte le num\u00e9ro 007 du Pok\u00e9dex, ce qui lui va plut\u00f4t bien pour un Pok\u00e9mon qui adore jouer les agents secrets. Dans la s\u00e9rie anim\u00e9e, l&rsquo;Escouade Carapuce et ses lunettes de soleil ont marqu\u00e9 toute une g\u00e9n\u00e9ration de t\u00e9l\u00e9spectateurs.<\/p>\n<p>La figurine reste dans cet esprit : un Carapuce plein d&rsquo;entrain, la carapace bien visible, avec l&rsquo;assurance de celui qui sait qu&rsquo;il a l&rsquo;avantage contre Salam\u00e8che.<\/p>\n<h3>Un socle qui dit tout<\/h3>\n<p>Comme le veut la gamme Prime Figure Mini, le Pok\u00e9mon repose sur un socle rond o\u00f9 sont inscrits son nom anglais, Squirtle, et son nom chinois. Les effets d&rsquo;eau en plastique transparent ajoutent du mouvement et de la lumi\u00e8re, surtout pr\u00e8s d&rsquo;une fen\u00eatre ou d&rsquo;une lampe.<\/p>\n<h3>Reformer le trio de Kanto<\/h3>\n<p>Le trio de d\u00e9part de la premi\u00e8re g\u00e9n\u00e9ration se reconstitue facilement dans la m\u00eame gamme : la <a href=\"https:\/\/www.bdfancomics.ch\/produit\/figurine-pokemon-bulbizarre\/\"><strong>figurine Bulbizarre Funism<\/strong><\/a> et la figurine Salam\u00e8che partagent le m\u00eame format et le m\u00eame type de socle.<\/p>\n<p>Et si la collection d\u00e9borde des \u00e9tag\u00e8res vers les classeurs, les <a href=\"https:\/\/www.bdfancomics.ch\/categorie-produit\/cartes-a-collectionner\/pokemon-cartes\/cartes-pokemon-en-francais\/\"><strong>cartes Pok\u00e9mon en fran\u00e7ais<\/strong><\/a> attendent dans le rayon d&rsquo;\u00e0 c\u00f4t\u00e9.<\/p>\n<h3>De Carapuce \u00e0 Tortank<\/h3>\n<p>Carapuce \u00e9volue en Carabaffe au niveau 16, puis en Tortank au niveau 36, avec ses deux canons \u00e0 eau qui ont fait r\u00eaver tous les enfants de 1999. Dans Pok\u00e9mon Jaune, on ne le choisissait pas au labo : c&rsquo;est l&rsquo;Agente Jenny de Carmin sur Mer qui le confiait au joueur.<\/p>\n<p>Pour voir la forme finale en pleine action, la <a href=\"https:\/\/www.bdfancomics.ch\/produit\/figurine-pokemon-tortank-attaque\/\"><strong>figurine Tortank Attaque<\/strong><\/a> montre le Pok\u00e9mon carapace en position de combat. Le petit et le grand c\u00f4te \u00e0 c\u00f4te, \u00e7a fonctionne toujours.<\/p>\n<h3>Bras lev\u00e9s, jet d&rsquo;eau aux pieds<\/h3>\n<p>La figurine montre un Carapuce debout, les deux bras lev\u00e9s, l&rsquo;air ravi. \u00c0 ses pieds, une gerbe d&rsquo;eau translucide bleu fonc\u00e9 jaillit du socle comme une vague qui vient de se briser. Le ventre cr\u00e8me et la carapace sont bien d\u00e9taill\u00e9s, et l&rsquo;ensemble garde ce c\u00f4t\u00e9 joyeux qui a toujours fait le charme du petit Pok\u00e9mon tortue.<\/p>\n<h3>Caract\u00e9ristiques<\/h3>\n<p>Une figurine Funism de la gamme Prime Figure Mini, en PVC, d&rsquo;environ 10 cm de haut, sous licence officielle Pok\u00e9mon. Code EAN : 6971680458136.<\/p>\n<div class=\"category-seo-more\">\n<details>\n<summary style=\"cursor:pointer;color:#cc0000\"><strong><span style=\"color:#ffffff\">Lire plus<\/span><\/strong><\/summary>\n<p>Les tortues ont la r\u00e9putation d&rsquo;\u00eatre lentes. Personne n&rsquo;a jamais pr\u00e9venu Carapuce : il est toujours le premier quand il s&rsquo;agit d&rsquo;arroser quelqu&rsquo;un. Sur l&rsquo;\u00e9tag\u00e8re, vos mangas restent au sec, promis.<\/p>\n<\/details>\n<\/div>","on_sale":false,"prices":{"price":"2900","regular_price":"2900","sale_price":"2900","price_range":null,"currency_code":"CHF","currency_symbol":"CHF","currency_minor_unit":2,"currency_decimal_separator":",","currency_thousand_separator":"","currency_prefix":"","currency_suffix":"CHF"},"price_html":"<span class=\"woocommerce-Price-amount amount\">29,00<span class=\"woocommerce-Price-currencySymbol\" dir=\"auto\">&#067;&#072;&#070;<\/span><\/span>","average_rating":"0","review_count":0,"images":[{"id":93770,"src":"https:\/\/www.bdfancomics.ch\/wp-content\/uploads\/2026\/10\/figurine-pokemon-carapuce-nyon.webp","thumbnail":"https:\/\/www.bdfancomics.ch\/wp-content\/uploads\/2026\/10\/figurine-pokemon-carapuce-nyon-500x500.webp","srcset":"https:\/\/www.bdfancomics.ch\/wp-content\/uploads\/2026\/10\/figurine-pokemon-carapuce-nyon.webp 1200w, https:\/\/www.bdfancomics.ch\/wp-content\/uploads\/2026\/10\/figurine-pokemon-carapuce-nyon-300x300.webp 300w, https:\/\/www.bdfancomics.ch\/wp-content\/uploads\/2026\/10\/figurine-pokemon-carapuce-nyon-1024x1024.webp 1024w, https:\/\/www.bdfancomics.ch\/wp-content\/uploads\/2026\/10\/figurine-pokemon-carapuce-nyon-150x150.webp 150w, https:\/\/www.bdfancomics.ch\/wp-content\/uploads\/2026\/10\/figurine-pokemon-carapuce-nyon-768x768.webp 768w, https:\/\/www.bdfancomics.ch\/wp-content\/uploads\/2026\/10\/figurine-pokemon-carapuce-nyon-500x500.webp 500w, https:\/\/www.bdfancomics.ch\/wp-content\/uploads\/2026\/10\/figurin