bdfancomics.ch\/wp-content\/uploads\/2026\/08\/protection-crystal-box-souple-coffret-4-boosters-phoenix-shield-nyon-64x64.webp 64w, https:\/\/www.bdfancomics.ch\/wp-content\/uploads\/2026\/08\/protection-crystal-box-souple-coffret-4-boosters-phoenix-shield-nyon.webp 1200w","thumbnail_sizes":"(max-width: 500px) 100vw, 500px","name":"Protection Crystal Box souple coffret Pok\u00e9mon 4 boosters Phoenix Shield","alt":"Protection Crystal Box souple Phoenix Shield pour coffret Pok\u00e9mon de 4 boosters, chez BDFancomics \u00e0 Nyon"}],"categories":[{"id":4294,"name":"Protections acryliques TCG","slug":"protections-acrylique-tcg","link":"https:\/\/www.bdfancomics.ch\/categorie-produit\/cartes-a-collectionner\/accessoires-cartes\/protections-acrylique-tcg\/"}],"tags":[],"brands":[{"id":6503,"name":"Phoenix Shield","slug":"phoenix-shield","link":"https:\/\/www.bdfancomics.ch\/marque\/phoenix-shield\/"}],"attributes":[{"id":11,"name":"Licence","taxonomy":"pa_licence","has_variations":false,"terms":[{"id":6680,"name":"Pok\u00e9mon","slug":"pokemon"}]},{"id":37,"name":"Type de produit TCG","taxonomy":"pa_format-tcg","has_variations":false,"terms":[{"id":12054,"name":"Protection","slug":"protection"}]}],"variations":[],"grouped_products":[],"has_options":false,"is_purchasable":true,"is_in_stock":true,"is_on_backorder":false,"low_stock_remaining":null,"stock_availability":{"text":"En stock","class":"in-stock"},"sold_individually":false,"weight":"","dimensions":{"length":"","width":"","height":""},"formatted_weight":"ND","formatted_dimensions":"ND","add_to_cart":{"text":"Ajouter au panier","description":"Ajouter au panier\u00a0: &ldquo;Protection Crystal Box Souple Coffret Pok\u00e9mon 4 Boosters&rdquo;","url":"\/wp-json\/wc\/store\/v1\/products?search=pokemon&#038;per_page=100&#038;orderby=date&#038;order=desc&#038;add-to-cart=89428","single_text":"Ajouter au panier","minimum":1,"maximum":51,"multiple_of":1},"is_password_protected":false,"extensions":{},"_links":{"self":[{"href":"https:\/\/www.bdfancomics.ch\/wp-json\/wc\/store\/v1\/products\/89428","targetHints":{"allow":["GET"]}}],"collection":[{"href":"https:\/\/www.bdfancomics.ch\/wp-json\/wc\/store\/v1\/products"}],"upsells":[{"embeddable":true,"href":"https:\/\/www.bdfancomics.ch\/wp-json\/wc\/store\/v1\/products?include=88977,89465,78164,89578"}],"cross_sells":[{"embeddable":true,"href":"https:\/\/www.bdfancomics.ch\/wp-json\/wc\/store\/v1\/products?include=88455,90931,89423,88454"}],"related":[{"embeddable":true,"href":"https:\/\/www.bdfancomics.ch\/wp-json\/wc\/store\/v1\/products?related=89428&per_page=10"}]}},{"id":89426,"name":"Protection Acrylique Magn\u00e9tique SPC Super Premium Pok\u00e9mon Phoenix Shield","slug":"protection-acrylique-magnetique-spc-super-premium-pokemon-phoenix-shield","parent":0,"type":"simple","variation":"","permalink":"https:\/\/www.bdfancomics.ch\/produit\/protection-acrylique-magnetique-spc-super-premium-pokemon-phoenix-shield\/","sku":"5412128690103","short_description":"<p>La <strong>Protection SPC Phoenix Shield<\/strong> est dimensionn\u00e9e pour les Super Premium Collection Pok\u00e9mon. Son acrylique transparent, sa fermeture magn\u00e9tique et sa filtration UV transforment le coffret en vraie pi\u00e8ce d\u2019exposition.<\/p>","description":"<h2>Protection SPC Phoenix Shield : quand le gros coffret demande sa propre vitrine<\/h2>\n<p>La <strong>Protection SPC Phoenix Shield<\/strong> est con\u00e7ue pour les <strong>Super Premium Collection Pok\u00e9mon<\/strong>, ces coffrets qui prennent d\u00e9j\u00e0 suffisamment de place pour annoncer clairement leurs intentions.<\/p>\n<p>L\u2019acrylique transparent prot\u00e8ge la bo\u00eete tout en laissant le visuel enti\u00e8rement visible. La fermeture magn\u00e9tique permet d\u2019acc\u00e9der au coffret sans d\u00e9montage compliqu\u00e9.<\/p>\n<h2>Plus la bo\u00eete est grande, plus le petit choc se voit<\/h2>\n<p>Sur une petite Tin, une marque peut parfois passer inaper\u00e7ue.<\/p>\n<p>Sur une grande Super Premium Collection expos\u00e9e en fa\u00e7ade, le regard finit toujours par tomber exactement sur le coin qui a pris un coup.<\/p>\n<p>La protection rigide sert donc autant au stockage qu\u2019\u00e0 l\u2019exposition.<\/p>\n<h2>Filtration UV pour les collections expos\u00e9es<\/h2>\n<p>Phoenix Shield annonce une filtration UV importante sur ses protections acryliques. C\u2019est particuli\u00e8rement utile pour les produits scell\u00e9s conserv\u00e9s dans une pi\u00e8ce lumineuse ou une vitrine.<\/p>\n<p>Le bo\u00eetier limite aussi la poussi\u00e8re, les rayures et les petits chocs li\u00e9s aux manipulations.<\/p>\n<h2>Caract\u00e9ristiques<\/h2>\n<ul>\n<li><strong>Marque :<\/strong> Phoenix Shield<\/li>\n<li><strong>Compatibilit\u00e9 :<\/strong> Super Premium Collection Pok\u00e9mon<\/li>\n<li><strong>Mat\u00e9riau :<\/strong> acrylique transparent<\/li>\n<li><strong>Fermeture :<\/strong> magn\u00e9tique<\/li>\n<li><strong>Protection UV :<\/strong> 98%+ annonc\u00e9e sur cette r\u00e9f\u00e9rence par les revendeurs<\/li>\n<li><strong>EAN :<\/strong> 5412128690103<\/li>\n<\/ul>\n<div class=\"seo-plus\" style=\"margin-top: 30px\">\n<details>\n<summary style=\"cursor: pointer;color: #cc0000;font-weight: 600\"><span style=\"color: #cc0000\">&#9654;&nbsp; Lire plus<\/span><\/summary>\n<p>Une Super Premium Collection est d\u00e9j\u00e0 le genre de bo\u00eete qu\u2019on regarde avant de d\u00e9cider si on l\u2019ouvre. Une fois plac\u00e9e dans l\u2019acrylique, la d\u00e9cision prend soudain un caract\u00e8re beaucoup plus officiel.<\/p>\n<\/details>\n<\/div>","on_sale":false,"prices":{"price":"4500","regular_price":"4500","sale_price":"4500","price_range":null,"currency_code":"CHF","currency_symbol":"CHF","currency_minor_unit":2,"currency_decimal_separator":",","currency_thousand_separator":"","currency_prefix":"","currency_suffix":"CHF"},"price_html":"<span class=\"woocommerce-Price-amount amount\">45,00<span class=\"woocommerce-Price-currencySym