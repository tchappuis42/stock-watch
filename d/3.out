ga-evolution"}]},{"id":39,"name":"Extension","taxonomy":"pa_extension","has_variations":false,"terms":[{"id":12080,"name":"Nuit Noire","slug":"nuit-noire"}]}],"variations":[],"grouped_products":[],"has_options":false,"is_purchasable":true,"is_in_stock":true,"is_on_backorder":false,"low_stock_remaining":null,"stock_availability":{"text":"En stock","class":"in-stock"},"sold_individually":false,"weight":"","dimensions":{"length":"","width":"","height":""},"formatted_weight":"ND","formatted_dimensions":"ND","add_to_cart":{"text":"Ajouter au panier","description":"Ajouter au panier\u00a0: &ldquo;ETB Pok\u00e9mon Coffret Dresseur d\u2019Elite ME05 Nuit Noire&rdquo;","url":"\/wp-json\/wc\/store\/v1\/products?search=pokemon&#038;per_page=100&#038;orderby=date&#038;order=desc&#038;add-to-cart=89035","single_text":"Ajouter au panier","minimum":1,"maximum":6,"multiple_of":1},"is_password_protected":false,"extensions":{},"_links":{"self":[{"href":"https:\/\/www.bdfancomics.ch\/wp-json\/wc\/store\/v1\/products\/89035","targetHints":{"allow":["GET"]}}],"collection":[{"href":"https:\/\/www.bdfancomics.ch\/wp-json\/wc\/store\/v1\/products"}],"upsells":[{"embeddable":true,"href":"https:\/\/www.bdfancomics.ch\/wp-json\/wc\/store\/v1\/products?include=89020,89021,89015,89578"}],"cross_sells":[{"embeddable":true,"href":"https:\/\/www.bdfancomics.ch\/wp-json\/wc\/store\/v1\/products?include=88455,89183,91139,89714"}],"related":[{"embeddable":true,"href":"https:\/\/www.bdfancomics.ch\/wp-json\/wc\/store\/v1\/products?related=89035&per_page=10"}]}},{"id":89034,"name":"ETB Pok\u00e9mon Coffret Dresseur d\u2019Elite ME03 Equilibre Parfait","slug":"etb-pokemon-equilibre-parfait-me03","parent":0,"type":"simple","variation":"","permalink":"https:\/\/www.bdfancomics.ch\/produit\/etb-pokemon-equilibre-parfait-me03\/","sku":"196214136380","short_description":"<p>L&rsquo;<strong>ETB \u00c9quilibre Parfait<\/strong> r\u00e9unit 9 boosters de l&rsquo;extension ME03, une carte promo pleine illustration de Ptyranidur, 65 prot\u00e8ge-cartes, 40 \u00c9nergies et tout le mat\u00e9riel de jeu.<\/p>\n<p>M\u00e9ga-Zygarde-ex veille sur le couvercle, un T-Rex de Kalos sur la promo.<\/p>","description":"<h2>ETB \u00c9quilibre Parfait : un dinosaure en promo, un l\u00e9gendaire sur la bo\u00eete<\/h2>\n<p>\u00c9quilibre Parfait est la troisi\u00e8me extension du bloc M\u00e9ga-\u00c9volution, sortie en fran\u00e7ais le 27 mars 2026. Son gardien s&rsquo;appelle M\u00e9ga-Zygarde-ex, et c&rsquo;est lui qui s&rsquo;\u00e9tend sur tout le couvercle vert et blanc de ce coffret. L&rsquo;<strong>ETB \u00c9quilibre Parfait<\/strong> reste le format pr\u00e9f\u00e9r\u00e9 de ceux qui veulent ouvrir et jouer avec la m\u00eame bo\u00eete.<\/p>\n<h3>Le contenu officiel<\/h3>\n<p>Le coffret contient 9 boosters \u00c9quilibre Parfait, une carte promo brillante enti\u00e8rement illustr\u00e9e de Ptyranidur, 65 prot\u00e8ge-cartes, 40 cartes \u00c9nergie, le guide de jeu de l&rsquo;extension, 6 d\u00e9s marqueurs de d\u00e9g\u00e2ts, un d\u00e9 de pi\u00e8ce autoris\u00e9 en comp\u00e9tition, une pi\u00e8ce en plastique, un coffret de collection avec 6 s\u00e9parateurs et une carte \u00e0 code pour Pok\u00e9mon TCG Live.<\/p>\n<h3>Ptyranidur, le tyran revenu du pass\u00e9<\/h3>\n<p>Ptyranidur est un Pok\u00e9mon Fossile de Kalos. Dans Pok\u00e9mon X et Y, on le ressuscite \u00e0 partir du Fossile M\u00e2choire, \u00e0 condition d&rsquo;avoir choisi le bon fossile dans la Grotte Scintillante. Ceux qui avaient pris l&rsquo;autre, le Fossile Nageoire, sont repartis avec Amagara, et beaucoup se souviennent encore de ce choix. Sa promo pleine illustration lui rend justice : m\u00e2choire grande ouverte et allure de roi.<\/p>\n<h3>Ce que l&rsquo;extension r\u00e9serve<\/h3>\n<p>La ville d&rsquo;\u00c9quilibre Parfait vit au rythme de ses Pok\u00e9mon. M\u00e9ga-M\u00e9lodelfe-ex, M\u00e9ga-Staross-ex et Miaouss-ex partagent l&rsquo;affiche avec M\u00e9ga-Zygarde-ex. Neuf boosters, c&rsquo;est 90 cartes \u00e0 d\u00e9couvrir, assez pour tomber sur plusieurs cartes \u00e0 illustration sp\u00e9ciale ou d\u00e9marrer un deck autour d&rsquo;un M\u00e9ga.<\/p>\n<h3>Un coffret qui sert apr\u00e8s<\/h3>\n<p>Avec ses 6 s\u00e9parateurs, la bo\u00eete accueille facilement plusieurs centaines de cartes. Les 65 prot\u00e8ge-cartes habillent un deck complet, avec cinq pochettes de secours pour les cartes du classeur. Les d\u00e9s et marqueurs d&rsquo;\u00c9tats Sp\u00e9ciaux \u00e9vitent les bouts de papier sur la table. C&rsquo;est le coffret qu&rsquo;on recommande \u00e0 un joueur qui d\u00e9bute comme \u00e0 un collectionneur qui veut la promo.<\/p>\n<p>Pour tout savoir sur l&rsquo;extension, voir la page <a href=\"https:\/\/www.bdfancomics.ch\/extension\/equilibre-parfait\/\"><strong>\u00c9quilibre Parfait<\/strong><\/a>. La m\u00eame extension existe en <a href=\"https:\/\/www.bdfancomics.ch\/produit\/display-pokemon-equilibre-parfait-me03\/\"><strong>Display \u00c9quilibre Parfait<\/strong><\/a> de 36 boosters et en <a href=\"https:\/\/www.bdfancomics.ch\/produit\/tripack-pokemon-equilibre-parfait-me3\/\"><strong>Tripack \u00c9quilibre Parfait<\/strong><\/a>. Les autres coffrets sont dans les <a href=\"https:\/\/www.bdfancomics.ch\/categorie-produit\/cartes-a-collectionner\/pokemon-cartes\/cartes-pokemon-en-francais\/etb\/\"><strong>ETB Pok\u00e9mon en fran\u00e7ais<\/strong><\/a>.<\/p>\n<h3>Caract\u00e9ristiques<\/h3>\n<p>Coffret Dresseur d&rsquo;\u00e9lite M\u00e9ga-\u00c9volution \u2013 \u00c9quilibre Parfait (ME03), version fran\u00e7aise. Contenu : 9 boosters, 1 carte promo Ptyranidur pleine illustration, 65 prot\u00e8ge-cartes, 40 cartes \u00c9nergie, 1 guide, 6 d\u00e9s de d\u00e9g\u00e2ts, 1 d\u00e9 pile ou face, 1 pi\u00e8ce plastique, 1 bo\u00eete avec 6 s\u00e9parateurs, 1 carte \u00e0 code. Sortie : 27 mars 2026. EAN : 196214136380.<\/p>\n<div class=\"category-seo-more\">\n<details>\n<summary style=\"cursor:pointer;color:#cc0000\"><strong><span style=\"color:#ffffff\">Lire plus<\/span><\/strong><\/summary>\n<p>Ptyranidur a attendu des millions d&rsquo;ann\u00e9es dans un fossile avant de revenir \u00e0 la vie. Vous, vous n&rsquo;aurez qu&rsquo;\u00e0 soulever un couvercle. Le progr\u00e8s, c&rsquo;est beau.<\/p>\n<\/details>\n<\/div>","on_sale":false,"prices":{"price":"7990","regular_price":"7990","sale_price":"7990","price_range":null,"currency_code":"CHF","currency_symbol":"CHF","currency_minor_unit":2,"currency_decimal_separator":",","currency_thousand_separator":"","currency_prefix":"","currency_suffix":"CHF"},"price_html":"<span class=\"woocommerce-Price-amount amount\">79,90<span class=\"woocommerce-Price-currencySymbol\" dir=\"auto\">&#067;&#072;&#070;<\/span><\/span>","average_rating":"0","review_count":0,"images":[{"id":92029,"src":"https:\/\/www.bdfancomics.ch\/wp-content\/uploads\/2026\/08\/etb-pokemon-coffret-dresseur-elite-equilibre-parfait-mega-evolution.webp","thumbnail":"https:\/\/www.bdfancomics.ch\/wp-content\/uploads\/2026\/08\/etb-pokemon-coffret-dresseur-elite-equilibre-parfait-mega-evolution-500x500.webp","srcset":"https:\/\/www.bdfancomics.ch\/wp-content\/uploads\/2026\/08\/etb-pokemon-coffret-dresseur-elite-equilibre-parfait-mega-evolution.webp 1000w, https:\/\/www.bdfancomics.ch\/wp-content\/uploads\/2026\/08\/etb-pokemon-coffret-dresseur-elite-equilibre-parfait-mega-evolution-300x300.webp 300w, https:\/\/www.bdfancomics.ch\/wp-content\/uploads\/2026\/08\/etb-pokemon-coffret-dresseur-elite-equilibre-parfait-mega-evolution-150x150.webp 150w, https:\/\/www.bdfancomics.ch\/wp-content\/uploads\/2026\/08\/etb-pokemon-coffret-dresseur-elite-equilibre-parfait-mega-evolution-768x768.webp 768w, https:\/\/www.bdfancomics.ch\/wp-content\/uploads\/2026\/08\/etb-pokemon-coffret-dresseur-elite-equilibre-parfait-mega-evolution-500x500.webp 500w, https:\/\/www.bdfancomics.ch\/wp-content\/uploads\/2026\/08\/etb-pokemon-coffret-dresseur-elite-equilibre-parfait-mega-evolution-600x600.webp 600w, https:\/\/www.bdfancomics.ch\/wp-content\/uploads\/2026\/08\/etb-pokemon-coffret-dresseur-elite-equilibre-parfait-mega-evolution-100x100.webp 100w, https:\/\/www.bdfancomics.ch\/wp-content\/uploads\/2026\/08\/etb-pokemon-coffret-dresseur-elite-equilibre-parfait-mega-evolution-64x64.webp 64w","sizes":"(max-width: 1000px) 100vw, 1000px","thumbnail_srcset":"https:\/\/www.bdfancomics.ch\/wp-content\/uploads\/2026\/08\/etb-pokemon-coffret-dresseur-elite-equilibre-parfait-mega-evolution-500x500.webp 500w, https:\/\/www.bdfancomics.ch\/wp-content\/uploads\/2026\/08\/etb-pokemon-coffret-dresseur-elite-equilibre-parfait-mega-evolution-300x300.webp 300w, https:\/\/www.bdfancomics.ch\/wp-content\/uploads\/2026\/08\/etb-pokemon-coffret-dresseur-elite-equilibre-parfait-mega-evolution-150x150.webp 150w, https:\/\/www.bdfancomics.ch\/wp-content\/uploads\/2026\/08\/etb-pokemon-coffret-dresseur-elite-equilibre-parfait-mega-evolution-768x768.webp 768w, https:\/\/www.bdfancomics.ch\/wp-content\/uploads\/2026\/08\/etb-pokemon-coffret-dresseur-elite-equilibre-parfait-mega-evolution-600x600.webp 600w, https:\/\/www.bdfancomics.ch\/wp-content\/uploads\/2026\/08\/etb-pokemon-coffret-dresseur-elite-equilibre-parfait-mega-evolution-100x100.webp 100w, https:\/\/www.bdfancomics.ch\/wp-content\/uploads\/2026\/08\/etb-pokemon-coffret-dresseur-elite-equilibre-parfait-mega-evolution-64x64.webp 64w, https:\/\/www.bdfancomics.ch\/wp-content\/uploads\/2026\/08\/etb-pokemon-coffret-dresseur-elite-equilibre-parfait-mega-evolution.webp 1000w","thumbnail_sizes":"(max-width: 500px) 100vw, 500px","name":"ETB Pok\u00e9mon Coffret Dresseur d\u2019Elite ME03 Equilibre Parfait","alt":"ETB Pok\u00e9mon Coffret Dresseur d\u2019Elite ME03 Equilibre Parfait"}],"categories":[{"id":2631,"name":"ETB Pok\u00e9mon en Fran\u00e7ais","slug":"etb","link":"https:\/\/www.bdfancomics.ch\/categorie-produit\/cartes-a-collectionner\/pokemon-cartes\/cartes-pokemon-en-francais\/etb\/"}],"tags":[],"brands":[{"id":6477,"name":"The Pok\u00e9mon Company","slug":"the-pokemon-company","link":"https:\/\/www.bdfancomics.ch\/marque\/the-pokemon-company\/"}],"attributes":[{"id":11,"name":"Licence","taxonomy":"pa_licence","has_variations":false,"terms":[{"id":6680,"name":"Pok\u00e9mon","slug":"pokemon"}]},{"id":7,"name":"Langue","taxonomy":"pa_langue","has_variations":false,"terms":[{"id":5361,"name":"Fran\u00e7ais","slug":"francais"}]},{"id":37,"name":"Type de produit TCG","taxonomy":"pa_format-tcg","has_variations":false,"terms":[{"id":12053,"name":"ETB","slug":"etb"}]},{"id":38,"name":"Bloc Pok\u00e9mon","taxonomy":"pa_bloc-pokemon","has_variations":false,"terms":[{"id":12065,"name":"M\u00e9ga-\u00c9volution","slug":"mega-evolution"}]},{"id":39,"name":"Extension","taxonomy":"pa_extension","has_variations":false,"terms":[{"id":12082,"name":"\u00c9quilibre Parfait","slug":"equilibre-parfait"}]}],"variations":[],"grouped_products":[],"has_options":false,"is_purchasable":true,"is_in_stock":true,"is_on_backorder":false,"low_stock_remaining":null,"stock_availability":{"text":"En stock","class":"in-stock"},"sold_individually":false,"weight":"","dimensions":{"length":"","width":"","height":""},"formatted_weight":"ND","formatted_dimensions":"ND","add_to_cart":{"text":"Ajouter au panier","description":"Ajouter au panier\u00a0: &ldquo;ETB Pok\u00e9mon Coffret Dresseur d\u2019Elite ME03 Equilibre Parfait&rdquo;","url":"\/wp-json\/wc\/store\/v1\/products?search=pokemon&#038;per_page=100&#038;orderby=date&#038;order=desc&#038;add-to-cart=89034","single_text":"Ajouter au panier","minimum":1,"maximum":9,"multiple_of":1},"is_password_protected":false,"extensions":{},"_links":{"self":[{"href":"https:\/\/www.bdfancomics.ch\/wp-json\/wc\/store\/v1\/products\/89034","targetHints":{"allow":["GET"]}}],"collection":[{"href":"https:\/\/www.bdfancomics.ch\/wp-json\/wc\/store\/v1\/products"}],"upsells":[{"embeddable":true,"href":"https:\/\/www.bdfancomics.ch\/wp-json\/wc\/store\/v1\/products?include=89021,89020,89015,89007"}],"cross_sells":[{"embeddable":true,"href":"https:\/\/www.bdfancomics.ch\/wp-json\/wc\/store\/v1\/products?include=88455,89183,91139,89714"}],"related":[{"embeddable":true,"href":"https:\/\/www.bdfancomics.ch\/wp-json\/wc\/store\/v1\/products?related=89034&per_page=10"}]}},{"id":89032,"name":"ETB Pok\u00e9mon Coffret Dresseur d\u2019Elite ME04 Chaos Ascendant","slug":"etb-pokemon-chaos-ascendant-me04","parent":0,"type":"simple","variation":"","permalink":"https:\/\/www.bdfancomics.ch\/produit\/etb-pokemon-chaos-ascendant-me04\/","sku":"196214139961","short_description":"<p>L&rsquo;<strong>ETB Chaos Ascendant<\/strong> contient 9 boosters de l&rsquo;extension ME04, une carte promo pleine illustration de Feunnec, 65 prot\u00e8ge-cartes, 40 \u00c9nergies et tout le mat\u00e9riel pour jouer.<\/p>\n<p>Le coffret qui ram\u00e8ne le chaos dans les rues d&rsquo;Illumis.<\/p>","description":"<h2>ETB Chaos Ascendant : Illumis en pleine temp\u00eate<\/h2>\n<p>Chaos Ascendant, sortie en fran\u00e7ais le 22 mai 2026, se d\u00e9roule \u00e0 Illumis, la grande ville de la r\u00e9gion de Kalos. M\u00e9ga-Floette-ex y s\u00e8me le d\u00e9sordre, et M\u00e9ga-Amphinobi-ex, M\u00e9ga-N\u00e9m\u00e9lios-ex et M\u00e9ga-Kravarech-ex se l\u00e8vent pour r\u00e9tablir l&rsquo;ordre. L&rsquo;<strong>ETB Chaos Ascendant<\/strong> est le coffret complet pour suivre cette histoire carte apr\u00e8s carte.<\/p>\n<h3>Le contenu officiel<\/h3>\n<p>Le coffret r\u00e9unit 9 boosters Chaos Ascendant, une carte promo brillante enti\u00e8rement illustr\u00e9e de Feunnec, 65 prot\u00e8ge-cartes, 40 cartes \u00c9nergie, le guide de jeu de l&rsquo;extension, 6 d\u00e9s marqueurs de d\u00e9g\u00e2ts, un d\u00e9 de pi\u00e8ce autoris\u00e9 en comp\u00e9tition, une pi\u00e8ce en plastique, un coffret de collection avec 6 s\u00e9parateurs et une carte \u00e0 code pour Pok\u00e9mon TCG Live.<\/p>\n<h3>Feunnec, le renard de Kalos<\/h3>\n<p>Feunnec est l&rsquo;un des trois Pok\u00e9mon de d\u00e9part de Pok\u00e9mon X et Y, avec Marisson et Grenousse. Ce petit renard de feu grignote des brindilles pour se donner de l&rsquo;\u00e9nergie, et ses grandes oreilles d\u00e9gagent de l&rsquo;air chaud. Il \u00e9volue en Roussil puis en Goupelin, un magicien qui tire des flammes de sa baguette. Retrouver Feunnec en promo pleine illustration dans une extension qui se passe \u00e0 Illumis, c&rsquo;est un joli retour aux sources pour tous ceux qui l&rsquo;avaient choisi en 2013.<\/p>\n<h3>Illumis, une vraie ville de fans<\/h3>\n<p>Illumis est inspir\u00e9e de Paris, avec sa Tour Prismatique au centre en guise de tour Eiffel. C&rsquo;est aussi le cadre de L\u00e9gendes Pok\u00e9mon : Z-A, le jeu qui a remis les M\u00e9ga-\u00c9volutions sur le devant de la sc\u00e8ne. Dans les boosters, les fans de Kalos retrouveront donc des visages familiers, M\u00e9ga ou non.<\/p>\n<h3>Jouer et ranger<\/h3>\n<p>Les 40 \u00c9nergies, les 65 prot\u00e8ge-cartes et les d\u00e9s suffisent pour jouer une partie compl\u00e8te d\u00e8s l&rsquo;ouverture. Le guide pr\u00e9sente les cartes cl\u00e9s et les r\u00e8gles des M\u00e9ga. La bo\u00eete, elle, finit en classeur de secours pour les doublons et les cartes \u00e0 \u00e9changer.<\/p>\n<p>L&rsquo;extension est d\u00e9crite sur la page <a href=\"https:\/\/www.bdfancomics.ch\/extension\/chaos-ascendant\/\"><strong>Chaos Ascendant<\/strong><\/a>. Pour aller plus loin : le <a href=\"https:\/\/www.bdfancomics.ch\/produit\/display-chaos-ascendant-me04\/\"><strong>Display Chaos Ascendant<\/strong><\/a> (36 boosters) ou le <a href=\"https:\/\/www.bdfancomics.ch\/produit\/tripack-pokemon-chaos-ascendant-me4\/\"><strong>Tripack Chaos Ascendant<\/strong><\/a>. Les autres coffrets sont dans les <a href=\"https:\/\/www.bdfancomics.ch\/categorie-produit\/cartes-a-collectionner\/pokemon-cartes\/cartes-pokemon-en-francais\/etb\/\"><strong>ETB Pok\u00e9mon en fran\u00e7ais<\/strong><\/a>.<\/p>\n<h3>Caract\u00e9ristiques<\/h3>\n<p>Coffret Dresseur d&rsquo;\u00e9lite M\u00e9ga-\u00c9volution \u2013 Chaos Ascendant (ME04), version fran\u00e7aise. Contenu : 9 boosters, 1 carte promo Feunnec pleine illustration, 65 prot\u00e8ge-cartes, 40 cartes \u00c9nergie, 1 guide, 6 d\u00e9s de d\u00e9g\u00e2ts, 1 d\u00e9 pile ou face, 1 pi\u00e8ce plastique, 1 bo\u00eete avec 6 s\u00e9parateurs, 1 carte \u00e0 code. Sortie : 22 mai 2026. EAN : 196214139961.<\/p>\n<div class=\"category-seo-more\">\n<details>\n<summary style=\"cursor:pointer;color:#cc0000\"><strong><span style=\"color:#ffffff\">Lire plus<\/span><\/strong><\/summary>\n<p>Feunnec mange des brindilles pour faire le plein d&rsquo;\u00e9nergie. Pour ouvrir neuf boosters d&rsquo;affil\u00e9e, un go\u00fbter un peu plus consistant est recommand\u00e9.<\/p>\n<\/details>\n<\/div>","on_sale":false,"prices":{"price":"7990","regular_price":"7990","sale_price":"7990","price_range":null,"currency_code":"CHF","currency_symbol":"CHF","currency_minor_unit":2,"currency_decimal_separator":",","currency_thousand_separator":"","currency_prefix":"","currency_suffix":"CHF"},"price_html":"<span class=\"woocommerce-Price-amount amount\">79,90<span class=\"woocommerce-Price-currencySymbol\" dir=\"auto\">&#067;&#072;&#070;<\/span><\/span>","average_rating":"0","review_count":0,"images":[{"id":92032,"src":"https:\/\/www.bdfancomics.ch\/wp-content\/uploads\/2026\/08\/etb-pokemon-coffret-dresseur-elite-chaos-ascendant-mega-evolution.webp","thumbnail":"https:\/\/www.bdfancomics.ch\/wp-content\/uploads\/2026\/08\/etb-pokemon-coffret-dresseur-elite-chaos-ascendant-mega-evolution-500x500.webp","srcset":"https:\/\/www.bdfancomics.ch\/wp-content\/uploads\/2026\/08\/etb-pokemon-coffret-dresseur-elite-chaos-ascendant-mega-evolution.webp 1000w, https:\/\/www.bdfancomics.ch\/wp-content\/uploads\/2026\/08\/etb-pokemon-coffret-dresseur-elite-chaos-ascendant-mega-evolution-300x300.webp 300w, https:\/\/www.bdfancomics.ch\/wp-content\/uploads\/2026\/08\/etb-pokemon-coffret-dresseur-elite-chaos-ascendant-mega-evolution-150x150.webp 