00e7ais","slug":"coffrets-pokemon-en-francais","link":"https:\/\/www.bdfancomics.ch\/categorie-produit\/cartes-a-collectionner\/pokemon-cartes\/cartes-pokemon-en-francais\/coffrets-pokemon-en-francais\/"}],"tags":[],"brands":[{"id":6477,"name":"The Pok\u00e9mon Company","slug":"the-pokemon-company","link":"https:\/\/www.bdfancomics.ch\/marque\/the-pokemon-company\/"}],"attributes":[{"id":11,"name":"Licence","taxonomy":"pa_licence","has_variations":false,"terms":[{"id":6680,"name":"Pok\u00e9mon","slug":"pokemon"}]},{"id":7,"name":"Langue","taxonomy":"pa_langue","has_variations":false,"terms":[{"id":5361,"name":"Fran\u00e7ais","slug":"francais"}]},{"id":37,"name":"Type de produit TCG","taxonomy":"pa_format-tcg","has_variations":false,"terms":[{"id":12052,"name":"Coffret","slug":"coffret"}]},{"id":38,"name":"Bloc Pok\u00e9mon","taxonomy":"pa_bloc-pokemon","has_variations":false,"terms":[{"id":12066,"name":"\u00c9carlate et Violet","slug":"ecarlate-et-violet"}]},{"id":39,"name":"Extension","taxonomy":"pa_extension","has_variations":false,"terms":[{"id":12071,"name":"\u00c9carlate et Violet","slug":"ecarlate-et-violet"},{"id":12073,"name":"Faille Paradoxe","slug":"faille-paradoxe"},{"id":12076,"name":"Rivalit\u00e9s Destin\u00e9es","slug":"rivalites-destinees"}]}],"variations":[],"grouped_products":[],"has_options":false,"is_purchasable":true,"is_in_stock":true,"is_on_backorder":false,"low_stock_remaining":null,"stock_availability":{"text":"En stock","class":"in-stock"},"sold_individually":false,"weight":"","dimensions":{"length":"","width":"","height":""},"formatted_weight":"ND","formatted_dimensions":"ND","add_to_cart":{"text":"Ajouter au panier","description":"Ajouter au panier\u00a0: &ldquo;Coffret Pok\u00e9mon Collection Sp\u00e9ciale Amphinobi-ex et Hyporoi-ex&rdquo;","url":"\/wp-json\/wc\/store\/v1\/products?search=pokemon&#038;per_page=100&#038;orderby=date&#038;order=desc&#038;add-to-cart=89000","single_text":"Ajouter au panier","minimum":1,"maximum":6,"multiple_of":1},"is_password_protected":false,"extensions":{},"_links":{"self":[{"href":"https:\/\/www.bdfancomics.ch\/wp-json\/wc\/store\/v1\/products\/89000","targetHints":{"allow":["GET"]}}],"collection":[{"href":"https:\/\/www.bdfancomics.ch\/wp-json\/wc\/store\/v1\/products"}],"upsells":[{"embeddable":true,"href":"https:\/\/www.bdfancomics.ch\/wp-json\/wc\/store\/v1\/products?include=88999,88352,89004,88998"}],"cross_sells":[{"embeddable":true,"href":"https:\/\/www.bdfancomics.ch\/wp-json\/wc\/store\/v1\/products?include=89428,89183,91139,89714"}],"related":[{"embeddable":true,"href":"https:\/\/www.bdfancomics.ch\/wp-json\/wc\/store\/v1\/products?related=89000&per_page=10"}]}},{"id":88999,"name":"Coffret Pok\u00e9mon Florizarre Ex et Tortank Ex","slug":"coffret-pokemon-florizarre-ex-et-tortank-ex","parent":0,"type":"simple","variation":"","permalink":"https:\/\/www.bdfancomics.ch\/produit\/coffret-pokemon-florizarre-ex-et-tortank-ex\/","sku":"196214129900","short_description":"<p>La <strong>Collection Premium Florizarre-ex et Tortank-ex<\/strong> contient une carte promo de chacun, une carte grand format de Florizarre-ex et 10 boosters du JCC Pok\u00e9mon.<\/p>\n<p>Deux starters de Kanto, pour ceux qui n&rsquo;ont jamais su choisir.<\/p>","description":"<h2>Collection Premium Florizarre-ex et Tortank-ex : deux starters de 1996<\/h2>\n<p>En 1996, tout commen\u00e7ait par un choix dans le laboratoire du Professeur Chen : Bulbizarre, Salam\u00e8che ou Carapuce. La <strong>Collection Premium Florizarre-ex et Tortank-ex<\/strong> r\u00e9unit deux de ces trois premiers partenaires, sous leur forme finale.<\/p>\n<h3>Le contenu<\/h3>\n<p>Le coffret contient une carte promo de Florizarre-ex, une carte promo de Tortank-ex, une carte grand format de Florizarre-ex et 10 boosters du JCC Pok\u00e9mon de l&rsquo;\u00e8re \u00c9carlate et Violet. Sur la photo, on aper\u00e7oit notamment un booster Couronne Stellaire. C&rsquo;est l&rsquo;un des coffrets les plus g\u00e9n\u00e9reux en boosters de sa gamme.<\/p>\n<h3>Florizarre, la plante qui a grandi avec nous<\/h3>\n<p>Florizarre est le num\u00e9ro 3 du Pok\u00e9dex national. La fleur sur son dos s&rsquo;\u00e9panouit en absorbant le soleil, et son parfum apaiserait les Pok\u00e9mon autour de lui. Il a longtemps \u00e9t\u00e9 le choix \u00ab sage \u00bb des joueurs, celui qui facilite les deux premi\u00e8res ar\u00e8nes de Pok\u00e9mon Rouge et Bleu.<\/p>\n<h3>Tortank, la tortue aux canons<\/h3>\n<p>Tortank, num\u00e9ro 9, porte deux canons \u00e0 eau sur sa carapace. C&rsquo;\u00e9tait la mascotte de Pok\u00e9mon Bleu, et beaucoup de joueurs se souviennent de sa silhouette sur la bo\u00eete du jeu. Dans le dessin anim\u00e9, le Carapuce de Sacha, ancien chef d&rsquo;une bande de Carapuce farceurs avec ses lunettes de soleil, est rest\u00e9 un personnage culte.<\/p>\n<h3>Pour qui ?<\/h3>\n<p>Pour les nostalgiques de la premi\u00e8re g\u00e9n\u00e9ration, pour ceux qui collectionnent les starters, et pour les familles qui ouvrent ensemble : dix boosters, c&rsquo;est 100 cartes \u00e0 partager. La carte grand format, elle, a sa place dans une vitrine.<\/p>\n<p>Le troisi\u00e8me starter n&rsquo;est pas oubli\u00e9 : Dracaufeu a sa carte en m\u00e9tal dans la <a href=\"https:\/\/www.bdfancomics.ch\/produit\/coffret-pokemon-ultra-premium-collection-25-ans\/\"><strong>Collection Ultra-Premium C\u00e9l\u00e9brations<\/strong><\/a>. L&rsquo;extension <a href=\"https:\/\/www.bdfancomics.ch\/extension\/couronne-stellaire\/\"><strong>Couronne Stellaire<\/strong><\/a> a sa page d\u00e9di\u00e9e, et l&rsquo;extension <a href=\"https:\/\/www.bdfancomics.ch\/extension\/151\/\"><strong>151<\/strong><\/a> c\u00e9l\u00e8bre tous les Pok\u00e9mon de Kanto. Le reste de la famille se trouve dans les <a href=\"https:\/\/www.bdfancomics.ch\/categorie-produit\/cartes-a-collectionner\/pokemon-cartes\/cartes-pokemon-en-francais\/coffrets-pokemon-en-francais\/\"><strong>coffrets Pok\u00e9mon en fran\u00e7ais<\/strong><\/a>.<\/p>\n<h3>Caract\u00e9ristiques<\/h3>\n<p>Collection Premium Florizarre-ex et Tortank-ex, version fran\u00e7aise. Contenu : 1 carte promo Florizarre-ex, 1 carte promo Tortank-ex, 1 carte grand format Florizarre-ex, 10 boosters du JCC Pok\u00e9mon. EAN : 196214129900.<\/p>\n<div class=\"category-seo-more\">\n<details>\n<summary style=\"cursor:pointer;color:#cc0000\"><strong><span style=\"color:#ffffff\">Lire plus<\/span><\/strong><\/summary>\n<p>Trente ans apr\u00e8s, le d\u00e9bat Bulbizarre ou Carapuce n&rsquo;est toujours pas tranch\u00e9. Ce coffret propose une solution diplomatique : prendre les deux.<\/p>\n<\/details>\n<\/div>","on_sale":false,"prices":{"price":"8900","regular_price":"8900","sale_price":"8900","price_range":null,"currency_code":"CHF","currency_symbol":"CHF","currency_minor_unit":2,"currency_decimal_separator":",","currency_thousand_separator":"","currency_prefix":"","currency_suffix":"CHF"},"price_html":"<span class=\"woocommerce-Price-amount amount\">89,00<span class=\"woocommerce-Price-currencySymbol\" dir=\"auto\">&#067;&#072;&#070;<\/span><\/span>","average_rating":"0","review_count":0,"images":[{"id":92049,"src":"https:\/\/www.bdfancomics.ch\/wp-content\/uploads\/2026\/08\/coffret-pokemon-florizarre-ex-et-tortank-ex.webp","thumbnail":"https:\/\/www.bdfancomics.ch\/wp-content\/uploads\/2026\/08\/coffret-pokemon-florizarre-ex-et-tortank-ex-500x500.webp","srcset":"https:\/\/www.bdfancomics.ch\/wp-content\/uploads\/2026\/08\/coffret-pokemon-florizarre-ex-et-tortank-ex.webp 1080w, https:\/\/www.bdfancomics.ch\/wp-content\/uploads\/2026\/08\/coffret-pokemon-florizarre-ex-et-tortank-ex-300x300.webp 300w, https:\/\/www.bdfancomics.ch\/wp-content\/uploads\/2026\/08\/coffret-pokemon-florizarre-ex-et-tortank-ex-1024x1024.webp 1024w, https:\/\/www.bdfancomics.ch\/wp-content\/uploads\/2026\/08\/coffret-pokemon-florizarre-ex-et-tortank-ex-150x150.webp 150w, https:\/\/www.bdfancomics.ch\/wp-content\/uploads\/2026\/08\/coffret-pokemon-florizarre-ex-et-t