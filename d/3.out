ancomics.ch\/categorie-produit\/cartes-a-collectionner\/pokemon-cartes\/cartes-pokemon-en-francais\/coffrets-pokemon-en-francais\/"}],"tags":[],"brands":[{"id":6477,"name":"The Pok\u00e9mon Company","slug":"the-pokemon-company","link":"https:\/\/www.bdfancomics.ch\/marque\/the-pokemon-company\/"}],"attributes":[{"id":11,"name":"Licence","taxonomy":"pa_licence","has_variations":false,"terms":[{"id":6680,"name":"Pok\u00e9mon","slug":"pokemon"}]},{"id":7,"name":"Langue","taxonomy":"pa_langue","has_variations":false,"terms":[{"id":5361,"name":"Fran\u00e7ais","slug":"francais"}]},{"id":37,"name":"Type de produit TCG","taxonomy":"pa_format-tcg","has_variations":false,"terms":[{"id":12052,"name":"Coffret","slug":"coffret"}]},{"id":38,"name":"Bloc Pok\u00e9mon","taxonomy":"pa_bloc-pokemon","has_variations":false,"terms":[{"id":12066,"name":"\u00c9carlate et Violet","slug":"ecarlate-et-violet"}]},{"id":39,"name":"Extension","taxonomy":"pa_extension","has_variations":false,"terms":[{"id":12071,"name":"\u00c9carlate et Violet","slug":"ecarlate-et-violet"},{"id":12073,"name":"Faille Paradoxe","slug":"faille-paradoxe"},{"id":12076,"name":"Rivalit\u00e9s Destin\u00e9es","slug":"rivalites-destinees"}]}],"variations":[],"grouped_products":[],"has_options":false,"is_purchasable":true,"is_in_stock":true,"is_on_backorder":false,"low_stock_remaining":1,"stock_availability":{"text":"Plus que 1 en stock","class":"in-stock"},"sold_individually":false,"weight":"","dimensions":{"length":"","width":"","height":""},"formatted_weight":"ND","formatted_dimensions":"ND","add_to_cart":{"text":"Ajouter au panier","description":"Ajouter au panier\u00a0: &ldquo;Coffret Pok\u00e9mon Florizarre Ex et Tortank Ex&rdquo;","url":"\/wp-json\/wc\/store\/v1\/products?search=pokemon&#038;per_page=100&#038;orderby=date&#038;order=desc&#038;add-to-cart=88999","single_text":"Ajouter au panier","minimum":1,"maximum":1,"multiple_of":1},"is_password_protected":false,"extensions":{},"_links":{"self":[{"href":"https:\/\/www.bdfancomics.ch\/wp-json\/wc\/store\/v1\/products\/88999","targetHints":{"allow":["GET"]}}],"collection":[{"href":"https:\/\/www.bdfancomics.ch\/wp-json\/wc\/store\/v1\/products"}],"upsells":[{"embeddable":true,"href":"https:\/\/www.bdfancomics.ch\/wp-json\/wc\/store\/v1\/products?include=88352,89004,89000,88998"}],"cross_sells":[{"embeddable":true,"href":"https:\/\/www.bdfancomics.ch\/wp-json\/wc\/store\/v1\/products?include=89428,89183,91139,89714"}],"related":[{"embeddable":true,"href":"https:\/\/www.bdfancomics.ch\/wp-json\/wc\/store\/v1\/products?related=88999&per_page=10"}]}},{"id":88998,"name":"Coffret Pok\u00e9mon F\u00e9linferno Ex Et Torterra Ex","slug":"coffret-pokemon-felinferno-ex-et-torterra-ex","parent":0,"type":"simple","variation":"","permalink":"https:\/\/www.bdfancomics.ch\/produit\/coffret-pokemon-felinferno-ex-et-torterra-ex\/","sku":"196214129887","short_description":"<p>La <strong>Collection sp\u00e9ciale F\u00e9linferno-ex et Torterra-ex<\/strong> r\u00e9unit une carte promo de chacun, une carte grand format de F\u00e9linferno-ex et 8 boosters du JCC Pok\u00e9mon.<\/p>\n<p>Un catcheur d&rsquo;Alola et une tortue-continent de Sinnoh.<\/p>","description":"<h2>Collection sp\u00e9ciale F\u00e9linferno-ex et Torterra-ex : le catcheur et la montagne<\/h2>\n<p>La <strong>Collection sp\u00e9ciale F\u00e9linferno-ex et Torterra-ex<\/strong> associe deux starters que tout oppose : un f\u00e9lin de feu qui se prend pour un catcheur, et une tortue si grande qu&rsquo;on la prenait pour une \u00eele. Deux \u00e9volutions finales, deux r\u00e9gions, une seule bo\u00eete.<\/p>\n<h3>Le contenu<\/h3>\n<p>Le coffret contient une carte promo de F\u00e9linferno-ex, une carte promo de Torterra-ex, une carte grand format de F\u00e9linferno-ex et 8 boosters du JCC Pok\u00e9mon issus de l&rsquo;\u00e9poque \u00c9carlate et Violet. La carte de F\u00e9linferno-ex visible sur la bo\u00eete affiche 320 PV.<\/p>\n<h3>F\u00e9linferno, le catcheur d&rsquo;Alola<\/h3>\n<p>F\u00e9linferno est l&rsquo;\u00e9volution finale de Flamiaou, le starter Feu de Pok\u00e9mon Soleil et Lune. Ceinture enflamm\u00e9e autour de la taille, poses de lutteur, attaque signature Dark Lariat : il a \u00e9t\u00e9 pens\u00e9 comme un v\u00e9ritable catcheur de ring. Il est d&rsquo;ailleurs devenu l&rsquo;un des Pok\u00e9mon les plus jou\u00e9s en comp\u00e9tition dans les jeux vid\u00e9o.<\/p>\n<h3>Torterra, une for\u00eat sur le dos<\/h3>\n<p>Torterra est le dernier stade de Tortipouss, le starter Plante de Pok\u00e9mon Diamant et Perle. Un arbre pousse sur sa carapace, et le Pok\u00e9dex raconte que les anciens imaginaient un Torterra g\u00e9ant vivant sous la terre. Certains petits Pok\u00e9mon na\u00eetraient m\u00eame sur son dos et y passeraient toute leur vie. Une cr\u00e9ature \u00e0 la fois douce et imposante, tr\u00e8s appr\u00e9ci\u00e9e des fans de Sinnoh.<\/p>\n<h3>Pour qui ?<\/h3>\n<p>Pour les fans de starters, pour ceux qui ont commenc\u00e9 l&rsquo;aventure \u00e0 Sinnoh ou \u00e0 Alola, et pour tous ceux qui aiment ouvrir huit boosters d&rsquo;un coup. La carte grand format de F\u00e9linferno-ex, elle, fera un bel effet dans une chambre d&rsquo;enfant comme dans une vitrine.<\/p>\n<p>Pour d&rsquo;autres starters, la <a href=\"https:\/\/www.bdfancomics.ch\/produit\/coffret-pokemon-florizarre-ex-et-tortank-ex\/\"><strong>Collection Premium Florizarre-ex et Tortank-ex<\/strong><\/a> r\u00e9unit ceux de Kanto. Les boosters inclus viennent notamment d&rsquo;extensions comme <a href=\"https:\/\/www.bdfancomics.ch\/extension\/aventures-ensemble\/\"><strong>Aventures Ensemble<\/strong><\/a>. \u00c0 parcourir aussi : les <a href=\"https:\/\/www.bdfancomics.ch\/categorie-produit\/cartes-a-collectionner\/pokemon-cartes\/cartes-pokemon-en-francais\/coffrets-pokemon-en-francais\/\"><strong>coffrets Pok\u00e9mon en fran\u00e7ais<\/strong><\/a>.<\/p>\n<h3>Caract\u00e9ristiques<\/h3>\n<p>Collection sp\u00e9ciale F\u00e9linferno-ex et Torterra-ex, version fran\u00e7aise. Contenu : 1 carte promo F\u00e9linferno-ex, 1 carte promo Torterra-ex, 1 carte grand format F\u00e9linferno-ex, 8 boosters du JCC Pok\u00e9mon. EAN : 196214129887.<\/p>\n<div class=\"category-seo-more\">\n<details>\n<summary style=\"cursor:pointer;color:#cc0000\"><strong><span style=\"color:#ffffff\">Lire plus<\/span><\/strong><\/summary>\n<p>F\u00e9linferno fait du catch, Torterra porte une for\u00eat sur son dos. Entre les deux, vos huit boosters n&rsquo;ont qu&rsquo;\u00e0 bien se tenir.<\/p>\n<\/details>\n<\/div>","on_sale":false,"prices":{"price":"6900","regular_price":"6900","sale_price":"6900","price_range":null,"currency_code":"CHF","currency_symbol":"CHF","currency_minor_unit":2,"currency_decimal_separator":",","currency_thousand_separator":"","currency_prefix":"","currency_suffix":"CHF"},"price_html":"<span class=\"woocommerce-Price-amount amount\">69,00<span class=\"woocommerce-Price-currencySymbol\" dir=\"auto\">&#067;&#072;&#070;<\/span><\/span>","average_rating":"0","review_count":0,"images":[{"id":91012,"src":"https:\/\/www.bdfancomics.ch\/wp-content\/uploads\/2026\/08\/coffret-pokemon-felinferno-ex-et-torterra-ex.webp","thumbnail":"https:\/\/www.bdfancomics.ch\/wp-content\/uploads\/2026\/08\/coffret-pokemon-felinferno-ex-et-torterra-ex-500x500.webp","srcset":"https:\/\/www.bdfancomics.ch\/wp-content\/uploads\/2026\/08\/coffret-pokemon-felinferno-ex-et-torterra-ex.webp 1000w, https:\/\/www.bdfancomics.ch\/wp-content\/uploads\/2026\/08\/coffret-pokemon-felinferno-ex-et-torterra-ex-300x300.webp 300w, https:\/\/www.bdfancomics.ch\/wp-content\/uploads\/2026\/08\/coffret-pokemon-felinferno-ex-et-torterra-ex-150x150.webp 150w, https:\/\/www.bdfancomics.ch\/wp-content\/uploads\/2026\/08\/coffret-pokemon-felinferno-ex-et-torterra-ex-768x768.webp 768w, https:\/\/www.bdfancomics.ch\/wp-content\/uploads\/2026\/08\/coffret-pokemon-felinferno-ex-et-torterra-ex-500x500.webp 500w, https:\/\/www.bdfancomics.ch\/wp-content\/uploads\/2026\/08\/coffr