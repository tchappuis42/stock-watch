0\/figurine-pokemon-pikachu-2-nyon-1024x1024.webp 1024w, https:\/\/www.bdfancomics.ch\/wp-content\/uploads\/2026\/10\/figurine-pokemon-pikachu-2-nyon-150x150.webp 150w, https:\/\/www.bdfancomics.ch\/wp-content\/uploads\/2026\/10\/figurine-pokemon-pikachu-2-nyon-768x768.webp 768w, https:\/\/www.bdfancomics.ch\/wp-content\/uploads\/2026\/10\/figurine-pokemon-pikachu-2-nyon-600x600.webp 600w, https:\/\/www.bdfancomics.ch\/wp-content\/uploads\/2026\/10\/figurine-pokemon-pikachu-2-nyon-100x100.webp 100w, https:\/\/www.bdfancomics.ch\/wp-content\/uploads\/2026\/10\/figurine-pokemon-pikachu-2-nyon-64x64.webp 64w, https:\/\/www.bdfancomics.ch\/wp-content\/uploads\/2026\/10\/figurine-pokemon-pikachu-2-nyon.webp 1200w","thumbnail_sizes":"(max-width: 500px) 100vw, 500px","name":"Figurine Pok\u00e9mon Pikachu (bo\u00eete)","alt":"Figurine Pok\u00e9mon Pikachu dans sa bo\u00eete"}],"categories":[{"id":3873,"name":"Figurines Pok\u00e9mon","slug":"figurines-pokemon","link":"https:\/\/www.bdfancomics.ch\/categorie-produit\/figurines\/figurines-mangas\/figurines-pokemon\/"}],"tags":[],"brands":[{"id":6477,"name":"The Pok\u00e9mon Company","slug":"the-pokemon-company","link":"https:\/\/www.bdfancomics.ch\/marque\/the-pokemon-company\/"}],"attributes":[{"id":11,"name":"Licence","taxonomy":"pa_licence","has_variations":false,"terms":[{"id":6680,"name":"Pok\u00e9mon","slug":"pokemon"}]},{"id":13,"name":"Personnage","taxonomy":"pa_personnage","has_variations":false,"terms":[{"id":6741,"name":"Pikachu","slug":"pikachu"}]},{"id":12,"name":"Univers \/ M\u00e9dia","taxonomy":"pa_univers-media","has_variations":false,"terms":[{"id":6682,"name":"Anime","slug":"anime"}]},{"id":41,"name":"Fabricant","taxonomy":"pa_fabricant","has_variations":false,"terms":[{"id":12206,"name":"Funism","slug":"funism"}]},{"id":3,"name":"Taille","taxonomy":"pa_taille","has_variations":false,"terms":[{"id":12164,"name":"Moins de 15 cm","slug":"moins-de-15-cm"}]}],"variations":[],"grouped_products":[],"has_options":false,"is_purchasable":true,"is_in_stock":true,"is_on_backorder":false,"low_stock_remaining":null,"stock_availability":{"text":"En stock","class":"in-stock"},"sold_individually":false,"weight":"","dimensions":{"length":"","width":"","height":""},"formatted_weight":"ND","formatted_dimensions":"ND","add_to_cart":{"text":"Ajouter au panier","description":"Ajouter au panier\u00a0: &ldquo;Figurine Pok\u00e9mon Pikachu&rdquo;","url":"\/wp-json\/wc\/store\/v1\/products?search=pokemon&#038;per_page=100&#038;orderby=date&#038;order=desc&#038;add-to-cart=89134","single_text":"Ajouter au panier","minimum":1,"maximum":5,"multiple_of":1},"is_password_protected":false,"extensions":{},"_links":{"self":[{"href":"https:\/\/www.bdfancomics.ch\/wp-json\/wc\/store\/v1\/products\/89134","targetHints":{"allow":["GET"]}}],"collection":[{"href":"https:\/\/www.bdfancomics.ch\/wp-json\/wc\/store\/v1\/products"}],"upsells":[{"embeddable":true,"href":"https:\/\/www.bdfancomics.ch\/wp-json\/wc\/store\/v1\/products?include=89465,78164,89578,76404"}],"cross_sells":[{"embeddable":true,"href":"https:\/\/www.bdfancomics.ch\/wp-json\/wc\/store\/v1\/products?include=89130,89120,89111,44935"}],"related":[{"embeddable":true,"href":"https:\/\/www.bdfancomics.ch\/wp-json\/wc\/store\/v1\/products?related=89134&per_page=10"}]}},{"id":89133,"name":"Figurine Pok\u00e9mon Mimiqui","slug":"figurine-pokemon-mimiqui","parent":0,"type":"simple","variation":"","permalink":"https:\/\/www.bdfancomics.ch\/produit\/figurine-pokemon-mimiqui\/","sku":"6970834316872","short_description":"<p>Un costume de Pikachu cousu main, des yeux griffonn\u00e9s et une ombre violette qui d\u00e9borde : la <strong>figurine Pok\u00e9mon Mimiqui<\/strong> de Funism garde tout le myst\u00e8re du Pok\u00e9mon Spectre et F\u00e9e. Format Prime Figure Mini, une dizaine de centim\u00e8tres, base violette et emballage vitrine.<\/p>","description":"<h2>Figurine Pok\u00e9mon Mimiqui : il veut juste qu&rsquo;on l&rsquo;aime<\/h2>\n<p>On dirait un Pikachu dessin\u00e9 par un enfant, et c&rsquo;est exactement l&rsquo;id\u00e9e. Cette <strong>figurine Pok\u00e9mon Mimiqui<\/strong> reproduit son d\u00e9guisement de tissu jaune, avec ses yeux trac\u00e9s au crayon, ses joues rouges un peu de travers et sa fausse queue en \u00e9clair. Autour, des volutes violettes et translucides rappellent qu&rsquo;il y a autre chose l\u00e0-dessous.<\/p>\n<h3>Ce qui se cache sous le costume<\/h3>\n<p>Mimiqui, num\u00e9ro 0778, est apparu dans Pok\u00e9mon Soleil et Lune. Spectre et F\u00e9e, il porte un d\u00e9guisement imitant Pikachu dans l&rsquo;espoir de se faire des amis. Le Pok\u00e9dex reste volontairement flou sur sa vraie apparence, en pr\u00e9venant seulement qu&rsquo;il vaut mieux ne pas regarder.<\/p>\n<p>Cette histoire de Pok\u00e9mon solitaire qui se fabrique un costume pour \u00eatre aim\u00e9 a touch\u00e9 \u00e9norm\u00e9ment de joueurs. En combat, son talent Fant\u00f4masque lui permet d&rsquo;encaisser une premi\u00e8re attaque gr\u00e2ce au d\u00e9guisement, qui se casse alors au niveau du cou. Dans l&rsquo;anime, c&rsquo;est Jessie de la Team Rocket qui l&rsquo;a captur\u00e9, et il voue une haine tenace \u00e0 Pikachu.<\/p>\n<h3>Les d\u00e9tails qui comptent<\/h3>\n<p>Funism n&rsquo;a pas liss\u00e9 le costume. La t\u00eate penche l\u00e9g\u00e8rement, les coutures suppos\u00e9es se devinent, et les deux petits pieds noirs d\u00e9passent sous le tissu. L&rsquo;effet d&rsquo;ombre violette, qui s&rsquo;enroule de chaque c\u00f4t\u00e9, apporte une touche inqui\u00e9tante parfaitement dans l&rsquo;esprit du personnage.<\/p>\n<p>Sur la base violette, on lit <em>Mimikyu<\/em> et son nom chinois. Ceux qui gardent leurs figurines emball\u00e9es appr\u00e9cieront la bo\u00eete transparente, qui le montre sous toutes ses coutures.<\/p>\n<h3>L&rsquo;original et la copie<\/h3>\n<p>L&rsquo;id\u00e9e la plus dr\u00f4le reste de le poser \u00e0 c\u00f4t\u00e9 de celui qu&rsquo;il imite. La <a href=\"https:\/\/www.bdfancomics.ch\/produit\/figurine-pokemon-pikachu\/\"><strong>figurine Pikachu Prime Figure Mini<\/strong><\/a> a exactement le m\u00eame format : c\u00f4te \u00e0 c\u00f4te, on voit tout de suite qui a un costume. Mimiqui risque de ne pas appr\u00e9cier la comparaison, mais l&rsquo;\u00e9tag\u00e8re, elle, gagne une petite histoire.<\/p>\n<p>Il va aussi tr\u00e8s bien avec une vitrine de Pok\u00e9mon Spectre, ou simplement sur un bureau, o\u00f9 sa silhouette bancale attire le regard.<\/p>\n<p>Pour les joueurs, Mimiqui est aussi un vrai personnage de Pok\u00e9mon Soleil et Lune : on le croise dans le supermarch\u00e9 abandonn\u00e9 d&rsquo;Alola, l&rsquo;un des lieux les plus inqui\u00e9tants de l&rsquo;archipel, o\u00f9 des Pok\u00e9mon Spectre r\u00f4dent entre les rayons. Le cadre id\u00e9al pour un Pok\u00e9mon qui pr\u00e9f\u00e8re qu&rsquo;on le regarde \u00e0 travers un costume.<\/p>\n<p>C&rsquo;est un cadeau qui marche bien aupr\u00e8s des fans de la septi\u00e8me g\u00e9n\u00e9ration, mais aussi de ceux qui aiment les personnages un peu tristes et d\u00e9cal\u00e9s.<\/p>\n<h3>Caract\u00e9ristiques<\/h3>\n<p><strong>Fabricant :<\/strong> Funism \u00b7 <strong>Gamme :<\/strong> Prime Figure Mini \u00b7 <strong>Personnage :<\/strong> Mimiqui (n\u00b0 0778) \u00b7 <strong>Hauteur :<\/strong> environ 10 cm \u00b7 <strong>Mati\u00e8re :<\/strong> PVC \u00b7 <strong>Pr\u00e9sentation :<\/strong> bo\u00eete vitrine \u00b7 <strong>EAN :<\/strong> 6970834316872<\/p>\n<p>Figurine fixe sur socle, pour l&rsquo;exposition. \u00c9vitez de la laisser en plein soleil pour pr\u00e9server les couleurs de l&rsquo;effet violet.<\/p>\n<div class=\"category-seo-more\">\n<details>\n<summary style=\"cursor:pointer;color:#cc0000\"><strong><span style=\"color:#ffffff\">Lire plus<\/span><\/strong><\/summary>\n<p>Promis, on n&rsquo;a pas regard\u00e9 sous le costume avant de le mettre en rayon. On tient \u00e0 notre sant\u00e9, et lui \u00e0 son secret.<\/p>\n<\/details>\n<\/div>","on_sale":false,"prices":{"price":"2900","regular_price":"2900","sale_price":"2900","price_range":null,"currency_code":"CHF","currency_symbol":"CHF","currency_minor_unit":2,"currency_decimal_separator":",","currency_thousand_separator":"","currency_prefix":"","currency_suffix":"CHF"},"price_html":"<span class=\"woocommerce-Price-amount amount\">29,00<span class=\"woocommerce-Price-currencySymbol\" dir=\"auto\">&#067;&#072;&#070;<\/span><\/span>","average_rating":"0","review_count":0,"images":[{"id":93792,"src":"https:\/\/www.bdfancomics.ch\/wp-content\/uploads\/2026\/10\/figurine-pokemon-mimiqui-nyon.webp","thumbnail":"https:\/\/www.bdfancomics.ch\/wp-content\/uploads\/2026\/10\/figurine-pokemon-mimiqui-nyon-500x500.webp","srcset":"https:\/\/www.bdfancomics.ch\/wp-content\/uploads\/2026\/10\/figurine-pokemon-mimiqui-nyon.webp 1200w, https:\/\/www.bdfancomics.ch\/wp-content\/uploads\/2026\/10\/figurine-pokemon-mimiqui-nyon-300x300.webp 300w, https:\/\/www.bdfancomics.ch\/wp-content\/uploads\/2026\/10\/figurine-pokemon-mimiqui-nyon-1024x1024.webp 1024w, https:\/\/www.bdfancomics.ch\/wp-content\/uploads\/2026\/10\/figurine-pokemon-mimiqui-nyon-150x150.webp 150w, https:\/\/www.bdfancomics.ch\/wp-content\/uploads\/2026\/10\/figurine-pokemon-mimiqui-nyon-768x768.webp 768w, https:\/\/www.bdfancomics.ch\/wp-content\/uploads\/2026\/10\/figurine-pokemon-mimiqui-nyon-500x500.webp 500w, https:\/\/www.bdfancomics.ch\/wp-content\/uploads\/2026\/10\/figurine-pokemon-mimiqui-nyon-600x600.webp 600w, https:\/\/www.bdfancomics.ch\/wp-content\/uploads\/2026\/10\/figurine-pokemon-mimiqui-nyon-100x100.webp 100w, https:\/\/www.bdfancomics.ch\/wp-content\/uploads\/2026\/10\/figurine-pokemon-mimiqui-nyon-64x64.webp 64w","sizes":"(max-width: 1200px) 100vw, 1200px","thumbnail_srcset":"https:\/\/www.bdfancomics.ch\/wp-content\/uploads\/2026\/10\/figurine-pokemon-mimiqui-nyon-500x500.webp 500w, https:\/\/www.bdfancomics.ch\/wp-content\/uploads\/2026\/10\/figurine-pokemon-mimiqui-nyon-300x300.webp 300w, https:\/\/www.bdfancomics.ch\/wp-content\/uploads\/2026\/10\/figurine-pokemon-mimiqui-nyon-1024x1024.webp 1024w, https:\/\/www.bdfancomics.ch\/wp-content\/uploads\/2026\/10\/figurine-pokemon-mimiqui-nyon-150x150.webp 150w, https:\/\/www.bdfancomics.ch\/wp-content\/uploads\/2026\/10\/figurine-pokemon-mimiqui-nyon-768x768.webp 768w, https:\/\/www.bdfancomics.ch\/wp-content\/uploads\/2026\/10\/figurine-pokemon-mimiqui-nyon-600x600.webp 600w, https:\/\/www.bdfancomics.ch\/wp-content\/uploads\/2026\/10\/figurine-pokemon-mimiqui-nyon-100x100.webp 100w, https:\/\/www.bdfancomics.ch\/wp-content\/uploads\/2026\/10\/figurine-pokemon-mimiqui-nyon-64x64.webp 64w, https:\/\/www.bdfancomics.ch\/wp-content\/uploads\/2026\/10\/figurine-pokemon-mimiqui-nyon.webp 1200w","thumbnail_sizes":"(max-width: 500px) 100vw, 500px","name":"Figurine Pok\u00e9mon Mimiqui","alt":"Figurine Pok\u00e9mon Mimiqui"}],"categories":[{"id":3873,"name":"Figurines Pok\u00e9mon","slug":"figurines-pokemon","link":"https:\/\/www.bdfancomics.ch\/categorie-produit\/figurines\/figurines-mangas\/figurines-pokemon\/"}],"tags":[],"brands":[{"id":6477,"name":"The Pok\u00e9mon Company","slug":"the-pokemon-company","link":"https:\/\/www.bdfancomics.ch\/marque\/the-pokemon-company\/"}],"attributes":[{"id":11,"name":"Licence","taxonomy":"pa_licence","has_variations":false,"terms":[{"id":6680,"name":"Pok\u00e9mon","slug":"pokemon"}]},{"id":13,"name":"Personnage","taxonomy":"pa_personnage","has_variations":false,"terms":[{"id":6729,"name":"Mimiqui","slug":"mimiqui"}]},{"id":12,"name":"Univers \/ M\u00e9dia","taxonomy":"pa_univers-media","has_variations":false,"terms":[{"id":6682,"name":"Anime","slug":"anime"}]},{"id":41,"name":"Fabricant","taxonomy":"pa_fabricant","has_variations":false,"terms":[{"id":12206,"name":"Funism","slug":"funism"}]},{"id":3,"name":"Taille","taxonomy":"pa_taille","has_variations":false,"terms":[{"id":12164,"name":"Moins de 15 cm","slug":"moins-de-15-cm"}]}],"variations":[],"grouped_products":[],"has_options":false,"is_purchasable":true,"is_in_stock":true,"is_on_backorder":false,"low_stock_remaining":null,"stock_availability":{"text":"En stock","class":"in-stock"},"sold_individually":false,"weight":"","dimensions":{"length":"","width":"","height":""},"formatted_weight":"ND","formatted_dimensions":"ND","add_to_cart":{"text":"Ajouter au panier","description":"Ajouter au panier\u00a0: &ldquo;Figurine Pok\u00e9mon Mimiqui&rdquo;","url":"\/wp-json\/wc\/store\/v1\/products?search=pokemon&#038;per_page=100&#038;orderby=date&#038;order=desc&#038;add-to-cart=89133","single_text":"Ajouter au panier","minimum":1,"maximum":4,"multiple_of":1},"is_password_protected":false,"extensions":{},"_links":{"self":[{"href":"https:\/\/www.bdfancomics.ch\/wp-json\/wc\/store\/v1\/products\/89133","targetHints":{"allow":["GET"]}}],"collection":[{"href":"https:\/\/www.bdfancomics.ch\/wp-json\/wc\/store\/v1\/products"}],"upsells":[{"embeddable":true,"href":"https:\/\/www.bdfancomics.ch\/wp-json\/wc\/store\/v1\/products?include=89465,78164,89578,76404"}],"cross_sells":[{"embeddable":true,"href":"https:\/\/www.bdfancomics.ch\/wp-json\/wc\/store\/v1\/products?include=89130,89120,89111,44935"}],"related":[{"embeddable":true,"href":"https:\/\/www.bdfancomics.ch\/wp-json\/wc\/store\/v1\/products?related=89133&per_page=10"}]}},{"id":89132,"name":"Figurine Pok\u00e9mon Miaouss Saison","slug":"figurine-pokemon-miaouss-saison","parent":0,"type":"simple","variation":"","permalink":"https:\/\/www.bdfancomics.ch\/produit\/figurine-pokemon-miaouss-saison\/","sku":"6923517312920","short_description":"<p>Debout sur ses pattes arri\u00e8re, une Pok\u00e9 Ball \u00e0 c\u00f4t\u00e9 de lui et un buisson derri\u00e8re : la <strong>figurine Pok\u00e9mon Miaouss Saison<\/strong> de Langbowang met en sc\u00e8ne le chat le plus bavard de la Team Rocket dans un d\u00e9cor de plein air. Une petite sc\u00e8ne officielle, id\u00e9ale pour les fans de Jessie et James.<\/p>","description":"<h2>Figurine Pok\u00e9mon Miaouss Saison : le chat qui avait tout pr\u00e9vu<\/h2>\n<p>Il a trouv\u00e9 une Pok\u00e9 Ball, et il compte bien en faire quelque chose. Cette <strong>figurine Pok\u00e9mon Miaouss Saison<\/strong> le montre debout, la pi\u00e8ce d&rsquo;or brillant sur le front, \u00e0 c\u00f4t\u00e9 d&rsquo;une Pok\u00e9 Ball pos\u00e9e au sol et d&rsquo;un buisson vert. On l&rsquo;imagine d\u00e9j\u00e0 en train de pr\u00e9parer un plan pour la Team Rocket.<\/p>\n<h3>La s\u00e9rie Nature Adventure de Langbowang<\/h3>\n<p>Les petits dioramas de la s\u00e9rie Nature Adventure montrent les Pok\u00e9mon hors des combats. Chacun a son d\u00e9cor et son ambiance. Pour Miaouss, Langbowang a choisi un sol clair et un buisson touffu, avec cette Pok\u00e9 Ball qui ajoute une petite histoire \u00e0 la sc\u00e8ne.<\/p>\n<p>La bo\u00eete, illustr\u00e9e, reprend le m\u00eame th\u00e8me nature, ce qui en fait une jolie pr\u00e9sentation pour ceux qui gardent l&#8217;emballage.<\/p>\n<h3>Num\u00e9ro 0052, le Pok\u00e9mon qui parle<\/h3>\n<p>Dans les jeux, Miaouss est un Pok\u00e9mon Normal qui adore les objets brillants, en particulier les pi\u00e8ces. Son attaque Jackpot permet m\u00eame de ramasser de l&rsquo;argent apr\u00e8s un combat, ce qui colle parfaitement \u00e0 son caract\u00e8re.<\/p>\n<p>Mais c&rsquo;est l&rsquo;anime qui l&rsquo;a rendu c\u00e9l\u00e8bre : le Miaouss de Jessie et James a appris \u00e0 parler la langue des humains, et \u00e0 marcher sur deux pattes, pour impressionner une Miaouss qu&rsquo;il aimait. Depuis, il est le cerveau de toutes les combines du trio, et l&rsquo;un des personnages les plus attachants de la s\u00e9rie.<\/p>\n<h3>Avec qui l&rsquo;exposer ?<\/h3>\n<p>Il s&rsquo;int\u00e8gre parfaitement aux autres dioramas de la m\u00eame s\u00e9rie : la <a href=\"https:\/\/www.bdfancomics.ch\/produit\/figurine-pokemon-pikachu-saison\/\"><strong>figurine Pikachu Saison<\/strong><\/a> face \u00e0 lui, c&rsquo;est l&rsquo;\u00e9ternelle poursuite entre la Team Rocket et la mascotte, version d\u00e9tente. La <a href=\"https:\/\/www.bdfancomics.ch\/produit\/figurine-pokemon-ramoloss-saison\/\"><strong>figurine Ramoloss Saison<\/strong><\/a> compl\u00e8te la petite collection dans une ambiance tout aussi tranquille.<\/p>\n<p>Les fans de la Team Rocket y verront une belle occasion de mettre leur personnage pr\u00e9f\u00e9r\u00e9 en avant, pour une fois sans montgolfi\u00e8re et sans chute dans le ciel.<\/p>\n<p>La sculpture insiste sur ce qui fait le personnage : les moustaches en \u00e9ventail, les oreilles noires et brunes, la queue enroul\u00e9e au bout et cette pi\u00e8ce dor\u00e9e au milieu du front. La Pok\u00e9 Ball, rouge et blanche, est bien proportionn\u00e9e par rapport \u00e0 lui et sert presque de second personnage dans la sc\u00e8ne.<\/p>\n<p>Pour un fan de l&rsquo;anime, c&rsquo;est l&rsquo;occasion d&rsquo;avoir un Miaouss qui ne finit pas la sc\u00e8ne projet\u00e9 dans le ciel en criant \u00ab La Team Rocket s&rsquo;envole vers d&rsquo;autres cieux ! \u00bb.<\/p>\n<h3>Caract\u00e9ristiques<\/h3>\n<p><strong>Fabricant :<\/strong> Langbowang \u00b7 <strong>Gamme :<\/strong> Nature Adventure (Saison) \u00b7 <strong>Personnage :<\/strong> Miaouss (n\u00b0 0052) \u00b7 <strong>Mati\u00e8re :<\/strong> PVC \u00b7 <strong>Pr\u00e9sentation :<\/strong> bo\u00eete \u00b7 <strong>EAN :<\/strong> 6923517312920<\/p>\n<p>Figurine fixe, sans pi\u00e8ce mobile, pour la vitrine ou le bureau.<\/p>\n<div class=\"category-seo-more\">\n<details>\n<summary style=\"cursor:pointer;color:#cc0000\"><strong><span style=\"color:#ffffff\">Lire plus<\/span><\/strong><\/summary>\n<p>Gardez un \u0153il sur vos pi\u00e8ces de monnaie pr\u00e8s de cette figurine. Rien ne prouve qu&rsquo;il les vole, mais rien ne prouve le contraire non plus.<\/p>\n<\/details>\n<\/div>","on_sale":false,"prices":{"price":"2900","regular_price":"2900","sale_price":"2900","price_range":null,"currency_code":"CHF","currency_symbol":"CHF","currency_minor_unit":2,"currency_decimal_separator":",","currency_thousand_separator":"","currency_prefix":"","currency_suffix":"CHF"},"price_html":"<span class=\"woocommerce-Price-amount amount\">29,00<span class=\"woocommerce-Price-currencySymbol\" dir=\"auto\">&#067;&#072;&#070;<\/span><\/span>","average_rating":"0","review_count":0,"images":[{"id":93791,"src":"https:\/\/www.bdfancomics.ch\/wp-content\/uploads\/2026\/10\/figurine-pokemon-miaouss-saison-nyon.webp","thumbnail":"https:\/\/www.bdfancomics.ch\/wp-content\/uploads\/2026\/10\/figurine-pokemon-miaouss-saison-nyon-500x500.webp","srcset":"https:\/\/www.bdfancomics.ch\/wp-content\/uploads\/2026\/10\/figurine-pokemon-miaouss-saison-nyon.webp 1200w, https:\/\/www.bdfancomics.ch\/wp-content\/uploads\/2026\/10\/figurine-pokemon-miaouss-saison-nyon-300x300.webp 300w, https:\/\/www.bdfancomics.ch\/wp-content\/uploads\/2026\/10\/figurine-pokemon-miaouss-saison-nyon-1024x1024.webp 1024w, https:\/\/www.bdfancomics.ch\/wp-content\/uploads\/2026\/10\/figurine-pokemon-miaouss-saison-nyon-150x150.webp 150w, https:\/\/www.bdfancomics.ch\/wp-content\/uploads\/2026\/10\/figurine-pokemon-miaouss-saison-nyon-768x768.webp 768w, https:\/\/www.bdfancomics.ch\/wp-content\/uploads\/2026\/10\/figurine-pokemon-miaouss-saison-nyon-500x500.webp 500w, https:\/\/www.bdfancomics.ch\/wp-content\/uploads\/2026\/10\/figurine-pokemon-miaouss-saison-nyon-600x600.webp 600w, https:\/\/www.bdfancomics.ch\/wp-content\/uploads\/2026\/10\/figurine-pokemon-miaouss-saison-nyon-100x100.webp 100w, https:\/\/www.bdfancomics.ch\/wp-content\/uploads\/2026\/10\/figurine-pokemon-miaouss-saison-nyon-64x64.webp 64w","sizes":"(max-width: 1200px) 100vw, 1200px","thumbnail_srcset":"https:\/\/www.bdfancomics.ch\/wp-content\/uploads\/2026\/10\/figurine-pokemon-miaouss-saison-nyon-500x500.webp 500w, https:\/\/www.bdfancomics.ch\/wp-content\/uploads\/2026\/10\/figurine-pokemon-miaouss-saison-nyon-300x300.webp 300w, https:\/\/www.bdfancomics.ch\/wp-content\/uploads\/2026\/10\/figurine-pokemon-miaouss-saison-nyon-1024x1024.webp 1024w, https:\/\/www.bdfancomics.ch\/wp-content\/uploads\/2026\/10\/figurine-pokemon-miaouss-saison-nyon-150x150.webp 150w, https:\/\/www.bdfancomics.ch\/wp-content\/uploads\/2026\/10\/figurine-pokemon-miaouss-saison-nyon-768x768.webp 768w, https:\/\/www.bdfancomics.ch\/wp-content\/uploads\/2026\/10\/figurine-pokemon-miaouss-saison-nyon-600x600.webp 600w, https:\/\/www.bdfancomics.ch\/wp-content\/uploads\/2026\/10\/figurine-pokemon-miaouss-saison-nyon-100x100.webp 100w, https:\/\/www.bdfancomics.ch\/wp-content\/uploads\/2026\/10\/figurine-pokemon-miaouss-saison-nyon-64x64.webp 64w, https:\/\/www.bdfancomics.ch\/wp-content\/uploads\/2026\/10\/figurine-pokemon-miaouss-saison-nyon.webp 1200w","thumbnail_sizes":"(max-width: 500px) 100vw, 500px","name":"Figurine Pok\u00e9mon Miaouss Saison","alt":"Figurine Pok\u00e9mon Miaouss Saison"}],"categories":[{"id":3873,"name":"Figurines Pok\u00e9mon","slug":"figurines-pokemon","link":"https:\/\/www.bdfancomics.ch\/categorie-produit\/figurines\/figurines-mangas\/figurines-pokemon\/"}],"tags":[],"brands":[{"id":6477,"name":"The Pok\u00e9mon Company","slug":"the-pokemon-company","link":"https:\/\/www.bdfancomics.ch\/marque\/the-pokemon-company\/"}],"attributes":[{"id":11,"name":"Licence","taxonomy":"pa_licence","has_variations":false,"terms":[{"id":6680,"name":"Pok\u00e9mon","slug":"pokemon"}]},{"id":13,"name":"Personnage","taxonomy":"pa_personnage","has_variations":false,"terms":[{"id":6725,"name":"Miaouss","slug":"miaouss"}]},{"id":12,"name":"Univers \/ M\u00e9dia","taxonomy":"pa_univers-media","has_variations":false,"terms":[{"id":6682,"name":"Anime","slug":"anime"}]},{"id":41,"name":"Fabricant","taxonomy":"pa_fabricant","has_variations":false,"terms":[{"id":12215,"name":"Langbowang","slug":"langbowang"}]},{"id":3,"name":"Taille","taxonomy":"pa_taille","has_variations":false,"terms":[{"id":12164,"name":"Moins de 15 cm","slug":"moins-de-15-cm"}]}],"variations":[],"grouped_products":[],"has_options":false,"is_purchasable":true,"is_in_stock":true,"is_on_backorder":false,"low_stock_remaining":null,"stock_availability":{"text":"En stock","class":"in-stock"},"sold_individually":false,"weight":"","dimensions":{"length":"","width":"","height":""},"formatted_weight":"ND","formatted_dimensions":"ND","add_to_cart":{"text":"Ajouter au panier","description":"Ajouter au panier\u00a0: &ldquo;Figurine Pok\u00e9mon Miaouss Saison&rdquo;","url":"\/wp-json\/wc\/store\/v1\/products?search=pokemon&#038;per_page=100&#038;orderby=date&#038;order=desc&#038;add-to-cart=89132","single_text":"Ajouter au panier","minimum":1,"maximum":7,"multiple_of":1},"is_password_protected":false,"extensions":{},"_links":{"self":[{"href":"https:\/\/www.bdfancomics.ch\/wp-json\/wc\/store\/v1\/products\/89132","targetHints":{"allow":["GET"]}}],"collection":[{"href":"https:\/\/www.bdfancomics.ch\/wp-json\/wc\/store\/v1\/products"}],"upsells":[{"embeddable":true,"href":"https:\/\/www.bdfancomics.ch\/wp-json\/wc\/store\/v1\/products?include=89465,78164,89578,76404"}],"cross_sells":[{"embeddable":true,"href":"https:\/\/www.bdfancomics.ch\/wp-json\/wc\/store\/v1\/products?include=89130,89120,89111,44935"}],"related":[{"embeddable":true,"href":"https:\/\/www.bdfancomics.ch\/wp-json\/wc\/store\/v1\/products?related=89132&per_page=10"}]}},{"id":89130,"name":"Figurine Pok\u00e9mon Mew","slug":"figurine-pokemon-mew","parent":0,"type":"simple","variation":"","permalink":"https:\/\/www.bdfancomics.ch\/produit\/figurine-pokemon-mew\/","sku":"6972940551833","short_description":"<p>La <strong>figurine Mew Funism<\/strong> (Prime Figure Mini) fait flotter le Pok\u00e9mon fabuleux au milieu de bulles bleues transparentes, sur un socle \u00e0 son nom. PVC, licence officielle Pok\u00e9mon.<\/p>\n<p>Le n\u00b0151, celui que personne n&rsquo;avait vu venir, enfin pos\u00e9 sur une \u00e9tag\u00e8re plut\u00f4t que cach\u00e9 sous un camion.<\/p>","description":"<h2>Figurine Mew Funism : le n\u00b0151 en apesanteur<\/h2>\n<p>Mew a toujours eu un parfum de rumeur. Absent des jeux de base, d\u00e9couvert par les joueurs \u00e0 coups de l\u00e9gendes de cour de r\u00e9cr\u00e9ation, il a gard\u00e9 cette aura de Pok\u00e9mon introuvable. La <strong>figurine Mew Funism<\/strong> le montre en apesanteur, port\u00e9 par des bulles bleues transparentes, comme s&rsquo;il venait de passer en coup de vent.<\/p>\n<h3>Le Pok\u00e9mon fabuleux de la premi\u00e8re g\u00e9n\u00e9ration<\/h3>\n<p>Num\u00e9ro 151 du Pok\u00e9dex national, Mew est de type Psy. Selon l&rsquo;univers Pok\u00e9mon, il porterait le code g\u00e9n\u00e9tique de tous les Pok\u00e9mon, ce qui explique pourquoi des scientifiques ont voulu en faire un clone : Mewtwo. Le premier film Pok\u00e9mon s&rsquo;est construit tout entier sur cette histoire.<\/p>\n<h3>Bulles bleues et socle rond<\/h3>\n<p>La gamme Prime Figure Mini de Funism associe chaque Pok\u00e9mon \u00e0 un effet en plastique transparent. Pour Mew, ce sont des bulles bleues translucides qui l&rsquo;entourent et donnent l&rsquo;impression qu&rsquo;il flotte. Le socle porte le nom du Pok\u00e9mon.<\/p>\n<p>Avec son rose p\u00e2le et ces reflets bleus, la figurine se remarque m\u00eame au milieu d&rsquo;une \u00e9tag\u00e8re bien remplie.<\/p>\n<h3>Mew et Mewtwo, l&rsquo;\u00e9ternel face-\u00e0-face<\/h3>\n<p>Impossible de parler de Mew sans son clone. La <a href=\"https:\/\/www.bdfancomics.ch\/produit\/mewtwo-strikes-back-evolution\/\"><strong>figurine Mewtwo Strikes Back Evolution<\/strong><\/a> rappelle le film o\u00f9 tout a commenc\u00e9. Les fans de cartes trouveront aussi Mew sous toutes ses formes dans les <a href=\"https:\/\/www.bdfancomics.ch\/categorie-produit\/cartes-a-collectionner\/pokemon-cartes\/cartes-pokemon-en-francais\/\"><strong>cartes Pok\u00e9mon en fran\u00e7ais<\/strong><\/a>.<\/p>\n<h3>Un Pok\u00e9mon qu&rsquo;on ne trouvait pas<\/h3>\n<p>Dans Pok\u00e9mon Rouge et Bleu, Mew n&rsquo;\u00e9tait pas capturable normalement : il \u00e9tait distribu\u00e9 lors d&rsquo;\u00e9v\u00e9nements officiels. Les journaux du Manoir Pok\u00e9mon de l&rsquo;\u00eele Cramois&rsquo;\u00cele racontent pourtant sa d\u00e9couverte dans la jungle de Guyane et la naissance de Mewtwo, des notes qui ont nourri des ann\u00e9es de th\u00e9ories.<\/p>\n<p>Le premier long-m\u00e9trage, Pok\u00e9mon, le film : Mewtwo contre-attaque, a fini de transformer ce petit Pok\u00e9mon rose en l\u00e9gende. Une figurine Mew, c&rsquo;est un clin d&rsquo;\u0153il direct \u00e0 cette \u00e9poque o\u00f9 l&rsquo;on \u00e9changeait des rumeurs plus souvent que des cartes.<\/p>\n<h3>Allong\u00e9 sur un nuage<\/h3>\n<p>La figurine montre Mew \u00e9tir\u00e9 sur un petit nuage bleu ciel, la longue queue en boucle dress\u00e9e vers le haut, entour\u00e9 de bulles transparentes et de petites \u00e9toiles dor\u00e9es. Le socle porte MEW et son nom chinois. Tout est l\u00e9ger, presque a\u00e9rien : exactement l&rsquo;id\u00e9e qu&rsquo;on se fait d&rsquo;un Pok\u00e9mon qui appara\u00eet puis dispara\u00eet sans pr\u00e9venir.<\/p>\n<h3>Caract\u00e9ristiques<\/h3>\n<p>Une figurine Funism de la collection Prime Figure Mini, en PVC avec effets transparents, sous licence officielle Pok\u00e9mon. EAN : 6972940551833.<\/p>\n<div class=\"category-seo-more\">\n<details>\n<summary style=\"cursor:pointer;color:#cc0000\"><strong><span style=\"color:#ffffff\">Lire plus<\/span><\/strong><\/summary>\n<p>Dans les ann\u00e9es 90, des millions de joueurs ont cru qu&rsquo;on trouvait Mew sous un camion pr\u00e8s du S.S. Anne. Bonne nouvelle : cette fois, il suffit de passer en boutique. Le camion n&rsquo;est pas n\u00e9cessaire.<\/p>\n<\/details>\n<\/div>","on_sale":false,"prices":{"price":"2900","regular_price":"2900","sale_price":"2900","price_range":null,"currency_code":"CHF","currency_symbol":"CHF","currency_minor_unit":2,"currency_decimal_separator":",","currency_thousand_separator":"","currency_prefix":"","currency_suffix":"CHF"},"price_html":"<span class=\"woocommerce-Price-amount amount\">29,00<span class=\"woocommerce-Price-currencySymbol\" dir=\"auto\">&#067;&#072;&#070;<\/span><\/span>","average_rating":"0","review_count":0,"images":[{"id":93789,"src":"https:\/\/www.bdfancomics.ch\/wp-content\/uploads\/2026\/10\/figurine-pokemon-mew-nyon.webp","thumbnail":"https:\/\/www.bdfancomics.ch\/wp-content\/uploads\/2026\/10\/figurine-pokemon-mew-nyon-500x500.webp","srcset":"https:\/\/www.bdfancomics.ch\/wp-content\/uploads\/2026\/10\/figurine-pokemon-mew-nyon.webp 1200w, https:\/\/www.bdfancomics.ch\/wp-content\/uploads\/2026\/10\/figurine-pokemon-mew-nyon-300x300.webp 300w, https:\/\/www.bdfancomics.ch\/wp-content\/uploads\/2026\/10\/figurine-pokemon-mew-nyon-1024x1024.webp 1024w, https:\/\/www.bdfancomics.ch\/wp-content\/uploads\/2026\/10\/figurine-pokemon-mew-nyon-150x150.webp 150w, https:\/\/www.bdfancomics.ch\/wp-content\/uploads\/2026\/10\/figurine-pokemon-mew-nyon-768x768.webp 768w, https:\/\/www.bdfancomics.ch\/wp-content\/uploads\/2026\/10\/figurine-pokemon-mew-nyon-500x500.webp 500w, https:\/\/www.bdfancomics.ch\/wp-content\/uploads\/2026\/10\/figurine-pokemon-mew-nyon-600x600.webp 600w, https:\/\/www.bdfancomics.ch\/wp-content\/uploads\/2026\/10\/figurine-pokemon-mew-nyon-100x100.webp 100w, https:\/\/www.bdfancomics.ch\/wp-content\/uploads\/2026\/10\/figurine-pokemon-mew-nyon-64x64.webp 64w","sizes":"(max-width: 1200px) 100vw, 1200px","thumbnail_srcset":"https:\/\/www.bdfancomics.ch\/wp-content\/uploads\/2026\/10\/figurine-pokemon-mew-nyon-500x500.webp 500w, https:\/\/www.bdfancomics.ch\/wp-content\/uploads\/2026\/10\/figurine-pokemon-mew-nyon-300x300.webp 300w, https:\/\/www.bdfancomics.ch\/wp-content\/uploads\/2026\/10\/figurine-pokemon-mew-nyon-1024x1024.webp 1024w, https:\/\/www.bdfancomics.ch\/wp-content\/uploads\/2026\/10\/figurine-pokemon-mew-nyon-150x150.webp 150w, https:\/\/www.bdfancomics.ch\/wp-content\/uploads\/2026\/10\/figurine-pokemon-mew-nyon-768x768.webp 768w, https:\/\/www.bdfancomics.ch\/wp-conte