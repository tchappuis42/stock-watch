www.bdfancomics.ch\/wp-content\/uploads\/2026\/08\/deck-pokemon-mon-premier-combat-salameche-carapuce-nyon-300x300.webp 300w, https:\/\/www.bdfancomics.ch\/wp-content\/uploads\/2026\/08\/deck-pokemon-mon-premier-combat-salameche-carapuce-nyon-1024x1024.webp 1024w, https:\/\/www.bdfancomics.ch\/wp-content\/uploads\/2026\/08\/deck-pokemon-mon-premier-combat-salameche-carapuce-nyon-150x150.webp 150w, https:\/\/www.bdfancomics.ch\/wp-content\/uploads\/2026\/08\/deck-pokemon-mon-premier-combat-salameche-carapuce-nyon-768x768.webp 768w, https:\/\/www.bdfancomics.ch\/wp-content\/uploads\/2026\/08\/deck-pokemon-mon-premier-combat-salameche-carapuce-nyon-600x600.webp 600w, https:\/\/www.bdfancomics.ch\/wp-content\/uploads\/2026\/08\/deck-pokemon-mon-premier-combat-salameche-carapuce-nyon-100x100.webp 100w, https:\/\/www.bdfancomics.ch\/wp-content\/uploads\/2026\/08\/deck-pokemon-mon-premier-combat-salameche-carapuce-nyon-64x64.webp 64w, https:\/\/www.bdfancomics.ch\/wp-content\/uploads\/2026\/08\/deck-pokemon-mon-premier-combat-salameche-carapuce-nyon.webp 1200w","thumbnail_sizes":"(max-width: 500px) 100vw, 500px","name":"Deck Pok\u00e9mon Mon Premier Combat \u2013 Salam\u00e8che et Carapuce","alt":"Deck Pok\u00e9mon Mon Premier Combat \u2013 Salam\u00e8che et Carapuce \u2013 visuel du produit"}],"categories":[{"id":2629,"name":"Decks Pok\u00e9mon en Fran\u00e7ais","slug":"decks-pokemon-en-francais","link":"https:\/\/www.bdfancomics.ch\/categorie-produit\/cartes-a-collectionner\/pokemon-cartes\/cartes-pokemon-en-francais\/decks-pokemon-en-francais\/"}],"tags":[{"id":2281,"name":"Pok\u00e9mon","slug":"pokemon","link":"https:\/\/www.bdfancomics.ch\/etiquette-produit\/pokemon\/"}],"brands":[{"id":6477,"name":"The Pok\u00e9mon Company","slug":"the-pokemon-company","link":"https:\/\/www.bdfancomics.ch\/marque\/the-pokemon-company\/"}],"attributes":[{"id":0,"name":"Mod\u00e8le","taxonomy":null,"has_variations":true,"terms":[{"id":0,"name":"Salam\u00e8che et Carapuce","slug":"Salam\u00e8che et Carapuce"},{"id":0,"name":"Pikachu et Bulbizarre","slug":"Pikachu et Bulbizarre"}]},{"id":11,"name":"Licence","taxonomy":"pa_licence","has_variations":false,"terms":[{"id":6680,"name":"Pok\u00e9mon","slug":"pokemon"}]},{"id":7,"name":"Langue","taxonomy":"pa_langue","has_variations":false,"terms":[{"id":5361,"name":"Fran\u00e7ais","slug":"francais"}]},{"id":37,"name":"Type de produit TCG","taxonomy":"pa_format-tcg","has_variations":false,"terms":[{"id":12056,"name":"Deck","slug":"deck"}]}],"variations":[{"id":89488,"attributes":[{"name":"Mod\u00e8le","value":"Salam\u00e8che et Carapuce"}]},{"id":89487,"attributes":[{"name":"Mod\u00e8le","value":"Pikachu et Bulbizarre"}]}],"grouped_products":[],"has_options":true,"is_purchasable":true,"is_in_stock":true,"is_on_backorder":false,"low_stock_remaining":null,"stock_availability":{"text":"","class":"in-stock"},"sold_individually":false,"weight":"","dimensions":{"length":"","width":"","height":""},"formatted_weight":"ND","formatted_dimensions":"ND","add_to_cart":{"text":"Choix des options","description":"S\u00e9lectionner les options pour &ldquo;Deck Pok\u00e9mon Mon Premier Combat&rdquo;","url":"https:\/\/www.bdfancomics.ch\/produit\/deck-pokemon-mon-premier-combat\/","single_text":"Ajouter au panier","minimum":1,"maximum":9999,"multiple_of":1},"is_password_protected":false,"extensions":{},"_links":{"self":[{"href":"https:\/\/www.bdfancomics.ch\/wp-json\/wc\/store\/v1\/products\/89468","targetHints":{"allow":["GET"]}}],"collection":[{"href":"https:\/\/www.bdfancomics.ch\/wp-json\/wc\/store\/v1\/products"}],"upsells":[{"embeddable":true,"href":"https:\/\/www.bdfancomics.ch\/wp-json\/wc\/store\/v1\/products?include=89021,89020,89015,88374"}],"cross_sells":[{"embeddable":true,"href":"https:\/\/www.bdfancomics.ch\/wp-json\/wc\/store\/v1\/products?include=89183,91139,89714,89434"}],"related":[{"embeddable":true,"href":"https:\/\/www.bdfancomics.ch\/wp-json\/wc\/store\/v1\/products?related=89468&per_page=10"}]}},{"id":89466,"name":"Deck Pok\u00e9mon World Championship Anaheim 2025","slug":"deck-pokemon-world-championship-anaheim-2025","parent":0,"type":"variable","variation":"","permalink":"https:\/\/www.bdfancomics.ch\/produit\/deck-pokemon-world-championship-anaheim-2025\/","sku":"196214135390","short_description":"<p>Les <strong>Decks des Championnats du Monde 2025<\/strong> sont des r\u00e9pliques exactes des decks de quatre finalistes des Worlds d&rsquo;Anaheim, avec tapis, pin&rsquo;s, pi\u00e8ce, \u00e9tui et livret.<\/p>\n<p>Quatre mod\u00e8les : Gardevoir-ex, Gromago-ex, Ire-Foudre-ex ou Lanssorien-ex.<\/p>","description":"<h2>Decks des Championnats du Monde 2025 : jouer comme un champion<\/h2>\n<p>Chaque ann\u00e9e, Pok\u00e9mon \u00e9dite les decks des meilleurs joueurs des Championnats du Monde. Les <strong>Decks des Championnats du Monde 2025<\/strong> reproduisent \u00e0 l&rsquo;identique les listes de quatre finalistes de l&rsquo;\u00e9dition d&rsquo;Anaheim, en Californie. Une fa\u00e7on unique de comprendre comment pensent les meilleurs joueurs de la plan\u00e8te.<\/p>\n<h3>Les quatre decks<\/h3>\n<p>Au choix : le deck Gardevoir-ex de Riley McKay (Canada), champion en cat\u00e9gorie Masters ; le deck Gromago-ex de Liao Fu Guan (Chine), champion Seniors ; le deck Ire-Foudre-ex de Yuya Okita (Japon), champion Juniors ; et le deck Lanssorien-ex de Jose Cruz Galindo-Resendiz (\u00c9tats-Unis), finaliste Juniors. Gardevoir et Lanssorien conviennent \u00e0 ceux qui aiment les parties longues et pr\u00e9par\u00e9es, Ire-Foudre et Gromago aux amateurs d&rsquo;attaques directes.<\/p>\n<h3>Le contenu officiel<\/h3>\n<p>Chaque deck contient un deck de 60 cartes des Championnats du Monde, le livret des Championnats du Monde 2025, un pin&rsquo;s, une pi\u00e8ce, un \u00e9tui pour deck, un tapis de jeu avec un poster et une carte \u00e0 code pour Pok\u00e9mon TCG Live.<\/p>\n<h3>\u00c0 savoir avant d&rsquo;acheter<\/h3>\n<p>Les cartes de ces decks ont un dos diff\u00e9rent, des bordures argent\u00e9es et la signature du joueur sur chaque carte. Elles ne sont donc pas autoris\u00e9es en tournoi officiel. C&rsquo;est voulu : ce sont des decks d&rsquo;apprentissage et de collection. On joue avec entre amis, on \u00e9tudie les choix du champion, puis on reconstruit la liste avec ses propres cartes pour la comp\u00e9tition.<\/p>\n<h3>Une signature sur chaque carte<\/h3>\n<p>Le d\u00e9tail pla\u00eet beaucoup aux collectionneurs : voir le nom d&rsquo;un champion du monde de la cat\u00e9gorie Juniors imprim\u00e9 sur chaque carte rappelle que les Worlds Pok\u00e9mon ont trois cat\u00e9gories d&rsquo;\u00e2ge, et que les plus jeunes y jouent au plus haut niveau.<\/p>\n<p>Le mod\u00e8le se choisit sur la fiche selon le stock. Pour s&rsquo;entra\u00eener avec un deck jouable en tournoi, voir le <a href=\"https:\/\/www.bdfancomics.ch\/produit\/deck-pokemon-combat-de-ligue-palkia-originel-vstar\/\"><strong>Deck Combat de Ligue Palkia Originel-VSTAR<\/strong><\/a> et le <a href=\"https:\/\/www.bdfancomics.ch\/produit\/coffret-pokemon-necessaire-du-dresseur-2025\/\"><strong>N\u00e9cessaire du Dresseur 2025<\/strong><\/a>. Les autres decks pr\u00eats \u00e0 jouer sont r\u00e9unis dans les <a href=\"https:\/\/www.bdfancomics.ch\/categorie-produit\/cartes-a-collectionner\/pokemon-cartes\/cartes-pokemon-en-francais\/decks-pokemon-en-francais\/\"><strong>decks Pok\u00e9mon en fran\u00e7ais<\/strong><\/a>.<\/p>\n<h3>Caract\u00e9ristiques<\/h3>\n<p>Decks des Championnats du Monde du JCC Pok\u00e9mon 2025, version fran\u00e7aise. Mod\u00e8les : Riley McKay, Liao Fu Guan, Yuya Okita, Jose Cruz Galindo-Resendiz. Contenu : 1 deck de 60 cartes, 1 livret, 1 pin&rsquo;s, 1 pi\u00e8ce, 1 \u00e9tui pour deck, 1 tapis de jeu et poster, 1 carte \u00e0 code. Sortie : 2e trimestre 2026. EAN : 196214135390.<\/p>\n<div class=\"category-seo-more\">\n<details>\n<summary style=\"cursor:pointer;color:#cc0000\"><strong><span style=\"color:#ffffff\">Lire plus<\/span><\/strong><\/summary>\n<p>Les cartes portent la signature d&rsquo;un champion du monde. Si vous perdez avec, vous aurez au moins une excuse : ce n&rsquo;\u00e9tait pas votre deck.<\/p>\n<\/details>\n<\/div>","on_sale":false,"prices":{"price":"2490","regular_price":"2490","sale_price":"2490","price_range":null,"currency_code":"CHF","currency_symbol":"CHF","currency_minor_unit":2,"currency_decimal_separator":",","currency_thousand_separator":"","currency_prefix":"","currency_suffix":"CHF"},"price_html":"<span class=\"woocommerce-Price-amount amount\">24,90<span class=\"woocommerce-Price-currencySymbol\" dir=\"auto\">&#067;&#072;&#070;<\/span><\/span>","average_rating":"0","review_count":0,"images":[{"id":93730,"src":"https:\/\/www.bdfancomics.ch\/wp-content\/uploads\/2026\/08\/deck-pokemon-championnats-du-monde-2025-jose-cruz-galindo-resendiz-nyon.webp","thumbnail":"https:\/\/www.bdfancomics.ch\/wp-content\/uploads\/2026\/08\/deck-pokemon-championnats-du-monde-2025-jose-cruz-galindo-resendiz-nyon-500x500.webp","srcset":"https:\/\/www.bdfancomics.ch\/wp-content\/uploads\/2026\/08\/deck-pokemon-championnats-du-monde-2025-jose-cruz-galindo-resendiz-nyon.webp 1200w, https:\/\/www.bdfancomics.ch\/wp-content\/uploads\/2026\/08\/deck-pokemon-championnats-du-monde-2025-jose-cruz-galindo-resendiz-nyon-300x300.webp 300w, https:\/\/www.bdfancomics.ch\/wp-content\/uploads\/2026\/08\/deck-pokemon-championnats-du-monde-2025-jose-cruz-galindo-resendiz-nyon-1024x1024.webp 1024w, https:\/\/www.bdfancomics.ch\/wp-content\/uploads\/2026\/08\/deck-pokemon-championnats-du-monde-2025-jose-cruz-galindo-resendiz-nyon-150x150.webp 150w, https:\/\/www.bdfancomics.ch\/wp-content\/uploads\/2026\/08\/deck-pokemon-championnats-du-monde-2025-jose-cruz-galindo-resendiz-nyon-768x768.webp 768w, https:\/\/www.bdfancomics.ch\/wp-content\/uploads\/2026\/08\/deck-pokemon-championnats-du-monde-2025-jose-cruz-galindo-resendiz-nyon-500x500.webp 500w, https:\/\/www.bdfancomics.ch\/wp-content\/uploads\/2026\/08\/deck-po