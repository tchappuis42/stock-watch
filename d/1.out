<div id="pocketdex-cursor" aria-hidden="true"></div>

<script>
  /* --- Cursor custom --- */
  (function () {
    if (window.innerWidth < 990) return;

    var cursorEl = document.getElementById('pocketdex-cursor');
    if (!cursorEl) return;

    /* Déplace l'élément dans le body pour échapper au contexte d'empilement (stacking context) */
    document.body.appendChild(cursorEl);

    /* Pose les styles du curseur via JS */
    cursorEl.style.cssText = 'position:fixed;top:-200px;left:-200px;pointer-events:none;z-index:2147483647;cursor:none;';

    var cursorImg = document.createElement('img');
    cursorImg.style.cssText = 'width:52px;height:auto;display:block;cursor:none;';
    cursorImg.draggable = false;
    cursorEl.appendChild(cursorImg);

    var srcGeneral = '//pocketdex.ch/cdn/shop/t/1/assets/Cursor-General.svg?v=37404488430907030251778273669';
    var srcClick   = '//pocketdex.ch/cdn/shop/t/1/assets/Cursor-click.svg?v=172138829463125114281778273669';
    var CURSOR_OX  = 15, CURSOR_OY = 7;

    cursorImg.src = srcGeneral;

    /* Cache le curseur natif sur TOUS les éléments sous la souris à chaque frame */
    document.addEventListener('mousemove', function (e) {
      if (document.body.lastElementChild !== cursorEl) {
        document.body.appendChild(cursorEl);
      }
      cursorEl.style.top  = (e.clientY - CURSOR_OY) + 'px';
      cursorEl.style.left = (e.clientX - CURSOR_OX) + 'px';

      var els = document.elementsFromPoint(e.clientX, e.clientY);
      for (var i = 0; i < els.length; i++) {
        if (els[i].style) els[i].style.setProperty('cursor', 'none', 'important');
      }
    }, true);

    document.addEventListener('mouseover', function (e) {
      var isLink = !!e.target.closest('a, button, .pocketdex-card, [role="button"], input, select, label, summary');
      cursorImg.src = isLink ? srcClick : srcGeneral;
    });

    document.addEventListener('mouseout', function (e) {
      if (!e.relatedTarget && !e.toElement) {
        cursorEl.style.top  = '-200px';
        cursorEl.style.left = '-200px';
      }
    });
  })();

  /* --- Hero (flyby + parallaxe) --- */
  (function () {
    var hero = document.getElementById('pocketdex-hero-template--30662567199069__pocketdex_hero');
    if (!hero) return;

    /* --- Flyby Ho-Oh --- */
    var video = hero.querySelector('.pocketdex-hero__flyby');
    if (video) {
      function triggerFlyby() {
        video.classList.remove('is-flying');
        void video.offsetWidth;
        video.currentTime = 0;
        video.play().catch(function () {});
        video.classList.add('is-flying');
      }
      setTimeout(function () {
        triggerFlyby();
        setInterval(triggerFlyby, 30000);
      }, 6000);
    }

    /* --- Desktop uniquement pour la suite --- */
    if (window.innerWidth < 990) return;

    /* --- Parallaxe kanjis --- */
    var letters = [
      { el: hero.querySelector('.pocketdex-hero__letter--1'), rot: 8.33, depth: 0.03 },
      { el: hero.querySelector('.pocketdex-hero__letter--2'), rot: -6.42, depth: 0.05 },
      { el: hero.querySelector('.pocketdex-hero__letter--3'), rot: 9.71, depth: 0.025 },
    ];

    var liftCurrent = [0, 0, 0];
    var liftTarget = [0, 0, 0];
    var LIFT = -14;

    letters.forEach(function (l, i) {
      if (!l.el) return;
      l.el.style.pointerEvents = 'auto';
      l.el.addEventListener('mouseenter', function () {
        liftTarget[i] = LIFT;
      });
      l.el.addEventListener('mouseleave', function () {
        liftTarget[i] = 0;
      });
    });

    var mouseRel = { x: 0, y: 0 };
    var curRel = { x: 0, y: 0 };

    document.addEventListener('mousemove', function (e) {
      var r = hero.getBoundingClientRect();
      mouseRel.x = e.clientX - r.left - r.width / 2;
      mouseRel.y = e.clientY - r.top - r.height / 2;
    });

    function lerp(a, b, t) { return a + (b - a) * t; }

    (function tick() {
      curRel.x = lerp(curRel.x, mouseRel.x, 0.06);
      curRel.y = lerp(curRel.y, mouseRel.y, 0.06);
      letters.forEach(function (l, i) {
        if (!l.el) return;
        liftCurrent[i] = lerp(liftCurrent[i], liftTarget[i], 0.06);
        var tx = curRel.x * l.depth;
        var ty = curRel.y * l.depth + liftCurrent[i];
        l.el.style.transform = 'translate(' + tx + 'px, ' + ty + 'px) rotate(' + l.rot + 'deg)';
      });
      requestAnimationFrame(tick);
    })();
  })();
</script>


