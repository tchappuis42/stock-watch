        <div class="pocketdex-filter__dropdown"><span class="pocketdex-filter__option" data-filter-type="type" data-filter-value="booster">Booster</span><span class="pocketdex-filter__option" data-filter-type="type" data-filter-value="bundle">Bundle</span><span class="pocketdex-filter__option" data-filter-type="type" data-filter-value="coffret">Coffret</span><span class="pocketdex-filter__option" data-filter-type="type" data-filter-value="coffret collection poster">Coffret Collection Poster</span><span class="pocketdex-filter__option" data-filter-type="type" data-filter-value="display">Display</span><span class="pocketdex-filter__option" data-filter-type="type" data-filter-value="duo pack">Duo Pack</span><span class="pocketdex-filter__option" data-filter-type="type" data-filter-value="elite trainer box">Elite Trainer Box</span><span class="pocketdex-filter__option" data-filter-type="type" data-filter-value="mini tin">Mini Tin</span><span class="pocketdex-filter__option" data-filter-type="type" data-filter-value="tin box">Tin Box</span><span class="pocketdex-filter__option" data-filter-type="type" data-filter-value="tripack">Tripack</span></div>
