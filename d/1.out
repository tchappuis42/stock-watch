        <span class="pocketdex-filter__arrow"><svg width="18" height="11" viewBox="0 0 18 11" fill="none" xmlns="http://www.w3.org/2000/svg">
<path d="M0.707031 0.707031L8.70703 8.70703L16.707 0.707031" stroke="black" stroke-width="2"/>
</svg>
</span>
      </summary>
      <div class="pocketdex-filter__dropdown">
        <span class="pocketdex-filter__option" data-filter-type="sort" data-filter-value="price-asc">Prix croissant</span>
        <span class="pocketdex-filter__option" data-filter-type="sort" data-filter-value="price-desc">Prix décroissant</span>
