<script>
(function () {
  var activeFilters = { type: null, tags: null, sort: null };

  /* Accordion : ferme les autres <details> quand un s'ouvre */
  var allDetails = Array.from(document.querySelectorAll('.pocketdex-filter'));
  allDetails.forEach(function (det) {
    det.addEventListener('toggle', function () {
      if (det.open) {
        allDetails.forEach(function (other) {
          if (other !== det) other.removeAttribute('open');
        });
      }
    });
  });

  document.querySelectorAll('.pocketdex-filter__option').forEach(function (opt) {
    opt.addEventListener('click', function () {
      var type = opt.dataset.filterType;
      var value = opt.dataset.filterValue;

      var details = opt.closest('details');
      var label = details.querySelector('.pocketdex-filter__label');
      var defaultLabel = label.dataset.default || label.textContent;
      label.dataset.default = defaultLabel;

      /* Désélectionner si déjà actif, sinon sélectionner */
      if (opt.classList.contains('is-active')) {
        opt.classList.remove('is-active');
        activeFilters[type] = null;
        label.textContent = defaultLabel;
        details.classList.remove('has-selection');
      } else {
        document.querySelectorAll('.pocketdex-filter__option[data-filter-type="' + type + '"]').forEach(function (o) {
          o.classList.remove('is-active');
        });
        opt.classList.add('is-active');
        activeFilters[type] = value;
        label.textContent = opt.textContent;
        details.classList.add('has-selection');
        addClearBtn(details, type, label, defaultLabel);
      }

      applyFilters();
      details.removeAttribute('open');
    });
  });

  function applyFilters() {
    var section = document.querySelector('.pocketdex-products');
    var cards = Array.from(document.querySelectorAll('.pocketdex-card'));
    var loadMoreWrap = document.getElementById('pd-loadmore-wrap');

    var hasActiveFilter = Boolean(activeFilters.type || activeFilters.tags || activeFilters.sort);

    if (section) {
      if (hasActiveFilter) {
        section.classList.add('has-active-filter');
      } else {
        section.classList.remove('has-active-filter');
      }
    }

    /* Filtrage */
    cards.forEach(function (card) {
      var show = true;

      if (activeFilters.type) {
        var cardType = (card.dataset.type || '').toLowerCase();
        if (!cardType.includes(activeFilters.type)) show = false;
      }

      if (activeFilters.tags) {
        var cardTags = (card.dataset.tags || '').toLowerCase();
        if (!cardTags.includes(activeFilters.tags)) show = false;
      }

      card.style.display = show ? '' : 'none';
    });

    /* Gérer l'affichage du bouton Charger plus pendant le filtrage */
    if (loadMoreWrap) {
      if (hasActiveFilter) {
        loadMoreWrap.style.display = 'none';
      } else {
        var remainingHidden = document.querySelectorAll('.pocketdex-card.is-hidden-loadmore');
        loadMoreWrap.style.display = remainingHidden.length > 0 ? '' : 'none';
      }
    }

    /* Tri */
    if (activeFilters.sort) {
      var grid = document.querySelector('.pocketdex-products__grid');
      if (!grid) return;

      var visible = cards.filter(function (c) { return c.style.display !== 'none'; });

      visible.sort(function (a, b) {
        if (activeFilters.sort === 'price-asc')  return (parseInt(a.dataset.price) || 0) - (parseInt(b.dataset.price) || 0);
        if (activeFilters.sort === 'price-desc') return (parseInt(b.dataset.price) || 0) - (parseInt(a.dataset.price) || 0);
        if (activeFilters.sort === 'date-desc')  return (parseInt(b.dataset.date) || 0) - (parseInt(a.dataset.date) || 0);
        return 0;
      });

      visible.forEach(function (card) { grid.appendChild(card); });
    }
  }

  function addClearBtn(details, type, label, defaultLabel) {
    var existing = details.querySelector('.pocketdex-filter__clear');
    if (existing) existing.remove();

    var btn = document.createElement('button');
    btn.className = 'pocketdex-filter__clear';
    btn.setAttribute('aria-label', 'Supprimer le filtre');
    btn.innerHTML = '&times;';

    btn.addEventListener('click', function (e) {
      e.preventDefault();
      e.stopPropagation();
      document.querySelectorAll('.pocketdex-filter__option[data-filter-type="' + type + '"]').forEach(function (o) {
        o.classList.remove('is-active');
      });
      activeFilters[type] = null;
      label.textContent = defaultLabel;
      details.classList.remove('has-selection');
      btn.remove();
      applyFilters();
    });

    label.insertAdjacentElement('afterend', btn);
  }
})();
</script>


