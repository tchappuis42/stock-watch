<script>
  document.querySelectorAll('.pocketdex-card__atc[data-variant-id]').forEach(function (btn) {
    btn.addEventListener('click', function (e) {
      e.preventDefault();
      if (btn.disabled) return;

      var variantId = parseInt(btn.dataset.variantId);
      btn.disabled = true;
      btn.textContent = '…';

      var cartEl = document.querySelector('cart-drawer') || document.querySelector('cart-notification');
      var sectionsToRender = cartEl ? cartEl.getSectionsToRender().map(function (s) { return s.id; }) : ['cart-icon-bubble'];

      fetch('/cart/add.js', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          id: variantId,
          quantity: 1,
          sections: sectionsToRender,
          sections_url: window.location.pathname
        })
      })
      .then(function (r) { return r.json(); })
      .then(function (state) {
        btn.textContent = 'Ajouté !';

        if (cartEl) {
          cartEl.renderContents(state);
        } else {
          /* Met à jour le compteur du panier Dawn */
          if (state.sections && state.sections['cart-icon-bubble']) {
            var parser = new DOMParser();
            var doc = parser.parseFromString(state.sections['cart-icon-bubble'], 'text/html');
            var newSection = doc.getElementById('shopify-section-cart-icon-bubble');
            var currentBubble = document.getElementById('cart-icon-bubble');
            if (newSection && currentBubble) {
              currentBubble.innerHTML = newSection.innerHTML;
            }
          }
        }

        setTimeout(function () {
          btn.textContent = 'Ajouter au panier';
          btn.disabled = false;
        }, 2500);
      })
      .catch(function () {
        btn.textContent = 'Erreur — réessaie';
        btn.disabled = false;
      });
    });
  });

  (function() {
    var btn = document.getElementById('pd-loadmore-btn');
    var wrap = document.getElementById('pd-loadmore-wrap');
    if (!btn || !wrap) return;

    btn.addEventListener('click', function() {
      var step = parseInt(btn.dataset.step) || 12;
      var hiddenCards = Array.from(document.querySelectorAll('.pocketdex-card.is-hidden-loadmore'));

      for (var i = 0; i < Math.min(step, hiddenCards.length); i++) {
        hiddenCards[i].classList.remove('is-hidden-loadmore');
      }

      if (document.querySelectorAll('.pocketdex-card.is-hidden-loadmore').length === 0) {
        wrap.style.display = 'none';
      }
    });
  })();
</script>



