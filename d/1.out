      "invertActivatorColors": true,
      "greetingMessage": "Salut ! Des questions sur une commande ou le catalogue ? On répond généralement sous quelques heures. 👋",
      "showFeaturedProducts": true,
      "featuredProducts": [],
      "horizontalPosition": "bottom_right",
      "icon": "chat_bubble",
      "buttonLabel": "Chat"
    }
  }
</script>

<style data-shopify>
  

  /* Shadow DOM content does not prevent theme-wide :empty rules from matching the host. */
  shopify-chat:defined:empty {
    display: grid;
  }

  :root {
    --shopify-chat-bg-color: #FFFFFF;
    --shopify-chat-text-color: #000000;
    --shopify-chat-accent-bg-color: #000000;
    --shopify-chat-accent-text-color: #FFFFFF;
    --shopify-chat-activator-offset: 20px;

    

    --shopify-chat-activator-font-size: 16px;
    --shopify-chat-border-radius: 16px;
  }

  
</style>

