<script id="wcpay-frontend-tracks-js" src="https://www.bdfancomics.ch/wp-content/plugins/woocommerce-payments/dist/frontend-tracks.js?ver=11.2.0"></script>
<script>
(function () {
	'use strict';

	const fields = [
		'.woocommerce-loop-product__title',
		'.price',
		'.entry-meta'
	];

	const activeLoops = new Set();
	let resizeTimer = null;

	function alignLoop(products) {

		const cards = Array.from(
			products.querySelectorAll('.product')
		).filter(function(card) {
			return card.offsetWidth > 1 && card.offsetHeight > 1;
		});

		if (!cards.length) return;


		/* Remise à zéro */
		cards.forEach(function(card) {

			fields.forEach(function(selector) {

				const el = card.querySelector(selector);

				if (el) {
					el.style.removeProperty('min-height');
				}

			});

		});


		/* Création des rangées */
		const rows = [];

		cards.forEach(function(card) {

			const top = Math.round(
				card.getBoundingClientRect().top
			);

			let row = rows.find(function(item) {
				return Math.abs(item.top - top) < 10;
			});

			if (!row) {
				row = {
					top: top,
					cards: []
				};

				rows.push(row);
			}

			row.cards.push(card);

		});


		/* Alignement titre + prix + catégorie */
		rows.forEach(function(row) {

			fields.forEach(function(selector) {

				let maxHeight = 0;
				const elements = [];

				row.cards.forEach(function(card) {

					const el = card.querySelector(selector);

					if (!el) return;

					elements.push(el);

					maxHeight = Math.max(
						maxHeight,
						Math.ceil(
							el.getBoundingClientRect().height
						)
					);

				});

				elements.forEach(function(el) {

					el.style.setProperty(
						'min-height',
						maxHeight + 'px',
						'important'
					);

				});

			});

		});
	}


	function schedule(products) {

		requestAnimationFrame(function() {

			requestAnimationFrame(function() {
				alignLoop(products);
			});

		});

	}


	function initialise() {

		const loops = document.querySelectorAll(
			'.woocommerce .products'
		);

		if (!loops.length) return;


		if ('IntersectionObserver' in window) {

			const observer = new IntersectionObserver(
				function(entries) {

					entries.forEach(function(entry) {

						if (entry.isIntersecting) {

							activeLoops.add(entry.target);
							schedule(entry.target);

						} else {

							activeLoops.delete(entry.target);

						}

					});

				},
				{
					rootMargin: '600px 0px'
				}
			);


			loops.forEach(function(products) {
				observer.observe(products);
			});

		} else {

			loops.forEach(function(products) {
				activeLoops.add(products);
				schedule(products);
			});

		}
	}


	if (document.readyState === 'loading') {

		document.addEventListener(
			'DOMContentLoaded',
			initialise,
			{ once: true }
		);

	} else {

		initialise();

	}


	if (document.fonts && document.fonts.ready) {

		document.fonts.ready.then(function() {

			activeLoops.forEach(function(products) {
				schedule(products);
			});

		});

	}


	window.addEventListener(
		'resize',
		function() {

			clearTimeout(resizeTimer);

			resizeTimer = setTimeout(function() {

				activeLoops.forEach(function(products) {
					schedule(products);
				});

			}, 250);

		},
		{ passive: true }
	);


	document.addEventListener('click', function(event) {

		if (!event.target.closest(
			'.flexy-arrow-prev, .flexy-arrow-next'
		)) {
			return;
		}

		setTimeout(function() {

			activeLoops.forEach(function(products) {
				schedule(products);
			});

		}, 300);

	});

})();
</script>

</body>
</html>
