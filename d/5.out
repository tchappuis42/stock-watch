<style id="wp-custom-css">
/* Corrige l'affichage des galeries WordPress dans les descriptions de catégories WooCommerce */
.tax-product_cat .gallery {
    display: grid !important;
    grid-template-columns: repeat(5, minmax(0, 1fr)) !important;
    gap: 18px !important;
    width: 100% !important;
    max-width: 100% !important;
}

.tax-product_cat .gallery .gallery-item {
    width: 100% !important;
    max-width: 100% !important;
    margin: 0 !important;
    float: none !important;
    display: block !important;
    text-align: center;
}

.tax-product_cat .gallery .gallery-icon {
    width: 100%;
}

.tax-product_cat .gallery img {
    width: 100% !important;
    height: auto !important;
    max-width: 100% !important;
    display: block;
    object-fit: contain;
}

/* Tablette */
@media (max-width: 1024px) {
    .tax-product_cat .gallery {
        grid-template-columns: repeat(3, minmax(0, 1fr)) !important;
    }
}

/* Mobile */
@media (max-width: 600px) {
    .tax-product_cat .gallery {
        grid-template-columns: repeat(2, minmax(0, 1fr)) !important;
    }
}
/* Masquer les légendes des galeries dans les catégories WooCommerce */
.tax-product_cat .gallery .gallery-caption {
    display: none !important;
}
/* =========================================================
   BDFANCOMICS — CARTES PRODUITS
   VERSION STABLE SANS SAUT
   ========================================================= */

/* Carte */
.woocommerce .products .product {
    height: 100% !important;
}


/* Image carrée */
.woocommerce .products .product figure > .ct-media-container {
    width: 100% !important;
    aspect-ratio: 1 / 1 !important;
    height: auto !important;
    overflow: hidden !important;
}


/* Image entière */
.woocommerce .products .product figure > .ct-media-container > img {
    width: 100% !important;
    height: 100% !important;
    aspect-ratio: auto !important;
    object-fit: contain !important;
    object-position: center center !important;
}


/* Titre */
.woocommerce .products .product .woocommerce-loop-product__title {
    height: auto !important;
    text-align: center !important;
}


/* Prix */
.woocommerce .products .product .price {
    text-align: center !important;
}


/* Catégorie */
.woocommerce .products .product .entry-meta {
    text-align: center !important;
}


/* Bouton */
.woocommerce .products .product .ct-woo-card-actions {
    margin-top: auto !important;
}
/* BDFancomics – Inversion barre archives produits Blocksy
   Tri à gauche / compteur + filtres à droite */

@media (min-width: 690px) {

 /* Barre principale des archives produits */
 .woocommerce .ct-woo-card-actions,
 .woocommerce .ct-product-actions {
  display: flex;
  align-items: center;
 }

 /* Le tri passe à gauche */
 .woocommerce .woocommerce-ordering {
  order: -10;
  margin-left: 0;
  margin-right: auto;
 }

 /* Bloc compteur */
 .woocommerce .woocommerce-result-count {
  order: 10;
  margin-left: auto;
  margin-right: 14px;
 }

 /* Bouton filtres à l'extrême droite */
 .woocommerce .ct-filter-trigger,
 .woocommerce .ct-filter-button,
 .woocommerce [data-toggle-panel="#woo-filters-panel"] {
  order: 20;
 }
}
/* Harmonisation du tri catégories avec le tri natif Blocksy */

.bdf-category-sort {
 box-sizing: border-box;
 height: 44px;
 min-height: 44px;
 padding: 0 42px 0 15px;

 border: 2px solid rgba(255,255,255,.55);
 border-radius: 4px;

 background: transparent;
 color: inherit;

 font-size: 14px;
 font-weight: 600;
 line-height: 1.2;

 box-shadow: none;
 -webkit-appearance: none;
 appearance: none;
}

.bdf-category-sort:hover,
.bdf-category-sort:focus {
 border-color: rgba(255,255,255,.8);
 box-shadow: none;
}
/* =====================================================
   BLOCKSY - TRIANGLES PLEINS MENU DESKTOP
   ===================================================== */

/* Cache l'icône native Blocksy visible */
.ct-toggle-dropdown-desktop svg,
.ct-toggle-dropdown-desktop .ct-icon {
	display: none !important;
}

/* Conteneur du triangle */
.ct-toggle-dropdown-desktop {
	display: inline-flex !important;
	align-items: center !important;
	justify-content: center !important;
	width: 16px !important;
	height: 20px !important;
	margin-left: 3px !important;
}

/* Nouveau triangle plein */
.ct-toggle-dropdown-desktop::after {
	content: "" !important;
	display: block !important;
	width: 0 !important;
	height: 0 !important;

	border-left: 5px solid transparent !important;
	border-right: 5px solid transparent !important;
	border-top: 7px solid #ffffff !important;
}
/* Triangle violet au survol du menu */
.ct-menu-link:hover .ct-toggle-dropdown-desktop::after,
.menu-item:hover > .ct-menu-link .ct-toggle-dropdown-desktop::after {
	border-top-color: #7c3aed !important;
}
/* H1 accueil BDFancomics - sécurisation mobile */
.bdf-home-title .stk-block-heading__text {
	word-break: normal !important;
	overflow-wrap: normal !important;
	hyphens: none !important;
}

/* Petits écrans / navigateurs intégrés Instagram */
@media (max-width: 420px) {
	.bdf-home-title .stk-block-heading__text {
		font-size: 32px !important;
		line-height: 1.08 !important;
	}
}

.bdf-mega-clickable > .wp-block-column > .wp-block-group {
 position: relative;
}
/* Mega menus BDFancomics : tuiles entièrement cliquables */
.bdf-mega-clickable .wp-block-group {
 position: relative;
}

.bdf-mega-clickable .wp-block-group a[href]::after {
 content: "";
 position: absolute;
 inset: 0;
 z-index: 10;
 cursor: pointer;
}

/* BDFancomics - supprimer les transitions lourdes des cartes produits sur mobile */

@media (max-width: 689px) {

	.products .product .ct-media-container,

	.products .product .ct-wishlist-button-archive,

	.products .product .add_to_cart_button,

	.products .product .woocommerce-LoopProduct-link,

	.products .product [class*="ct-term-"] {

		transition: none !important;

		animation: none !important;

	}

}

@media (max-width: 689px) {

	body.home .stk-block,

	body.home .stk-block *,

	body.home .stk-block *::before,

	body.home .stk-block *::after {

		transition: none !important;

		animation: none !important;

	}

}
/* =========================================================
   BDFANCOMICS — BLOC 4 AVANTAGES ACCUEIL
   Empêche les mots de se casser sur écrans intermédiaires
   ========================================================= */

body.home .ct-frosted-glass .stk-block-heading__text {
	word-break: normal !important;
	overflow-wrap: normal !important;
	hyphens: none !important;
}

/* Ordinateur / petits laptops */
@media (min-width: 768px) and (max-width: 1300px) {
	body.home .ct-frosted-glass .stk-block-heading__text {
		font-size: clamp(20px, 2.2vw, 28px) !important;
		line-height: 1.15 !important;
	}
}

/* TEST LCP BDFANCOMICS — TEMPORAIRE */
.home .stk-b3b3150 {
    opacity: 1 !important;
    visibility: visible !important;
}
/* BDFancomics — bandeau des articles : uniquement le titre (pas d'auteur, de date, de catégorie ni de résumé) */
.single-post .hero-section .entry-meta,
.single-post .hero-section .page-description {
	display: none !important;
}

</style>
